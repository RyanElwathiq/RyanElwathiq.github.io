---
// ═══════════════════════════════════════════════════════════════
//  الـ HERO — سكرول-سيكوينس سينمائي (زي أبل)
//
//  كيف بيشتغل:
//  • الفيديو مفكفك لفريمات بمجلد  public/frames/desktop  و  /mobile
//  • وانت بتسكرول، الفريمات بتتحرك وحدة وحدة (الزائر «بيحيك» العقدة)
//  • النص الافتتاحي بيذوب، وبنهاية الرحلة بتظهر الجملة الختامية
//
//  ✏️ تعديل النصوص: من قسم "النصوص" تحت مباشرة
//  ✏️ تعديل المقاسات والتباعد: من "لوحة التحكم" بقسم <style>
//  ✏️ تعديل طول الرحلة وسرعتها: من أول ملف src/scripts/sequence.js
// ═══════════════════════════════════════════════════════════════
interface Props {
  lang: 'en' | 'ar';
}

const { lang } = Astro.props;
const isAr = lang === 'ar';

// ─────────────── النصوص (عدّل من هون) ───────────────
const t = isAr
  ? {
      line1: 'تسويق يبني،',
      line2Pre: 'ونتائج ',
      line2Em: 'بتنقاس بالأرقام.',
      sub: 'ريّان الواثق. تسويق رقمي ونمو من عمّان: سوشال ميديا، إعلانات مدفوعة، مونتاج، وهويات بصرية.',
      cta1: 'شوف أعمالي',
      cta2: 'تواصل معي',
      outroPre: 'استراتيجية، محتوى، ونمو.',
      outroEm: 'مجدولين ببعض.',
    }
  : {
      line1: 'Growth you can',
      line2Pre: '',
      line2Em: 'actually measure.',
      sub: 'Rayan Elwathiq. Digital marketing and growth from Amman: social media, paid ads, video editing, and brand identities.',
      cta1: 'View my work',
      cta2: 'Contact me',
      outroPre: 'Strategy, content, and growth.',
      outroEm: 'Woven into one.',
    };
---

<!-- data-seq-desktop / data-seq-mobile : مسارات مجلدات الفريمات
     data-seq-pin : يعني الفيديو بيتثبّت بالشاشة طول الرحلة
     data-seq-length : طول الرحلة بعدد الشاشات (3 = ثلاث شاشات سكرول) -->
<section
  class="hero"
  data-seq
  data-seq-pin-always
  data-seq-length="3"
  data-seq-desktop="/frames/desktop/"
  data-seq-mobile="/frames/mobile/"
>
  <!-- الجزء المثبّت: بيضل قدامك طول رحلة السكرول -->
  <div class="sticky" data-seq-sticky>
    <!-- الكانفاس: هون بتنرسم فريمات الفيديو -->
    <canvas class="seq-canvas" aria-hidden="true"></canvas>

    <!-- احتياط: لو الفريمات مش موجودة بتظهر العقدة الثابتة بدالها -->
    <div class="knot" data-seq-fallback aria-hidden="true">
      <img src="/assets/logo-white.png" alt="" width="900" height="900" loading="eager" />
    </div>

    <!-- تعتيم خفيف فوق الفيديو عشان النص يضل مقروء دايماً -->
    <div class="scrim" aria-hidden="true"></div>

    <!-- ═══ النص الافتتاحي (بيذوب مع بداية السكرول) ═══ -->
    <div class="container overlay intro" data-seq-intro>
      <div class="panel">
        <h1 class="headline">
          <span class="line-mask"><span class="line" data-hero-line>{t.line1}</span></span>
          <span class="line-mask">
            <span class="line" data-hero-line>{t.line2Pre}<em>{t.line2Em}</em></span>
          </span>
        </h1>

        <p class="sub" data-hero-fade>{t.sub}</p>

        <div class="actions" data-hero-fade>
          <a class="btn btn-primary" href="#work">{t.cta1}</a>
          <a class="btn btn-ghost" href="#contact">{t.cta2}</a>
        </div>
      </div>
    </div>

    <!-- ═══ الجملة الختامية (بتظهر بنهاية رحلة السكرول) ═══ -->
    <div class="container overlay outro" data-seq-outro aria-hidden="true">
      <p class="outro-text">
        {t.outroPre}<br />
        <em>{t.outroEm}</em>
      </p>
    </div>
  </div>
</section>

<style>
  /* ╔═══════════════════════════════════════════════════════════╗
     ║              🎛️ لوحة التحكم — عدّل من هون                  ║
     ╠═══════════════════════════════════════════════════════════╣
     ║  كل رقم مشروح جنبه. غيّر واحفظ وشوف النتيجة فوراً          ║
     ╚═══════════════════════════════════════════════════════════╝ */
  .hero {
    /* حجم العنوان الرئيسي: (أصغر حد، نسبة من الشاشة، أكبر حد)
       أصغر من قبل لأن اللوح صار عرضي والعنوان بياخد نصه بس */
    --headline-size: clamp(34px, 4.6vw, 62px);

    /* المسافة العمودية بين سطور العنوان (1 = ملاصق، 1.3 = مريح) */
    --headline-line-gap: 1.04;

    /* التباعد بين حروف العنوان (بالإنجليزي سالب أحلى، بالعربي صفر) */
    --headline-letter-spacing: -0.03em;

    /* المسافة بين العنوان والوصف (بيكسل) */
    --gap-headline-sub: 28px;

    /* المسافة بين الوصف والأزرار */
    --gap-sub-actions: 40px;

    /* حجم نص الوصف */
    --sub-size: clamp(16px, 1.6vw, 19px);

    /* أقصى عرض لسطر الوصف (بالحرف — أقصر = أسطر أضيق) */
    --sub-max-width: 46ch;

    /* حجم الجملة الختامية */
    --outro-size: clamp(30px, 4.6vw, 64px);

    /* ═══════════════ 🪟 اللوح الزجاجي ═══════════════
       النص محطوط جوا لوح زجاجي بعمق — بيحل مشكلة التباين
       وبيخلي الفيديو ظاهر بكامل وضوحه بباقي الشاشة.

       PANEL_TINT  : غمقان اللوح (0 = شفاف تماماً، 1 = معتم)
       PANEL_BLUR  : قوة ضبابية الزجاج بالبكسل
       PANEL_RADIUS: انحناء زوايا اللوح
       PANEL_PAD   : الحشوة الداخلية */
    --panel-tint: 0.66;
    --panel-blur: 26px;
    --panel-radius: 26px;
    --panel-pad: clamp(26px, 3.4vw, 52px);

    /* ⬛ التعتيم العام فوق الفيديو كله (0 = الفيديو بكامل وضوحه) */
    --scrim-opacity: 0;

    /* ⬛ تعتيم موضعي خفيف جداً خلف اللوح — بيساعد اللوح يقعد
       على الخلفية بدل ما يطفو معلّق. مع اللوح ما عاد نحتاجه قوي. */
    --text-scrim: 0.18;
    --text-scrim-width: 78%;
  }

  /* ═══ البنية (ما بتحتاج تلمسها غالباً) ═══ */
  .hero {
    position: relative;
  }

  .sticky {
    position: relative;
    height: 100dvh;
    overflow: clip;
    display: flex;
    align-items: center;
    /* مساحة لشريط الإشارة وكبسولة التنقل فوق */
    padding-top: 90px;
  }

  .seq-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* طبقتين:
     1) تعتيم عام فوق الفيديو كله  → --scrim-opacity
     2) تعتيم موضعي خلف النص فقط   → --text-scrim
     التاني بيبدأ غامق من جهة النص وبيذوب لشفاف، فالفيديو بيضل
     واضح بالجهة الثانية وبنفس الوقت النص مقروء دايماً. */
  .scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to var(--text-side, right),
        rgba(14, 15, 18, var(--text-scrim)) 0%,
        rgba(14, 15, 18, calc(var(--text-scrim) * 0.75)) 35%,
        transparent var(--text-scrim-width)
      ),
      linear-gradient(
        to top,
        rgba(14, 15, 18, var(--scrim-opacity)),
        rgba(14, 15, 18, var(--scrim-opacity))
      );
    pointer-events: none;
  }

  /* بالعربي النص عاليمين، فالتعتيم لازم يبدأ من اليمين */
  html[dir='rtl'] .scrim {
    --text-side: left;
  }

  /* ═══ العقدة الاحتياطية (لما ما يكون في فريمات) ═══ */
  .knot {
    position: absolute;
    top: 50%;
    inset-inline-end: -12%;
    translate: 0 -50%;
    width: clamp(340px, 52vw, 780px);
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
    pointer-events: none;
    user-select: none;
  }

  .knot img {
    width: 100%;
    height: auto;
    opacity: 0.07;
  }

  /* ═══ طبقات النص ═══ */
  .overlay {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .outro {
    position: absolute;
    inset-inline: 0;
    bottom: 14dvh;
    opacity: 0;
    text-align: center;
    /* ⚠️ شفاف ≠ غير موجود. بدون هالسطر كان هذا العنصر يقف فوق
       زر «تواصل معي» ويبتلع الضغط — فالزر يبين كأنه نص عادي
       بينتسخ. والزر اللي فوقه شغال لأنه خارج مساحته. */
    pointer-events: none;
  }

  /* ═══════════════ 🪟 اللوح الزجاجي ═══════════════
     مستطيل **عرضي**: العنوان بجهة، والوصف والأزرار بالجهة الثانية.
     هيك اللوح واطي وعريض وبيبيّن الفيديو ورا أكثر، والعنوان ما
     بينكسر لأسطر كثيرة تخبص ببعضها. عالموبايل بيرجعوا فوق بعض. */
  .panel {
    position: relative;
    isolation: isolate;
    max-width: min(980px, 100%);
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    column-gap: clamp(28px, 4vw, 56px);
    align-items: center;
    padding: var(--panel-pad);
    border-radius: var(--panel-radius);

    /* الزجاج: تعتيم متدرّج + ضبابية للي وراه */
    background: linear-gradient(
      160deg,
      rgba(27, 30, 36, calc(var(--panel-tint) + 0.1)),
      rgba(14, 15, 18, var(--panel-tint))
    );
    backdrop-filter: blur(var(--panel-blur)) saturate(150%);
    -webkit-backdrop-filter: blur(var(--panel-blur)) saturate(150%);

    /* الحدود: خط رفيع بلون النص الخافت */
    border: 1px solid rgba(242, 243, 238, 0.12);

    /* العمق: لمعة من فوق، ظل داخلي من تحت، وظل خارجي بعيد */
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.14),
      inset 0 -1px 0 rgba(0, 0, 0, 0.45),
      0 28px 70px rgba(0, 0, 0, 0.5);
  }

  /* خط ليموني رفيع على الحافة من جهة النص — توقيع الهوية */
  .panel::before {
    content: '';
    position: absolute;
    inset-block: var(--panel-pad);
    inset-inline-start: 0;
    width: 3px;
    border-radius: var(--r-pill);
    background: linear-gradient(
      to bottom,
      var(--accent),
      color-mix(in srgb, var(--accent) 30%, transparent)
    );
  }

  /* وهج ليموني خافت جداً بالزاوية العليا — عمق بلون الهوية */
  .panel::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: radial-gradient(
      120% 90% at 8% 0%,
      color-mix(in srgb, var(--accent) 9%, transparent),
      transparent 55%
    );
    pointer-events: none;
  }

  /* لو المتصفح ما بيدعم الضبابية أو المستخدم مطفيها: خلفية صلبة */
  @supports not (backdrop-filter: blur(4px)) {
    .panel {
      background: rgba(14, 15, 18, 0.92);
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .panel {
      background: rgba(14, 15, 18, 0.94);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }

  /* توزيع الشبكة: العنوان بياخد العمود الأول بكامله،
     والوصف والأزرار فوق بعض بالعمود الثاني */
  .headline {
    grid-column: 1;
    grid-row: 1 / 3;
    font-weight: 700;
    font-size: var(--headline-size);
    line-height: var(--headline-line-gap);
    letter-spacing: var(--headline-letter-spacing);
    margin-bottom: 0;
  }

  .sub {
    grid-column: 2;
    grid-row: 1;
    align-self: end;
  }

  .actions {
    grid-column: 2;
    grid-row: 2;
    align-self: start;
  }

  /* العربي: خط أثقل، وأسطر أوسع بوضوح.
     ⚠️⚠️ تباعد الأسطر هون **مش رفاهية**.
     الخط العربي فيه نوازل طويلة (ي، ج، ق، ن) وفيه تشكيل فوق
     (تسويق، ونتائج) — فلما العنوان ينكسر لثلاث أسطر، نوازل
     السطر بتلمس رؤوس اللي تحته. جرّبنا 1.22 وبعدين 1.4 والاثنين
     كانوا لسا متلازقين بالصور اللي بعتها ريّان. 1.78 بتعطي فراغ
     مريح وواضح بين الأسطر. لا تنزّله عن 1.6. */
  html[lang='ar'] .headline {
    font-weight: 800;
    line-height: 1.78;
    letter-spacing: 0;
    font-size: clamp(29px, 4vw, 52px);
  }

  /* بالعربي الخط الليموني بيروح عاليمين */
  html[dir='rtl'] .panel::before {
    background: linear-gradient(
      to bottom,
      var(--accent),
      color-mix(in srgb, var(--accent) 30%, transparent)
    );
  }

  /* ⚠️ القناع بيقص حركة دخول السطر. الحشوة تحت لازم تكفي نوازل
     الحروف العربية (ي، ق، ن…) — كانت 0.08em وكانت تقصها */
  .line-mask {
    display: block;
    overflow: clip;
    padding-bottom: 0.22em;
    margin-bottom: -0.22em;
  }

  /* ═══════════════════════════════════════════════════════════════
     أنيميشن دخول الهيرو — CSS خالص، بدون أي مكتبة
     ⚠️ كان معمول بـ GSAP، والنتيجة إنه على تلفون متوسط بالأردن كان
        النص يضل **مخفي ٣ ثواني** لحد ما ينزّل ملف GSAP ويشتغل —
        والنص أصلاً مكتوب بالصفحة وجاهز من أول ثانية!
        هلق الأنيميشن بينفّذه كرت الشاشة، بيبلّش مع أول رسمة، وما
        بيستنى ولا بايت جافاسكربت.
     ✏️ بدك تعدّل السرعة أو التأخير؟ الأرقام تحت مباشرة.
     ═══════════════════════════════════════════════════════════════ */
  .line {
    display: inline-block;
    will-change: transform;
    animation: hero-line 1.05s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  /* السطر الثاني بيدخل بعد الأول بشوي */
  .line-mask:nth-of-type(2) .line {
    animation-delay: 0.12s;
  }

  @keyframes hero-line {
    from {
      transform: translateY(115%);
    }
  }

  [data-hero-fade] {
    animation: hero-fade 0.85s cubic-bezier(0.16, 1, 0.3, 1) 0.5s both;
  }

  .actions[data-hero-fade] {
    animation-delay: 0.6s;
  }

  @keyframes hero-fade {
    from {
      opacity: 0;
      transform: translateY(26px);
    }
  }

  .headline em,
  .outro-text em {
    font-style: normal;
    color: var(--accent);
  }

  .sub {
    /* أفتح من --muted العادي: النص فوق فيديو متغيّر، فبيحتاج تباين أعلى */
    color: #cdd1c8;
    font-size: var(--sub-size);
    max-width: var(--sub-max-width);
    margin-bottom: var(--gap-sub-actions);
  }

  .actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .outro-text {
    font-weight: 700;
    font-size: var(--outro-size);
    line-height: 1.18;
    letter-spacing: -0.02em;
  }

  html[lang='ar'] .outro-text {
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.35;
  }

  /* ═══ وضع بدون فريمات أو «تقليل حركة»: هيرو ثابت عادي ═══ */
  .hero:global(.seq-static) .seq-canvas {
    display: none;
  }

  .hero:global(.seq-static) .outro {
    display: none;
  }

  /* ═══ شاشات أضيق من 860px: اللوح بيرجع عمود واحد ═══ */
  @media (max-width: 860px) {
    .panel {
      grid-template-columns: 1fr;
    }

    .headline {
      grid-column: 1;
      grid-row: auto;
      margin-bottom: var(--gap-headline-sub);
    }

    .sub,
    .actions {
      grid-column: 1;
      grid-row: auto;
      align-self: auto;
    }

    .sub {
      margin-bottom: 20px;
    }
  }

  /* ═══ موبايل ═══ */
  @media (max-width: 640px) {
    .hero {
      --panel-pad: 22px;
      --panel-radius: 20px;
    }

    .panel {
      max-width: 100%;
    }

    .knot {
      inset-inline-end: -38%;
      width: 130vw;
    }

    /* عالموبايل الأزرار فوق بعض بعرض كامل.
       جنب بعض كان نص الزر ينكسر لثلاث أسطر. */
    .actions {
      width: 100%;
      flex-direction: column;
      gap: 12px;
    }

    .actions .btn {
      width: 100%;
      justify-content: center;
      padding-inline: 20px;
      white-space: nowrap;
    }

    .outro {
      bottom: 18dvh;
    }
  }
</style>
