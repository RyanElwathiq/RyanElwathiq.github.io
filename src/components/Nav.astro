---
// ═══════════════════════════════════════════════════════════════
//  شريط التنقل — كبسولة عائمة (Pill) بعمق زجاجي
//  • ديسكتوب: كبسولة بالنص فوق، ما بتاخد عرض الصفحة كله
//  • موبايل: لوجو + زر هامبرجر بيفتح قائمة كاملة
// ═══════════════════════════════════════════════════════════════
import servicesData from '../data/services.json';

interface Props {
  lang: 'en' | 'ar';
  // رابط بديل لتبديل اللغة (بتستخدمه صفحات المقالات لأن اسم
  // ملف المقال بيختلف بين اللغتين)
  switchTo?: string;
}

const { lang, switchTo } = Astro.props;
const isAr = lang === 'ar';

// تبديل اللغة الذكي: بينقلك لنفس الصفحة باللغة الثانية
const path = Astro.url.pathname;
const switchHref =
  switchTo ||
  (isAr
    ? path.replace(/^\/ar\/?/, '/') || '/'
    : path === '/'
      ? '/ar/'
      : `/ar${path}`);

const home = isAr ? '/ar/' : '/';
const blogHref = isAr ? '/ar/signals/' : '/signals/';

// ─────────────── النصوص (عدّل من هون) ───────────────
const t = isAr
  ? {
      work: 'الأعمال',
      brief: 'ابدأ مشروعك',
      loss: 'حاسبة الخسارة',
      budget: 'لعبة الميزانية',
      lab: 'مختبر الأفكار',
      eye: 'عين البراند',
      labWork: 'التجارب',
      seo: 'السيو',
      data: 'تحليل البيانات',
      gProblem: 'المشكلة', gThink: 'كيف بفكّر', gProof: 'الشغل', gStart: 'ابدأ',
      about: 'من أنا', knot: 'ثلاثي الأبعاد', growth: 'قصص النمو',
      designs: 'التصاميم', websites: 'المواقع', video: 'الفيديو',
      pricing: 'كيف بشتغل',
      faq: 'أسئلة شائعة',
      blog: 'إشارات',
      contact: 'تواصل',
      menu: 'القائمة',
      close: 'إغلاق',
      services: 'خدماتي',
      allServices: 'كل الخدمات ←',
    }
  : {
      work: 'Work',
      brief: 'Start a project',
      loss: 'Loss calculator',
      budget: 'Budget game',
      lab: 'Idea lab',
      eye: 'The Brand Eye',
      labWork: 'The lab',
      seo: 'SEO',
      data: 'Data',
      gProblem: 'The problem', gThink: 'How I think', gProof: 'The work', gStart: 'Start',
      about: 'About', knot: '3D', growth: 'Growth stories',
      designs: 'Designs', websites: 'Websites', video: 'Video',
      pricing: 'How I work',
      faq: 'FAQ',
      blog: 'Signals',
      contact: 'Contact',
      menu: 'Menu',
      close: 'Close',
      services: 'Services',
      allServices: 'All services →',
    };

// ═══════════════════════════════════════════════════════════════
//  الخدمات — بتتقرا من services.json فما في مكانين ينفصلوا
//  ✏️ ضفت خدمة بالملف؟ بتظهر بالقائمة لحالها، ما بدها تعديل هون
// ═══════════════════════════════════════════════════════════════
const svcLang = isAr ? 'ar' : 'en';
const services = [...servicesData.services]
  .sort((a, b) => a.order - b.order)
  .map((s) => ({
    name: s[svcLang].name,
    desc: s[svcLang].menuDesc,
    href: `${isAr ? '/ar' : ''}/services/${s.slug}/`,
  }));
const servicesHref = `${isAr ? '/ar' : ''}/services/`;

// ✏️ روابط الكبسولة عالديسكتوب — مختصرة عشان تضل الكبسولة أنيقة
//    (باقي الأقسام موجودة كعلامات على شريط الإشارة فوق)
const links = [
  { label: t.work, href: `${home}#work` },
  { label: t.pricing, href: `${home}#pricing` },
  { label: t.blog, href: blogHref },
  { label: t.contact, href: `${home}#contact` },
];

// ═══════════════════════════════════════════════════════════════
//  روابط قائمة الموبايل — **كل** أقسام الموقع
//
//  ⚠️ قاعدة من ريّان: أي قسم جديد لازم يكون بالقائمة وبشريط
//     الإشارة. الفحص لقى ١٢ قسم ناقص من القائمة (كانت ١٠ روابط
//     مقابل ١٨ قسم) — يعني نص الموقع ما إله طريق من الموبايل
//     إلا السكرول.
//  ⚠️ مجمّعة بنفس ترتيب الصفحة (مشكلة → تفكير → شغل → قرار)
//     لأن ١٨ رابط بقائمة مسطّحة بتصير جدار.
//  ✏️ ضفت قسم؟ ضيفه هون وبشريط الإشارة (marks بصفحة index)
//     وبأيقونات SignalBar.
// ═══════════════════════════════════════════════════════════════
const sheetGroups = [
  // الخدمات أول مجموعة بقائمة الموبايل — هاي اللي بتجيب شغل
  {
    title: t.services,
    links: [
      ...services.map((s) => ({ label: s.name, href: s.href })),
      { label: t.allServices, href: servicesHref },
    ],
  },
  {
    title: t.gProblem,
    links: [
      { label: t.loss, href: `${home}#loss` },
      { label: t.eye, href: `${home}#brand-eye` },
    ],
  },
  {
    title: t.gThink,
    links: [
      { label: t.about, href: `${home}#about` },
      { label: t.seo, href: `${home}#seo` },
      { label: t.data, href: `${home}#data` },
      { label: t.knot, href: `${home}#knot` },
      { label: t.budget, href: `${home}#budget` },
      { label: t.lab, href: `${home}#lab` },
    ],
  },
  {
    title: t.gProof,
    links: [
      { label: t.growth, href: `${home}#growth` },
      { label: t.video, href: `${home}#work` },
      { label: t.designs, href: `${home}#designs` },
      { label: t.websites, href: `${home}#websites` },
      { label: t.labWork, href: `${home}#lab-work` },
      { label: t.blog, href: `${home}#signals` },
    ],
  },
  {
    title: t.gStart,
    links: [
      { label: t.pricing, href: `${home}#pricing` },
      { label: t.faq, href: `${home}#faq` },
      { label: t.brief, href: `${home}#brief` },
      { label: t.contact, href: `${home}#contact` },
    ],
  },
];

const switchLabel = isAr ? 'EN' : 'عربي';
---

<header class="nav">
  <!-- ═══ الكبسولة ═══ -->
  <div class="pill">
    <a class="brand" href={home} aria-label="Rayan Elwathiq">
      <img src="/assets/logo-white.png" alt="" width="30" height="30" />
      <span class="brand-name">{isAr ? 'ريّان الواثق' : 'Rayan Elwathiq'}</span>
    </a>

    <nav class="links" aria-label={isAr ? 'التنقل الرئيسي' : 'Main navigation'}>
      {/* ═══════════════════════════════════════════════════════
          قائمة الخدمات المنسدلة

          ⚠️ مبنية على <details> مش على hover لحاله. ليش؟
             • بتشتغل بالضغط عالموبايل واللمس (الـ hover ما بيوجد)
             • بتنفتح بالكيبورد (Enter/Space) لحالها بلا كود
             • قارئ الشاشة بيعرف إنها مطوية ولا مفتوحة لحاله
             والـ hover مضاف فوقها للماوس بس — أحسن الاثنين.
          ═══════════════════════════════════════════════════════ */}
      <details class="dd" data-dd>
        <summary>
          {t.services}
          <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
            <path d="M5 9l7 7 7-7" />
          </svg>
        </summary>

        <div class="dd-panel">
          <div class="dd-grid">
            {services.map((s) => (
              <a class="dd-item" href={s.href}>
                <span class="dd-name">{s.name}</span>
                <span class="dd-desc">{s.desc}</span>
              </a>
            ))}
          </div>
          <a class="dd-all" href={servicesHref}>{t.allServices}</a>
        </div>
      </details>

      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <a class="lang" href={switchHref}>{switchLabel}</a>

    <!-- زر الهامبرجر (بيبين عالموبايل بس) -->
    <button class="burger" data-menu-open aria-label={t.menu} aria-expanded="false">
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<!-- ═══ قائمة الموبايل ═══ -->
<div class="sheet" data-menu hidden>
  <button class="sheet-close" data-menu-close aria-label={t.close}>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18" />
    </svg>
  </button>

  <nav class="sheet-links" aria-label={isAr ? 'قائمة التنقل' : 'Navigation menu'}>
    {sheetGroups.map((g, gi) => (
      <div class="sheet-group">
        <p class="sheet-title">{g.title}</p>
        {g.links.map((l, i) => (
          <a href={l.href} style={`--i:${gi * 5 + i}`}>{l.label}</a>
        ))}
      </div>
    ))}
  </nav>

  <a class="sheet-lang" href={switchHref}>{switchLabel}</a>
</div>

<style>
  /* ╔═══════════════ 🎛️ لوحة التحكم ═══════════════╗ */
  .nav {
    /* بعد الكبسولة عن أعلى الشاشة — لازم يكون تحت شريط الإشارة
       (ارتفاع الشريط 34px + مسافة تنفّس) */
    --pill-top: 44px;
    --pill-height: 58px; /* ارتفاع الكبسولة */
    --pill-padding: 8px 8px 8px 22px; /* الحشوة الداخلية */
    --pill-gap: clamp(14px, 2vw, 30px); /* المسافة بين الروابط */
    --link-size: 14.5px; /* حجم خط الروابط */
  }

  /* ─── الحاوية: عائمة فوق كل إشي ─── */
  .nav {
    position: fixed;
    top: var(--pill-top);
    inset-inline: 0;
    z-index: var(--z-nav);
    display: flex;
    justify-content: center;
    padding-inline: 16px;
    pointer-events: none; /* المساحة الفاضية حواليها ما بتحجب الضغط */

    /* نفس علاج شريط الإشارة: طبقة رسم مستقلة عشان الكبسولة
       ما ترتجّ وأنت بتمرّر عالموبايل (شريط المتصفح بيختفي ويرجع) */
    transform: translateZ(0);
    backface-visibility: hidden;
  }

  /* ─── الكبسولة نفسها: زجاج بعمق ─── */
  .pill {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: var(--pill-gap);
    height: var(--pill-height);
    padding: var(--pill-padding);
    border-radius: var(--r-pill);
    border: 1px solid rgba(242, 243, 238, 0.12);

    /* الزجاج: تعتيم + ضبابية */
    background: linear-gradient(
      to bottom,
      rgba(33, 36, 42, 0.82),
      rgba(20, 22, 27, 0.86)
    );
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);

    /* العمق: لمعة داخلية فوق + ظل خارجي تحت */
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.14),
      inset 0 -1px 0 rgba(0, 0, 0, 0.4),
      0 10px 34px rgba(0, 0, 0, 0.5);
  }

  /* لو المتصفح ما بيدعم الضبابية أو المستخدم مطفيها: خلفية صلبة */
  @supports not (backdrop-filter: blur(4px)) {
    .pill {
      background: var(--surface-2);
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .pill {
      background: var(--surface-2);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }

  /* ─── اللوجو ─── */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    font-size: 15px;
    white-space: nowrap;
  }

  /* ─── الروابط ─── */
  .links {
    display: flex;
    align-items: center;
    gap: var(--pill-gap);
  }

  /* ╔═══════════ قائمة الخدمات المنسدلة ═══════════╗ */
  .dd {
    position: relative;
  }

  .dd > summary {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: var(--link-size);
    color: var(--muted);
    white-space: nowrap;
    cursor: pointer;
    list-style: none;
    transition: color 0.3s var(--ease-out);
  }
  .dd > summary::-webkit-details-marker { display: none; }
  .dd > summary:hover,
  .dd[open] > summary { color: var(--text); }

  .dd > summary svg {
    transition: transform 0.35s var(--ease-out);
    opacity: 0.75;
  }
  .dd[open] > summary svg { transform: rotate(180deg); }

  /* اللوحة — بتنزل من تحت الكبسولة */
  .dd-panel {
    position: absolute;
    top: calc(100% + 18px);
    inset-inline-start: 50%;
    transform: translateX(var(--dd-x, -50%)) translateY(-6px);
    width: min(560px, 78vw);
    padding: 12px;
    border-radius: 20px;
    border: 1px solid rgba(242, 243, 238, 0.12);
    background: linear-gradient(to bottom, rgba(33, 36, 42, 0.94), rgba(18, 20, 25, 0.96));
    backdrop-filter: blur(22px) saturate(160%);
    -webkit-backdrop-filter: blur(22px) saturate(160%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      0 18px 48px rgba(0, 0, 0, 0.58);
    opacity: 0;
    animation: dd-in 0.28s var(--ease-out) forwards;
  }
  html[dir='rtl'] .dd-panel { --dd-x: 50%; }

  @keyframes dd-in {
    to { opacity: 1; transform: translateX(var(--dd-x, -50%)) translateY(0); }
  }

  /* جسر شفاف بين الرابط واللوحة — بدونه الماوس بيمرق بالفراغ
     واللوحة بتسكّر قبل ما توصلها */
  .dd-panel::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: -20px;
    height: 20px;
  }

  .dd-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3px;
  }

  .dd-item {
    display: block;
    padding: 11px 13px;
    border-radius: 12px;
    transition: background 0.25s var(--ease-out);
  }
  .dd-item:hover { background: rgba(242, 243, 238, 0.06); }

  .dd-name {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 2px;
    transition: color 0.25s var(--ease-out);
  }
  .dd-item:hover .dd-name { color: var(--accent); }

  .dd-desc {
    display: block;
    font-size: 12px;
    line-height: 1.4;
    color: var(--muted);
  }

  .dd-all {
    display: block;
    margin-top: 6px;
    padding: 11px 13px;
    border-top: 1px solid var(--line);
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
    transition: opacity 0.25s var(--ease-out);
  }
  .dd-all:hover { opacity: 0.75; }

  /* لو المتصفح ما بيدعم الضبابية */
  @supports not (backdrop-filter: blur(4px)) {
    .dd-panel { background: var(--surface-2); }
  }

  @media (prefers-reduced-transparency: reduce) {
    .dd-panel {
      background: var(--surface-2);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dd-panel { animation: none; opacity: 1; transform: translateX(var(--dd-x, -50%)); }
  }

  .links a {
    position: relative;
    font-size: var(--link-size);
    color: var(--muted);
    white-space: nowrap; /* ⚠️ مهم: بيمنع «كيف بشتغل» تنكسر لثلاث أسطر */
    transition: color 0.3s var(--ease-out);
  }

  .links a:hover {
    color: var(--text);
  }

  /* خط ليموني بيمتد تحت الرابط عند المرور */
  .links a::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: -6px;
    height: 1.5px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: var(--x-origin, left);
    transition: transform 0.35s var(--ease-out);
  }

  html[dir='rtl'] .links a::after {
    --x-origin: right;
  }

  .links a:hover::after {
    transform: scaleX(1);
  }

  /* ─── زر اللغة: كبسولة ليمونية صغيرة ─── */
  .lang {
    display: grid;
    place-items: center;
    height: 42px;
    padding-inline: 20px;
    border-radius: var(--r-pill);
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 13.5px;
    font-weight: 700;
    white-space: nowrap;
    transition: transform 0.3s var(--ease-out);
  }

  .lang:hover {
    transform: translateY(-1px);
  }

  /* ─── زر الهامبرجر (مخفي عالديسكتوب) ─── */
  .burger {
    display: none;
    width: 42px;
    height: 42px;
    padding: 0;
    border: 1px solid rgba(242, 243, 238, 0.16);
    border-radius: var(--r-pill);
    background: transparent;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
  }

  .burger span {
    display: block;
    width: 16px;
    height: 1.6px;
    background: var(--text);
    border-radius: 2px;
  }

  /* ─── قائمة الموبايل ─── */
  .sheet {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: color-mix(in srgb, var(--bg) 94%, transparent);
    backdrop-filter: blur(22px);
    -webkit-backdrop-filter: blur(22px);
  }

  .sheet[hidden] {
    display: none;
  }

  .sheet-close {
    position: absolute;
    top: 22px;
    inset-inline-end: 22px;
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(242, 243, 238, 0.2);
    border-radius: var(--r-pill);
    background: transparent;
    color: var(--text);
  }

  /* ═══════════════════════════════════════════════════════
     ⚠️ القائمة صارت ١٨ قسم بدل ١٠ (كان نص الموقع بلا طريق من
        الموبايل إلا السكرول). بعمودين ومجمّعة، فبتزبط بالشاشة
        بدون سكرول داخلي وبتنقرا كبنية مش كجدار.
     ═══════════════════════════════════════════════════════ */
  .sheet-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(16px, 3.5vh, 30px) clamp(18px, 6vw, 44px);
    align-items: start;
    width: min(520px, 88vw);
    text-align: start;
  }

  .sheet-group {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .sheet-title {
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 3px;
  }

  html[lang='ar'] .sheet-title {
    letter-spacing: 0;
    text-transform: none;
  }

  .sheet-links a {
    /* ⚠️ أصغر من قبل بكثير: ١٨ رابط بحجم ٣٤ بكسل ما بيزبطوا
       بشاشة تلفون. هلق بحجم مريح للّمس وبيبانوا كلهم مرة وحدة. */
    font-size: clamp(15px, 4.1vw, 19px);
    font-weight: 700;
    letter-spacing: -0.02em;
    /* دخول متتابع: كل رابط بيطلع بعد اللي قبله */
    animation: rise 0.5s var(--ease-out) backwards;
    animation-delay: calc(var(--i) * 0.06s + 0.05s);
  }

  html[lang='ar'] .sheet-links a {
    font-weight: 800;
    letter-spacing: 0;
  }

  .sheet-links a:active {
    color: var(--accent);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(22px);
    }
  }

  .sheet-lang {
    margin-top: 26px;
    padding: 13px 30px;
    border-radius: var(--r-pill);
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 15px;
    font-weight: 700;
  }

  @media (prefers-reduced-motion: reduce) {
    .sheet-links a {
      animation: none;
    }
  }

  /* ═══════════ موبايل ═══════════ */
  @media (max-width: 860px) {
    .nav {
      --pill-height: 54px;
      --pill-padding: 7px 7px 7px 16px;
      --pill-top: 36px; /* شريط الإشارة بيصير 28px عالموبايل */
    }

    .pill {
      width: 100%;
      justify-content: space-between;
    }

    /* نخفي الروابط وزر اللغة، ونبين الهامبرجر */
    .links,
    .lang {
      display: none;
    }

    .burger {
      display: flex;
    }
  }
</style>

<script>
  // ═══════════════════════════════════════════════════════════════
  //  فتح وإغلاق قائمة الموبايل
  //
  //  ⚠️⚠️ أهم إشي بهذا السكربت: إعادة الربط عند كل انتقال ⚠️⚠️
  //
  //  الموقع بينتقل بين الصفحات بدون إعادة تحميل (ClientRouter).
  //  يعني هذا السكربت بيشتغل **مرة وحدة بس** بأول فتحة للموقع،
  //  بينما عناصر الصفحة بتتبدّل كل ما تنتقل لصفحة ثانية.
  //
  //  فالنسخة القديمة كانت بتمسك زر الهامبرجر أول مرة وبس. وأول
  //  ما تروح لأي صفحة (التصاميم، المدونة، الميزانية، تبديل اللغة)
  //  بيصير في زر جديد **بدون أي ربط** — فالقائمة بتوقف عن الشغل.
  //  وهاد اللي كان يبيّن كأنها «أحياناً بتشتغل وأحياناً لأ»:
  //  بتشتغل لو ما انتقلت، وبتموت لو انتقلت.
  //
  //  الحل: منعيد الربط عند كل astro:page-load، مع حارس على
  //  العنصر نفسه عشان ما نربط نفس الزر مرتين.
  // ═══════════════════════════════════════════════════════════════
  let escBound = false;

  function initMenu() {
    // بأي انتقال منتأكد إنه السكرول راجع طبيعي — لو انتقل الزائر
    // والقائمة مفتوحة، كان بيضل overflow:hidden والصفحة مقفلة
    document.documentElement.style.overflow = '';

    const sheet = document.querySelector('[data-menu]') as HTMLElement | null;
    if (!sheet) return;

    // حارس: لو ربطنا هالقائمة من قبل، ما نربطها مرتين
    if (sheet.dataset.menuReady) return;
    sheet.dataset.menuReady = '1';

    const openBtn = document.querySelector('[data-menu-open]');
    const closeBtn = document.querySelector('[data-menu-close]');

    // ═══════════════════════════════════════════════════════════
    //  ⚠️⚠️ أهم إشي بهذا الملف ⚠️⚠️
    //  فتح القائمة بيقفل سكرول الصفحة بـ overflow: hidden. بس هاد
    //  بيشيل شريط التمرير → بيتغيّر عرض الشاشة → بتتغيّر أطوال كل
    //  الأقسام. ونظام الحركة (GSAP) بيكون حافظ مواقع الأقسام
    //  المثبّتة بالقديم — فلما تسكّر القائمة بتلاقي الأقسام فوق
    //  بعض، وقسم المواقع بيطلع بمكان غلط تماماً.
    //  وهاد بالضبط اللي كان بيصير ومش راضي ينحل إلا بريفرش.
    //
    //  الحل: نحفظ مكان السكرول، ولما نسكّر منرجّعه ومنجبر النظام
    //  يعيد حساب كل المواقع من جديد.
    // ═══════════════════════════════════════════════════════════
    let lockedY = 0;
    const w = window as any;

    const setOpen = (open: boolean) => {
      sheet.hidden = !open;
      openBtn?.setAttribute('aria-expanded', String(open));
      const root = document.documentElement;

      if (open) {
        lockedY = window.scrollY;
        w.__lenis?.stop();
        root.style.overflow = 'hidden';
        return;
      }

      root.style.overflow = '';
      w.__lenis?.start();
      // منرجّع الصفحة لمكانها بالضبط قبل ما تنفتح القائمة
      if (w.__lenis) w.__lenis.scrollTo(lockedY, { immediate: true, force: true });
      else window.scrollTo(0, lockedY);
      // ومنعيد حساب مواقع الأقسام المثبّتة
      w.__gsap?.core?.globals?.().ScrollTrigger?.refresh();
    };

    openBtn?.addEventListener('click', () => setOpen(true));
    closeBtn?.addEventListener('click', () => setOpen(false));

    // الضغط على أي رابط بيسكّر القائمة
    sheet.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

    // زر Escape بيسكّرها كمان.
    // ⚠️ هذا بينربط على document اللي ما بيتبدّل مع الانتقال،
    //    فمنربطه مرة وحدة بس وإلا بيتكدّس مع كل صفحة.
    if (!escBound) {
      escBound = true;
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        const s = document.querySelector('[data-menu]') as HTMLElement | null;
        if (!s || s.hidden) return;
        s.hidden = true;
        document.querySelector('[data-menu-open]')?.setAttribute('aria-expanded', 'false');
        // ⚠️ نفس معالجة زر الإغلاق: نرجّع السكرول ونعيد حساب المواقع
        //    (شوف الشرح المطوّل عند setOpen)
        const root = document.documentElement;
        const win = window as any;
        root.style.overflow = '';
        win.__lenis?.start();
        win.__gsap?.core?.globals?.().ScrollTrigger?.refresh();
      });
    }
  }

  initMenu();
  document.addEventListener('astro:page-load', initMenu);

  // ═══════════════════════════════════════════════════════════════
  //  قائمة الخدمات المنسدلة
  //
  //  الأساس <details> — يعني بتشتغل بالضغط وبالكيبورد بلا أي كود.
  //  هذا السكربت بيضيف تلاتة فوقها بس:
  //   ١. الفتح بمرور الماوس (للأجهزة اللي إلها مؤشر حقيقي فقط —
  //      على التلفون الـ hover بيعلق مفتوح وبيصير مزعج)
  //   ٢. السكّر لما تضغط برّا
  //   ٣. السكّر بزر Escape ورجوع التركيز عالرابط
  //
  //  ⚠️ نفس علاج قائمة الموبايل: العناصر بتتبدّل مع كل انتقال
  //     صفحة، فمنعيد الربط عند astro:page-load مع حارس ضد التكرار.
  // ═══════════════════════════════════════════════════════════════
  let ddDocBound = false;

  function initDropdown() {
    const dd = document.querySelector('[data-dd]') as HTMLDetailsElement | null;
    if (!dd || dd.dataset.bound) return;
    dd.dataset.bound = '1';

    const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    if (canHover) {
      let closeTimer: number | undefined;

      dd.addEventListener('mouseenter', () => {
        clearTimeout(closeTimer);
        dd.open = true;
      });

      // تأخير بسيط قبل السكّر: لو الماوس مرق برّا للحظة وهو رايح
      // عاللوحة، ما بدنا القائمة تختفي بوجهه
      dd.addEventListener('mouseleave', () => {
        closeTimer = window.setTimeout(() => (dd.open = false), 160);
      });
    }

    // الضغط على أي خدمة بيسكّر القائمة
    dd.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => (dd.open = false)),
    );

    if (!ddDocBound) {
      ddDocBound = true;

      document.addEventListener('click', (e) => {
        const d = document.querySelector('[data-dd]') as HTMLDetailsElement | null;
        if (d?.open && !d.contains(e.target as Node)) d.open = false;
      });

      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        const d = document.querySelector('[data-dd]') as HTMLDetailsElement | null;
        if (!d?.open) return;
        d.open = false;
        (d.querySelector('summary') as HTMLElement | null)?.focus();
      });
    }
  }

  initDropdown();
  document.addEventListener('astro:page-load', initDropdown);
</script>
