---
// ═══════════════════════════════════════════════════════════════
//  شريط الأرقام — عدّادات بتعد لحالها لما توصلها بالسكرول
//
//  ⚠️⚠️ هالأرقام **بتتحدّث لحالها** ⚠️⚠️
//  ما عاد فيه رقم مكتوب بالإيد. كلهم بينحسبوا من work.json:
//   • عدد العملاء  = عدد المشاريع الحقيقية (بدون التجارب والمواقع)
//   • عدد الأعمال  = مجموع التصاميم والفيديوهات المعروضة
//   • باقي الأرقام = أقوى إنجازات مكتوبة بحقل stats بالمشاريع
//
//  يعني كل ما تضيف مشروع أو معرض أو رقم إنجاز، الشريط بيتحدّث
//  لحاله بدون ما تلمس هذا الملف.
//
//  ✏️ بدك تضيف رقم إنجاز جديد؟ حطّه بـ stats داخل المشروع
//     بملف src/data/work.json، وهو بيوصل لهون تلقائياً.
// ═══════════════════════════════════════════════════════════════
import work from '../data/work.json';

interface Props {
  lang: 'en' | 'ar';
}

const { lang } = Astro.props;
const isAr = lang === 'ar';

// المشاريع اللي بتنحسب كـ«عميل»: نستثني موقعنا والمشاريع المعلّقة
const NOT_CLIENTS = ['portfolio', 'coming-soon-1'];
const clients = work.projects.filter((p: any) => !NOT_CLIENTS.includes(p.id));

// مجموع كل التصاميم والفيديوهات المعروضة فعلياً بالموقع
const pieces = work.projects.reduce(
  (n: number, p: any) => n + (p.gallery?.length || 0) + (p.videos?.length || 0),
  0
);

// ─── أقوى رقمين إنجاز من المشاريع ───
// بنقرأ كل حقول stats، وبناخد الأرقام الأكبر (أقوى دليل)
const parse = (v: string) => {
  const n = parseFloat(String(v).replace(/[^0-9.]/g, '')) || 0;
  return /K/i.test(v) ? n * 1000 : n;
};

const achievements = work.projects
  .flatMap((p: any) => p.stats || [])
  // منستثني «صفر إنفاق» — صفر مش رقم بيكبر بالعدّاد
  .filter((s: any) => parse(s.value) > 0)
  .sort((a: any, b: any) => parse(b.value) - parse(a.value))
  .slice(0, 2)
  .map((s: any) => {
    const raw = String(s.value);
    const num = parseFloat(raw.replace(/[^0-9.]/g, '')) || 0;
    const suffix = raw.replace(/[0-9.,]/g, ''); // K أو % أو +
    return { value: num, suffix, label: isAr ? s.labelAr : s.label };
  });

const stats = [
  {
    value: clients.length,
    suffix: '+',
    label: isAr ? 'عملاء اشتغلت معهم' : 'Client engagements',
  },
  ...achievements,
  {
    value: pieces,
    suffix: '+',
    label: isAr ? 'عمل منشور بالموقع' : 'Pieces published here',
  },
];
---

<section class="stats">
  <div class="container grid" data-stagger>
    {
      stats.map((s) => (
        <div class="stat">
          <strong data-counter={s.value} data-suffix={s.suffix}>
            0
          </strong>
          <span>{s.label}</span>
        </div>
      ))
    }
  </div>
</section>

<style>
  /* 🎛️ لوحة التحكم */
  .stats {
    --number-size: clamp(38px, 4.6vw, 64px); /* حجم الرقم */
    --gap-number-label: 6px; /* المسافة بين الرقم والشرح */
    padding-block: clamp(64px, 9vh, 110px);
    border-block: 1px solid var(--line);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(24px, 4vw, 56px);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--gap-number-label);
  }

  .stat strong {
    /* الأرقام دايماً بالخط الإنجليزي حتى بالعربي (شكلها أنضف) */
    font-family: var(--font-en);
    font-size: var(--number-size);
    font-weight: 700;
    line-height: 1;
    color: var(--accent);
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .stat span {
    color: var(--muted);
    font-size: 14.5px;
  }

  /* موبايل: عمودين */
  @media (max-width: 700px) {
    .grid {
      grid-template-columns: 1fr 1fr;
      row-gap: 40px;
    }
  }
</style>
