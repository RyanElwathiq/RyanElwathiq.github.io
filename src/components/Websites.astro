---
// ═══════════════════════════════════════════════════════════════
//  قسم المواقع — فيديو مثبّت بيخلص كامل + بطاقات فيها بريفيو ونبذة
//
//  ✏️ عشان تضيف موقع جديد: افتح src/data/work.json وضيف مشروع
//     category = "website"  ومعه "url" لرابط الموقع
//     و "status": "live" (شغّال) أو "wip" (تحت الشغل)
//     الموقع بينضاف هون تلقائياً — ما بتحتاج تعدّل هذا الملف
// ═══════════════════════════════════════════════════════════════
interface Props {
  lang: 'en' | 'ar';
  projects: any[]; // اللي بينعرضوا بالهوم (محدودين بـ HOME_LIMIT)
  heading: string;
  allHref: string;
  allLabel: string;
  showAll?: boolean; // هل في مواقع زيادة بصفحة القسم؟
}

const { lang, projects, heading, allHref, allLabel, showAll = true } = Astro.props;
const isAr = lang === 'ar';

const t = isAr
  ? {
      // ✏️ الجزء بين notePre و noteEm بيطلع بلون الهوية الليموني
      notePre: 'من أول سطر كود ',
      noteEm: 'لآخر تفصيل بالتصميم.',
      live: 'شغّال',
      wip: 'تحت الشغل',
      visit: 'زيارة الموقع ↗',
      details: 'القصة الكاملة ←',
    }
  : {
      notePre: 'From the first line of code ',
      noteEm: 'to the last design detail.',
      live: 'Live',
      wip: 'In progress',
      visit: 'Visit site ↗',
      details: 'Full story →',
    };
---

<section class="sites" id="websites">
  <!-- ═══ الفيديو الرمزي: بلوكات بتتجمّع وتبني صفحة ═══
       data-seq-pin : بيتثبّت بالشاشة لحد ما الفيديو يخلص كامل
       data-seq-length : طول الرحلة (1.4 = شاشة ونصف تقريباً من السكرول) -->
  <!-- ⚠️ اللفافة الثابتة: GSAP بيثبّت .film، ولو لفّها بنفسه بينقلها
       بالصفحة وبيعيد تشغيل أي أنيميشن CSS جوّاها (شوف Hero.astro).
       لا تشيلها ولا تحط عليها ستايل. -->
  <div data-pin-spacer>
  <div
    class="film"
    data-seq
    data-seq-pin
    data-seq-length="1.4"
    data-seq-desktop="/frames/websites/"
  >
    <canvas aria-hidden="true"></canvas>
    <div class="film-veil" aria-hidden="true"></div>
    <div class="container film-copy">
      <!-- لوح زجاجي عرضي بنفس روح لوح الهيرو — خط ليموني على
           الحافة، وجزء من النص بلون الهوية -->
      <div class="copy-panel">
        <h2>{heading}</h2>
        <p>{t.notePre}<em>{t.noteEm}</em></p>
      </div>
    </div>
  </div>
  </div><!-- /data-pin-spacer -->

  <!-- ═══ بطاقات المواقع ═══ -->
  <div class="container">
    <ul class="list" data-stagger>
      {
        projects.map((p) => {
          const href = `${isAr ? '/ar' : ''}/work/${p.id}/`;
          const isLive = p.status !== 'wip';
          return (
            <li class={`card ${isLive ? '' : 'is-wip'}`}>
              {/* بريفيو الموقع: صورة مصغّرة داخل إطار متصفح */}
              <a class="shot" href={href} aria-label={isAr ? p.titleAr : p.title}>
                <span class="chrome" aria-hidden="true">
                  <i /> <i /> <i />
                </span>
                {/* إطار متصفح = صندوق عريض ← الغلاف العريض بلغة الصفحة */}
                <img
                  src={(isAr ? p.coverWide : p.coverEnWide || p.coverWide) || p.cover}
                  alt={isAr ? p.titleAr : p.title}
                  loading="lazy"
                  width="720"
                  height="440"
                />
              </a>

              <div class="info">
                <div class="top">
                  <span class={`status ${isLive ? 'live' : 'wip'}`}>
                    {isLive ? t.live : t.wip}
                  </span>
                  <span class="role">{isAr ? p.roleAr : p.role}</span>
                </div>

                <h3>
                  <a href={href}>{isAr ? p.titleAr : p.title}</a>
                </h3>
                <p class="desc">{isAr ? p.descAr : p.desc}</p>

                <div class="actions">
                  <a class="details" href={href}>{t.details}</a>
                  {p.url && (
                    <a class="visit" href={p.url} target="_blank" rel="noreferrer">
                      {t.visit}
                    </a>
                  )}
                </div>
              </div>
            </li>
          );
        })
      }
    </ul>

    <!-- زر «كل المواقع» بيظهر بس إذا في مواقع زيادة عن اللي فوق -->
    {showAll && <a class="all-btn" href={allHref} data-reveal>{allLabel}</a>}
  </div>
</section>

<style>
  /* 🎛️ لوحة التحكم */
  .sites {
    --heading-size: clamp(28px, 4vw, 52px); /* حجم العنوان فوق الفيديو */
    --card-gap: clamp(24px, 3vw, 44px); /* المسافة بين بطاقات المواقع */
    --name-size: clamp(21px, 2.4vw, 30px); /* حجم اسم الموقع */
    /* نسبة صورة البريفيو — 16/9 عشان تطابق الغلاف العريض بالضبط،
       وإلا `object-fit:cover` بيقصّ من الجوانب واسم العميل بينقص */
    --shot-ratio: 16 / 9;
    /* ⬛ التعتيم العام فوق الفيديو كله (0 = الفيديو بكامل وضوحه) */
    --film-scrim: 0;
    /* ⬛ تعتيم موضعي خلف النص فقط (ضروري لقراءة العنوان) */
    --text-scrim: 0.6;
    --text-scrim-width: 58%;
    padding-block: var(--section-gap) 0;
  }

  /* ─── الفيديو المثبّت ─── */
  .film {
    position: relative;
    height: 100dvh;
    display: flex;
    align-items: center;
    overflow: clip;
  }

  .film canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* التعتيم فوق الفيديو — بينضبط من --film-scrim فوق.
     التدرّج بالأطراف بيضل موجود عشان الفيديو يذوب بالصفحة
     بدل ما ينقطع فجأة (هذا مش تعتيم، هذا وصل بصري). */
  .film-veil {
    position: absolute;
    inset: 0;
    background:
      /* وصل بصري بالأطراف عشان الفيديو يذوب بالصفحة (مش تعتيم) */
      linear-gradient(to top, var(--bg), transparent 16%, transparent 86%, var(--bg)),
      /* تعتيم موضعي خلف النص فقط */
        linear-gradient(
          to var(--text-side, right),
          rgba(14, 15, 18, var(--text-scrim)) 0%,
          rgba(14, 15, 18, calc(var(--text-scrim) * 0.72)) 32%,
          transparent var(--text-scrim-width)
        ),
      /* تعتيم عام (صفر افتراضياً) */
        linear-gradient(
          to top,
          rgba(14, 15, 18, var(--film-scrim)),
          rgba(14, 15, 18, var(--film-scrim))
        );
  }

  html[dir='rtl'] .film-veil {
    --text-side: left;
  }

  .film-copy {
    position: relative;
    z-index: 1;
  }

  /* ─── اللوح الزجاجي (نفس روح لوح الهيرو) ─── */
  .copy-panel {
    position: relative;
    isolation: isolate;
    display: inline-block;
    max-width: min(560px, 100%);
    padding: clamp(22px, 2.8vw, 40px) clamp(26px, 3.2vw, 48px);
    border-radius: 22px;
    background: linear-gradient(160deg, rgba(27, 30, 36, 0.72), rgba(14, 15, 18, 0.62));
    backdrop-filter: blur(22px) saturate(150%);
    -webkit-backdrop-filter: blur(22px) saturate(150%);
    border: 1px solid rgba(242, 243, 238, 0.12);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.13),
      inset 0 -1px 0 rgba(0, 0, 0, 0.45),
      0 22px 60px rgba(0, 0, 0, 0.5);
  }

  /* خط ليموني على الحافة من جهة النص — توقيع الهوية */
  .copy-panel::before {
    content: '';
    position: absolute;
    inset-block: clamp(22px, 2.8vw, 40px);
    inset-inline-start: 0;
    width: 3px;
    border-radius: var(--r-pill);
    background: linear-gradient(
      to bottom,
      var(--accent),
      color-mix(in srgb, var(--accent) 30%, transparent)
    );
  }

  /* لو الضبابية مش مدعومة: خلفية صلبة */
  @supports not (backdrop-filter: blur(4px)) {
    .copy-panel {
      background: rgba(14, 15, 18, 0.92);
    }
  }

  .film-copy h2 {
    font-size: var(--heading-size);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }

  html[lang='ar'] .film-copy h2 {
    font-weight: 800;
    letter-spacing: 0;
  }

  .film-copy p {
    /* أفتح من --muted: النص فوق فيديو، بيحتاج تباين أعلى */
    color: var(--dim);
    font-size: clamp(15px, 1.6vw, 18px);
    max-width: 44ch;
  }

  /* الجزء الليموني من الجملة */
  .film-copy p em {
    font-style: normal;
    color: var(--accent);
  }

  /* ─── بطاقات المواقع ─── */
  .list {
    list-style: none;
    padding: 0;
    margin: clamp(48px, 7vh, 80px) 0 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--card-gap);
  }

  .card {
    display: flex;
    flex-direction: column;
  }

  /* بريفيو داخل إطار متصفح صغير */
  .shot {
    display: block;
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    overflow: hidden;
    background: var(--surface);
    transition: border-color 0.4s var(--ease-out), transform 0.4s var(--ease-out);
  }

  .card:hover .shot {
    border-color: var(--accent);
    transform: translateY(-4px);
  }

  /* شريط أزرار المتصفح الوهمية */
  .chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 11px 14px;
    background: var(--surface-2);
    border-bottom: 1px solid var(--line);
  }

  .chrome i {
    width: 9px;
    height: 9px;
    border-radius: var(--r-pill);
    background: rgba(242, 243, 238, 0.16);
  }

  .shot img {
    width: 100%;
    aspect-ratio: var(--shot-ratio);
    object-fit: cover;
    transition: transform 0.8s var(--ease-out);
  }

  .card:hover .shot img {
    transform: scale(1.04);
  }

  /* ─── المواقع تحت الشغل: باهتة وبخطوط متقطعة ───
     عشان يبين إنها مقصودة، مش بطاقة ناقصة أو مكسورة */
  .card.is-wip .shot {
    border-style: dashed;
    border-color: rgba(242, 243, 238, 0.18);
  }

  .card.is-wip .shot img {
    opacity: 0.32;
    filter: grayscale(0.6);
  }

  .card.is-wip:hover .shot img {
    opacity: 0.5;
  }

  /* ─── النبذة ─── */
  .info {
    padding-top: 20px;
  }

  .top {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .status {
    font-size: 12px;
    font-weight: 700;
    padding: 5px 13px;
    border-radius: var(--r-pill);
  }

  .status.live {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .status.wip {
    border: 1px solid var(--line);
    color: var(--muted);
  }

  .role {
    font-size: 13.5px;
    color: var(--muted);
  }

  h3 {
    font-size: var(--name-size);
    font-weight: 700;
    letter-spacing: -0.015em;
    margin-bottom: 10px;
  }

  html[lang='ar'] h3 {
    letter-spacing: 0;
    font-weight: 800;
  }

  h3 a {
    transition: color 0.3s var(--ease-out);
  }

  .card:hover h3 a {
    color: var(--accent);
  }

  .desc {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.7;
    margin-bottom: 16px;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .details,
  .visit {
    font-size: 14.5px;
    font-weight: 600;
    transition: color 0.3s var(--ease-out);
  }

  .details {
    color: var(--muted);
  }

  .card:hover .details {
    color: var(--accent);
  }

  .visit {
    color: var(--accent);
  }

  /* زر «كل المواقع» */
  .all-btn {
    display: inline-flex;
    align-items: center;
    margin-top: clamp(32px, 4.5vh, 52px);
    font-size: 15px;
    font-weight: 600;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: var(--r-pill);
    padding: 12px 26px;
    transition: background-color 0.35s var(--ease-out), color 0.35s var(--ease-out);
  }

  .all-btn:hover {
    background: var(--accent);
    color: var(--accent-ink);
  }

  /* ─── موبايل: بطاقة بالصف، والفيديو أقصر (بدون تثبيت) ─── */
  @media (max-width: 767px) {
    .list {
      grid-template-columns: 1fr;
      margin-top: clamp(32px, 5vh, 48px);
    }

    /* عالموبايل الفيديو ما بيتثبّت، فبنخليه بارتفاع معقول
       بدل شاشة كاملة عشان ما ياخد كل المساحة */
    .film {
      height: 62dvh;
    }
  }
</style>
