---
// ═══════════════════════════════════════════════════════════════
//  التصاميم — شبكة بطاقات + بلاطة Behance (كل شغلك الإبداعي هناك)
// ═══════════════════════════════════════════════════════════════
import WorkCard from './WorkCard.astro';
import work from '../data/work.json';

interface Props {
  lang: 'en' | 'ar';
  projects: any[];
  heading: string;
  allHref: string;
  allLabel: string;
  id?: string;
  showAll?: boolean;
}

const { lang, projects, heading, allHref, allLabel, id, showAll = true } = Astro.props;
const isAr = lang === 'ar';
const behance = work.links.behance;
---

<section class="designs" id={id}>
  <div class="container">
    <div class="head">
      <div>
        <h2 data-reveal>{heading}</h2>
        <!-- سطر توضيحي: بيقول للزائر إن كل تصميم إله صفحة، وإن في المزيد -->
        <p class="note" data-reveal>
          {
            isAr
              ? 'اضغط أي تصميم تشوف صفحته كاملة: الرؤية والهدف والنتيجة.'
              : 'Open any design to read its full page: the vision, the goal, and the result.'
          }
        </p>
      </div>
      {showAll && <a class="all-btn" href={allHref} data-reveal>{allLabel}</a>}
    </div>

    <div class="grid" data-stagger>
      {projects.map((p) => <WorkCard project={p} lang={lang} />)}

      <!-- بلاطة Behance -->
      <a class="behance" href={behance} target="_blank" rel="noreferrer">
        <span class="big">Behance</span>
        <span class="hint">{isAr ? 'مكتبة شغلي الإبداعي كاملة ↗' : 'My full creative library ↗'}</span>
      </a>
    </div>
  </div>
</section>

<style>
  /* 🎛️ لوحة التحكم */
  .designs {
    --heading-size: clamp(28px, 4vw, 52px);
    --grid-gap: clamp(20px, 2.6vw, 36px);
    padding-block: var(--section-gap) 0;
  }

  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: clamp(32px, 5vh, 56px);
  }

  h2 {
    font-size: var(--heading-size);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  html[lang='ar'] h2 {
    font-weight: 800;
    letter-spacing: 0;
  }

  .note {
    margin-top: 10px;
    color: var(--muted);
    font-size: 15px;
    max-width: 46ch;
  }

  /* زر «كل التصاميم»: زر واضح مش مجرد رابط باهت */
  .all-btn {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 600;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: var(--r-pill);
    padding: 12px 26px;
    white-space: nowrap;
    transition: background-color 0.35s var(--ease-out), color 0.35s var(--ease-out);
  }

  .all-btn:hover {
    background: var(--accent);
    color: var(--accent-ink);
  }

  @media (max-width: 640px) {
    .head {
      flex-direction: column;
      align-items: stretch;
    }

    .all-btn {
      justify-content: center;
    }
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--grid-gap);
    align-items: stretch;
  }

  /* بلاطة Behance: ليمونية جريئة */
  .behance {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 10px;
    min-height: 320px;
    background: var(--accent);
    color: var(--accent-ink);
    border-radius: var(--r-card);
    text-align: center;
    padding: 24px;
    transition: transform 0.4s var(--ease-out);
  }

  .behance:hover {
    transform: translateY(-4px);
  }

  .behance .big {
    font-family: var(--font-en);
    font-size: clamp(30px, 3.4vw, 46px);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .behance .hint {
    font-size: 14.5px;
    font-weight: 600;
  }

  @media (max-width: 767px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .behance {
      min-height: 200px;
    }
  }
</style>
