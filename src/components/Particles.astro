---
// ═══════════════════════════════════════════════════════════════
//  الاسم المتفتّت — نقاط صغيرة بتتجمّع لتصير الاسم
//
//  الفكرة (طلبها ريّان من موقع Inngest): الاسم مرسوم بآلاف
//  النقاط. أول ما توصله بالسكرول بيكون مبعثر، وكل ما تنزل أكثر
//  بتتجمّع النقاط لمكانها ويستقر الاسم. ولما تقرّب الماوس
//  بتهرب النقاط من تحت المؤشّر وبترجع لحالها.
//
//  ⚠️ ملاحظة صادقة: مستودع inngest/inngest اللي بعتّه هو محرّك
//     مهام خلفية (queues/workflows) — ما إله علاقة بالحركة.
//     الحركة اللي على موقعهم مكتوبة بكانفس، وهاي نسختنا منها.
//
//  ⚠️ الأداء أهم من الشكل: عدد النقاط بينقص للنص عالموبايل،
//     والرسم بيوقف تماماً لما القسم يطلع برّا الشاشة. بدون
//     هالشغلتين هالحركة بتاكل بطارية تلفون متوسط بالأردن.
//
//  ✏️ الاستخدام: <Particles text="RAYAN ELWATHIQ" />
//     ⚠️ الاسم بالإنجليزي دايماً حتى بالصفحات العربية (طلب ريّان)
// ═══════════════════════════════════════════════════════════════
interface Props {
  text?: string;
  /** صورة بدل النص — منستخدمها للوجو بالمساحات الفاضية */
  src?: string;
  /** small = فاصل هادي بين الأقسام · '' = الحجم الكامل */
  size?: 'small' | '';
  label?: string;
}

const { text = 'RAYAN ELWATHIQ', src, size = '', label = '' } = Astro.props;
---

<section
  class={`dust ${size === 'small' ? 'dust-sm' : ''}`}
  data-dust
  data-dust-src={src}
  aria-label={label || (src ? 'Rayan Elwathiq' : text)}
>
  <canvas data-dust-canvas aria-hidden="true"></canvas>
  <!-- بديل للقارئ الصوتي وللي مطفّي الجافاسكربت -->
  <p class="dust-text">{text}</p>
</section>

<script>
  // ═══════════════════════════════════════════════════════════
  //  🎛️ لوحة التحكم
  // ═══════════════════════════════════════════════════════════
  const MAX_DOTS = 2600; // أكبر عدد نقاط على الديسكتوب
  const MAX_DOTS_MOBILE = 900; // وعلى الموبايل
  const SCATTER = 240; // قديش بتبعد النقطة وهي مبعثرة (بكسل)
  const PUSH_RADIUS = 110; // نصف قطر هروب النقاط من الماوس
  const PUSH_FORCE = 34; // قوة الهروب
  const RETURN = 0.12; // سرعة رجوع النقطة لمكانها (٠ – ١)
  const DOT = 1.35; // حجم النقطة

  function initDust() {
    const roots = document.querySelectorAll('[data-dust]');
    if (!roots.length) return () => {};

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const kills: (() => void)[] = [];

    roots.forEach((root) => {
      const canvas = root.querySelector('[data-dust-canvas]') as HTMLCanvasElement;
      const label = (root.querySelector('.dust-text') as HTMLElement)?.textContent?.trim() || '';
      if (!canvas || !label) return;

      const ctx = canvas.getContext('2d', { alpha: true });
      if (!ctx) return;

      const isMobile = window.innerWidth < 768;
      const cap = isMobile ? MAX_DOTS_MOBILE : MAX_DOTS;
      // ⚠️ نسقّف كثافة البكسل: على تلفون بكثافة ٣ الكانفس بيصير
      //    ٩ أضعاف المساحة والرسم بيهبط لـ ٢٠ إطار بالثانية
      const dpr = Math.min(window.devicePixelRatio || 1, 2);

      let dots: {
        hx: number; // مكانها النهائي
        hy: number;
        sx: number; // مكانها وهي مبعثرة
        sy: number;
        x: number; // مكانها الحالي
        y: number;
        vx: number;
        vy: number;
      }[] = [];
      let W = 0;
      let H = 0;
      let raf = 0;
      let visible = false;
      let progress = reduce ? 1 : 0; // ٠ = مبعثر، ١ = مستقر
      const pointer = { x: -9999, y: -9999 };

      // ─── نبني النقاط من شكل الاسم ───
      // منرسم النص على كانفس مخفي، ومنقرأ البكسلات المليانة،
      // وكل بكسل مليان بيصير نقطة.
      function build(art?: HTMLImageElement) {
        const rect = root.getBoundingClientRect();
        W = Math.round(rect.width);
        H = Math.round(rect.height);
        if (W < 10 || H < 10) return;

        canvas.width = W * dpr;
        canvas.height = H * dpr;
        canvas.style.width = W + 'px';
        canvas.style.height = H + 'px';
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        const off = document.createElement('canvas');
        off.width = W;
        off.height = H;
        const o = off.getContext('2d', { willReadFrequently: true });
        if (!o) return;

        if (art) {
          // ─── نمط اللوجو: منرسم الصورة بالنص ونقرأ شفافيتها ───
          // ⚠️ ٠.٩٢ مش ٠.٧: أول نسخة كانت تترك هوامش كبيرة فاضية
          //    فاللوجو يبيّن صغير جوّا مساحة كبيرة. هلق بيعبّي مربّعه.
          const s = Math.min((W * 0.92) / art.naturalWidth, (H * 0.94) / art.naturalHeight);
          const w = art.naturalWidth * s;
          const h = art.naturalHeight * s;
          o.drawImage(art, (W - w) / 2, (H - h) / 2, w, h);
        } else {
          // ─── نمط الاسم: منضبّط حجم الخط ليعبّي العرض المتاح ───
          const font = getComputedStyle(document.body).getPropertyValue('--font-en').trim();
          let size = Math.round(H * 0.62);
          o.textAlign = 'center';
          o.textBaseline = 'middle';
          for (let i = 0; i < 30; i++) {
            o.font = `700 ${size}px ${font}`;
            if (o.measureText(label).width <= W * 0.88) break;
            size -= Math.max(1, Math.round(size * 0.06));
          }
          o.fillStyle = '#fff';
          o.fillText(label, W / 2, H / 2);
        }

        const data = o.getImageData(0, 0, W, H).data;

        // ⚠️ الخطوة بتتحسب مش بتنكتب بالإيد.
        //    أول نسخة كانت تمشي بخطوة ٢ وبعدين تاخد كل نقطة ثامنة
        //    عشان تنزل تحت السقف — والنتيجة كانت خطوط مايلة بدل
        //    حروف، لأن «كل نقطة ثامنة» بصف متتالي بتعمل قطر.
        //    هلق: منقدّر كم بكسل مليان، ومنحسب خطوة شبكية موحّدة
        //    بتعطي العدد المطلوب — فالنقاط بتوزّع بانتظام على الحرف.
        let sample = 0;
        for (let y = 0; y < H; y += 4) {
          for (let x = 0; x < W; x += 4) {
            if (data[(y * W + x) * 4 + 3] > 128) sample++;
          }
        }
        const estimate = sample * 16; // كم بكسل مليان تقريباً
        const step = Math.max(2, Math.round(Math.sqrt(estimate / cap)));

        const filled: number[] = [];
        for (let y = 0; y < H; y += step) {
          for (let x = 0; x < W; x += step) {
            if (data[(y * W + x) * 4 + 3] > 128) filled.push(x, y);
          }
        }

        dots = [];
        for (let i = 0; i < filled.length / 2; i++) {
          const hx = filled[i * 2];
          const hy = filled[i * 2 + 1];
          const ang = Math.random() * Math.PI * 2;
          // ⚠️ التبعثر مربوط بحجم العنصر مش برقم ثابت.
          //    كان ثابت ٢٤٠ بكسل، فبالعناصر الصغيرة (اللوجو) النقاط
          //    كانت تطير برّا حدود الكانفس وتنقصّ — فيبيّن اللوجو
          //    «مقطوع نصّه» وهو بيتجمّع.
          const reach = Math.min(SCATTER, Math.min(W, H) * 0.42);
          const dist = reach * (0.35 + Math.random() * 0.9);
          dots.push({
            hx,
            hy,
            sx: hx + Math.cos(ang) * dist,
            sy: hy + Math.sin(ang) * dist * 0.5,
            x: hx,
            y: hy,
            vx: 0,
            vy: 0,
          });
        }
      }

      // ─── الرسم ───
      function frame() {
        raf = 0;
        if (!visible || !dots.length) return;
        ctx.clearRect(0, 0, W, H);

        // النقاط بتبيّن أقوى كل ما تجمّعت
        const alpha = 0.28 + progress * 0.62;
        ctx.fillStyle = `rgba(242, 243, 238, ${alpha})`;

        let moving = false;
        for (let i = 0; i < dots.length; i++) {
          const d = dots[i];
          // مكانها المستهدف بين «مبعثر» و«مستقر» حسب السكرول
          const tx = d.sx + (d.hx - d.sx) * progress;
          const ty = d.sy + (d.hy - d.sy) * progress;

          // هروب من الماوس
          const dx = d.x - pointer.x;
          const dy = d.y - pointer.y;
          const dd = dx * dx + dy * dy;
          if (dd < PUSH_RADIUS * PUSH_RADIUS) {
            const dist = Math.sqrt(dd) || 1;
            const f = (1 - dist / PUSH_RADIUS) * PUSH_FORCE;
            d.vx += (dx / dist) * f * 0.14;
            d.vy += (dy / dist) * f * 0.14;
          }

          d.vx += (tx - d.x) * RETURN;
          d.vy += (ty - d.y) * RETURN;
          d.vx *= 0.76;
          d.vy *= 0.76;
          d.x += d.vx;
          d.y += d.vy;

          if (Math.abs(d.vx) > 0.05 || Math.abs(d.vy) > 0.05) moving = true;
          ctx.fillRect(d.x, d.y, DOT, DOT);
        }

        // ما في حركة وما في تفاعل؟ منوقّف — بلاش نحرق بطارية
        if (moving || pointer.x > -9000) raf = requestAnimationFrame(frame);
      }

      const kick = () => {
        if (!raf && visible) raf = requestAnimationFrame(frame);
      };

      // ─── السكرول بيحرّك التجمّع ───
      const onScroll = () => {
        if (reduce) return;
        const r = root.getBoundingClientRect();
        const vh = window.innerHeight;
        // ⚠️ الحساب مربوط بأول ما يطلّ القسم من تحت الشاشة، مش
        //    بوصوله لنص الشاشة. ليش؟ لأن هذا القسم آخر إشي قبل
        //    التذييل — يعني ما بيوصل لنص الشاشة أبداً مهما نزّلت،
        //    فالاسم كان يضل مبعثر ولا يستقر ولا مرة.
        //    هلق: أول ما يطلّ = مبعثر، وبعد نص شاشة سكرول = مستقر.
        // ⚠️ لو القسم كله ظاهر بالشاشة = مستقر تماماً، خلص.
        //    بدون هالسطر كان الاسم يوصل ٩٠٪ ويقف — لأنه آخر إشي
        //    قبل التذييل، فمهما نزّلت ما بيوصل لنص الشاشة أبداً
        //    وبيضل الحروف مبعثرة شوي.
        if (r.bottom <= vh + 4 && r.top >= -4) {
          progress = 1;
          kick();
          return;
        }
        const p = (vh - r.top) / (vh * 0.32);
        progress = Math.max(0, Math.min(1, p));
        kick();
      };

      const onMove = (e: PointerEvent) => {
        const r = canvas.getBoundingClientRect();
        pointer.x = e.clientX - r.left;
        pointer.y = e.clientY - r.top;
        kick();
      };
      const onLeave = () => {
        pointer.x = pointer.y = -9999;
        kick();
      };

      const io = new IntersectionObserver(
        (entries) => {
          visible = entries[0].isIntersecting;
          if (visible) {
            onScroll();
            kick();
          } else if (raf) {
            cancelAnimationFrame(raf);
            raf = 0;
          }
        },
        { rootMargin: '200px' }
      );
      io.observe(root);

      // ─── مصدر الشكل: صورة اللوجو أو النص ───
      const srcUrl = (root as HTMLElement).dataset.dustSrc;
      let art: HTMLImageElement | undefined;

      const rebuild = () => {
        build(art);
        onScroll();
        kick();
      };
      const onResize = rebuild;

      if (srcUrl) {
        const im = new Image();
        im.decoding = 'async';
        im.src = srcUrl;
        im.decode()
          .then(() => {
            art = im;
            rebuild();
          })
          // الصورة ما وصلت؟ منرجع للاسم بدل ما نترك مساحة فاضية
          .catch(rebuild);
      } else {
        // الخط لازم يكون محمّل قبل ما نقرأ شكل الحروف — بدونها
        // بتنبنى النقاط على خط النظام وبيطلع الاسم بشكل ثاني
        (document.fonts?.ready || Promise.resolve()).then(rebuild);
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onResize);
      root.addEventListener('pointermove', onMove as EventListener);
      root.addEventListener('pointerleave', onLeave);

      kills.push(() => {
        io.disconnect();
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onResize);
        root.removeEventListener('pointermove', onMove as EventListener);
        root.removeEventListener('pointerleave', onLeave);
        if (raf) cancelAnimationFrame(raf);
      });
    });

    return () => kills.forEach((fn) => fn());
  }

  // بينشغّل بأول تحميل وبعد كل انتقال بين الصفحات
  let stop: (() => void) | null = null;
  const start = () => {
    stop?.();
    stop = initDust();
  };
  document.addEventListener('astro:page-load', start);
  document.addEventListener('astro:before-swap', () => {
    stop?.();
    stop = null;
  });
</script>

<style>
  .dust {
    position: relative;
    height: clamp(150px, 20vw, 290px);
    margin-block: clamp(30px, 6vh, 70px);
    /* الماوس لازم يوصل للكانفس عشان النقاط تهرب منه */
    touch-action: pan-y;
  }

  /* الفاصل الهادي: اللوجو بالمساحات الفاضية بين الأقسام */
  .dust-sm {
    height: clamp(110px, 13vw, 170px);
    margin-block: clamp(20px, 4vh, 46px);
  }

  .dust canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* النص الحقيقي: موجود للقارئ الصوتي ولمحرّكات البحث، ومخفي
     بصرياً لأن الكانفس هو اللي بيرسمه.
     ⚠️ لو الجافاسكربت ما اشتغل بيرجع يبيّن (شوف .no-js) */
  .dust-text {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-en);
    font-size: clamp(28px, 7vw, 90px);
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--muted);
    opacity: 0;
  }

  html:not(.js) .dust-text {
    opacity: 0.5;
  }
</style>
