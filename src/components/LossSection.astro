---
// ═══════════════════════════════════════════════════════════════
//  الغلاف حول حاسبة الخسارة
//
//  ✏️ الاستعمال:
//     <LossSection lang="ar" />         ← بصفحة أو قسم
//     <LossSection lang="ar" eager />   ← بالصفحة المخصصة
//     <LossSection lang="ar" bare />    ← جوّا مقال
// ═══════════════════════════════════════════════════════════════
import LossCalc from './LossCalc.jsx';

interface Props {
  lang: 'en' | 'ar';
  id?: string;
  eager?: boolean;
  bare?: boolean;
  h1?: boolean; // بالصفحة المخصّصة بس — العنوان بيصير h1
}

const { lang, id = 'loss', eager = false, bare = false, h1 = false } = Astro.props;
const isAr = lang === 'ar';
const briefHref = isAr ? '/ar/brief/' : '/brief/';
const props = { lang, briefHref, asH1: h1 };
---

{
  /* ⚠️⚠️ rootMargin مهم جداً ⚠️⚠️
     بدونه الحاسبة ما بتبلّش تحمّل نفسها إلا لما توصل الشاشة بالضبط —
     وبهاي اللحظة الزائر بيكون واصل، والملفات لسا عم تنزل على نت
     الموبايل. النتيجة: بيشوف الأرقام الثابتة (صفر) والقوائم ما
     بتنفتح، وبيحس إنه الحاسبة خربانة.
     ٩٠٠ بكسل = بتبلّش تجهّز حالها قبل ما يوصل بشاشة كاملة تقريباً. */
  bare ? (
    <div class="loss-bare">
      {eager ? (
        <LossCalc client:load {...props} />
      ) : (
        <LossCalc client:visible={{ rootMargin: '900px' }} {...props} />
      )}
    </div>
  ) : (
    <section class="loss-section" id={id}>
      <div class="container">
        {eager ? (
          <LossCalc client:load {...props} />
        ) : (
          <LossCalc client:visible={{ rootMargin: '900px' }} {...props} />
        )}
      </div>
    </section>
  )
}

<style>
  .loss-section {
    padding-block: clamp(64px, 10vh, 120px);
  }

  /* جوّا المقال: خطّين رفيعين بيفصلوها عن النص */
  .loss-bare {
    margin-block: clamp(34px, 5vh, 56px);
    padding-block: clamp(28px, 4vh, 44px);
    border-block: 1px solid var(--line);
  }

  .loss-bare :global(.loss h2) {
    font-size: clamp(22px, 2.8vw, 32px);
  }
</style>
