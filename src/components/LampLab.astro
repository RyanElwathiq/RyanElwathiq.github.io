  .for-biz[hidden] {
    display: none;
  }

  .rows {
    display: grid;
    gap: 18px;
  }

  .r {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 16px;
    align-items: baseline;
  }

  .r span {
    font-size: 12px;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.04em;
  }

  .r strong {
    font-size: clamp(18px, 2.1vw, 24px);
    font-weight: 700;
    line-height: 1.4;
  }

  .r p {
    color: var(--muted);
    font-size: 15.5px;
    line-height: 1.7;
  }

  .actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 28px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }

  /* ─── بلوك الذكاء الاصطناعي ─── */
  .ai-block {
    margin-top: 22px;
    padding-top: 20px;
    border-top: 1px dashed color-mix(in srgb, var(--muted) 30%, transparent);
  }

  .ai-block[hidden] {
    display: none;
  }

  .ai-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }

  .ai-tag {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
  }

  /* ⚠️ نبضة خفيفة بس — الانتظار قصير، وأي حركة أقوى بتلفت
     الانتباه عن الفكرة اللي فوقها وهي الأهم */
  .ai-load {
    font-size: 12px;
    color: var(--muted);
    animation: ai-pulse 1.4s ease-in-out infinite;
  }

  .ai-load[hidden] {
    display: none;
  }

  @keyframes ai-pulse {
    0%,
    100% {
      opacity: 0.35;
    }
    50% {
      opacity: 0.9;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-load {
      animation: none;
      opacity: 0.7;
    }
  }

  .ai-text {
    font-size: clamp(15px, 1.6vw, 17px);
    line-height: 1.85;
    color: var(--text);
  }

  .ai-text:empty {
    display: none;
  }

  .ai-warn {
    margin-top: 12px;
    font-size: 12px;
    line-height: 1.7;
    color: var(--muted);
    opacity: 0.75;
  }

  .disclaimer {
    margin-top: 20px;
    font-size: 13px;
    line-height: 1.75;
    color: var(--muted);
    opacity: 0.85;
    padding-inline-start: 14px;
    border-inline-start: 2px solid color-mix(in srgb, var(--accent) 40%, transparent);
  }

  .ask {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 26px;
  }

  .ask span {
    color: var(--text);
    font-size: 15.5px;
    font-weight: 600;
  }

  /* ─── موبايل: مفتاح بالضغط بدل الحبل ─── */
  @media (max-width: 700px) {
    /* الحبل والسحب للديسكتوب فقط */
    .cord-wrap {
      display: none;
    }

    .switch {
      display: inline-flex;
    }

    .r {
      grid-template-columns: 1fr;
      gap: 6px;
    }

    .actions .btn,
    .ask .btn {
      flex: 1;
      justify-content: center;
    }
  }

  /* ─── تقليل الحركة: القسم بيضوي لحاله عند التحميل
     (بينحط data-lit بالجافاسكربت) فما بنحتاج قاعدة خاصة هون ─── */
</style>

<script>
  import { generateIdea } from '../scripts/idea-engine.js';

  function initLab() {
    const lab = document.querySelector('[data-lab]') as HTMLElement | null;
    if (!lab || lab.hasAttribute('data-lab-ready')) return;
    lab.setAttribute('data-lab-ready', '');

    const handle = lab.querySelector('[data-cord]') as HTMLElement;
    // عمود السحب: كل المساحة اللي فيها الحبل والكرة
    const grab = lab.querySelector('[data-cord-wrap]') as HTMLElement;
    const arm = lab.querySelector('[data-arm]') as HTMLElement;
    const wire = lab.querySelector('[data-wire]') as HTMLElement;
    const form = lab.querySelector('[data-lab-form]') as HTMLElement;
    const result = lab.querySelector('[data-lab-result]') as HTMLElement;
    const bizInput = lab.querySelector('[data-biz]') as HTMLInputElement;
    const notesInput = lab.querySelector('[data-notes]') as HTMLTextAreaElement;
    const askMail = lab.querySelector('[data-ask-mail]') as HTMLAnchorElement;

    // ═══════════════════════════════════════════════════════
    //  فكرة الذكاء الاصطناعي — بتوصل بعد الفكرة المركّبة
    //
    //  ⚠️ ليش «بعد» مش «بدل»؟ لأنه الفكرة المركّبة فورية وما
    //     بتفشل أبداً. لو ربطنا كل النتيجة بالخدمة، أي تأخير
    //     أو انقطاع بيخلّي الزائر قاعد يتفرّج على شاشة فاضية.
    //     هيك: نتيجة كاملة فوراً، والذكاء الاصطناعي إضافة.
    //
    //  ولو فشل الطلب — منخبّي البلوك كله بهدوء. الزائر ما بيشوف
    //  رسالة خطأ ولا بيعرف إنه في إشي كان المفروض يجي.
    // ═══════════════════════════════════════════════════════
    const API = 'https://ryanalali-api.ryanalali-api.workers.dev';
    const aiBlock = lab.querySelector('[data-ai-block]') as HTMLElement;
    const aiText = lab.querySelector('[data-ai-text]') as HTMLElement;
    const aiLoad = lab.querySelector('[data-ai-load]') as HTMLElement;
    let aiRun = 0;

    async function askAI(answers: any, notes: string) {
      if (!aiBlock) return;
      const run = ++aiRun; // عشان نتيجة قديمة ما تكتب فوق جديدة

      aiBlock.hidden = false;
      aiText.textContent = '';
      aiLoad.hidden = false;

      // ما نخلّي الزائر مستني للأبد لو الخدمة بطيئة
      const stop = new AbortController();
      const timer = setTimeout(() => stop.abort(), 25000);

      try {
        const label = (sel: string) =>
          (lab.querySelector(sel + '.is-on') as HTMLElement)?.textContent?.trim() || '';

        const r = await fetch(API + '/idea', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          signal: stop.signal,
          body: JSON.stringify({
            lang: isAr ? 'ar' : 'en',
            industry: label('[data-industry]'),
            goal: label('[data-goal]'),
            notes: [answers.biz, notes].filter(Boolean).join('. '),
          }),
        });

        const d = await r.json();
        if (run !== aiRun) return; // الزائر ضغط «فكرة ثانية» بالأثناء
        if (!r.ok || !d?.idea) throw new Error('no-idea');

        aiLoad.hidden = true;
        aiText.textContent = d.idea;
      } catch {
        if (run === aiRun) aiBlock.hidden = true;
      } finally {
        clearTimeout(timer);
      }
    }

    const isAr = document.documentElement.lang === 'ar';
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const FOR_LABEL = isAr ? 'فكرة لـ' : 'An idea for';

    const answers = {
      industry: (lab.querySelector('[data-industry]') as HTMLElement)?.dataset.industry || '',
      goal: (lab.querySelector('[data-goal]') as HTMLElement)?.dataset.goal || '',
      biz: '',
    };

    // ─────────────────────────────────────────────
    //  فيزياء الحبل: نابض بسيط
    //  y = المسافة المسحوبة، v = السرعة
    // ─────────────────────────────────────────────
    // ┌──────────── 🎛️ إحساس اللمبة ────────────┐
    const REST = 150; // طول السلك بالراحة
    const STIFF = 0.16; // صلابة النابض (السحب لتحت)
    const DAMP = 0.82; // التخميد العمودي (كل ما قل، اهتز أكثر)
    const PULL_THRESHOLD = 46; // كم لازم تسحب لتحت عشان تضوي

    // الأرجحة يمين وشمال (بندول)
    const SWING_STIFF = 0.055; // كل ما زاد، رجعت أسرع للنص
    const SWING_DAMP = 0.955; // كل ما قرب من ١، ضلّت تتأرجح أطول
    const SWING_MAX = 26; // أقصى ميلان بالدرجات
    const SWING_PER_PX = 0.16; // كل بكسل سحب أفقي = كم درجة
    // └──────────────────────────────────────────┘

    let y = 0; // الاستطالة العمودية
    let v = 0; // سرعتها
    let a = 0; // زاوية الميلان بالدرجات
    let av = 0; // سرعة الميلان
    let dragging = false;
    let startY = 0;
    let startX = 0;
    let raf = 0;

    // ⚠️ الكتابة على الصفحة بتصير **بالإطار بس**، مش مع كل حركة إصبع.
    //    قبل هيك كنا منرسم مع كل pointermove — وهاي بتوصل ١٢٠ مرة
    //    بالثانية على الماوس باد، فكانت اللمبة تتقطّع وقت السحب.
    const draw = () => {
      wire.style.height = `${REST + y}px`;
      arm.style.transform = `translateX(-50%) rotate(${a.toFixed(2)}deg)`;
    };

    const tick = () => {
      if (!dragging) {
        // نابض عمودي
        v += -y * STIFF;
        v *= DAMP;
        y += v;

        // بندول أفقي
        av += -a * SWING_STIFF;
        av *= SWING_DAMP;
        a += av;

        const still =
          Math.abs(y) < 0.3 && Math.abs(v) < 0.3 && Math.abs(a) < 0.05 && Math.abs(av) < 0.05;
        if (still) {
          y = 0;
          v = 0;
          a = 0;
          av = 0;
          draw();
          raf = 0;
          return;
        }
      }
      draw();
      raf = requestAnimationFrame(tick);
    };

    const start = () => {
      if (!raf) raf = requestAnimationFrame(tick);
    };

    const switchBtn = lab.querySelector('[data-switch]') as HTMLElement | null;
    const switchLabel = lab.querySelector('[data-switch-label]') as HTMLElement | null;
    const LABEL_ON = isAr ? 'اضغط للإضاءة' : 'Tap to light';
    const LABEL_OFF = isAr ? 'اضغط للإطفاء' : 'Tap to switch off';

    const content = lab.querySelector('[data-lab-content]') as HTMLElement;

    const setLit = (nowLit: boolean) => {
      if (nowLit) lab.setAttribute('data-lit', '');
      else lab.removeAttribute('data-lit');

      // ⚠️ inert بيمنع التركيز بالكيبورد وقارئات الشاشة كمان،
      //    مش بس الضغط بالماوس. بدونها كان الزائر يقدر يوصل
      //    للخيارات بزر Tab والقسم لسا مطفي.
      if (content) {
        if (nowLit) content.removeAttribute('inert');
        else content.setAttribute('inert', '');
      }

      switchBtn?.setAttribute('aria-pressed', String(nowLit));
      if (switchLabel) switchLabel.textContent = nowLit ? LABEL_OFF : LABEL_ON;
    };

    const toggleLight = () => setLit(!lab.hasAttribute('data-lit'));

    // نبدأ مقفول
    setLit(false);

    // «تقليل الحركة»: منضويه لحاله عشان يضل قابل للاستخدام
    if (reduce) setLit(true);

    // مفتاح الموبايل: ضغطة وحدة بتضوي
    switchBtn?.addEventListener('click', toggleLight);

    // ─── السحب بالماوس واللمس ───
    // ⚠️ عالموبايل، مكتبة السكرول الناعم (Lenis) بتلتقط حركة
    //    الإصبع وبتعمل سكرول للصفحة بدل ما نسحب الحبل. فمنوقفها
    //    مؤقتاً طول مدة السحب ومنرجّعها بعدها.
    const lenis = () => (window as any).__lenis;

    // TAP_SLOP = أقصى حركة تعتبرها لمسة مش سحبة (بالبكسل)
    const TAP_SLOP = 8;
    let originY = 0; // مكان بداية الإصبع (عمودي)
    let originX = 0; // مكان بداية الإصبع (أفقي)
    let travelled = 0; // أقصى مسافة تحركتها

    let lastX = 0; // آخر موقع أفقي، منحسب منه سرعة الأرجحة

    const onDown = (e: PointerEvent) => {
      e.preventDefault();
      dragging = true;
      originY = e.clientY;
      originX = e.clientX;
      lastX = e.clientX;
      travelled = 0;
      startY = e.clientY - y;
      startX = e.clientX;
      // لو فشل الالتقاط لأي سبب، منكمل عادي بدل ما ينكسر السحب
      try {
        grab.setPointerCapture(e.pointerId);
      } catch {}
      // ⚠️ منوقف السكرول الناعم **بس على اللمس**. على الماوس ما إله
      //    داعي (السحب بالماوس ما بيعمل سكرول أصلاً)، ووقفه بيحط
      //    overflow: clip على الصفحة كلها — وهاي بتجبر المتصفح يعيد
      //    حساب تخطيط صفحة طولها ٢٤ ألف بكسل بلحظة بداية السحب.
      //    هاي كانت سبب «التعليق» اللي بيحس فيه الزائر أول ما يمسك.
      if (e.pointerType !== 'mouse') lenis()?.stop();
      start();
    };

    const onMove = (e: PointerEvent) => {
      if (!dragging) return;
      e.preventDefault();
      travelled = Math.max(travelled, Math.abs(e.clientY - originY));

      // ─── عمودي: بتنزل، وبمقاومة لو حاول يطلّعها ───
      const raw = e.clientY - startY;
      y = raw < 0 ? raw * 0.25 : Math.min(raw, 120);

      // ─── أفقي: بتميل مع إيدك ───
      // ⚠️⚠️ الإشارة سالبة عن قصد ⚠️⚠️
      //  الذراع معلّقة من فوق، ودورانها بالـ CSS بيكون باتجاه عقارب
      //  الساعة للأرقام الموجبة. يعني زاوية موجبة بتودّي **طرفها
      //  السفلي لليسار** — عكس إيدك بالضبط. بدون السالب كنت تسحب
      //  يمين واللمبة تروح شمال.
      const dx = e.clientX - startX;
      a = Math.max(-SWING_MAX, Math.min(SWING_MAX, -dx * SWING_PER_PX));
      // سرعة الأرجحة وقت الإفلات = آخر حركة عملها (بنفس الاتجاه)
      av = -(e.clientX - lastX) * SWING_PER_PX * 0.6;
      lastX = e.clientX;

      // ⚠️ ما منرسم هون عن قصد — الرسم بصير بالإطار (tick).
      //    الماوس باد بيبعت لحد ١٢٠ حركة بالثانية، ولو رسمنا مع كل
      //    وحدة بنجبر المتصفح يعيد الحساب أكثر من مرة بالإطار الواحد
      //    وبتصير الحركة متقطّعة بدل ما تكون أنعم.
    };

    // ⚠️ مسار واحد بس للتشغيل: من رفع الإصبع.
    //    قبل هيك كان في مسارين (السحب + حدث الضغط) وكانوا
    //    يلغوا بعض أحياناً فما تشتغل اللمسة السريعة.
    const onUp = () => {
      lenis()?.start();
      if (!dragging) return;
      dragging = false;

      if (travelled < TAP_SLOP) {
        // لمسة سريعة: نشغّل ونعطي اهتزازة خفيفة
        toggleLight();
        y = 30;
      } else if (y > PULL_THRESHOLD) {
        // سحبة كافية لتحت = تشغيل/إطفاء
        // (الأرجحة يمين وشمال للّعب بس، ما بتشغّل — زي اللمبة الحقيقية)
        toggleLight();
      }

      v = -y * 0.35; // ارتداد عمودي
      start();
    };

    grab.addEventListener('pointerdown', onDown);
    grab.addEventListener('pointermove', onMove);
    grab.addEventListener('pointerup', onUp);
    grab.addEventListener('pointercancel', onUp);
    grab.addEventListener('lostpointercapture', onUp);

    // ⚠️ شبكة أمان: lenis.stop() بتحط overflow:clip على الصفحة كلها.
    //    فلو ما وصلنا لـ onUp لأي سبب (مثلاً فشل setPointerCapture
    //    ورفع الزائر إصبعه برّا الحبل)، بتضل الصفحة **مقفلة**
    //    وما بيقدر يمرّر أبداً. فمنضمن إنه أي رفع إصبع بأي مكان
    //    بالصفحة بيرجّع السكرول. منربطها مرة وحدة على النافذة
    //    (مش مع كل انتقال) عشان ما تتكدّس.
    const w = window as any;
    if (!w.__scrollSafety) {
      w.__scrollSafety = true;
      const unlock = () => w.__lenis?.start();
      window.addEventListener('pointerup', unlock);
      window.addEventListener('pointercancel', unlock);
      window.addEventListener('blur', unlock);
    }

    // تأمين إضافي للموبايل: بنمنع المتصفح من تحويل السحب لسكرول.
    // touch-action لحاله ما بيكفي مع كل المتصفحات.
    grab.addEventListener('touchmove', (e) => e.preventDefault(), { passive: false });

    // دعم الكيبورد (Enter و Space)
    handle.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      e.preventDefault();
      toggleLight();
      y = 34;
      v = 0;
      start();
    });

    // قفل منطقي: ما في تفاعل مع المختبر قبل ما يضوي.
    // (الـ CSS بيمنع الضغط أصلاً، وهاد سطر أمان إضافي)
    const isLit = () => lab.hasAttribute('data-lit');

    // ─── اختيار الأجوبة ───
    lab.querySelectorAll('[data-industry]').forEach((b) => {
      b.addEventListener('click', () => {
        if (!isLit()) return;
        lab.querySelectorAll('[data-industry]').forEach((o) => o.classList.remove('is-on'));
        b.classList.add('is-on');
        answers.industry = (b as HTMLElement).dataset.industry || '';
      });
    });

    lab.querySelectorAll('[data-goal]').forEach((b) => {
      b.addEventListener('click', () => {
        if (!isLit()) return;
        lab.querySelectorAll('[data-goal]').forEach((o) => o.classList.remove('is-on'));
        b.classList.add('is-on');
        answers.goal = (b as HTMLElement).dataset.goal || '';
      });
    });

    // ─── التوليد ───
    const show = () => {
      if (!isLit()) return;
      answers.biz = bizInput?.value || '';
      const idea = generateIdea(answers, isAr ? 'ar' : 'en');
      const set = (sel: string, val: string) => {
        const el = lab.querySelector(sel);
        if (el) el.textContent = val;
      };
      // سطر «فكرة لـ...» بيظهر بس إذا كتب اسم مشروعه
      const forEl = lab.querySelector('[data-r-for]') as HTMLElement | null;
      if (forEl) {
        const typed = (bizInput?.value || '').trim();
        if (typed) {
          forEl.textContent = `${FOR_LABEL} ${typed}`;
          forEl.hidden = false;
        } else {
          forEl.hidden = true;
        }
      }

      set('[data-r-hook]', idea.hook);
      set('[data-r-format]', idea.format);
      set('[data-r-angle]', idea.angle);
      set('[data-r-proof]', idea.proof);
      set('[data-r-closer]', idea.closer);

      // نعبّي إيميل التواصل بإجاباته والفكرة، عشان يوصلني السياق
      // كامل بدل ما يكتب «مرحبا» وبس
      if (askMail) {
        const label = (sel: string) =>
          (lab.querySelector(sel + '.is-on') as HTMLElement)?.textContent?.trim() || '';
        const notes = (notesInput?.value || '').trim();
        const subject = isAr ? 'استفسار من مختبر الأفكار' : 'Enquiry from the idea lab';
        const body = [
          isAr ? 'مرحبا ريّان،' : 'Hi Rayan,',
          '',
          `${isAr ? 'المجال' : 'Industry'}: ${label('[data-industry]')}`,
          `${isAr ? 'الهدف' : 'Goal'}: ${label('[data-goal]')}`,
          `${isAr ? 'المشروع' : 'Business'}: ${answers.biz || '-'}`,
          notes ? `${isAr ? 'تفاصيل' : 'Details'}: ${notes}` : '',
          '',
          `${isAr ? 'الفكرة اللي طلعتلي' : 'The idea I got'}: ${idea.hook}`,
          '',
          isAr ? 'بحب أحكي معك أكثر عن مشروعي.' : 'I would like to talk about my project.',
        ]
          .filter(Boolean)
          .join('\n');

        askMail.href =
          `mailto:${askMail.dataset.email}` +
          `?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      }

      form.hidden = true;
      result.hidden = false;
      askAI(answers, (notesInput?.value || '').trim());
      if (!reduce) result.animate([{ opacity: 0, transform: 'translateY(14px)' }, { opacity: 1, transform: 'none' }], { duration: 420, easing: 'cubic-bezier(0.16,1,0.3,1)' });
    };

    lab.querySelector('[data-generate]')?.addEventListener('click', show);
    lab.querySelector('[data-again]')?.addEventListener('click', show);
    lab.querySelector('[data-restart]')?.addEventListener('click', () => {
      result.hidden = true;
      form.hidden = false;
    });

    draw();
  }

  initLab();
  document.addEventListener('astro:page-load', initLab);
</script>
