---
// ═══════════════════════════════════════════════════════════════
//  قسم اللمبة — «خليني أعطيك فكرة»
//
//  قسم مستقل بيبدأ عتمة. فيه حبل لمبة معلّق بيتأرجح بفيزياء
//  حقيقية. تسحبه ← الضوء بينتشر ← بيطلعلك ثلاث أسئلة سريعة عن
//  مشروعك ← بنولّدلك فكرة محتوى مخصصة إلك.
//
//  ✏️ الأسئلة والخيارات من ملف src/data/ideas.json
//  ✏️ النصوص من قسم t تحت مباشرة
// ═══════════════════════════════════════════════════════════════
import { industries, goals } from '../scripts/idea-engine.js';
import work from '../data/work.json';

const email = work.links.email;

interface Props {
  lang: 'en' | 'ar';
  id?: string;
}

const { lang, id = 'lab' } = Astro.props;
const isAr = lang === 'ar';

// ─────────────── النصوص (عدّل من هون) ───────────────
const t = isAr
  ? {
      kicker: 'تجربة',
      heading: 'اسحب الحبل، خليني أعطيك فكرة.',
      sub: 'ثلاث أسئلة سريعة عن مشروعك، وبطلعلك فكرة محتوى جاهزة تنفّذها اليوم.',
      pull: 'اسحب',
      tapOn: 'اضغط للإضاءة',
      tapOff: 'اضغط للإطفاء',
      q1: 'شو مجال مشروعك؟',
      q2: 'شو بدك من المحتوى؟',
      q3: 'اسم مشروعك (اختياري)',
      q3ph: 'مثلاً: كافيه الركن',
      q4: 'إشي ثاني بتحب أعرفه؟ (اختياري)',
      q4ph: 'مثلاً: جمهوري شباب من 18 لـ 25، ومشكلتي إن الناس بتيجي مرة وما بترجع…',
      q4hint: 'كل ما تحكي أكثر، كل ما صارت الفكرة أقرب لمشروعك، وبتوصلني معك لو حبيت تتواصل.',
      generate: 'ولّد لي فكرة',
      again: 'فكرة ثانية',
      restart: 'غيّر إجاباتي',
      aiTag: 'وفكرة كمان من الذكاء الاصطناعي',
      aiLoading: 'عم تتولّد…',
      // ⚠️ التحذير مقصود يكون صريح مش مطمّن. قسنا الموديل المجاني
      //    وطلع ما بيقرأ عربي منيح، والزائر لازم يعرف قبل ما يحكم
      //    على شغل ريّان من نتيجة غلط.
      aiWarn:
        'هاي مولّدة بالذكاء الاصطناعي، فممكن تطلع غلط أو مش دقيقة، خُذها كنقطة بداية مش كخطة. للنتائج الأدق جرّب اللعبة بالإنجليزي. وبنشتغل على تحسين النموذج قريباً.',
      labelHook: 'الخطاف',
      labelFormat: 'الشكل',
      labelAngle: 'الزاوية',
      labelProof: 'الإثبات',
      labelCloser: 'الخاتمة',
      forBiz: 'فكرة لـ',
      disclaimer:
        'هاي تجربة سريعة، والفكرة مش بالضرورة تناسب مشروعك تماماً. الأفكار اللي بتجيب نتيجة فعلية بتحتاج دراسة لمشروعك ومنافسيك وجمهورك.',
      cta: 'بدك أفكار مبنية على دراسة حقيقية؟',
      ctaBtn: 'احكيلي عن مشروعك',
    }
  : {
      kicker: 'Experiment',
      heading: 'Pull the cord, let me give you an idea.',
      sub: 'Three quick questions about your business, and you get a content idea you could shoot today.',
      pull: 'Pull',
      tapOn: 'Tap to light',
      tapOff: 'Tap to switch off',
      q1: 'What is your business?',
      q2: 'What do you want from the content?',
      q3: 'Business name (optional)',
      q3ph: 'e.g. Corner Cafe',
      q4: 'Anything else I should know? (optional)',
      q4ph: 'e.g. my audience is 18 to 25, and my problem is people come once and never return…',
      q4hint: 'The more you tell me, the closer the idea gets, and it reaches me if you decide to get in touch.',
      generate: 'Generate an idea',
      again: 'Another idea',
      restart: 'Change my answers',
      aiTag: 'And one more, from AI',
      aiLoading: 'generating…',
      aiWarn:
        'This one is AI-generated, so it can be wrong or imprecise: treat it as a starting point, not a plan. We are working on a better model.',
      labelHook: 'Hook',
      labelFormat: 'Format',
      labelAngle: 'Angle',
      labelProof: 'Proof',
      labelCloser: 'Closer',
      forBiz: 'An idea for',
      disclaimer:
        'This is a quick experiment and the idea will not necessarily fit your business exactly. Ideas that actually move numbers need a real look at your business, your competitors, and your audience.',
      cta: 'Want ideas built on an actual study?',
      ctaBtn: 'Tell me about your business',
    };

const contactHref = isAr ? '/ar/#contact' : '/#contact';
---

<section class="lab" id={id} data-lab>
  <!-- الوهج اللي بينتشر لما تضوي اللمبة -->
  <div class="glow" aria-hidden="true"></div>

  <div class="container inner">
    <!-- ═══ مفتاح الإضاءة (موبايل فقط) ═══
         عالموبايل السحب مش عملي، فمنستبدله بمفتاح بالضغط، 
         شكل مألوف وواضح إنه بينضغط -->
    <button class="switch" data-switch type="button" aria-pressed="false">
      <span class="switch-track" aria-hidden="true"><span class="switch-knob"></span></span>
      <span class="switch-label" data-switch-label>{t.tapOn}</span>
    </button>

    <!-- ═══════════════════════════════════════════════════════════
         اللمبة المعلّقة (ديسكتوب فقط)
         ⚠️ الذراع كلها بتلف من نقطة التعليق فوق (transform-origin)،
            فبتتأرجح يمين وشمال زي البندول. والسلك بيطول وبيقصر
            بتغيير ارتفاعه. كل الحركة بخاصيتين بس (transform + height)
            عشان تضل ناعمة ٦٠ إطار بالثانية.
         ═══════════════════════════════════════════════════════════ -->
    <div class="cord-wrap" data-cord-wrap>
      <div class="lamp-arm" data-arm>
        <span class="wire" data-wire aria-hidden="true"></span>

        <button class="handle" data-cord type="button" aria-label={t.pull}>
          <svg class="bulb" viewBox="0 0 44 70" aria-hidden="true">
            <!-- هالة الضوء (بتظهر لما تضوي) -->
            <ellipse class="halo" cx="22" cy="26" rx="21" ry="23" />

            <!-- زجاج اللمبة -->
            <path
              class="glass"
              d="M22 3c9.4 0 17 7.4 17 16.6 0 6.3-3.3 9.9-5.6 14.1-1.7 3.1-2.4 5.6-2.6 8.3H13.2c-.2-2.7-.9-5.2-2.6-8.3C8.3 29.5 5 25.9 5 19.6 5 10.4 12.6 3 22 3Z"
            />

            <!-- الفتيل جوّا الزجاج -->
            <path class="filament" d="M16 34v-8c0-3.3 2.7-6 6-6s6 2.7 6 6v8" />
            <path class="filament-wires" d="M16 34v6M28 34v6" />

            <!-- القاعدة المعدنية -->
            <path class="cap" d="M13.2 42h17.6v5.5H13.2z" />
            <path class="cap" d="M14.4 49h15.2v4.5H14.4z" />
            <path class="cap" d="M16 55h12v3.5H16z" />
            <path class="cap-tip" d="M19 60h6v3.5h-6z" />
          </svg>

          <span class="pull-label">{t.pull}</span>
        </button>
      </div>
    </div>

    <!-- ═══ المحتوى (بيظهر بعد الإضاءة) ═══ -->
    <div class="content" data-lab-content>
      <p class="kicker">{t.kicker}</p>
      <h2>{t.heading}</h2>
      <p class="sub">{t.sub}</p>

      <!-- الأسئلة -->
      <div class="form" data-lab-form>
        <div class="field">
          <label>{t.q1}</label>
          <div class="opts">
            {
              industries.map((i: any, n: number) => (
                <button
                  class={`opt ${n === 0 ? 'is-on' : ''}`}
                  type="button"
                  data-industry={i.id}
                >
                  {isAr ? i.labelAr : i.label}
                </button>
              ))
            }
          </div>
        </div>

        <div class="field">
          <label>{t.q2}</label>
          <div class="opts">
            {
              goals.map((g: any, n: number) => (
                <button class={`opt ${n === 0 ? 'is-on' : ''}`} type="button" data-goal={g.id}>
                  {isAr ? g.labelAr : g.label}
                </button>
              ))
            }
          </div>
        </div>

        <div class="field">
          <label for="biz-name">{t.q3}</label>
          <input id="biz-name" type="text" placeholder={t.q3ph} data-biz maxlength="40" />
        </div>

        <!-- مربع حر: الزائر بيكتب أي إشي عن مشروعه.
             حالياً بينحفظ وبينبعت مع رسالة التواصل، ولما نربط
             الذكاء الاصطناعي بيصير هو المدخل الأساسي للتخصيص. -->
        <div class="field">
          <label for="biz-notes">{t.q4}</label>
          <textarea
            id="biz-notes"
            rows="3"
            maxlength="400"
            placeholder={t.q4ph}
            data-notes></textarea>
          <p class="hint">{t.q4hint}</p>
        </div>

        <button class="btn btn-primary go" data-generate type="button">{t.generate}</button>
      </div>

      <!-- ═══ النتيجة ═══ -->
      <div class="result" data-lab-result hidden>
        <div class="card">
          <!-- سطر بيقول الفكرة لمين — بيظهر بس إذا كتب اسم مشروعه -->
          <p class="for-biz" data-r-for hidden></p>

          <div class="rows">
            <div class="r"><span>{t.labelHook}</span><strong data-r-hook></strong></div>
            <div class="r"><span>{t.labelFormat}</span><p data-r-format></p></div>
            <div class="r"><span>{t.labelAngle}</span><p data-r-angle></p></div>
            <div class="r"><span>{t.labelProof}</span><p data-r-proof></p></div>
            <div class="r"><span>{t.labelCloser}</span><p data-r-closer></p></div>
          </div>

          <!-- ═══ فكرة من الذكاء الاصطناعي ═══
               ⚠️ بتوصل بعد الفكرة المركّبة، مش بدلها. لو الخدمة
               وقعت أو تأخّرت، الزائر بيضل شايف نتيجة كاملة، 
               ما بينكسر إشي وما بيستنى على فاضي. -->
          <div class="ai-block" data-ai-block hidden>
            <div class="ai-head">
              <span class="ai-tag">{t.aiTag}</span>
              <span class="ai-load" data-ai-load>{t.aiLoading}</span>
            </div>
            <p class="ai-text" data-ai-text></p>
            <p class="ai-warn">{t.aiWarn}</p>
          </div>

          <div class="actions">
            <button class="btn btn-primary" data-again type="button">{t.again}</button>
            <button class="btn btn-ghost" data-restart type="button">{t.restart}</button>
          </div>
        </div>

        <p class="disclaimer">{t.disclaimer}</p>

        <!-- الزر بيفتح إيميل معبّى بإجاباته والفكرة اللي طلعتله،
             فما بيضطر يعيد شرح مشروعه من الصفر -->
        <div class="ask">
          <span>{t.cta}</span>
          <a class="btn btn-ghost" href={`mailto:${email}`} data-ask-mail data-email={email}>
            {t.ctaBtn}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ╔═══════════════ 🎛️ لوحة التحكم ═══════════════╗ */
  .lab {
    --dark: #08090b; /* عتمة القسم قبل الإضاءة */
    --glow-size: 120vmax; /* اتساع الوهج */
    --glow-strength: 0.16; /* قوة الوهج */
    --cord-length: 150px; /* طول الحبل */
    --heading-size: clamp(28px, 4.2vw, 54px);
    position: relative;
    margin-top: var(--section-gap);
    padding-block: clamp(70px, 11vh, 130px);
    background: var(--dark);
    overflow: clip;
    isolation: isolate;
  }

  /* ─── الوهج ─── */
  .glow {
    position: absolute;
    top: -10%;
    inset-inline-start: 50%;
    translate: -50% 0;
    width: var(--glow-size);
    height: var(--glow-size);
    z-index: -1;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(
      circle at 50% 0%,
      color-mix(in srgb, var(--accent) 42%, transparent),
      transparent 42%
    );
    transition: opacity 1s var(--ease-out);
  }

  .lab[data-lit] .glow {
    opacity: var(--glow-strength);
  }

  /* ─── الحبل واللمبة ─── */
  /* ⚠️ كل عمود الحبل قابل للسحب — مش بس الكرة اللي بآخره.
     قبل هيك كان الحبل مجرد شكل، فلما تمسكه الصفحة بتنزل. */
  .cord-wrap {
    position: absolute;
    top: 0;
    inset-inline-end: clamp(20px, 8vw, 132px);
    width: 56px;
    height: calc(var(--cord-length) + 70px);
    pointer-events: auto;
    cursor: grab;
    touch-action: none;
    -webkit-user-select: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .cord-wrap:active {
    cursor: grabbing;
  }

  /* ═══════════════════════════════════════════════════════════════
     الذراع: السلك + اللمبة. بتلف من نقطة التعليق فوق.
     ═══════════════════════════════════════════════════════════════ */
  .lamp-arm {
    position: absolute;
    top: 0;
    left: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* ⚠️ نقطة الدوران فوق بالضبط — من هون بتتعلّق اللمبة */
    transform-origin: 50% 0;
    transform: translateX(-50%);
    will-change: transform;
    pointer-events: none; /* السحب بيمسكه الغلاف والزر */
  }

  /* السلك */
  .wire {
    width: 2px;
    height: var(--cord-length);
    border-radius: 2px;
    background: linear-gradient(
      180deg,
      rgba(242, 243, 238, 0.1),
      rgba(242, 243, 238, 0.32)
    );
    transition: background 0.5s var(--ease-out);
  }

  .lab[data-lit] .wire {
    background: linear-gradient(
      180deg,
      rgba(242, 243, 238, 0.12),
      color-mix(in srgb, var(--accent) 55%, transparent)
    );
  }

  /* المقبض = اللمبة نفسها */
  .handle {
    display: grid;
    place-items: center;
    gap: 6px;
    padding: 0 14px 10px;
    border: 0;
    background: transparent;
    pointer-events: auto;
    cursor: grab;
    /* بيمنع المتصفح من اعتبار السحب سكرول */
    touch-action: none;
    -webkit-user-select: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .handle:active {
    cursor: grabbing;
  }

  .bulb {
    /* ✏️ حجم اللمبة */
    width: 58px;
    height: 92px;
    overflow: visible;
    /* بتكبر شوي وقت الإضاءة — إحساس إنها «صحيت» */
    transition: scale 0.45s var(--ease-out);
  }

  .lab[data-lit] .bulb {
    scale: 1.06;
  }

  /* ─── الزجاج ─── */
  .glass {
    fill: rgba(242, 243, 238, 0.05);
    stroke: rgba(242, 243, 238, 0.34);
    stroke-width: 1.4;
    transition:
      fill 0.5s var(--ease-out),
      stroke 0.5s var(--ease-out);
  }

  .lab[data-lit] .glass {
    fill: color-mix(in srgb, var(--accent) 26%, transparent);
    stroke: color-mix(in srgb, var(--accent) 85%, transparent);
  }

  /* ─── الفتيل ─── */
  .filament,
  .filament-wires {
    fill: none;
    stroke: rgba(242, 243, 238, 0.3);
    stroke-width: 1.6;
    stroke-linecap: round;
    transition:
      stroke 0.4s var(--ease-out),
      filter 0.5s var(--ease-out);
  }

  .filament-wires {
    stroke-width: 1.2;
  }

  .lab[data-lit] .filament,
  .lab[data-lit] .filament-wires {
    stroke: #fffde3;
    filter: drop-shadow(0 0 4px var(--accent)) drop-shadow(0 0 10px var(--accent));
  }

  /* ─── القاعدة المعدنية ─── */
  .cap {
    fill: #6f7468;
    stroke: rgba(0, 0, 0, 0.35);
    stroke-width: 0.6;
  }

  .cap-tip {
    fill: #4a4e45;
  }

  .lab[data-lit] .cap {
    fill: #8b9180;
  }

  /* ─── هالة الضوء حوالين الزجاج ─── */
  .halo {
    fill: var(--accent);
    opacity: 0;
    filter: blur(14px);
    transition: opacity 0.6s var(--ease-out);
  }

  .lab[data-lit] .halo {
    opacity: 0.5;
  }

  .pull-label {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    opacity: 0.7;
    transition: opacity 0.4s var(--ease-out);
  }

  .lab[data-lit] .pull-label {
    opacity: 0;
  }

  /* ─── مفتاح الإضاءة (بيبين عالموبايل بس) ─── */
  .switch {
    display: none;
    align-items: center;
    gap: 14px;
    margin-bottom: 30px;
    padding: 10px 18px 10px 10px;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: rgba(242, 243, 238, 0.04);
    font-family: inherit;
    -webkit-tap-highlight-color: transparent;
    transition:
      border-color 0.35s var(--ease-out),
      background-color 0.35s var(--ease-out);
  }

  .switch:active {
    transform: scale(0.98);
  }

  .lab[data-lit] .switch {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  /* مسار المفتاح */
  .switch-track {
    position: relative;
    flex-shrink: 0;
    width: 54px;
    height: 30px;
    border-radius: var(--r-pill);
    background: rgba(242, 243, 238, 0.14);
    transition: background-color 0.4s var(--ease-out);
  }

  .lab[data-lit] .switch-track {
    background: var(--accent);
  }

  /* الزر اللي بينزلق */
  .switch-knob {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 24px;
    height: 24px;
    border-radius: var(--r-pill);
    background: var(--text);
    transition: transform 0.4s var(--ease-out), background-color 0.4s var(--ease-out);
  }

  .lab[data-lit] .switch-knob {
    transform: translateX(24px);
    background: var(--accent-ink);
  }

  /* بالعربي المفتاح بينزلق لليسار */
  html[dir='rtl'] .lab[data-lit] .switch-knob {
    transform: translateX(24px);
  }

  .switch-label {
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
    white-space: nowrap;
    transition: color 0.35s var(--ease-out);
  }

  .lab[data-lit] .switch-label {
    color: var(--text);
  }

  /* ─── المحتوى ─── */
  .content {
    max-width: 62ch;
    opacity: 0.12;
    filter: blur(1.5px);
    /* ⚠️ مقفول للتفاعل لحد ما تضوي — قبل هيك كان الزائر يقدر
       يضغط الخيارات ويولّد فكرة والقسم لسا عتمة */
    pointer-events: none;
    transition:
      opacity 0.9s var(--ease-out),
      filter 0.9s var(--ease-out);
  }

  .lab[data-lit] .content {
    opacity: 1;
    filter: none;
    pointer-events: auto;
  }

  .kicker {
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 14px;
  }

  h2 {
    font-size: var(--heading-size);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 16px;
    max-width: 18ch;
  }

  html[lang='ar'] h2 {
    font-weight: 800;
    letter-spacing: 0;
  }

  .sub {
    color: var(--muted);
    font-size: clamp(15px, 1.6vw, 18px);
    line-height: 1.75;
    margin-bottom: clamp(30px, 4.5vh, 48px);
  }

  /* ─── الأسئلة ─── */
  .form[hidden] {
    display: none;
  }

  .field {
    margin-bottom: 26px;
  }

  .field label {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 12px;
  }

  .opts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .opt {
    border: 1px solid var(--line);
    background: transparent;
    color: var(--muted);
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    padding: 10px 18px;
    border-radius: var(--r-pill);
    transition:
      color 0.3s var(--ease-out),
      border-color 0.3s var(--ease-out),
      background-color 0.3s var(--ease-out);
  }

  .opt:hover {
    color: var(--text);
    border-color: rgba(242, 243, 238, 0.32);
