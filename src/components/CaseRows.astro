---
// ═══════════════════════════════════════════════════════════════
//  قصص النمو (التسويق) — صفوف كبيرة متناوبة: صورة يمين، صورة يسار
//  بنعرض أقوى قصتين بس، والباقي بصفحة القسم
// ═══════════════════════════════════════════════════════════════
interface Props {
  lang: 'en' | 'ar';
  projects: any[]; // أول مشروعين بينعرضوا
  heading: string;
  allHref: string;
  allLabel: string;
  id?: string;
  showAll?: boolean;
}

const { lang, projects, heading, allHref, allLabel, id, showAll = true } = Astro.props;
const isAr = lang === 'ar';
// بيعرض أول قصتين بس عشان تضل الصفحة الرئيسية مركّزة
const shown = projects.slice(0, 2);
---

<section class="cases" id={id}>
  <div class="container">
    <div class="head">
      <h2 data-reveal>{heading}</h2>
      {showAll && <a class="all-link" href={allHref} data-reveal>{allLabel}</a>}
    </div>

    {
      shown.map((p, i) => (
        <article class={`row ${i % 2 === 1 ? 'flip' : ''}`} data-reveal>
          <div class="media">
            <img src={p.cover} alt={isAr ? p.titleAr : p.title} loading="lazy" width="800" height="800" />
          </div>
          <div class="copy">
            <p class="role">{isAr ? p.roleAr : p.role}</p>
            <h3>{isAr ? p.titleAr : p.title}</h3>
            <p class="desc">{isAr ? p.descAr : p.desc}</p>
            {p.stats?.length > 0 && (
              <ul class="chips">
                {p.stats.map((s: any) => (
                  <li>
                    <strong>{s.value}</strong> {isAr ? s.labelAr : s.label}
                  </li>
                ))}
              </ul>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  /* 🎛️ لوحة التحكم */
  .cases {
    --row-gap: clamp(48px, 8vh, 96px); /* المسافة بين القصص */
    --heading-size: clamp(28px, 4vw, 52px);
    padding-block: var(--section-gap) 0;
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: clamp(32px, 5vh, 56px);
  }

  h2 {
    font-size: var(--heading-size);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  html[lang='ar'] h2 {
    font-weight: 800;
    letter-spacing: 0;
  }

  .all-link {
    flex-shrink: 0;
    font-size: 15px;
    font-weight: 600;
    color: var(--muted);
    border-bottom: 1px solid var(--line);
    padding-bottom: 3px;
    transition: color 0.3s var(--ease-out), border-color 0.3s var(--ease-out);
  }

  .all-link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .row {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(28px, 4vw, 64px);
    align-items: center;
  }

  .row + .row {
    margin-top: var(--row-gap);
  }

  /* الصف الثاني معكوس: النص أول والصورة بعده */
  .row.flip .media {
    order: 2;
  }

  .media {
    border-radius: var(--r-card);
    overflow: hidden;
    background: var(--surface);
  }

  .media img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 0.8s var(--ease-out);
  }

  .row:hover .media img {
    transform: scale(1.04);
  }

  .role {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 10px;
  }

  h3 {
    font-size: clamp(24px, 2.8vw, 38px);
    font-weight: 700;
    margin-bottom: 14px;
    letter-spacing: -0.015em;
  }

  html[lang='ar'] h3 {
    letter-spacing: 0;
    font-weight: 800;
  }

  .desc {
    color: var(--muted);
    font-size: 15.5px;
    line-height: 1.75;
    max-width: 48ch;
  }

  .chips {
    list-style: none;
    padding: 0;
    margin: 18px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chips li {
    font-size: 13px;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    padding: 7px 16px;
  }

  .chips strong {
    color: var(--accent);
    font-family: var(--font-en);
  }

  /* ─── موبايل: عمود واحد، والصورة أقصر عشان القصة تبين كاملة ─── */
  @media (max-width: 767px) {
    .cases {
      --row-gap: 44px;
    }

    .row,
    .row.flip {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .row.flip .media {
      order: 0;
    }

    .media img {
      aspect-ratio: 16 / 10;
    }

    .desc {
      font-size: 15px;
    }
  }
</style>
