---
// ═══════════════════════════════════════════════════════════════
//  بطاقة «وكيلك الذكي» بالرئيسية — مدخل صغير لصفحة /agent/
//
//  ليش؟ لعبة «وظّف وكيلك» كانت مدفونة بصفحة خدمة «قريباً» ونادراً
//  حدا بيوصلها (ملاحظة ريّان 2026-08-04). هاي البطاقة بتعرّف عليها
//  من أكثر مكان مزار — بسيطة عن قصد: سطرين وزر.
//
//  ✏️ الاستخدام: <AgentTeaser lang="ar" />  (بعد مختبر الأفكار)
// ═══════════════════════════════════════════════════════════════
interface Props {
  lang: 'en' | 'ar';
  id?: string;
}

const { lang, id = 'agent-teaser' } = Astro.props;
const isAr = lang === 'ar';
const p = isAr ? '/ar' : '';

const t = isAr
  ? {
      kicker: 'جديد بالمختبر',
      title: 'جرّب توظّف وكيل ذكاء اصطناعي',
      line: 'لعبة بدقيقة وحدة: اختار مجالك، علّم على المهام اللي بتاكل يومك، وتفرّج على يومك بيصير لحاله — وكم ساعة بالأسبوع بترجعلك.',
      cta: 'العب يومك التجريبي',
    }
  : {
      kicker: 'New in the lab',
      title: 'Try hiring an AI agent',
      line: 'A one-minute game: pick your field, tick the tasks eating your day, and watch your day handle itself — and how many hours a week you get back.',
      cta: 'Play your trial day',
    };
---

<section class="agt container" id={id}>
  <a class="agt-card frame frame-on" href={`${p}/agent/`} data-reveal>
    <span class="agt-bot" aria-hidden="true">🤖</span>
    <span class="agt-txt">
      <span class="agt-kicker">{t.kicker}</span>
      <span class="agt-title">{t.title}</span>
      <span class="agt-line">{t.line}</span>
    </span>
    <span class="agt-cta btn btn-primary">{t.cta}</span>
  </a>
</section>

<style>
  /* ╔═══════════════ 🎛️ لوحة التحكم ═══════════════╗ */
  .agt {
    margin-block: clamp(20px, 3vh, 36px);
  }

  .agt-card {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2.5vw, 28px);
    border-radius: var(--r-card);
    padding: clamp(18px, 2.6vw, 28px);
    transition: border-color 0.3s var(--ease-out), transform 0.25s var(--ease-out);
  }

  .agt-card:hover {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    transform: translateY(-2px);
  }

  .agt-bot {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    font-size: 27px;
    border-radius: var(--r-pill);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
  }

  .agt-txt {
    flex: 1;
    min-width: 0;
    display: grid;
    gap: 4px;
  }

  .agt-kicker {
    font-size: 12.5px;
    font-weight: 700;
    color: var(--accent);
  }

  .agt-title {
    font-size: clamp(17px, 2vw, 21px);
    font-weight: 800;
    color: var(--text);
  }

  .agt-line {
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--muted);
    max-width: 62ch;
  }

  .agt-cta {
    flex-shrink: 0;
    pointer-events: none; /* البطاقة كلها رابط — الزر شكل بس */
  }

  /* ─── موبايل ─── */
  @media (max-width: 700px) {
    .agt-card {
      flex-direction: column;
      align-items: flex-start;
    }

    .agt-cta {
      align-self: stretch;
      justify-content: center;
    }
  }
</style>
