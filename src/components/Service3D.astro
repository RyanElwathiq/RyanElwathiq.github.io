---
// ═══════════════════════════════════════════════════════════════
//  مسرح الجسم الثلاثي لصفحة الخدمة
//  المحرّك والهندسات بـ src/scripts/service3d.js — هون بس الكانفاس
//  وربط دورة الحياة (تشغيل عند الوصول، تنظيف قبل المغادرة).
//
//  ✏️ service = معرّف الخدمة — بيحدد أي هندسة بتنرسم
// ═══════════════════════════════════════════════════════════════
interface Props {
  service: string;
}

const { service } = Astro.props;
---

<canvas data-s3d={service} aria-hidden="true"></canvas>

<script>
  import { initService3D } from '../scripts/service3d.js';

  // نفس نمط Particles: نسخة شغّالة وحدة، بتتنضّف قبل كل انتقال
  let stop: (() => void) | null = null;
  const start = () => {
    stop?.();
    stop = initService3D();
  };
  start();
  document.addEventListener('astro:page-load', start);
  document.addEventListener('astro:before-swap', () => {
    stop?.();
    stop = null;
  });
</script>

<style>
  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
