---
// ═══════════════════════════════════════════════════════════════
//  «الأرقام بتقول شو صار — مش ليش»
//
//  ⚠️ ليش هذا القسم موجود؟
//  ريّان طلب قسم عن تحليل البيانات وتعقيداتها والأدوات (Hotjar،
//  Microsoft Clarity، GA4). والزاوية اللي بتفرّق: أغلب الناس
//  بتوقف عند «كم زائر» — وهاد بيقول شو صار بس ما بيقول ليش.
//  فالقسم مبني كثلاث طبقات رؤية، وكل وحدة بتجاوب سؤال مختلف.
//
//  ⚠️ الإشارات المذكورة (نقرات الغضب، النقرات الميتة…) كلها
//     مصطلحات حقيقية بأدوات حقيقية — مش تسميات مخترعة. اللي
//     بيفهم بيتعرّف عليها فوراً.
//
//  ✏️ النصوص كلها تحت مباشرة
// ═══════════════════════════════════════════════════════════════
interface Props {
  lang: 'en' | 'ar';
  id?: string;
}

const { lang, id = 'data' } = Astro.props;
const isAr = lang === 'ar';

const t = isAr
  ? {
      kicker: 'تحليل البيانات',
      heading: 'الأرقام بتقول شو صار. مش ليش صار.',
      lede: '«زارنا ٥ آلاف الشهر الماضي»، طيب؟ الرقم لحاله ما بيقول لك شو تعمل بكرا. الشغل الحقيقي إنك تشوف بثلاث طبقات: شو صار، وليش صار، وشو بتغيّر بناءً عليه. وكل طبقة إلها أدواتها.',
      layers: [
        {
          n: '01',
          q: 'شو صار؟',
          name: 'الأرقام',
          body: 'الطبقة اللي الكل بيوقف عندها. زيارات، مصادر، صفحات، معدّل ارتداد. مفيدة. بس بتوصف الماضي بدون ما تفسّره. وأكبر غلط هون إنه القياس ينبني على الزيارات بدل الأحداث: الزيارة مش نتيجة، الحدث نتيجة.',
          points: [
            'أحداث مبنية على أفعال حقيقية مش صفحات',
            'مسارات التحويل ووين بالضبط بينقطع الناس',
            'الجمهور المقسّم حسب السلوك مش حسب البلد',
            'الإحالة: مين آخر مصدر ومين ساعد بالطريق',
          ],
          tools: ['GA4', 'Google Tag Manager', 'Looker Studio'],
        },
        {
          n: '02',
          q: 'ليش صار؟',
          name: 'السلوك',
          body: 'هون بتشوف الشاشة بعيون الزائر. خرائط حرارية بتوريك وين وصلت عينه ووين وقف سكروله، وتسجيلات جلسات بتوريك اللحظة اللي زهق فيها. والإشارات اللي بتطلع من هون ما بتطلع من أي تقرير أرقام.',
          // ⚠️ Rage clicks و dead clicks انتركوا بالإنجليزي بقرار
          //    ريّان: المسوّق الأردني بيحكيهم هيك، والترجمة الحرفية
          //    («نقرات الغضب») بتبيّن مترجمة وما حدا بيبحث فيها.
          points: [
            'Rage clicks: بيضغط ويضغط لأنه ما صار إشي',
            'Dead clicks: بيضغط على إشي مش قابل للضغط أصلاً',
            'عمق السكرول: وين بالضبط بيوقفوا يقرأوا',
            'رجّة الماوس: علامة تشتّت أو انتظار',
            'وين بيوقفوا بالفورم: أي حقل بالضبط بيخلّيهم يمشوا',
          ],
          tools: ['Hotjar', 'Microsoft Clarity', 'تسجيلات الجلسات'],
        },
        {
          n: '03',
          q: 'شو بتغيّر؟',
          name: 'القرار',
          body: 'التحليل اللي ما بينتج قرار هو تقرير حلو وبس. آخر طبقة إنك تحوّل اللي شفته لتغيير محدّد، وتقيس هل التغيير نفع فعلاً. مش تحكم عليه بذوقك.',
          points: [
            'فرضية مكتوبة قبل التغيير مش بعده',
            'تغيير واحد بالمرة عشان تعرف مين اللي أثّر',
            'مقارنة قبل وبعد على نفس الفترة الزمنية',
            'لوحة واحدة بتقرأها إنت بدون ما أشرحها',
          ],
          tools: ['Looker Studio', 'GA4', 'Search Console'],
        },
      ],
      privacyTitle: 'وملاحظة عن الخصوصية',
      privacy:
        'التسجيلات بتصير مع إخفاء تلقائي للنصوص الحسّاسة والحقول. يعني ما بينحفظ اسم ولا رقم ولا بطاقة. وأي تتبّع بينركّب بيكون على حساباتك إنت وباسمك، والبيانات بتضل عندك.',
      cta: 'عندك أرقام وما بتعرف شو بتقول؟',
      ctaBtn: 'خلّينا نقرأها سوا',
    }
  : {
      kicker: 'Data',
      heading: 'Numbers tell you what happened. Not why.',
      lede: '"We had 5,000 visitors last month", and? The number alone does not tell you what to do tomorrow. The real work is seeing in three layers: what happened, why it happened, and what you change because of it. Each layer has its own tools.',
      layers: [
        {
          n: '01',
          q: 'What happened?',
          name: 'The numbers',
          body: 'The layer everyone stops at. Sessions, sources, pages, bounce rate. Useful, but it describes the past without explaining it. The biggest mistake here is measuring pageviews instead of events: a visit is not a result, an action is.',
          points: [
            'Events built on real actions, not pages',
            'Conversion paths and exactly where people drop',
            'Audiences split by behaviour, not by country',
            'Attribution: last source and everything that assisted',
          ],
          tools: ['GA4', 'Google Tag Manager', 'Looker Studio'],
        },
        {
          n: '02',
          q: 'Why did it happen?',
          name: 'Behaviour',
          body: 'Here you see the screen through the visitor’s eyes. Heatmaps show where attention landed and where scrolling stopped; session recordings show the moment someone gave up. These signals never appear in a numbers report.',
          points: [
            'Rage clicks: clicking again and again because nothing happened',
            'Dead clicks: clicking something that was never clickable',
            'Scroll depth: exactly where reading stops',
            'Cursor thrashing: a sign of confusion or waiting',
            'Form drop-off: the specific field that loses people',
          ],
          tools: ['Hotjar', 'Microsoft Clarity', 'Session recordings'],
        },
        {
          n: '03',
          q: 'What do you change?',
          name: 'The decision',
          body: 'Analysis that produces no decision is just a nice report. The last layer is turning what you saw into one specific change, then measuring whether it actually worked instead of judging it by taste.',
          points: [
            'A hypothesis written before the change, not after',
            'One change at a time so you know what moved',
            'Before and after compared over the same window',
            'One dashboard you can read without me explaining it',
          ],
          tools: ['Looker Studio', 'GA4', 'Search Console'],
        },
      ],
      privacyTitle: 'And a note on privacy',
      privacy:
        'Recordings run with automatic masking of sensitive text and form fields. No names, no numbers, no card details are stored. Any tracking I set up sits on your properties in your name, and the data stays with you.',
      cta: 'Have numbers and cannot tell what they say?',
      ctaBtn: 'Let us read them together',
    };

const contactHref = isAr ? '/ar/#contact' : '/#contact';
---

<section class="data" id={id}>
  <div class="container">
    <div class="head">
      <p class="kicker" data-reveal>{t.kicker}</p>
      <h2 data-reveal>{t.heading}</h2>
      <p class="lede" data-reveal>{t.lede}</p>
    </div>

    <div class="grid" data-stagger>
      {
        t.layers.map((l) => (
          <article class="card frame">
            <span class="n" aria-hidden="true">{l.n}</span>
            <p class="q">{l.q}</p>
            <h3>{l.name}</h3>
            <p class="body">{l.body}</p>
            <ul class="points">
              {l.points.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
            <div class="tools">
              {l.tools.map((tool) => (
                <span class="tool">{tool}</span>
              ))}
            </div>
          </article>
        ))
      }
    </div>

    <div class="foot" data-reveal>
      <div class="privacy">
        <p class="privacy-title">{t.privacyTitle}</p>
        <p class="privacy-body">{t.privacy}</p>
      </div>
      <div class="cta">
        <p>{t.cta}</p>
        <a class="btn btn-primary" href={contactHref}>{t.ctaBtn}</a>
      </div>
    </div>
  </div>
</section>

<style>
  /* 🎛️ لوحة التحكم */
  .data {
    padding-block: var(--section-gap);
  }

  .kicker {
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 10px;
  }

  h2 {
    font-size: clamp(28px, 4.4vw, 56px);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  html[lang='ar'] h2 {
    font-weight: 800;
    letter-spacing: 0;
  }

  .lede {
    margin-top: 14px;
    color: var(--muted);
    font-size: 16.5px;
    line-height: 1.85;
    max-width: 64ch;
  }

  .head {
    margin-bottom: clamp(30px, 5vh, 52px);
  }

  /* ─── البطاقات الثلاث ─── */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(14px, 1.8vw, 22px);
    align-items: start;
  }

  .card {
    padding: clamp(20px, 2.4vw, 30px);
  }

  .n {
    display: block;
    font-family: var(--font-en);
    font-size: 12.5px;
    font-weight: 700;
    color: color-mix(in srgb, var(--accent) 65%, transparent);
  }

  /* السؤال هو بطل البطاقة — أكبر من الاسم عن قصد */
  .q {
    margin-top: 12px;
    font-size: clamp(19px, 2.2vw, 25px);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  html[lang='ar'] .q {
    font-weight: 800;
    letter-spacing: 0;
  }

  h3 {
    margin-top: 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
  }

  .body {
    margin-top: 14px;
    color: var(--muted);
    font-size: 14.5px;
    line-height: 1.8;
  }

  .points {
    list-style: none;
    padding: 0;
    margin: 16px 0 0;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .points li {
    position: relative;
    padding-inline-start: 16px;
    font-size: 14px;
    line-height: 1.65;
  }

  .points li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 0.62em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent) 70%, transparent);
  }

  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .tool {
    font-family: var(--font-en);
    font-size: 12px;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    padding: 4px 11px;
  }

  html[lang='ar'] .tool {
    font-family: var(--font-ar);
  }

  /* ─── الخاتمة ─── */
  .foot {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
    margin-top: clamp(28px, 4vh, 44px);
    padding-top: clamp(24px, 3.5vh, 36px);
    border-top: 1px solid var(--line);
  }

  .privacy-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 8px;
  }

  .privacy-body {
    color: var(--muted);
    font-size: 14.5px;
    line-height: 1.8;
  }

  .cta p {
    font-size: 16.5px;
    font-weight: 600;
    margin-bottom: 16px;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .foot {
      grid-template-columns: 1fr;
    }
  }
</style>
