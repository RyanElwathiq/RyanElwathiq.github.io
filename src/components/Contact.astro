---
// ═══════════════════════════════════════════════════════════════
//  تواصل معي — الختام: خلفية من مشهد العقدة المكتملة + كل الروابط
//  ⚠️ روابط CV / Drive / Notion / Behance بتيجي من work.json (links)
//     ممنوع حذفها — عدّلها من هناك إذا تغيّرت
// ═══════════════════════════════════════════════════════════════
import work from '../data/work.json';

interface Props {
  lang: 'en' | 'ar';
}

const { lang } = Astro.props;
const isAr = lang === 'ar';
const links = work.links;

const t = isAr
  ? {
      heading: 'خلينا نبني إشي بيكبر.',
      sub: 'متاح لفرص عن بعد وهجينة، تدريب أو توظيف: تسويق رقمي، نمو، محتوى، هوية، وإنتاج إبداعي.',
      brief: 'احكيلي عن مشروعك',
      email: 'راسلني',
      call: 'اتصل بي',
      resources: [
        { k: 'CV', label: 'حمّل سيرتي الذاتية', href: links.cv },
        { k: 'Drive', label: 'أرشيف ملفات المشاريع', href: links.driveArchive },
        { k: 'Notion', label: 'أرشيف نوشن', href: links.notion },
        { k: 'Behance', label: 'شغلي الإبداعي', href: links.behance },
      ],
    }
  : {
      heading: "Let's build something that grows.",
      sub: 'Open to remote, hybrid, internship, and job opportunities: digital marketing, growth, content, branding, and creative production.',
      brief: 'Tell me about your project',
      email: 'Email me',
      call: 'Call me',
      resources: [
        { k: 'CV', label: 'Download my CV', href: links.cv },
        { k: 'Drive', label: 'Project files archive', href: links.driveArchive },
        { k: 'Notion', label: 'Notion archive', href: links.notion },
        { k: 'Behance', label: 'Creative work', href: links.behance },
      ],
    };
---

<section class="contact" id="contact">
  <!-- الخلفية: آخر مشهد من فيديو العقدة (نفس هوية الهيرو)
       ⚠️ لازم نسختين: العريضة 16:9 للشاشات الكبيرة، والعمودية 9:16
          للموبايل. بدون هيك كانت الصورة العريضة تنزوّم بشكل بشع
          عشان تملا شاشة طويلة وضيّقة. -->
  <picture class="bg-wrap" aria-hidden="true">
    <source media="(max-width: 767px)" srcset="/frames/mobile/frame_0110.webp" />
    <img class="bg" src="/frames/desktop/frame_0110.webp" alt="" loading="lazy" width="1920" height="1080" />
  </picture>
  <div class="veil" aria-hidden="true"></div>

  <div class="container inner">
    <h2 data-reveal>{t.heading}</h2>
    <p class="sub" data-reveal>{t.sub}</p>

    <!-- ⚠️ الزر الأول بيودي على نموذج الطلب المفصّل، وباقي الطرق
         (إيميل، اتصال، لينكدإن) ضلّت زي ما هي، النموذج **إضافة**
         مش بديل، لأن في ناس بتفضّل تحكي مباشرة. -->
    <div class="actions" data-reveal>
      <a class="btn btn-primary" href={isAr ? '/ar/brief/' : '/brief/'}>{t.brief}</a>
      <a class="btn btn-ghost" href={`mailto:${links.email}`}>{t.email}</a>
      <a class="btn btn-ghost" href={`tel:${links.phone}`}>{t.call}</a>
      <a class="btn btn-ghost" href={links.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
    </div>

    <div class="resources" data-stagger>
      {
        t.resources.map((r) => (
          <a class="res" href={r.href} target="_blank" rel="noreferrer">
            <span class="k">{r.k}</span>
            <strong>{r.label}</strong>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* 🎛️ لوحة التحكم */
  .contact {
    --heading-size: clamp(34px, 5.6vw, 76px); /* حجم العنوان الكبير */
    --bg-opacity: 0.5; /* وضوح خلفية العقدة (0 = مخفية) */
    position: relative;
    margin-top: var(--section-gap);
    padding-block: clamp(96px, 14vh, 170px);
    overflow: clip;
  }

  .bg-wrap {
    position: absolute;
    inset: 0;
    display: block;
  }

  .bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: var(--bg-opacity);
  }

  .veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, var(--bg), rgba(14, 15, 18, 0.55) 30%, var(--bg));
  }

  .inner {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  h2 {
    font-size: var(--heading-size);
    font-weight: 700;
    letter-spacing: -0.025em;
    margin-bottom: 18px;
  }

  html[lang='ar'] h2 {
    font-weight: 800;
    letter-spacing: 0;
  }

  .sub {
    color: var(--muted);
    font-size: clamp(15px, 1.6vw, 18px);
    max-width: 52ch;
    margin: 0 auto 40px;
  }

  .actions {
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: clamp(48px, 7vh, 72px);
  }

  /* بطاقات الروابط (CV / Drive / Notion / Behance) */
  .resources {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    text-align: start;
  }

  .res {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px 24px;
    background: color-mix(in srgb, var(--surface) 80%, transparent);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    backdrop-filter: blur(8px);
    transition: border-color 0.35s var(--ease-out), transform 0.35s var(--ease-out);
  }

  .res:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
  }

  .res .k {
    font-family: var(--font-en);
    font-size: 12px;
    font-weight: 600;
    color: var(--accent);
  }

  .res strong {
    font-size: 15px;
  }

  @media (max-width: 767px) {
    .resources {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
