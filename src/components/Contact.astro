---
// ═══════════════════════════════════════════════════════════════
//  تواصل معي — الختام: خلفية من مشهد العقدة المكتملة + طرق الإقناع
//
//  ⚠️ إعادة تصميم 2026-08-03 بطلب ريّان (التوجه الجديد: موقع
//     أعمال مش بورتفوليو):
//     • زر «اتصل بي» انشال — رقمه ما بيظهر عالموقع.
//     • بطاقات CV / Drive / Notion انشالت نهائياً.
//     • البطاقات الجداد بتخدم البيع: الزائر اللي مش جاهز يتواصل
//       بياخد ثلاث طرق يتقنع فيها ويرجع (بكجات، مقالات، مختبر)
//       + Behance كدليل شغل.
//  ⚠️ external: true = بيفتح بتبويب جديد. الروابط الداخلية لأ —
//     التنقل الداخلي بيمرق من ClientRouter بدون إعادة تحميل.
// ═══════════════════════════════════════════════════════════════
import work from '../data/work.json';

interface Props {
  lang: 'en' | 'ar';
}

const { lang } = Astro.props;
const isAr = lang === 'ar';
const links = work.links;
const p = isAr ? '/ar' : '';

const t = isAr
  ? {
      heading: 'خلينا نبني إشي بيكبر.',
      sub: 'بشتغل مع مشاريع بدها تكبر صح: تشخيص قبل التنفيذ، وقرارات بالأرقام مش بالإحساس.',
      brief: 'احكيلي عن مشروعك',
      email: 'راسلني',
      resources: [
        { k: 'Packages', label: 'بكجات بتشتغل مع بعض', href: `${p}/services/#packs`, external: false },
        { k: 'Signals', label: 'مقالات بألعاب جوّاها', href: `${p}/signals/`, external: false },
        { k: 'Free', label: 'مختبر الأفكار: فكرة لمشروعك ببلاش', href: `${p}/#lab`, external: false },
        { k: 'Behance', label: 'شغلي الإبداعي', href: links.behance, external: true },
      ],
    }
  : {
      heading: "Let's build something that grows.",
      sub: 'I work with projects that want to grow properly: diagnosis before execution, and decisions by numbers, not feelings.',
      brief: 'Tell me about your project',
      email: 'Email me',
      resources: [
        { k: 'Packages', label: 'Packages that work as one', href: `${p}/services/#packs`, external: false },
        { k: 'Signals', label: 'Articles with games inside', href: `${p}/signals/`, external: false },
        { k: 'Free', label: 'The idea lab: a free idea for your project', href: `${p}/#lab`, external: false },
        { k: 'Behance', label: 'Creative work', href: links.behance, external: true },
      ],
    };
---

<section class="contact" id="contact">
  <!-- الخلفية: آخر مشهد من فيديو العقدة (نفس هوية الهيرو)
       ⚠️ لازم نسختين: العريضة 16:9 للشاشات الكبيرة، والعمودية 9:16
          للموبايل. بدون هيك كانت الصورة العريضة تنزوّم بشكل بشع
          عشان تملا شاشة طويلة وضيّقة. -->
  <picture class="bg-wrap" aria-hidden="true">
    <source media="(max-width: 767px)" srcset="/frames/mobile/frame_0110.webp" />
    <img class="bg" src="/frames/desktop/frame_0110.webp" alt="" loading="lazy" width="1920" height="1080" />
  </picture>
  <div class="veil" aria-hidden="true"></div>

  <div class="container inner">
    <h2 data-reveal>{t.heading}</h2>
    <p class="sub" data-reveal>{t.sub}</p>

    <!-- ⚠️ الزر الأول بيودي على نموذج الطلب المفصّل. زر الاتصال
         انشال بطلب ريّان (2026-08-03): رقمه ما بيظهر عالموقع. -->
    <div class="actions" data-reveal>
      <a class="btn btn-primary" href={isAr ? '/ar/brief/' : '/brief/'}>{t.brief}</a>
      <a class="btn btn-ghost" href={`mailto:${links.email}`}>{t.email}</a>
      <a class="btn btn-ghost" href={links.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
    </div>

    <div class="resources" data-stagger>
      {
        t.resources.map((r) =>
          r.external ? (
            <a class="res" href={r.href} target="_blank" rel="noreferrer">
              <span class="k">{r.k}</span>
              <strong>{r.label}</strong>
            </a>
          ) : (
            <a class="res" href={r.href}>
              <span class="k">{r.k}</span>
              <strong>{r.label}</strong>
            </a>
          ),
        )
      }
    </div>
  </div>
</section>

<style>
  /* 🎛️ لوحة التحكم */
  .contact {
    --heading-size: clamp(34px, 5.6vw, 76px); /* حجم العنوان الكبير */
    --bg-opacity: 0.5; /* وضوح خلفية العقدة (0 = مخفية) */
    position: relative;
    margin-top: var(--section-gap);
    padding-block: clamp(96px, 14vh, 170px);
    overflow: clip;
  }

  .bg-wrap {
    position: absolute;
    inset: 0;
    display: block;
  }

  .bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: var(--bg-opacity);
  }

  .veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, var(--bg), rgba(14, 15, 18, 0.55) 30%, var(--bg));
  }

  .inner {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  h2 {
    font-size: var(--heading-size);
    font-weight: 700;
    letter-spacing: -0.025em;
    margin-bottom: 18px;
  }

  html[lang='ar'] h2 {
    font-weight: 800;
    letter-spacing: 0;
  }

  .sub {
    color: var(--muted);
    font-size: clamp(15px, 1.6vw, 18px);
    max-width: 52ch;
    margin: 0 auto 40px;
  }

  .actions {
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: clamp(48px, 7vh, 72px);
  }

  /* بطاقات الروابط (CV / Drive / Notion / Behance) */
  .resources {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    text-align: start;
  }

  .res {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px 24px;
    background: color-mix(in srgb, var(--surface) 80%, transparent);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    backdrop-filter: blur(8px);
    transition: border-color 0.35s var(--ease-out), transform 0.35s var(--ease-out);
  }

  .res:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
  }

  .res .k {
    font-family: var(--font-en);
    font-size: 12px;
    font-weight: 600;
    color: var(--accent);
  }

  .res strong {
    font-size: 15px;
  }

  @media (max-width: 767px) {
    .resources {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
