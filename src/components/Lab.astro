---
// ═══════════════════════════════════════════════════════════════
//  «التجارب» — البدايات والمختبر
//
//  ⚠️⚠️ اقرأ هذا قبل ما تعدّل النصوص ⚠️⚠️
//  هذا القسم كان قرار صعب. ريّان قال بالحرف إنه خايف الشغل
//  المبكر «يخلّيه يبيّن ضعيف». والقرار المتّفق عليه: ما بنخبّيه،
//  بنأطّره. لأن إخفاء البدايات بيخلّي الباقي يبيّن حظ، وعرضها
//  بيخلّيه يبيّن مسار.
//
//  فالقسم مقسوم قسمين بيحكوا قصة وحدة:
//   • البدايات — شغل حقيقي بس بنطاق صغير: تصميم بلا استراتيجية
//   • المختبر  — شغل بيعمله لحاله اليوم بدون عميل ولا بريف
//  والمسافة بين الاثنين هي الرسالة. ما في وعود، في فرق بيتشاف.
//
//  ⚠️⚠️ التواريخ «مراحل» مش «سنوات» — وهذا مقصود ⚠️⚠️
//  ريّان ما بيتذكّر التواريخ بالضبط، كل اللي متأكّد منه إنه الشغل
//  بين ٢٠١٧ و٢٠٢٠. فالمدى حقيقي، والترتيب مبني على حكم بصري
//  بالتصاميم نفسها (شوف التفصيل بـ src/data/lab.json).
//  ولهيك مكتوب «٢٠١٧ – ٢٠١٨» مش «٢٠١٧»، وفي سطر تحت القسم
//  بيقول إنها تقريبية. حطّ رقم مزيّف على موقع بيبيع مصداقية غلط.
//  ✏️ لما يتذكّر ريّان، بينعدّل phase لكل مجموعة من lab.json.
//
//  ✏️ المحتوى كله من src/data/lab.json
// ═══════════════════════════════════════════════════════════════
import lab from '../data/lab.json';

interface Props {
  lang: 'en' | 'ar';
  id?: string;
}

const { lang, id = 'lab-work' } = Astro.props;
const isAr = lang === 'ar';

const t = isAr
  ? {
      kicker: 'التجارب',
      heading: 'شغل ما بحطّه بالواجهة. وما بخبّيه.',
      lede: 'أي حدا بيقدر يعرض أحسن ٥ أعمال إله ويبيّن ممتاز. اللي بيفرق فعلاً هو المسافة: من وين بلّشت، ووين صرت. هاي البدايات وهاي التجارب اللي بعملها لحالي اليوم، بدون عميل، بدون بريف، وبدون سبب غير إني بحب أجرّب.',
      tracks: [
        {
          key: 'start',
          name: 'البدايات',
          note: 'مشاريع حقيقية بنطاق صغير: محل تلفونات، فساتين أعراس، سبا. شغل تصميم بحت، بدون استراتيجية ولا أرقام ولا رأي بالمحتوى. هيك بلّشت وهيك بتبلّش.',
        },
        {
          key: 'lab',
          name: 'المختبر',
          note: 'تجارب بعملها اليوم لحالي: علامات وهمية، أساليب جديدة، ودمج الذكاء الاصطناعي بسير التصميم. ما إلها عميل وما إلها موعد تسليم، إلها هدف واحد إني ما أقف بمكاني.',
        },
      ],
      distance: 'المسافة',
      distanceNote:
        'نفس الشخص. الفرق مش بالبرامج. الفرق إني صرت أسأل «شو المشكلة» قبل ما أفتح فوتوشوب.',
      approx: 'المراحل تقريبية. الشغل بين ٢٠١٧ و٢٠٢٠، ومرتّب حسب تطوّر التصاميم نفسها.',
      cta: 'وهاد أحدث شغل',
      ctaHref: '#growth',
    }
  : {
      kicker: 'The lab',
      heading: 'Work I do not lead with, and do not hide.',
      lede: 'Anyone can show their best five pieces and look excellent. What actually tells you something is the distance: where it started and where it is now. These are the beginnings, and the experiments I still run on my own. No client, no brief, no reason beyond wanting to try something.',
      tracks: [
        {
          key: 'start',
          name: 'The beginnings',
          note: 'Real projects with a small scope: a phone shop, wedding dresses, a spa. Pure design work. No strategy, no numbers, no say in the content. This is how it started, and how it starts for everyone.',
        },
        {
          key: 'lab',
          name: 'The lab',
          note: 'Experiments I run today on my own: fictional brands, new techniques, and folding AI into the design pipeline. No client and no deadline. One purpose, which is not standing still.',
        },
      ],
      distance: 'The distance',
      distanceNote:
        'Same person. The difference is not the software. It is that I now ask what the problem is before I open Photoshop.',
      approx: 'Phases are approximate. The work spans 2017 to 2020, ordered by how the design itself developed.',
      cta: 'And here is the current work',
      ctaHref: '#growth',
    };

// المجموعات من lab.json، وكل وحدة بتاخد صورها من مانيفست الأعمال
const tracks = t.tracks.map((tr) => ({
  ...tr,
  groups: (lab.tracks as any)[tr.key].map((g: any) => ({
    ...g,
    label: isAr ? g.labelAr : g.label,
    phase: isAr ? g.phaseAr : g.phase,
    line: isAr ? g.lineAr : g.line,
    // ✏️ اختياري بـlab.json: `credit` / `creditAr`
    //    لما يكون الشغل بالتعاون مع حدا ثاني. ذكره بيقوّي الثقة
    //    مش بيضعّفها — بس بشرط تكون الصياغة واضحة مين عمل شو.
    credit: isAr ? g.creditAr : g.credit,
  })),
}));
---

<section class="lab" id={id}>
  <div class="container">
    <div class="head">
      <p class="kicker" data-reveal>{t.kicker}</p>
      <h2 data-reveal>{t.heading}</h2>
      <p class="lede" data-reveal>{t.lede}</p>
    </div>

    {
      tracks.map((tr) => (
        <div class={`track track-${tr.key}`}>
          <div class="track-head" data-reveal>
            <h3>{tr.name}</h3>
            <p>{tr.note}</p>
          </div>

          <div class="rows">
            {tr.groups.map((g: any) => (
              <article class="row" data-reveal>
                <div class="row-meta">
                  <h4>{g.label}</h4>
                  {g.phase && <span class="year">{g.phase}</span>}
                  <p>{g.line}</p>
                  {g.credit && <p class="credit">{g.credit}</p>}
                </div>
                <div class="shots">
                  {g.shots.map((src: string, i: number) => (
                    <figure class="frame">
                      <img
                        src={src}
                        alt={`${g.label}: ${i + 1}`}
                        loading="lazy"
                        decoding="async"
                        width="600"
                        height="600"
                      />
                    </figure>
                  ))}
                </div>
              </article>
            ))}
          </div>
        </div>
      ))
    }

    <!-- ═══ الخلاصة ═══ -->
    <div class="distance frame frame-on" data-reveal>
      <p class="distance-label">{t.distance}</p>
      <p class="distance-note">{t.distanceNote}</p>
      <a class="btn btn-primary" href={t.ctaHref}>{t.cta}</a>
      {/* ⚠️ ملاحظة مقصودة: ريّان ما بيتذكّر التواريخ بالضبط،
          فبنقول هيك بدل ما ندّعي دقّة مش موجودة */}
      <p class="approx">{t.approx}</p>
    </div>
  </div>
</section>

<style>
  /* 🎛️ لوحة التحكم */
  .lab {
    --gap: clamp(46px, 7vh, 84px);
    padding-block: var(--section-gap);
  }

  .kicker {
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 10px;
  }

  h2 {
    font-size: clamp(28px, 4vw, 52px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  html[lang='ar'] h2 {
    font-weight: 800;
    letter-spacing: 0;
  }

  .lede {
    margin-top: 14px;
    color: var(--muted);
    font-size: 16.5px;
    line-height: 1.85;
    max-width: 62ch;
  }

  .head {
    margin-bottom: var(--gap);
  }

  /* ─── المسار ─── */
  .track + .track {
    margin-top: var(--gap);
    padding-top: var(--gap);
    border-top: 1px solid var(--line);
  }

  .track-head {
    margin-bottom: clamp(22px, 3.5vh, 36px);
  }

  h3 {
    font-size: clamp(20px, 2.4vw, 28px);
    font-weight: 700;
    margin-bottom: 10px;
  }

  html[lang='ar'] h3 {
    font-weight: 800;
  }

  /* المختبر عنوانه ليموني — هو الحاضر، والبدايات هي الماضي */
  .track-lab h3 {
    color: var(--accent);
  }

  .track-head p {
    color: var(--muted);
    font-size: 15.5px;
    line-height: 1.8;
    max-width: 58ch;
  }

  /* ─── الصفوف ─── */
  .rows {
    display: flex;
    flex-direction: column;
    gap: clamp(26px, 4vh, 44px);
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 240px) minmax(0, 1fr);
    gap: clamp(18px, 3vw, 40px);
    align-items: start;
  }

  h4 {
    font-size: 16.5px;
    font-weight: 700;
  }

  .year {
    display: inline-block;
    margin-top: 6px;
    font-family: var(--font-en);
    font-size: 12px;
    font-weight: 600;
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 34%, transparent);
    border-radius: var(--r-pill);
    padding: 3px 10px;
  }

  .row-meta p {
    margin-top: 10px;
    color: var(--muted);
    font-size: 14.5px;
    line-height: 1.75;
  }

  /* ═══════════════════════════════════════════════════════
     كريدت التعاون

     ⚠️ مقصود إنه يبيّن، مش يتخبّى. ذكر إنه في متعاون بيقوّي
        الثقة — بس بحجم أصغر ولون أهدى، عشان يقرا كمعلومة
        عن الشغل مش كتنازل عنه.
     ═══════════════════════════════════════════════════════ */
  .credit {
    margin-top: 12px !important;
    padding-inline-start: 11px;
    border-inline-start: 2px solid color-mix(in srgb, var(--accent) 45%, transparent);
    font-size: 13px !important;
    line-height: 1.6 !important;
    opacity: 0.9;
  }

  /* ═══════════════════════════════════════════════════════
     أعمدة مش شبكة — نفس قاعدة صفحة LUV IT

     ⚠️ المشكلة اللي حلّتها: بشبكة CSS كل بطاقة بتتمدّد لارتفاع
        أطول بطاقة بالصف (`align-items: stretch` هو الافتراضي)،
        بس الصورة بتضل بنسبتها الطبيعية — فبيبين لون البطاقة
        الداكن تحت الصورة كفراغ أسود. القياس كان **٢٠٥px فراغ
        بأسوأ حالة، يعني ٥٥٪ من البطاقة**.

     بالأعمدة كل صورة بتاخد ارتفاعها الحقيقي والعمود بيتعبّى
     ورا بعض بدون فراغ، وبدون ما نقصّ ولا صورة.
     ═══════════════════════════════════════════════════════ */
  .shots {
    columns: 150px;
    column-gap: clamp(10px, 1.4vw, 16px);
  }

  /* ⚠️ ضرورية: بدونها الصورة بتنقسم بين عمودين */
  .shots .frame {
    break-inside: avoid;
    margin-bottom: clamp(10px, 1.4vw, 16px);
  }

  /* ═══════════════════════════════════════════════════════
     ⚠️ البدايات مطفية شوي وبتضوّي لما تمرّ عليها.
        مش عشان نخبّيها، عشان العين تعرف شو الأساسي وشو
        السياق. المختبر بيبيّن بكامل وضوحه من أول لحظة.
     ═══════════════════════════════════════════════════════ */
  .track-start .shots img {
    opacity: 0.62;
    filter: saturate(0.75);
    transition:
      opacity 0.45s var(--ease-out),
      filter 0.45s var(--ease-out);
  }

  .track-start .frame:hover img,
  .track-start .frame.lit img {
    opacity: 1;
    filter: none;
  }

  /* ─── الخلاصة ─── */
  .distance {
    margin-top: var(--gap);
    padding: clamp(24px, 4vw, 48px);
  }

  .distance-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 10px;
  }

  .distance-note {
    font-size: clamp(18px, 2.4vw, 27px);
    font-weight: 700;
    line-height: 1.45;
    max-width: 48ch;
    letter-spacing: -0.015em;
  }

  html[lang='ar'] .distance-note {
    font-weight: 800;
    letter-spacing: 0;
  }

  .distance .btn {
    margin-top: 22px;
  }

  .approx {
    margin-top: 18px;
    font-size: 13px;
    color: var(--muted);
    opacity: 0.85;
  }

  @media (max-width: 820px) {
    .row {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .shots {
      columns: 3;
    }
  }
</style>
