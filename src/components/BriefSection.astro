---
// ═══════════════════════════════════════════════════════════════
//  الغلاف حول نموذج الطلب
//
//  ✏️ الاستعمال:
//     <BriefSection lang="ar" />          ← بالصفحة الرئيسية
//     <BriefSection lang="ar" eager />    ← بالصفحة المخصصة
//
//  ⚠️ نفس النموذج بالضبط بالمكانين — ملف واحد، فأي تعديل
//     بيظهر بالاثنين. والأزرار اللي بتودي لصفحة /brief/ ضلّت
//     شغالة زي ما هي.
// ═══════════════════════════════════════════════════════════════
import Brief from './Brief.jsx';
import work from '../data/work.json';

interface Props {
  lang: 'en' | 'ar';
  id?: string;
  eager?: boolean;
  bare?: boolean;
  h1?: boolean; // بالصفحة المخصّصة بس — العنوان بيصير h1
  // معرّف خدمة بتنختار تلقائياً — بتستخدمها صفحات /services/
  preselect?: string;
}

const { lang, id = 'brief', eager = false, bare = false, h1 = false, preselect = '' } = Astro.props;
const { email, phone } = work.links;
const whatsapp = `https://wa.me/${phone.replace(/[^0-9]/g, '')}`;
const props = { lang, email, whatsapp, asH1: h1, preselect };
---

{
  bare ? (
    eager ? <Brief client:load {...props} /> : <Brief client:visible {...props} />
  ) : (
    <section class="brief-section" id={id}>
      <div class="container">
        {eager ? <Brief client:load {...props} /> : <Brief client:visible {...props} />}
      </div>
    </section>
  )
}

<style>
  .brief-section {
    padding-block: clamp(64px, 10vh, 120px);
    /* ⚠️ ما في خط فاصل فوق عن قصد. كان موجود، بس بما إنه بعده
       ١٢٠ بكسل فراغ قبل المحتوى، كان الخط يبين معلّق لحاله تحت
       الأسئلة الشائعة وكأنه غلطة. الفراغ لحاله بيفصل الأقسام. */
  }
</style>
