---
// ═══════════════════════════════════════════════════════════════
//  «عين البراند» — لعبة بتشرح مبادئ الهوية بالتجربة
//
//  الفكرة: بكل جولة بتشوف نفس التصميم بنسختين — وحدة مضبوطة
//  ووحدة فيها خلل واحد بس. بتختار الأقوى قبل ما يخلص الوقت،
//  وبعدها بتقرأ ليش.
//
//  ⚠️⚠️ التصاميم مش مرسومة بالإيد ⚠️⚠️
//  في **نموذج واحد** بيتغيّر بمتغيّرات CSS. النسخة المضبوطة
//  بتاخد القيم الافتراضية، والضعيفة بتكسر قيمة وحدة. لهيك
//  نقدر نضيف أسئلة بدون ما نلمس CSS ولا HTML — بس نضيف
//  أرقام بملف src/data/brand-eye.js.
//  وهاد كمان اللي بيخلّي محرّك الذكاء الاصطناعي يقدر يولّد
//  أسئلة جديدة: هو ما بيعرف CSS، بس بيعرف يكتب نص ويضبط أرقام.
//
//  ⚠️ مكتوبة بجافاسكربت عادي مش React — عمداً. صفحات المشاريع
//     ما بتحمّل React، وإضافتها لأجل لعبة كانت بتزيد ~٤٠ كيلوبايت
//     على كل زائر من الأردن.
//
//  ✏️ بدك تضيف سؤال؟ src/data/brand-eye.js — ولا تلمس هذا الملف
//  ✏️ عدد الأسئلة والوقت؟ نفس الملف (ROUNDS_PER_GAME / SECONDS)
// ═══════════════════════════════════════════════════════════════
import { BANK, DEFAULTS, ROUNDS_PER_GAME, SECONDS_PER_ROUND } from '../data/brand-eye.js';

interface Props {
  lang: 'en' | 'ar';
  compact?: boolean;
  href?: string;
}

const { lang, compact = false, href } = Astro.props;
const isAr = lang === 'ar';
const bank = BANK[lang];

const t = isAr
  ? {
      eyebrow: 'لعبة قصيرة',
      title: 'عين البراند',
      lede: 'عشر جولات، وكل مرة أسئلة غير. بكل جولة نفس التصميم بنسختين والفرق بينهم مبدأ واحد. عندك ١٥ ثانية تختار الأقوى.',
      compactLede:
        'عشر جولات بتشرح ليش تصميم بيشتغل وتصميم لأ، والأسئلة بتتغيّر كل مرة. عندك ١٥ ثانية لكل وحدة.',
      start: 'ابدأ اللعب',
      coverTitle: 'قدّيش عينك بتشوف؟',
      rules: ['١٠ جولات، نسختين من نفس التصميم', 'الفرق بينهم مبدأ واحد بس', '١٥ ثانية لكل جولة'],
      next: 'الجولة الجاية',
      again: 'العب من جديد',
      round: 'جولة',
      of: 'من',
      right: 'صح',
      wrong: 'مش هاي',
      timeout: 'خلص الوقت',
      streak: 'متتالية',
      brief: 'خلّينا نشتغل على علامتك',
      seeApplied: 'شوف المبادئ مطبّقة على مشروع حقيقي',
      scores: [
        'عينك لسا عم تتدرّب. وهاد طبيعي، هاي القواعد بتتعلّم مش بتنولد.',
        'عينك بتشوف نص القصة. المبادئ اللي فاتتك هي غالباً اللي بتفرّق بالنتيجة.',
        'عينك مضبوطة. بتعرف تميّز الشغل المبني عن الشغل الحلو بس.',
        'عين محترف. هاي بالضبط الأسئلة اللي ببدأ فيها أي هوية.',
      ],
      scoreLine: 'جاوبت صح على',
      bestStreak: 'أطول متتالية',
    }
  : {
      eyebrow: 'Short game',
      title: 'The Brand Eye',
      lede: 'Ten rounds, different every time. Each shows the same design twice and one principle is all that separates them. You get 15 seconds to pick the stronger one.',
      compactLede:
        'Ten rounds on why one design works and another does not: new questions every time. Fifteen seconds each.',
      start: 'Start',
      coverTitle: 'How good is your eye?',
      rules: ['10 rounds. The same design twice', 'One principle separates them', '15 seconds each'],
      next: 'Next round',
      again: 'Play again',
      round: 'Round',
      of: 'of',
      right: 'Right',
      wrong: 'Not this one',
      timeout: 'Time up',
      streak: 'streak',
      brief: 'Let us work on your brand',
      seeApplied: 'See these principles on a real project',
      scores: [
        'Your eye is still training, and that is fine. These rules are learned, not born.',
        'Your eye catches half the story. The ones you missed are usually what decides the result.',
        'Your eye is calibrated. You can tell built work from merely pretty work.',
        'A professional eye. These are exactly the questions I open every identity with.',
      ],
      scoreLine: 'You got',
      bestStreak: 'Best streak',
    };

const mock = isAr
  ? {
      eyebrow: 'عناية بالبشرة',
      title: 'روتين التفتيح',
      body: 'فيتامين سي ونياسيناميد وبانثينول، ثلاث خطوات بتشتغل مع بعض، مش منتج واحد بيوعد بكل إشي.',
      ctas: ['اطلبيها الآن', 'شوف المكوّنات', 'تواصل معنا'],
    }
  : {
      eyebrow: 'Skincare',
      title: 'Brighten routine',
      body: 'Vitamin C, niacinamide and panthenol. Three steps that work together, not one product promising everything.',
      ctas: ['Shop now', 'See ingredients', 'Talk to us'],
    };
---

<section class={`bx ${compact ? 'bx-compact' : ''}`} id="brand-eye">
  <div class="container">
    <div class="bx-head" data-reveal>
      <p class="bx-eyebrow">{t.eyebrow}</p>
      <h2>{t.title}</h2>
      <p class="bx-lede">{compact ? t.compactLede : t.lede}</p>
    </div>

    <div class="bx-board frame frame-on" data-reveal data-brand-eye>
      <!-- ═══════════════════════════════════════════════════════
           شاشة البداية
           ⚠️ اللعبة ما بتشتغل لحالها أول ما توصلها بالسكرول.
              أول نسخة كانت تبلّش بمجرد ما تظهر، فالزائر بيوصل
              وقد يكون الوقت خلص وهو ما لعب أصلاً، وكمان الضغطة
              نفسها هي اللي بتخلّيه داخل باللعبة.
           ═══════════════════════════════════════════════════════ -->
      <div class="bx-cover" data-bx-cover>
        <p class="bx-cover-kicker">{t.eyebrow}</p>
        <p class="bx-cover-title">{t.coverTitle}</p>
        <ul class="bx-rules">
          {t.rules.map((r) => <li>{r}</li>)}
        </ul>
        <button type="button" class="btn btn-primary bx-start" data-bx-start>{t.start}</button>
      </div>

      <!-- شريط التقدّم + المؤقّت -->
      <div class="bx-bar">
        <div class="bx-dots" data-bx-dots></div>
        <div class="bx-meta">
          <span class="bx-streak" data-bx-streak hidden></span>
          <span class="bx-count" data-bx-count></span>
        </div>
      </div>
      <!-- ⚠️ عرض الشريط مربوط بمتغيّر واحد بيتحدّث بالجافاسكربت،
           فالمتصفح بيحرّكه على كرت الشاشة بدون ما يشغّل المعالج -->
      <div class="bx-timer" data-bx-timer><i></i></div>

      <p class="bx-q" data-bx-q></p>

      <div class="bx-options" data-bx-options>
        {
          [0, 1].map((i) => (
            <button type="button" class="bx-opt" data-bx-opt={i}>
              <span class="bx-mark" data-bx-mark aria-hidden="true" />
              <div class="bx-mock" data-bx-mock>
                <span class="m-orn" aria-hidden="true" />
                <span class="m-eyebrow">{mock.eyebrow}</span>
                <span class="m-title">{mock.title}</span>
                <span class="m-body">{mock.body}</span>
                <span class="m-ctas">
                  {mock.ctas.map((c, n) => (
                    <span class={`m-cta m-cta-${n + 1}`}>{c}</span>
                  ))}
                </span>
              </div>
            </button>
          ))
        }
      </div>

      <!-- الشرح بعد الاختيار -->
      <div class="bx-why" data-bx-why hidden>
        <p class="bx-verdict" data-bx-verdict></p>
        <p class="bx-name" data-bx-name></p>
        <p class="bx-text" data-bx-text></p>
        <button type="button" class="btn btn-primary bx-next" data-bx-next></button>
      </div>

      <!-- النتيجة -->
      <div class="bx-end" data-bx-end hidden>
        <p class="bx-score" data-bx-score></p>
        <p class="bx-best" data-bx-best></p>
        <p class="bx-verdict-final" data-bx-final></p>
        <div class="bx-end-actions">
          <button type="button" class="btn btn-ghost" data-bx-again>{t.again}</button>
          {
            compact && href ? (
              <a class="btn btn-primary" href={href}>
                {t.seeApplied}
              </a>
            ) : (
              <a class="btn btn-primary" href={`${isAr ? '/ar' : ''}/brief/`}>
                {t.brief}
              </a>
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script
  is:inline
  define:vars={{
    bank,
    DEFAULTS,
    perGame: ROUNDS_PER_GAME,
    seconds: SECONDS_PER_ROUND,
    labels: {
      round: t.round,
      of: t.of,
      right: t.right,
      wrong: t.wrong,
      timeout: t.timeout,
      streak: t.streak,
      next: t.next,
      scores: t.scores,
      scoreLine: t.scoreLine,
      bestStreak: t.bestStreak,
      locale: isAr ? 'ar-EG' : 'en-US',
    },
  }}
>
  // ═══════════════════════════════════════════════════════════
  //  محرّك اللعبة
  //  ⚠️ is:inline + define:vars: عشان النصوص والبنك يجوا من
  //     الأسترو مباشرة بدل ما نكرّرهم بالجافاسكربت
  //  ⚠️ بينشغّل مرة كل ما توصل الصفحة (astro:page-load) لأن
  //     الموقع بينتقل بين الصفحات بدون إعادة تحميل
  // ═══════════════════════════════════════════════════════════
  (function () {
    // 🤖 مكان توصيل الذكاء الاصطناعي:
    //    لما ينجهز الـ Worker، بيرجّع نفس شكل عناصر البنك بالضبط
    //    (principle / q / why / bad). لحد هديك اللحظة منستخدم
    //    البنك المحلّي — واللعبة بتشتغل بالحالتين بدون تغيير كود.
    var AI_ENDPOINT = null; // مثال لاحقاً: '/api/brand-eye'

    function pickRounds(n) {
      // خلط ثم قص — كل لعبة أسئلة مختلفة وبدون تكرار
      var pool = bank.slice();
      for (var i = pool.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var tmp = pool[i];
        pool[i] = pool[j];
        pool[j] = tmp;
      }
      // البنك أصغر من المطلوب؟ منكرّر بترتيب مختلف بدل ما نقصّ اللعبة
      while (pool.length < n) pool = pool.concat(pool);
      return pool.slice(0, n);
    }

    async function loadRounds(n) {
      if (!AI_ENDPOINT) return pickRounds(n);
      try {
        var res = await fetch(AI_ENDPOINT, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ count: n, locale: labels.locale }),
        });
        if (!res.ok) throw new Error('bad status');
        var data = await res.json();
        if (Array.isArray(data.rounds) && data.rounds.length) return data.rounds;
      } catch (e) {
        // المحرّك ما ردّ؟ اللعبة بتكمّل بالبنك المحلّي — ولا زائر بيلاحظ
      }
      return pickRounds(n);
    }

    // ألوان مسمّاة → متغيّرات هويتنا
    var COLORS = {
      accent: 'var(--accent)',
      text: 'var(--text)',
      muted: 'var(--muted)',
      faint: 'rgba(160,164,155,0.34)',
      pink: '#ff8fd0',
      blue: '#7ad6ff',
      gold: '#ffd166',
      violet: '#b57bff',
    };

    // بتحوّل المتغيّرات لستايل على النموذج
    function apply(el, vars) {
      var v = Object.assign({}, DEFAULTS, vars || {});
      var s = el.style;
      s.setProperty('--m-body-op', v.bodyOpacity);
      s.setProperty('--m-title', v.titleSize + 'px');
      s.setProperty('--m-body-size', v.bodySize + 'px');
      s.setProperty('--m-title-weight', v.titleWeight);
      s.setProperty('--m-body-weight', v.bodyWeight);
      s.setProperty('--m-pad', v.pad + 'px');
      s.setProperty('--m-gap', v.gap + 'px');
      s.setProperty('--m-r', v.radius + 'px');
      s.setProperty('--m-cta-r', v.ctaRadius + 'px');
      s.setProperty('--m-eyebrow-c', COLORS[v.eyebrowColor] || COLORS.accent);
      s.setProperty('--m-body-c', COLORS[v.bodyColor] || COLORS.muted);
      s.setProperty('--m-title-c', COLORS[v.titleColor] || COLORS.text);
      s.setProperty('--m-cta-c', COLORS[v.ctaColor] || COLORS.accent);
      s.setProperty('--m-tracking', v.tracking / 100 + 'em');
      s.setProperty('--m-align', v.align);
      s.setProperty('--m-maxw', v.maxWidth + 'ch');
      el.dataset.ctas = v.ctas;
      el.dataset.orn = v.ornament;
    }

    // ⚠️ querySelectorAll مش querySelector: اللعبة موجودة بالرئيسية
    //    وبصفحة المشروع، ولو ضل واحد بس بيشتغل بتبطل الثانية.
    function boot() {
      document.querySelectorAll('[data-brand-eye]').forEach(setup);
    }

    function setup(board) {
      if (board.dataset.ready === '1') return;
      board.dataset.ready = '1';

      var opts = board.querySelectorAll('[data-bx-opt]');
      var mocks = board.querySelectorAll('[data-bx-mock]');
      var marks = board.querySelectorAll('[data-bx-mark]');
      var qEl = board.querySelector('[data-bx-q]');
      var dots = board.querySelector('[data-bx-dots]');
      var count = board.querySelector('[data-bx-count]');
      var streakEl = board.querySelector('[data-bx-streak]');
      var timer = board.querySelector('[data-bx-timer]');
      var why = board.querySelector('[data-bx-why]');
      var verdict = board.querySelector('[data-bx-verdict]');
      var nameEl = board.querySelector('[data-bx-name]');
      var text = board.querySelector('[data-bx-text]');
      var nextBtn = board.querySelector('[data-bx-next]');
      var end = board.querySelector('[data-bx-end]');
      var scoreEl = board.querySelector('[data-bx-score]');
      var bestEl = board.querySelector('[data-bx-best]');
      var finalEl = board.querySelector('[data-bx-final]');
      var againBtn = board.querySelector('[data-bx-again]');
      var optWrap = board.querySelector('[data-bx-options]');
      var cover = board.querySelector('[data-bx-cover]');
      var startBtn = board.querySelector('[data-bx-start]');
      var bar = board.querySelector('.bx-bar');

      var rounds = [];
      var i = 0;
      var score = 0;
      var streak = 0;
      var best = 0;
      var goodSide = 0;
      var locked = true;
      var tick = 0;
      var left = 0;

      var n = function (v) {
        return v.toLocaleString(labels.locale);
      };

      function stopTimer() {
        if (tick) clearInterval(tick);
        tick = 0;
      }

      function startTimer() {
        stopTimer();
        left = seconds;
        timer.style.setProperty('--p', '1');
        timer.classList.remove('low');
        tick = setInterval(function () {
          left -= 0.1;
          var p = Math.max(0, left / seconds);
          timer.style.setProperty('--p', String(p));
          if (p < 0.28) timer.classList.add('low');
          if (left <= 0) {
            stopTimer();
            choose(-1); // خلص الوقت = جواب خاطئ، بس بيشرح المبدأ
          }
        }, 100);
      }

      function render() {
        var r = rounds[i];
        locked = false;
        // الجهة الصح بتتغيّر كل جولة — وإلا بتصير اللعبة حفظ مكان
        goodSide = Math.random() < 0.5 ? 0 : 1;

        qEl.textContent = r.q;
        count.textContent =
          labels.round + ' ' + n(i + 1) + ' ' + labels.of + ' ' + n(rounds.length);
        streakEl.hidden = streak < 2;
        streakEl.textContent = n(streak) + ' ' + labels.streak;

        for (var d = 0; d < dots.children.length; d++) {
          dots.children[d].className = d < i ? 'done' : d === i ? 'now' : '';
        }

        for (var s = 0; s < 2; s++) {
          // المضبوطة بالقيم الافتراضية، والثانية بالخلل
          apply(mocks[s], s === goodSide ? null : r.bad);
          marks[s].textContent = '';
          marks[s].className = 'bx-mark';
          opts[s].disabled = false;
          opts[s].className = 'bx-opt';
        }
        why.hidden = true;
        end.hidden = true;
        optWrap.hidden = false;
        qEl.hidden = false;
        timer.hidden = false;
        startTimer();
      }

      function choose(side) {
        if (locked) return;
        locked = true;
        stopTimer();
        var timedOut = side === -1;
        var ok = !timedOut && side === goodSide;

        if (ok) {
          score++;
          streak++;
          if (streak > best) best = streak;
        } else {
          streak = 0;
        }

        for (var s = 0; s < 2; s++) {
          opts[s].disabled = true;
          var isGood = s === goodSide;
          opts[s].className = 'bx-opt ' + (isGood ? 'is-good' : 'is-bad');
          marks[s].textContent = isGood ? '✓' : '✕';
          marks[s].className = 'bx-mark ' + (isGood ? 'good' : 'bad');
        }

        var r = rounds[i];
        verdict.textContent = ok ? labels.right : timedOut ? labels.timeout : labels.wrong;
        verdict.className = 'bx-verdict ' + (ok ? 'good' : 'bad');
        nameEl.textContent = r.principle;
        text.textContent = r.why;
        nextBtn.textContent = labels.next;
        why.hidden = false;
      }

      function next() {
        i++;
        if (i >= rounds.length) return finish();
        render();
      }

      function finish() {
        stopTimer();
        optWrap.hidden = true;
        qEl.hidden = true;
        why.hidden = true;
        timer.hidden = true;
        end.hidden = false;
        for (var d = 0; d < dots.children.length; d++) dots.children[d].className = 'done';
        count.textContent = '';
        streakEl.hidden = true;
        scoreEl.textContent = labels.scoreLine + ' ' + n(score) + '/' + n(rounds.length);
        bestEl.textContent = labels.bestStreak + ': ' + n(best);
        var pct = score / rounds.length;
        var band = pct < 0.3 ? 0 : pct < 0.6 ? 1 : pct < 0.85 ? 2 : 3;
        finalEl.textContent = labels.scores[band];
      }

      async function start() {
        stopTimer();
        cover.hidden = true;
        bar.hidden = false;
        rounds = await loadRounds(perGame);
        i = 0;
        score = 0;
        streak = 0;
        best = 0;
        dots.innerHTML = '';
        for (var d = 0; d < rounds.length; d++) dots.appendChild(document.createElement('span'));
        render();
      }

      for (var s = 0; s < 2; s++) {
        (function (k) {
          opts[k].addEventListener('click', function () {
            choose(k);
          });
        })(s);
      }
      nextBtn.addEventListener('click', next);
      againBtn.addEventListener('click', start);

      // ⚠️ ما في تشغيل تلقائي: اللعبة بتستنّى الزائر يضغط «ابدأ».
      //    الضغطة نفسها هي اللي بتخلّيه داخل باللعبة، وبتضمن إنه
      //    ما بيوصل والوقت خالص وهو ما لعب.
      startBtn.addEventListener('click', start);

      // الحالة الأولى: الغطا ظاهر وكل إشي ثاني مخفي
      cover.hidden = false;
      bar.hidden = true;
      timer.hidden = true;
      qEl.hidden = true;
      optWrap.hidden = true;
      why.hidden = true;
      end.hidden = true;

      // بنوقّف العدّاد لو الزائر غادر الصفحة أو طلع لتبويب ثاني
      document.addEventListener('astro:before-swap', stopTimer, { once: true });
      document.addEventListener('visibilitychange', function () {
        if (document.hidden) stopTimer();
      });
    }

    boot();
    document.addEventListener('astro:page-load', boot);
  })();
</script>

<style>
  /* ═══════════════ 🎛️ لوحة التحكم ═══════════════ */
  .bx {
    padding-block: var(--section-gap);
  }

  .bx-compact {
    padding-block: clamp(56px, 8vh, 96px);
  }

  .bx-eyebrow {
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 10px;
  }

  .bx h2 {
    font-size: clamp(28px, 4vw, 52px);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  html[lang='ar'] .bx h2 {
    font-weight: 800;
    letter-spacing: 0;
  }

  .bx-lede {
    margin-top: 12px;
    color: var(--muted);
    font-size: 16.5px;
    line-height: 1.8;
    max-width: 56ch;
  }

  .bx-head {
    margin-bottom: clamp(26px, 4vh, 40px);
  }

  /* ─── اللوح ─── */
  .bx-board {
    padding: clamp(20px, 3vw, 38px);
    /* ⚠️ الإطار بيقصّ المحتوى — هون بدنا المحتوى يتنفّس */
