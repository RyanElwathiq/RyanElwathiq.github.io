---
// ═══════════════════════════════════════════════════════════════
//  بطاقة عمل واحدة — بتنستخدم بكل أقسام الأعمال والصفحات الداخلية
//  • إذا للمشروع youtube → بيظهر زر تشغيل وبيفتح اللايت-بوكس
//  • إذا للمشروع url → بيظهر زر «زيارة الموقع»
// ═══════════════════════════════════════════════════════════════
interface Props {
  project: any;
  lang: 'en' | 'ar';
  // مستوى عنوان البطاقة.
  // ⚠️ ٣ بالأقسام (لأنه فوقها عنوان قسم h2)، و٢ بصفحات القوائم
  //    (لأنه فوقها عنوان الصفحة h1 مباشرة — والقفز h1→h3 بيكسر
  //    التسلسل، وقارئات الشاشة بتقول «في عنوان ناقص»).
  level?: 2 | 3;
  // ⚠️ الغلاف المولّد اسم العميل قاعد **أسفل الصورة**، فلازم شكل
  //    الصورة يطابق شكل الصندوق وإلا `object-fit:cover` بيقصّه.
  //    والشريط الأفقي (WorkStrip) بيبدّل شكل صندوقه حسب الشاشة:
  //    مربّع عالديسكتوب و16:11 عالموبايل (`--card-cover-ratio`).
  //    فمنمرّر `wide` هناك، وبتحت منخدم كل شاشة بصورتها بـ<picture>.
  wide?: boolean;
}

const { project: p, lang, level = 3, wide = false } = Astro.props;
const isAr = lang === 'ar';
const H = `h${level}` as 'h2' | 'h3';

// النسخة العريضة للموبايل بس، ولو المشروع لسا بلا غلاف مولّد
// بيرجع للمربّع بدل ما تنكسر الصورة
const coverWide = wide ? p.coverWide || p.cover : null;

const title = isAr ? p.titleAr : p.title;
const role = isAr ? p.roleAr : p.role;
const desc = isAr ? p.descAr : p.desc;

// رابط صفحة المشروع المستقلة (بتتولد تلقائياً من work.json)
const href = `${isAr ? '/ar' : ''}/work/${p.id}/`;
const more = isAr ? 'تفاصيل المشروع ←' : 'Project details →';
---

<article class="card">
  <a class="cover" href={href} aria-label={title}>
    <picture>
      {/* عالموبايل الصندوق بيصير 16:11 ← الغلاف العريض.
          نفس نقطة الكسر اللي بـWorkStrip بالضبط (767px) */}
      {coverWide && <source media="(max-width: 767px)" srcset={coverWide} />}
      <img src={p.cover} alt={title} loading="lazy" width="640" height="640" />
    </picture>
  </a>

  {
    p.youtube && (
      <button
        class="play"
        data-play={p.youtube}
        aria-label={isAr ? `شغّل فيديو ${title}` : `Play ${title} video`}
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M8 5.5v13l11-6.5z" />
        </svg>
      </button>
    )
  }

  <p class="role">{role}</p>
  <H><a href={href}>{title}</a></H>
  <p class="desc">{desc}</p>
  <a class="more" href={href}>{more}</a>

  {
    p.stats?.length > 0 && (
      <ul class="chips">
        {p.stats.map((s: any) => (
          <li>
            <strong>{s.value}</strong> {isAr ? s.labelAr : s.label}
          </li>
        ))}
      </ul>
    )
  }

  {
    p.url && (
      <a class="visit" href={p.url} target="_blank" rel="noreferrer">
        {isAr ? 'زيارة الموقع ↗' : 'Visit site ↗'}
      </a>
    )
  }
</article>

<style>
  /* 🎛️ لوحة التحكم */
  .card {
    --cover-radius: var(--r-card); /* زوايا صورة الغلاف */
    --hover-zoom: 1.05; /* قديش الصورة بتكبر عند المرور */
    --gap-cover-text: 18px; /* المسافة بين الصورة والنص */
  }

  .card {
    position: relative;
  }

  .cover {
    display: block;
    border-radius: var(--cover-radius);
    overflow: hidden;
    margin-bottom: var(--gap-cover-text);
    background: var(--surface);
  }

  /* <picture> عنصر inline بالافتراضي، فبيخلّي فراغ تحت الصورة */
  .cover picture {
    display: block;
  }

  .cover img {
    width: 100%;
    /* النسبة بتنورث من القسم اللي فوق (مثلاً الشريط بيغيّرها عالموبايل) */
    aspect-ratio: var(--card-cover-ratio, 1);
    object-fit: cover;
    transition: transform 0.7s var(--ease-out);
  }

  .card:hover .cover img {
    transform: scale(var(--hover-zoom));
  }

  /* زر التشغيل */
  .play {
    position: absolute;
    inset-inline-end: 14px;
    bottom: 14px;
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    border: none;
    border-radius: var(--r-pill);
    background: var(--accent);
    color: var(--accent-ink);
    transition: transform 0.35s var(--ease-out);
  }

  .play:hover {
    transform: scale(1.1);
  }

  .play:active {
    transform: scale(0.94);
  }

  .role {
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 6px;
  }

  h2,
  h3 {
    font-size: clamp(19px, 1.9vw, 23px);
    font-weight: 700;
    margin-bottom: 8px;
  }

  h2 a,
  h3 a {
    transition: color 0.3s var(--ease-out);
  }

  .card:hover h2 a,
  .card:hover h3 a {
    color: var(--accent);
  }

  .desc {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.65;
  }

  /* رابط «تفاصيل المشروع» */
  .more {
    display: inline-block;
    margin-top: 12px;
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
    transition: color 0.3s var(--ease-out);
  }

  .card:hover .more {
    color: var(--accent);
  }

  .chips {
    list-style: none;
    padding: 0;
    margin: 14px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chips li {
    font-size: 12.5px;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    padding: 6px 14px;
  }

  .chips strong {
    color: var(--text);
    font-family: var(--font-en);
  }

  .visit {
    display: inline-block;
    margin-top: 14px;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--accent);
  }
</style>
