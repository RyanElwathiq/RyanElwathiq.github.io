---
// ═══════════════════════════════════════════════════════════════
//  صفحة مشروع مستقلة (عربي) — بتتولد تلقائياً لكل مشروع
//  الرابط بيصير: /ar/work/معرّف-المشروع/
//  (نفس الشرح الموجود بملف src/pages/work/[id].astro)
// ═══════════════════════════════════════════════════════════════
import ProjectPage from '../../../layouts/ProjectPage.astro';
import work from '../../../data/work.json';

export function getStaticPaths() {
  // نفس الاستثناء اللي بالنسخة الإنجليزية — شوف الشرح هناك
  // ⚠️ لازم يكون **جوّا** الدالة: أسترو بيرفع getStaticPaths لبرّا
  //    الصفحة، فأي متغيّر مكتوب فوق ما بيشوفه (BESPOKE is not defined)
  const BESPOKE = ['luvit'];

  return work.projects
    .filter((p) => !BESPOKE.includes(p.id))
    .map((p) => ({
      params: { id: p.id },
      props: { project: p },
    }));
}

const { project } = Astro.props;
---

<ProjectPage project={project} lang="ar" />
