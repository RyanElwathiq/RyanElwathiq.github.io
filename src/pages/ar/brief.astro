---
// ═══════════════════════════════════════════════════════════════
//  صفحة «احكيلي عن مشروعك» — النسخة العربية
//  (النسخة الإنجليزية: src/pages/brief.astro)
//
//  ⚠️ هاي **إضافة** لطرق التواصل مش بديل عنها. قسم «تواصل»
//     بالصفحة الرئيسية بكل روابطه ضل زي ما هو.
//
//  ✏️ النموذج نفسه: src/components/Brief.jsx
// ═══════════════════════════════════════════════════════════════
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import BriefSection from '../../components/BriefSection.astro';




---

<Base
  title="احكيلي عن مشروعك | ريّان الواثق"
  description="ابدأ مشروعك: احكيلي شو بتحتاج وعن مشروعك، وبرجعلك خلال ٢٤–٤٨ ساعة برأي واضح ومن وين نبدأ."
  lang="ar"
>
  <Nav lang="ar" />

  <main id="top" class="page">
    <div class="container">
      <a class="back" href="/ar/#contact">→ رجوع</a>
      <BriefSection lang="ar" eager bare h1 />
    </div>
  </main>

  <Footer lang="ar" />
</Base>

<style>
  .page {
    padding-top: 118px; /* تحت شريط الإشارة وكبسولة التنقل */
    padding-bottom: var(--section-gap);
  }

  .back {
    display: inline-block;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: clamp(20px, 4vh, 40px);
    transition: color 0.3s var(--ease-out);
  }

  .back:hover {
    color: var(--accent);
  }
</style>
