---
// ═══════════════════════════════════════════════════════════════
//  الصفحة الرئيسية — النسخة العربية (RTL)
//
//  ✏️ ترتيب الأقسام = ترتيب السطور تحت. بدك تقدّم قسم؟ حرّك سطره
//  ✏️ كم عمل يظهر بالهوم؟ غيّر HOME_LIMIT تحت مباشرة
// ═══════════════════════════════════════════════════════════════
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Hero from '../../components/Hero.astro';
import Stats from '../../components/Stats.astro';
import About from '../../components/About.astro';
import WorkStrip from '../../components/WorkStrip.astro';
import CaseRows from '../../components/CaseRows.astro';
import DesignsGrid from '../../components/DesignsGrid.astro';
import Websites from '../../components/Websites.astro';
import Skills from '../../components/Skills.astro';
import Pricing from '../../components/Pricing.astro';
import Education from '../../components/Education.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import Lightbox from '../../components/Lightbox.astro';
import work from '../../data/work.json';

const HOME_LIMIT = 4; // كم عمل يظهر بالهوم من كل قسم

const byCat = (c: string) =>
  work.projects.filter((p) => p.category === c).sort((a, b) => a.order - b.order);
const forHome = (c: string) => byCat(c).slice(0, HOME_LIMIT);
---

<Base
  title="ريّان الواثق | تسويق رقمي ونمو"
  description="بورتفوليو ريّان الواثق: تسويق رقمي، نمو، SEO، إدارة علاقات العملاء، إعلانات مدفوعة، استراتيجية إبداعية، هوية بصرية، ومونتاج فيديو."
  lang="ar"
>
  <Nav lang="ar" />

  <main id="top">
    <Hero lang="ar" />
    <Stats lang="ar" />
    <About lang="ar" />

    <!-- الفيديوهات: سحب أفقي مع السكرول عالديسكتوب -->
    <WorkStrip
      lang="ar"
      projects={forHome('video')}
      heading="شغل الفيديو"
      allHref="/ar/videos/"
      allLabel="كل الفيديوهات"
      id="work"
      pan={true}
    />

    <CaseRows
      lang="ar"
      projects={forHome('marketing')}
      heading="قصص نمو"
      allHref="/ar/marketing/"
      allLabel="كل شغل التسويق"
    />

    <DesignsGrid
      lang="ar"
      projects={forHome('design')}
      heading="شغل التصميم"
      allHref="/ar/designs/"
      allLabel="كل التصاميم"
    />

    <Websites
      lang="ar"
      projects={byCat('website')}
      heading="المواقع"
      allHref="/ar/websites/"
      allLabel="كل المواقع"
    />

    <Skills lang="ar" />
    <Pricing lang="ar" />
    <Education lang="ar" />
    <Contact lang="ar" />
  </main>

  <Footer lang="ar" />
  <Lightbox lang="ar" />
</Base>
