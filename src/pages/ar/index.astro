---
// ═══════════════════════════════════════════════════════════════
//  الصفحة الرئيسية — النسخة العربية (RTL)
//
//  ✏️ ترتيب الأقسام = ترتيب السطور تحت. بدك تقدّم قسم؟ حرّك سطره
//  ✏️ كم عمل يظهر بالهوم؟ غيّر HOME_LIMIT تحت مباشرة
// ═══════════════════════════════════════════════════════════════
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Hero from '../../components/Hero.astro';
import Stats from '../../components/Stats.astro';
import About from '../../components/About.astro';
import WorkStrip from '../../components/WorkStrip.astro';
import CaseRows from '../../components/CaseRows.astro';
import DesignsGrid from '../../components/DesignsGrid.astro';
import Websites from '../../components/Websites.astro';
import Skills from '../../components/Skills.astro';
import KnotSection from '../../components/KnotSection.astro';
import LossSection from '../../components/LossSection.astro';
import Pricing from '../../components/Pricing.astro';
import BudgetSection from '../../components/BudgetSection.astro';
import LampLab from '../../components/LampLab.astro';
import Faq from '../../components/Faq.astro';
import BriefSection from '../../components/BriefSection.astro';
import Signals from '../../components/Signals.astro';
import Education from '../../components/Education.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import Lightbox from '../../components/Lightbox.astro';
import BrandEyeSection from '../../components/BrandEyeSection.astro';
import Particles from '../../components/Particles.astro';
// 🎛️ منطق «شو يظهر بالهوم» كله بملف واحد مشروح: src/utils/work.js
//    (الترتيب، العدد، والتحكم اليدوي بحقل "home" بملف work.json)
import { forHome, hasMore } from '../../utils/work.js';

// ✏️ علامات شريط الإشارة فوق — كل علامة بتنقل لقسمها
const marks = [
  { id: 'about', label: 'من أنا' },
  { id: 'work', label: 'فيديو' },
  { id: 'growth', label: 'نمو' },
  { id: 'designs', label: 'تصميم' },
  { id: 'websites', label: 'مواقع' },
  { id: 'knot', label: 'ثلاثي الأبعاد' },
  { id: 'loss', label: 'الخسارة' },
  { id: 'pricing', label: 'كيف بشتغل' },
  { id: 'budget', label: 'الميزانية' },
  { id: 'lab', label: 'مختبر الأفكار' },
  { id: 'brand-eye', label: 'عين البراند' },
  { id: 'signals', label: 'إشارات' },
  { id: 'faq', label: 'أسئلة' },
  { id: 'brief', label: 'ابدأ' },
  { id: 'contact', label: 'تواصل' },
];
---

<Base
  title="ريّان الواثق | تسويق رقمي ونمو"
  description="بورتفوليو ريّان الواثق: تسويق رقمي، نمو، SEO، إدارة علاقات العملاء، إعلانات مدفوعة، استراتيجية إبداعية، هوية بصرية، ومونتاج فيديو."
  lang="ar"
  sections={marks}
>
  <Nav lang="ar" />

  <main id="top">
    <Hero lang="ar" />
    <Stats lang="ar" />
    <About lang="ar" />

    <!-- الفيديوهات: سحب أفقي مع السكرول عالديسكتوب -->
    <WorkStrip
      lang="ar"
      projects={forHome('video')}
      heading="شغل الفيديو"
      allHref="/ar/videos/"
      allLabel="كل الفيديوهات"
      id="work"
      pan={true}
      showAll={hasMore('video')}
    />

    <CaseRows
      lang="ar"
      projects={forHome('marketing')}
      heading="قصص نمو"
      allHref="/ar/marketing/"
      allLabel="كل شغل التسويق"
      id="growth"
      showAll={hasMore('marketing', 2)}
    />

    <DesignsGrid
      lang="ar"
      projects={forHome('design')}
      heading="شغل التصميم"
      allHref="/ar/designs/"
      allLabel="كل التصاميم"
      id="designs"
      showAll={hasMore('design')}
    />

    <Websites
      lang="ar"
      projects={forHome('website')}
      heading="المواقع"
      allHref="/ar/websites/"
      allLabel="كل المواقع"
      showAll={hasMore('website')}
    />

    <Skills lang="ar" />
    <!-- العقدة ثلاثية الأبعاد: إثبات عملي بعد قائمة المهارات -->
    <KnotSection lang="ar" id="knot" />
    <!-- «قديش عم تخسر بدون موقع؟» — قبل الأسعار عن قصد: الزائر بيشوف
         حجم المشكلة الأول، وبعدها بيشوف قديش بتكلّف. الكاملة على /ar/loss/ -->
    <LossSection lang="ar" id="loss" />
    <Pricing lang="ar" />
    <!-- لعبة الميزانية: نسخة مختصرة هون، والكاملة على /ar/budget/ -->
    <BudgetSection lang="ar" id="budget" compact />
    <LampLab lang="ar" id="lab" />
    <!-- «عين البراند»: لمحة بس — اللعبة الكاملة بصفحة LUV IT -->
    <BrandEyeSection lang="ar" compact href="/ar/work/luvit/#brand-eye" />
    <Signals lang="ar" id="signals" />
    <Education lang="ar" />
    <!-- ⚠️ قاعدة ثابتة: الأسئلة الشائعة دايماً آخر قسم قبل التواصل -->
    <Faq lang="ar" id="faq" />
    <!-- نموذج الطلب: نفس نموذج صفحة /ar/brief/ بالضبط -->
    <BriefSection lang="ar" id="brief" />
    <Contact lang="ar" />
    <!-- الاسم المتفتّت — آخر إشي قبل التذييل.
         ⚠️ مرة وحدة بالموقع كله عن قصد، والاسم بالإنجليزي دايماً -->
    <Particles />
  </main>

  <Footer lang="ar" />
  <Lightbox lang="ar" />
</Base>
