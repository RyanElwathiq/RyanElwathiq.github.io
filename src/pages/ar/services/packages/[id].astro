---
// صفحات البكجات (عربي) — /ar/services/packages/launch|growth|system/
import PackagePage from '../../../../layouts/PackagePage.astro';
import servicesData from '../../../../data/services.json';

export async function getStaticPaths() {
  return (servicesData as any).packages.ar.items.map((pk: any) => ({ params: { id: pk.id } }));
}

const { id } = Astro.params;
---

<PackagePage lang="ar" packId={id as any} />
