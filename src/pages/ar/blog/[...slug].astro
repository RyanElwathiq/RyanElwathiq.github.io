---
// ═══════════════════════════════════════════════════════════════
//  تحويل مقالات الرابط القديم: /ar/blog/اسم-المقال/ → /ar/signals/…
//  (اقرأ الشرح بملف src/pages/blog/index.astro)
// ═══════════════════════════════════════════════════════════════
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((p) => p.data.lang === 'ar')
    .map((p) => ({ params: { slug: p.id } }));
}

const { slug } = Astro.params;
const target = `/ar/signals/${slug}/`;
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={`https://ryanalali.me${target}`} />
    <meta name="robots" content="noindex" />
    <title>إشارات</title>
    <script is:inline define:vars={{ target }}>
      location.replace(target);
    </script>
  </head>
  <body>
    <a href={target}>إشارات</a>
  </body>
</html>
