---
// ═══════════════════════════════════════════════════════════════
//  تحويل: /ar/blog/  →  /ar/signals/
//  (اقرأ الشرح بملف src/pages/blog/index.astro)
// ═══════════════════════════════════════════════════════════════
const target = '/ar/signals/';
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={`https://ryanalali.me${target}`} />
    <meta name="robots" content="noindex" />
    <title>إشارات</title>
    <script is:inline define:vars={{ target }}>
      location.replace(target);
    </script>
  </head>
  <body>
    <a href={target}>إشارات</a>
  </body>
</html>
