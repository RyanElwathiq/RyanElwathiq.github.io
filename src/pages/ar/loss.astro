---
// ═══════════════════════════════════════════════════════════════
//  صفحة «حاسبة الخسارة» — النسخة العربية
//  (النسخة الإنجليزية: src/pages/loss.astro)
//
//  💡 هاي الصفحة مصمّمة تكون **صفحة هبوط لإعلانات جوجل**:
//     الزائر بيجي من إعلان، بيحسب خسارته، وبيتواصل. لهيك ما
//     حطّينا فيها إشي بيشتّت — لا أقسام ولا أعمال، بس الحاسبة.
//
//  ✏️ الحاسبة نفسها: src/components/LossCalc.jsx
//  ✏️ الأرقام: src/data/loss.js
// ═══════════════════════════════════════════════════════════════
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import LossSection from '../../components/LossSection.astro';

const t = {
  back: '→ رجوع للرئيسية',
  readTitle: 'بدك تفهم الموضوع كامل؟',
  readBody:
    'كتبت مقال بيشرح ليش الموقع صار ضرورة مش رفاهية، وليش الاعتماد على السوشال لحاله بيبني مشروعك على أرض مستأجرة.',
  readBtn: 'اقرأ المقال',
};
---

<Base
  title="حاسبة الخسارة | قديش عم تخسر بدون موقع؟"
  description="احسب قديش عم يخسر مشروعك كل شهر بدون موقع إلكتروني: عملاء بحثوا وما لقوك، ناس ما وثقت، واستفسارات جت بوقت ما بتردّ فيه."
  lang="ar"
>
  <Nav lang="ar" />

  <main id="top" class="page">
    <div class="container">
      <a class="back" href="/ar/">{t.back}</a>
    </div>

    <LossSection lang="ar" id="loss" eager />

    <!-- ═══ وصلة للمقال ═══ -->
    <section class="read">
      <div class="container">
        <h2 data-reveal>{t.readTitle}</h2>
        <p data-reveal>{t.readBody}</p>
        <a class="btn btn-ghost" href="/ar/signals/ar-limatha-almawqi3-daroura/" data-reveal>
          {t.readBtn}
        </a>
      </div>
    </section>
  </main>

  <Footer lang="ar" />
</Base>

<style>
  .page {
    padding-top: 118px; /* تحت شريط الإشارة وكبسولة التنقل */
  }

  .back {
    display: inline-block;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--muted);
    transition: color 0.3s var(--ease-out);
  }

  .back:hover {
    color: var(--accent);
  }

  .read {
    padding-block: clamp(40px, 6vh, 70px) var(--section-gap);
    border-top: 1px solid var(--line);
  }

  .read h2 {
    font-size: clamp(22px, 3vw, 34px);
    font-weight: 800;
    margin-bottom: 12px;
  }

  .read p {
    color: var(--muted);
    font-size: clamp(15px, 1.6vw, 18px);
    line-height: 1.75;
    max-width: 58ch;
    margin-bottom: 24px;
  }
</style>
