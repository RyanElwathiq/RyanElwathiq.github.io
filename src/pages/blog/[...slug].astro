---
// ═══════════════════════════════════════════════════════════════
//  تحويل مقالات الرابط القديم:  /blog/اسم-المقال/ → /signals/اسم-المقال/
//  (اقرأ الشرح بملف index.astro اللي جنبه)
// ═══════════════════════════════════════════════════════════════
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((p) => p.data.lang === 'en')
    .map((p) => ({ params: { slug: p.id } }));
}

const { slug } = Astro.params;
const target = `/signals/${slug}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={`https://ryanalali.me${target}`} />
    <meta name="robots" content="noindex" />
    <title>Signals</title>
    <script is:inline define:vars={{ target }}>
      location.replace(target);
    </script>
  </head>
  <body>
    <a href={target}>Signals</a>
  </body>
</html>
