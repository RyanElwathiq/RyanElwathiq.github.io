---
// ═══════════════════════════════════════════════════════════════
//  الصفحة الرئيسية — النسخة الإنجليزية
//
//  ✏️ ترتيب الأقسام = ترتيب السطور تحت. بدك تقدّم قسم؟ حرّك سطره
//  ✏️ كم عمل يظهر بالهوم؟ غيّر HOME_LIMIT تحت مباشرة
// ═══════════════════════════════════════════════════════════════
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import About from '../components/About.astro';
import WorkStrip from '../components/WorkStrip.astro';
import CaseRows from '../components/CaseRows.astro';
import DesignsGrid from '../components/DesignsGrid.astro';
import Websites from '../components/Websites.astro';
import Skills from '../components/Skills.astro';
import KnotSection from '../components/KnotSection.astro';
import LossSection from '../components/LossSection.astro';
import Pricing from '../components/Pricing.astro';
import BudgetSection from '../components/BudgetSection.astro';
import LampLab from '../components/LampLab.astro';
import Faq from '../components/Faq.astro';
import BriefSection from '../components/BriefSection.astro';
import Signals from '../components/Signals.astro';
import Education from '../components/Education.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import BrandEyeSection from '../components/BrandEyeSection.astro';
import Particles from '../components/Particles.astro';
import Lab from '../components/Lab.astro';
import Seo from '../components/Seo.astro';
import Data from '../components/Data.astro';
// 🎛️ منطق «شو يظهر بالهوم» كله بملف واحد مشروح: src/utils/work.js
//    (الترتيب، العدد، والتحكم اليدوي بحقل "home" بملف work.json)
import { forHome, hasMore } from '../utils/work.js';

// ✏️ علامات شريط الإشارة فوق — كل علامة بتنقل لقسمها
const marks = [
  { id: 'loss', label: 'Loss' },
  { id: 'brand-eye', label: 'Brand Eye' },
  { id: 'about', label: 'About' },
  { id: 'seo', label: 'SEO' },
  { id: 'data', label: 'Data' },
  { id: 'knot', label: '3D' },
  { id: 'budget', label: 'Budget' },
  { id: 'lab', label: 'Idea lab' },
  { id: 'growth', label: 'Growth' },
  { id: 'work', label: 'Video' },
  { id: 'designs', label: 'Design' },
  { id: 'websites', label: 'Web' },
  { id: 'lab-work', label: 'The lab' },
  { id: 'signals', label: 'Signals' },
  { id: 'pricing', label: 'How I work' },
  { id: 'faq', label: 'FAQ' },
  { id: 'brief', label: 'Start' },
  { id: 'contact', label: 'Contact' },
];
---

<Base
  title="Rayan Elwathiq | Digital Marketing & Growth"
  description="Rayan Elwathiq portfolio: digital marketing, growth, SEO, CRM, paid media, creative strategy, branding, and video editing."
  lang="en"
  sections={marks}
>
  <Nav lang="en" />

  <main id="top">
    <Hero lang="en" />
    <Stats lang="en" />

    <!-- ══════════════ ١) المشكلة ══════════════
         الزائر لازم يعرف إنه عنده مشكلة قبل ما نعرض عليه حل.
         «قدّيش عم تخسر» بتحوّل الغياب لرقم، و«عين البراند»
         بتخلّيه يجرّب بعينه ليش تصميم بينجح وتصميم لأ. -->
    <LossSection lang="en" id="loss" />
    <BrandEyeSection lang="en" compact href="/work/luvit/#brand-eye" />

    <!-- ══════════════ ٢) كيف بفكّر ══════════════
         مين أنا، وشو بعرف، وكيف بفكّر بالميزانية وبالأفكار.
         هون بينبني السبب اللي بيخلّي الشغل الجاي مقنع. -->
    <About lang="en" />
    <Skills lang="en" />
    <Seo lang="en" id="seo" />
    <Data lang="en" id="data" />
    <KnotSection lang="en" id="knot" />
    <!-- لعبة الميزانية: نسخة مختصرة هون، والكاملة على /budget/ -->
    <BudgetSection lang="en" id="budget" compact />
    <LampLab lang="en" id="lab" />

    <!-- ══════════════ ٣) الإثبات ══════════════
         قصص النمو أول — لأنها الوحيدة اللي فيها أرقام.
         وبعدها الشغل كله، وبالآخر التجارب اللي بتبيّن المسار. -->
    <CaseRows
      lang="en"
      projects={forHome('marketing')}
      heading="Growth stories"
      allHref="/marketing/"
      allLabel="All growth work"
      id="growth"
      showAll={hasMore('marketing', 2)}
    />
    <!-- الفيديوهات: سحب أفقي مع السكرول عالديسكتوب -->
    <WorkStrip
      lang="en"
      projects={forHome('video')}
      heading="Video work"
      allHref="/videos/"
      allLabel="All videos"
      id="work"
      pan={true}
      showAll={hasMore('video')}
    />
    <DesignsGrid
      lang="en"
      projects={forHome('design')}
      heading="Design work"
      allHref="/designs/"
      allLabel="All designs"
      id="designs"
      showAll={hasMore('design')}
    />
    <Websites
      lang="en"
      projects={forHome('website')}
      heading="Websites"
      allHref="/websites/"
      allLabel="All websites"
      showAll={hasMore('website')}
    />
    <!-- التجارب: البدايات والمختبر — آخر الإثبات، لأنها بتقول
         «شوف المسافة» بعد ما شاف النتيجة -->
    <Lab lang="en" id="lab-work" />
    <Signals lang="en" id="signals" />
    <Education lang="en" />

    <!-- ══════════════ ٤) القرار ══════════════
         بعد ما شاف المشكلة والتفكير والإثبات: كيف بشتغل،
         وشو أسئلته، وكيف يبدأ.
         ⚠️ قاعدة ثابتة: الأسئلة الشائعة دايماً قبل التواصل. -->
    <Pricing lang="en" />
    <Faq lang="en" id="faq" />
    <!-- نموذج الطلب: نفس نموذج صفحة /brief/ بالضبط -->
    <BriefSection lang="en" id="brief" />
    <Contact lang="en" />
    <!-- الاسم المتفتّت — آخر إشي قبل التذييل.
         ⚠️ مرة وحدة بالموقع كله عن قصد: الحركة قوية ولو تكرّرت
            بتفقد أثرها وبتثقّل الصفحة -->
    <Particles />
  </main>

  <Footer lang="en" />
  <Lightbox lang="en" />
</Base>
