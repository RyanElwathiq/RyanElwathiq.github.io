---
// ═══════════════════════════════════════════════════════════════
//  الصفحة الرئيسية — النسخة الإنجليزية
//
//  ✏️ ترتيب الأقسام = ترتيب السطور تحت. بدك تقدّم قسم؟ حرّك سطره
//  ✏️ كم عمل يظهر بالهوم؟ غيّر HOME_LIMIT تحت مباشرة
// ═══════════════════════════════════════════════════════════════
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import About from '../components/About.astro';
import WorkStrip from '../components/WorkStrip.astro';
import CaseRows from '../components/CaseRows.astro';
import DesignsGrid from '../components/DesignsGrid.astro';
import Websites from '../components/Websites.astro';
import Skills from '../components/Skills.astro';
import Pricing from '../components/Pricing.astro';
import Education from '../components/Education.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import work from '../data/work.json';

// ┌──────────────────────────────────────────────────────────┐
// │ 🎛️ كم عمل يظهر بالصفحة الرئيسية من كل قسم               │
// │    الباقي بينحط تلقائياً بصفحة القسم («كل التصاميم»...)  │
// └──────────────────────────────────────────────────────────┘
const HOME_LIMIT = 4;

// بيرجع أعمال قسم معيّن مرتبة، وبياخد أول HOME_LIMIT منها
const byCat = (c: string) =>
  work.projects.filter((p) => p.category === c).sort((a, b) => a.order - b.order);
const forHome = (c: string) => byCat(c).slice(0, HOME_LIMIT);
---

<Base
  title="Rayan Elwathiq | Digital Marketing & Growth"
  description="Rayan Elwathiq portfolio: digital marketing, growth, SEO, CRM, paid media, creative strategy, branding, and video editing."
  lang="en"
>
  <Nav lang="en" />

  <main id="top">
    <Hero lang="en" />
    <Stats lang="en" />
    <About lang="en" />

    <!-- الفيديوهات: سحب أفقي مع السكرول عالديسكتوب -->
    <WorkStrip
      lang="en"
      projects={forHome('video')}
      heading="Video work"
      allHref="/videos/"
      allLabel="All videos"
      id="work"
      pan={true}
    />

    <CaseRows
      lang="en"
      projects={forHome('marketing')}
      heading="Growth stories"
      allHref="/marketing/"
      allLabel="All growth work"
    />

    <DesignsGrid
      lang="en"
      projects={forHome('design')}
      heading="Design work"
      allHref="/designs/"
      allLabel="All designs"
    />

    <Websites
      lang="en"
      projects={byCat('website')}
      heading="Websites"
      allHref="/websites/"
      allLabel="All websites"
    />

    <Skills lang="en" />
    <Pricing lang="en" />
    <Education lang="en" />
    <Contact lang="en" />
  </main>

  <Footer lang="en" />
  <Lightbox lang="en" />
</Base>
