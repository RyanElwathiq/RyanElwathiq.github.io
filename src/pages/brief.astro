---
// ═══════════════════════════════════════════════════════════════
//  صفحة «احكيلي عن مشروعك» — النسخة الإنجليزية
//  (النسخة العربية: src/pages/ar/brief.astro)
//
//  ⚠️ هاي **إضافة** لطرق التواصل مش بديل عنها.
//  ✏️ النموذج نفسه: src/components/Brief.jsx
// ═══════════════════════════════════════════════════════════════
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Brief from '../components/Brief.jsx';
import work from '../data/work.json';

const { email, phone } = work.links;
const whatsapp = `https://wa.me/${phone.replace(/[^0-9]/g, '')}`;
---

<Base
  title="Tell me about your project | Rayan Elwathiq"
  description="Start a project: tell me what you need and about your business, and I get back to you within 24–48 hours with a clear opinion and where to start."
  lang="en"
>
  <Nav lang="en" />

  <main id="top" class="page">
    <div class="container">
      <a class="back" href="/#contact">← Back</a>
      <Brief client:load lang="en" email={email} whatsapp={whatsapp} />
    </div>
  </main>

  <Footer lang="en" />
</Base>

<style>
  .page {
    padding-top: 118px; /* تحت شريط الإشارة وكبسولة التنقل */
    padding-bottom: var(--section-gap);
  }

  .back {
    display: inline-block;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: clamp(20px, 4vh, 40px);
    transition: color 0.3s var(--ease-out);
  }

  .back:hover {
    color: var(--accent);
  }
</style>
