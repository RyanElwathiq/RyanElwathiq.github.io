---
// ═══════════════════════════════════════════════════════════════
//  قالب المقال الواحد
//  • فيديو المقال بيكون بالأعلى كهيرو (بيمسك القارئ من أول لحظة)
//  • العنوان فوق الفيديو، وبيرتفع ويذوب مع سكرولك
//  • بعده المقال، وبآخره صندوق دعوة للتواصل
//
//  ✏️ عشان تضيف فيديو لمقال: حط  film: '/frames/اسم-المجلد/'
//     بأول ملف المقال. بدون هالسطر بيظهر عنوان عادي بدون فيديو.
// ═══════════════════════════════════════════════════════════════
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  post: any;
}

const { post } = Astro.props;
const { title, description, date, lang, tags, film, alt } = post.data;
const isAr = lang === 'ar';

// ⚠️ اسم ملف المقال بيختلف بين العربي والإنجليزي، فتبديل اللغة
//    لازم يعرف اسم الملف المقابل. بنقرأه من حقل alt بأول المقال.
//    إذا ما كان موجود، بيرجّعك لقائمة المقالات باللغة الثانية.
const switchTo = alt
  ? isAr
    ? `/blog/${alt}/`
    : `/ar/blog/${alt}/`
  : isAr
    ? '/blog/'
    : '/ar/blog/';

const fmt = date.toLocaleDateString(isAr ? 'ar-EG' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// وقت القراءة التقريبي (200 كلمة بالدقيقة)
const words = post.body?.trim().split(/\s+/).length || 0;
const minutes = Math.max(1, Math.round(words / 200));

const t = isAr
  ? {
      back: '→ كل المقالات',
      read: `${minutes} دقائق قراءة`,
      ctaTitle: 'عندك مشروع وبدك تبدأ صح؟',
      ctaBody: 'احكيلي عن وضعك وبساعدك تحدد أول خطوة تستاهل وقتك ومصاريفك.',
      ctaBtn: 'احكيلي',
      more: 'كل المقالات',
    }
  : {
      back: '← All articles',
      read: `${minutes} min read`,
      ctaTitle: 'Have a project and want to start right?',
      ctaBody: 'Tell me about your situation and I will help you work out the first step worth your time and budget.',
      ctaBtn: 'Get in touch',
      more: 'All articles',
    };

const blogHref = isAr ? '/ar/blog/' : '/blog/';
const contactHref = isAr ? '/ar/#contact' : '/#contact';
---

<Base title={`${title} | ${isAr ? 'ريّان الواثق' : 'Rayan Elwathiq'}`} description={description} lang={lang}>
  <Nav lang={lang} switchTo={switchTo} />

  <main id="top" class="post">
    <!-- ═══════════ الترويسة السينمائية ═══════════
         إذا في فيديو: بيتثبّت والعنوان فوقه وبيتحرك مع السكرول
         إذا ما في: ترويسة عادية بسيطة -->
    {
      film ? (
        <!-- data-seq-pin-always: بيتثبّت على كل الأجهزة.
             ⚠️ ضروري هون لأن الفيديو بأعلى الصفحة تماماً. بدون
                تثبيت، رحلة السكرول بتخلص قبل ما الزائر يبدأ ينزل،
                فالفيديو كان يطلع ثابت عالموبايل. وهاي الصفحة فيها
                فيديو واحد بس، فما في خطر تداخل تثبيتات. -->
        <header class="film" data-seq data-seq-pin-always data-seq-length="1.2" data-seq-desktop={film}>
          <div class="film-sticky" data-seq-sticky>
            <canvas aria-hidden="true"></canvas>
            <div class="film-veil" aria-hidden="true" />

            <div class="container film-copy" data-seq-intro>
              <a class="back" href={blogHref}>{t.back}</a>
              <div class="meta">
                <time datetime={date.toISOString()}>{fmt}</time>
                <span class="dot" aria-hidden="true" />
                <span>{t.read}</span>
              </div>
              <h1>{title}</h1>
              <p class="lede">{description}</p>
            </div>
          </div>
        </header>
      ) : (
        <header class="plain container">
          <a class="back" href={blogHref}>{t.back}</a>
          <div class="meta">
            <time datetime={date.toISOString()}>{fmt}</time>
            <span class="dot" aria-hidden="true" />
            <span>{t.read}</span>
          </div>
          <h1>{title}</h1>
          <p class="lede">{description}</p>
        </header>
      )
    }

    <article class="container">
      {
        tags.length > 0 && (
          <ul class="tags" data-reveal>
            {tags.map((tag: string) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }

      <div class="body">
        <slot />
      </div>

      <!-- ═══ دعوة للتواصل بآخر المقال ═══ -->
      <aside class="cta" data-reveal>
        <div>
          <h2>{t.ctaTitle}</h2>
          <p>{t.ctaBody}</p>
        </div>
        <div class="cta-actions">
          <a class="btn btn-primary" href={contactHref}>{t.ctaBtn}</a>
          <a class="btn btn-ghost" href={blogHref}>{t.more}</a>
        </div>
      </aside>
    </article>
  </main>

  <Footer lang={lang} />
</Base>

<style>
  /* ╔═══════════════ 🎛️ لوحة التحكم ═══════════════╗ */
  .post {
    --title-size: clamp(30px, 4.6vw, 62px); /* حجم عنوان المقال */
    --text-size: clamp(16px, 1.7vw, 19px); /* حجم نص المقال */
    --text-line-gap: 1.85; /* تباعد أسطر النص */
    --content-width: 68ch; /* أقصى عرض للنص (مهم للقراءة) */
    --film-scrim: 0; /* ⬛ التعتيم العام فوق الفيديو (0 = بدون) */
    --text-scrim: 0.66; /* ⬛ تعتيم موضعي خلف عنوان المقال فقط */
    --text-scrim-width: 66%;
  }

  /* ─── الترويسة السينمائية ─── */
  .film-sticky {
    position: relative;
    height: 100dvh;
    display: flex;
    align-items: center;
    overflow: clip;
  }

  .film canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .film-veil {
    position: absolute;
    inset: 0;
    background:
      /* وصل بصري بالأسفل (مش تعتيم) */
      linear-gradient(to top, var(--bg), transparent 18%),
      /* تعتيم موضعي خلف النص فقط */
        linear-gradient(
          to var(--text-side, right),
          rgba(14, 15, 18, var(--text-scrim)) 0%,
          rgba(14, 15, 18, calc(var(--text-scrim) * 0.75)) 34%,
          transparent var(--text-scrim-width)
        ),
      /* تعتيم عام (صفر افتراضياً) */
        linear-gradient(
          to top,
          rgba(14, 15, 18, var(--film-scrim)),
          rgba(14, 15, 18, var(--film-scrim))
        );
  }

  html[dir='rtl'] .film-veil {
    --text-side: left;
  }

  .film-copy {
    position: relative;
    z-index: 1;
    padding-top: 120px; /* تحت شريط الإشارة وكبسولة التنقل */
  }

  /* ─── ترويسة بدون فيديو ─── */
  .plain {
    padding-top: calc(120px + clamp(26px, 4vh, 52px));
  }

  /* ─── عناصر مشتركة بين الترويستين ─── */
  .back {
    display: inline-block;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 22px;
    transition: color 0.3s var(--ease-out);
  }

  .back:hover {
    color: var(--accent);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-en);
    font-size: 13.5px;
    color: var(--accent);
    margin-bottom: 14px;
  }

  .dot {
    width: 4px;
    height: 4px;
    border-radius: var(--r-pill);
    background: currentColor;
    opacity: 0.6;
  }

  h1 {
    font-size: var(--title-size);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.1;
    margin-bottom: 18px;
    max-width: 22ch;
  }

  html[lang='ar'] h1 {
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.35;
  }

  .lede {
    color: var(--muted);
    font-size: clamp(16px, 1.8vw, 20px);
    line-height: 1.7;
    max-width: 56ch;
  }

  /* ─── الوسوم ─── */
  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0;
    margin: clamp(40px, 6vh, 64px) 0 0;
  }

  .tags li {
    font-size: 12.5px;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    padding: 6px 14px;
  }

  /* ─── نص المقال ─── */
  .body {
    max-width: var(--content-width);
    margin-top: clamp(28px, 4vh, 44px);
    padding-top: clamp(28px, 4vh, 44px);
    border-top: 1px solid var(--line);
    font-size: var(--text-size);
    line-height: var(--text-line-gap);
    color: var(--muted);
  }

  .body :global(h2) {
    font-size: clamp(22px, 2.4vw, 30px);
    font-weight: 700;
    color: var(--text);
    margin: 2em 0 0.6em;
    letter-spacing: -0.015em;
    /* خط ليموني صغير قبل كل عنوان فرعي */
    padding-inline-start: 16px;
    border-inline-start: 3px solid var(--accent);
  }

  html[lang='ar'] .body :global(h2) {
    letter-spacing: 0;
    font-weight: 800;
  }

  .body :global(h3) {
    font-size: clamp(18px, 2vw, 23px);
    font-weight: 700;
    color: var(--text);
    margin: 1.6em 0 0.5em;
  }

  .body :global(p) {
    margin-bottom: 1.3em;
  }

  .body :global(strong) {
    color: var(--text);
  }

  .body :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .body :global(ul),
  .body :global(ol) {
    margin: 0 0 1.5em;
    padding-inline-start: 1.4em;
  }

  .body :global(li) {
    margin-bottom: 0.6em;
  }

  .body :global(li::marker) {
    color: var(--accent);
  }

  /* الاقتباس: بطاقة بارزة بلون الهوية */
  .body :global(blockquote) {
    margin: 2em 0;
    padding: 22px 26px;
    border-inline-start: 3px solid var(--accent);
    border-radius: var(--r-card);
    background: var(--surface);
    color: var(--text);
    font-size: 1.05em;
  }

  .body :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .body :global(img) {
    border-radius: var(--r-card);
    margin: 1.8em 0;
  }

  .body :global(code) {
    font-size: 0.9em;
    background: var(--surface);
    border-radius: 5px;
    padding: 2px 7px;
  }

  /* ─── دعوة التواصل ─── */
  .cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(22px, 4vw, 48px);
    flex-wrap: wrap;
    max-width: var(--content-width);
    margin: clamp(48px, 7vh, 80px) 0 var(--section-gap);
    padding: clamp(26px, 3.4vw, 44px);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background: var(--surface);
  }

  .cta h2 {
    font-size: clamp(20px, 2.2vw, 27px);
    font-weight: 700;
    color: var(--text);
    margin-bottom: 10px;
  }

  .cta p {
    color: var(--muted);
    font-size: 15.5px;
    line-height: 1.7;
    max-width: 46ch;
  }

  .cta-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* ─── موبايل ─── */
  @media (max-width: 767px) {
    /* الفيديو مثبّت عالموبايل كمان، فبياخد شاشة كاملة
       بس بارتفاع أقل شوي عشان يبين إن في محتوى تحته */
    .film-sticky {
      height: 88dvh;
      padding-block: 20px;
    }

    .film-copy {
      padding-top: 74px;
    }

    .cta {
      flex-direction: column;
      align-items: stretch;
    }

    .cta-actions .btn {
      flex: 1;
      justify-content: center;
    }
  }
</style>
