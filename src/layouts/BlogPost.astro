---
// ═══════════════════════════════════════════════════════════════
//  قالب المقال الواحد
//  • فيديو المقال بيكون بالأعلى كهيرو (بيمسك القارئ من أول لحظة)
//  • العنوان فوق الفيديو، وبيرتفع ويذوب مع سكرولك
//  • بعده المقال، وبآخره صندوق دعوة للتواصل
//
//  ✏️ عشان تضيف فيديو لمقال: حط  film: '/frames/اسم-المجلد/'
//     بأول ملف المقال. بدون هالسطر بيظهر عنوان عادي بدون فيديو.
// ═══════════════════════════════════════════════════════════════
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  post: any;
}

const { post } = Astro.props;
const { title, seoTitle, description, date, lang, tags, film, alt } = post.data;
const isAr = lang === 'ar';

// ⚠️ اسم ملف المقال بيختلف بين العربي والإنجليزي، فتبديل اللغة
//    لازم يعرف اسم الملف المقابل. بنقرأه من حقل alt بأول المقال.
//    إذا ما كان موجود، بيرجّعك لقائمة المقالات باللغة الثانية.
const switchTo = alt
  ? isAr
    ? `/signals/${alt}/`
    : `/ar/signals/${alt}/`
  : isAr
    ? '/signals/'
    : '/ar/signals/';

const fmt = date.toLocaleDateString(isAr ? 'ar-EG' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// وقت القراءة التقريبي (200 كلمة بالدقيقة)
const words = post.body?.trim().split(/\s+/).length || 0;
const minutes = Math.max(1, Math.round(words / 200));

const t = isAr
  ? {
      back: '→ كل الإشارات',
      read: `${minutes} دقائق قراءة`,
      ctaTitle: 'عندك مشروع وبدك تبدأ صح؟',
      ctaBody: 'احكيلي عن وضعك وبساعدك تحدد أول خطوة تستاهل وقتك ومصاريفك.',
      ctaBtn: 'احكيلي',
      more: 'كل الإشارات',
      tocLabel: 'بهذا المقال',
    }
  : {
      back: '← All signals',
      read: `${minutes} min read`,
      ctaTitle: 'Have a project and want to start right?',
      ctaBody: 'Tell me about your situation and I will help you work out the first step worth your time and budget.',
      ctaBtn: 'Get in touch',
      more: 'All signals',
      tocLabel: 'In this article',
    };

const blogHref = isAr ? '/ar/signals/' : '/signals/';
const contactHref = isAr ? '/ar/#contact' : '/#contact';

// ═══ بيانات منظّمة للمقال ═══
//  BlogPosting بيخلّي المقال يطلع بنتائج جوجل بالتاريخ والكاتب،
//  و BreadcrumbList بيبدّل الرابط الطويل بمسار «الإشارات › المقال».
const home = 'https://ryanalali.me';
const here = `${home}${Astro.url.pathname}`;
const cover = post.data.cover ? `${home}${post.data.cover}` : `${home}/og.jpg`;

const articleSchema = [
  {
    '@type': 'BlogPosting',
    '@id': here + '#article',
    headline: title,
    description,
    image: cover,
    datePublished: date.toISOString().slice(0, 10),
    dateModified: date.toISOString().slice(0, 10),
    inLanguage: isAr ? 'ar-JO' : 'en',
    keywords: tags,
    wordCount: words,
    author: { '@id': home + '/#me' },
    publisher: { '@id': home + '/#me' },
    mainEntityOfPage: { '@id': here + '#page' },
  },
  {
    '@type': 'BreadcrumbList',
    '@id': here + '#crumbs',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: isAr ? 'الرئيسية' : 'Home', item: isAr ? home + '/ar/' : home + '/' },
      { '@type': 'ListItem', position: 2, name: isAr ? 'الإشارات' : 'Signals', item: home + blogHref },
      { '@type': 'ListItem', position: 3, name: title },
    ],
  },
];
---

<Base
  title={`${seoTitle || title} | ${isAr ? 'ريّان الواثق' : 'Rayan Elwathiq'}`}
  description={description}
  lang={lang}
  altUrl={alt ? switchTo : null}
  image={post.data.cover}
  schema={articleSchema}
>
  <Nav lang={lang} switchTo={switchTo} />

  <main id="top" class="post">
    <!-- ═══════════ الترويسة السينمائية ═══════════
         إذا في فيديو: بيتثبّت والعنوان فوقه وبيتحرك مع السكرول
         إذا ما في: ترويسة عادية بسيطة -->
    {
      film ? (
        <!-- data-seq-pin-always: بيتثبّت على كل الأجهزة.
             ⚠️ ضروري هون لأن الفيديو بأعلى الصفحة تماماً. بدون
                تثبيت، رحلة السكرول بتخلص قبل ما الزائر يبدأ ينزل،
                فالفيديو كان يطلع ثابت عالموبايل. وهاي الصفحة فيها
                فيديو واحد بس، فما في خطر تداخل تثبيتات. -->
        <header class="film" data-seq data-seq-pin-always data-seq-length="1.2" data-seq-desktop={film} data-seq-mobile={film + "mobile/"}>
          <div class="film-sticky" data-seq-sticky>
            <canvas aria-hidden="true"></canvas>
            <div class="film-veil" aria-hidden="true" />

            <div class="container film-copy" data-seq-intro>
              <a class="back" href={blogHref}>{t.back}</a>
              <div class="meta">
                <time datetime={date.toISOString()}>{fmt}</time>
                <span class="dot" aria-hidden="true" />
                <span>{t.read}</span>
              </div>
              <h1>{title}</h1>
              <p class="lede">{description}</p>
            </div>
          </div>
        </header>
      ) : (
        <header class="plain container">
          <a class="back" href={blogHref}>{t.back}</a>
          <div class="meta">
            <time datetime={date.toISOString()}>{fmt}</time>
            <span class="dot" aria-hidden="true" />
            <span>{t.read}</span>
          </div>
          <h1>{title}</h1>
          <p class="lede">{description}</p>
        </header>
      )
    }

    <article class="container">
      {
        tags.length > 0 && (
          <ul class="tags" data-reveal>
            {tags.map((tag: string) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }

      <!-- ═══════════════════════════════════════════════════════
           المقال + فهرس جانبي لاصق
           ⚠️ الفهرس بينبني بالجافاسكربت من عناوين المقال نفسه —
              يعني ما بتحتاج تكتبه بأي مقال، وما بينسى يتحدّث لما
              تعدّل العناوين.
           ⚠️ مخفي تحت ١٠٨٠ بكسل: بالشاشات الضيقة بياخد مساحة
              القراءة نفسها فبيضرّ أكثر ما بينفع.
           ═══════════════════════════════════════════════════════ -->
      <div class="layout">
        <nav class="toc" data-toc aria-label={t.tocLabel}>
          <p class="toc-title">{t.tocLabel}</p>
          <ol data-toc-list></ol>
        </nav>

        <div class="body" data-post-body>
          <slot />
        </div>
      </div>

      <!-- ═══ دعوة للتواصل بآخر المقال ═══ -->
      <aside class="cta" data-reveal>
        <div>
          <h2>{t.ctaTitle}</h2>
          <p>{t.ctaBody}</p>
        </div>
        <div class="cta-actions">
          <a class="btn btn-primary" href={contactHref}>{t.ctaBtn}</a>
          <a class="btn btn-ghost" href={blogHref}>{t.more}</a>
        </div>
      </aside>
    </article>
  </main>

  <Footer lang={lang} />
</Base>

<script>
  // ═══════════════════════════════════════════════════════════
  //  الفهرس الجانبي — بينبني من عناوين المقال نفسه
  //
  //  ⚠️ ليش بالجافاسكربت مش مكتوب بكل مقال؟ لأنه بيصير ينسى
  //     يتحدّث. أي عنوان بتضيفه أو بتغيّره بينعكس فوراً هون.
  //  ⚠️ العنوان اللي عم تقرأه بينضوّي — بـ IntersectionObserver
  //     مش بحساب مواقع مع كل حركة سكرول (أرخص بكثير للمعالج).
  // ═══════════════════════════════════════════════════════════
  function initToc() {
    const nav = document.querySelector('[data-toc]') as HTMLElement | null;
    const list = document.querySelector('[data-toc-list]');
    const body = document.querySelector('[data-post-body]');
    if (!nav || !list || !body) return;
    if (nav.dataset.ready === '1') return;
    nav.dataset.ready = '1';

    const heads = [...body.querySelectorAll('h2')] as HTMLElement[];
    // مقال قصير ما بيحتاج فهرس — بيصير حشو
    if (heads.length < 3) {
      nav.hidden = true;
      return;
    }

    const slug = (s: string) =>
      s
        .trim()
        .toLowerCase()
        .replace(/[^\p{L}\p{N}]+/gu, '-')
        .replace(/^-|-$/g, '');

    const links = new Map<string, HTMLAnchorElement>();
    heads.forEach((h, i) => {
      if (!h.id) h.id = slug(h.textContent || '') || 'h' + i;
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = '#' + h.id;
      a.textContent = (h.textContent || '').trim();
      li.appendChild(a);
      list.appendChild(li);
      links.set(h.id, a);
    });

    // ═══════════════════════════════════════════════════════
    //  إضاءة القسم الحالي
    //
    //  ⚠️⚠️ النسخة الأولى كانت غلط ⚠️⚠️
    //  كانت تضوّي العنوان **وهو ظاهر بالشاشة بس**. النتيجة اللي
    //  لاحظها ريّان: اللون بيتغيّر مع كل حركة سكرول، وبلحظات
    //  ما بيكون في ولا عنوان مضوّي أصلاً (لما تكون بنص فقرة
    //  طويلة وما في عنوان بالشاشة) — فالفهرس ما بيقول لك وين إنت.
    //
    //  الصح: **دايماً** في قسم واحد مضوّي، وهو آخر عنوان مرقت
    //  عليه. بيضل مضوّي لحد ما توصل اللي بعده. مؤشّر موقع ثابت،
    //  مش وميض.
    // ═══════════════════════════════════════════════════════
    let active: HTMLAnchorElement | null = null;

    const setActive = (a: HTMLAnchorElement | null) => {
      if (a === active) return; // ما منكتب إلا لما يتغيّر فعلاً
      active?.classList.remove('is-now');
      a?.classList.add('is-now');
      active = a;
    };

    const sync = () => {
      const line = 140; // تحت الشريط والكبسولة
      let current = heads[0];
      for (const h of heads) {
        if (h.getBoundingClientRect().top <= line) current = h;
        else break;
      }
      setActive(links.get(current.id) || null);
    };

    sync();
    window.addEventListener('scroll', sync, { passive: true });
    // السكرول الناعم بيرسل حدثه الخاص كمان
    (window as any).__lenis?.on?.('scroll', sync);
    document.addEventListener('astro:before-swap', () => window.removeEventListener('scroll', sync), {
      once: true,
    });
  }

  initToc();
  document.addEventListener('astro:page-load', initToc);
</script>

<style>
  /* ╔═══════════════ 🎛️ لوحة التحكم ═══════════════╗ */
  .post {
    --title-size: clamp(30px, 4.6vw, 62px); /* حجم عنوان المقال */
    --text-size: clamp(16px, 1.7vw, 19px); /* حجم نص المقال */
    --text-line-gap: 1.85; /* تباعد أسطر النص */
    --content-width: 68ch; /* أقصى عرض للنص (مهم للقراءة) */
    --film-scrim: 0; /* ⬛ التعتيم العام فوق الفيديو (0 = بدون) */
    --text-scrim: 0.66; /* ⬛ تعتيم موضعي خلف عنوان المقال فقط */
    --text-scrim-width: 66%;
  }

  /* ─── الترويسة السينمائية ─── */
  .film-sticky {
    position: relative;
    height: 100dvh;
    display: flex;
    align-items: center;
    overflow: clip;
  }

  .film canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .film-veil {
    position: absolute;
    inset: 0;
    background:
      /* وصل بصري بالأسفل (مش تعتيم) */
      linear-gradient(to top, var(--bg), transparent 18%),
      /* تعتيم موضعي خلف النص فقط */
        linear-gradient(
          to var(--text-side, right),
          rgba(14, 15, 18, var(--text-scrim)) 0%,
          rgba(14, 15, 18, calc(var(--text-scrim) * 0.75)) 34%,
          transparent var(--text-scrim-width)
        ),
      /* تعتيم عام (صفر افتراضياً) */
        linear-gradient(
          to top,
          rgba(14, 15, 18, var(--film-scrim)),
          rgba(14, 15, 18, var(--film-scrim))
        );
  }

  html[dir='rtl'] .film-veil {
    --text-side: left;
  }

  .film-copy {
    position: relative;
    z-index: 1;
    padding-top: 120px; /* تحت شريط الإشارة وكبسولة التنقل */
  }

  /* ─── ترويسة بدون فيديو ─── */
  .plain {
    padding-top: calc(120px + clamp(26px, 4vh, 52px));
  }

  /* ─── عناصر مشتركة بين الترويستين ─── */
  .back {
    display: inline-block;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 22px;
    transition: color 0.3s var(--ease-out);
  }

  .back:hover {
    color: var(--accent);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-en);
    font-size: 13.5px;
    color: var(--accent);
    margin-bottom: 14px;
  }

  .dot {
    width: 4px;
    height: 4px;
    border-radius: var(--r-pill);
    background: currentColor;
    opacity: 0.6;
  }

  h1 {
    font-size: var(--title-size);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.1;
    margin-bottom: 18px;
    max-width: 22ch;
  }

  html[lang='ar'] h1 {
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.35;
  }

  .lede {
    color: var(--muted);
    font-size: clamp(16px, 1.8vw, 20px);
    line-height: 1.7;
    max-width: 56ch;
  }

  /* ─── الوسوم ─── */
  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0;
    margin: clamp(40px, 6vh, 64px) 0 0;
  }

  .tags li {
    font-size: 12.5px;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    padding: 6px 14px;
  }

  /* ─── نص المقال ─── */
  .body {
    max-width: var(--content-width);
    margin-top: clamp(28px, 4vh, 44px);
    padding-top: clamp(28px, 4vh, 44px);
    border-top: 1px solid var(--line);
    font-size: var(--text-size);
    line-height: var(--text-line-gap);
    color: var(--muted);
  }

  /* ═══════════════════════════════════════════════════════════
     ⚠️ ليش كل القواعد تحت مكتوبة بـ «‎>‎» (ابن مباشر)؟

     لأن المقال ممكن يكون جوّاه أدوات تفاعلية (مثل لعبة الميزانية).
     لو كتبنا `.body p` عادي، ستايل نص المقال بينزل جوّا اللعبة
     وبيكسّر مسافاتها وألوانها — جرّبناها وصار زر التواصل ليموني
     على ليموني وما بان.

     «‎>‎» بتعني: طبّق الستايل على الفقرات والعناوين اللي طالعة من
     المقال نفسه بس، وما تفوت جوّا أي مكوّن محطوط بالمقال.
     ═══════════════════════════════════════════════════════════ */
  .body > :global(h2) {
    font-size: clamp(22px, 2.4vw, 30px);
    font-weight: 700;
    color: var(--text);
    margin: 2em 0 0.6em;
    letter-spacing: -0.015em;
    /* خط ليموني صغير قبل كل عنوان فرعي */
    padding-inline-start: 16px;
    border-inline-start: 3px solid var(--accent);
  }

  html[lang='ar'] .body > :global(h2) {
    letter-spacing: 0;
    font-weight: 800;
  }

  .body > :global(h3) {
    font-size: clamp(18px, 2vw, 23px);
    font-weight: 700;
    color: var(--text);
    margin: 1.6em 0 0.5em;
  }

  .body > :global(p) {
    margin-bottom: 1.3em;
  }

  .body > :global(p strong),
  .body > :global(ul strong),
  .body > :global(ol strong),
  .body > :global(blockquote strong) {
    color: var(--text);
  }

  .body > :global(p a),
  .body > :global(ul a),
  .body > :global(ol a),
  .body > :global(blockquote a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .body > :global(ul),
  .body > :global(ol) {
    margin: 0 0 1.5em;
    padding-inline-start: 1.4em;
  }

  .body > :global(ul li),
  .body > :global(ol li) {
    margin-bottom: 0.6em;
  }

  .body > :global(ul li::marker),
  .body > :global(ol li::marker) {
    color: var(--accent);
  }

  /* الاقتباس: بطاقة بارزة بلون الهوية */
  .body > :global(blockquote) {
    margin: 2em 0;
    padding: 22px 26px;
    border-inline-start: 3px solid var(--accent);
    border-radius: var(--r-card);
    background: var(--surface);
    color: var(--text);
    font-size: 1.05em;
  }

  .body > :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .body > :global(img),
  .body > :global(p img) {
    border-radius: var(--r-card);
    margin: 1.8em 0;
  }

  .body > :global(p code),
  .body > :global(ul code),
  .body > :global(ol code) {
    font-size: 0.9em;
    background: var(--surface);
    border-radius: 5px;
    padding: 2px 7px;
  }

  /* ─── دعوة التواصل ─── */
  .cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(22px, 4vw, 48px);
    flex-wrap: wrap;
    max-width: var(--content-width);
    margin: clamp(48px, 7vh, 80px) 0 var(--section-gap);
    padding: clamp(26px, 3.4vw, 44px);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background: var(--surface);
  }

  .cta h2 {
    font-size: clamp(20px, 2.2vw, 27px);
    font-weight: 700;
    color: var(--text);
    margin-bottom: 10px;
  }

  .cta p {
    color: var(--muted);
    font-size: 15.5px;
    line-height: 1.7;
    max-width: 46ch;
  }

  .cta-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* ─── موبايل ─── */
  @media (max-width: 767px) {
    /* الفيديو مثبّت عالموبايل كمان، فبياخد شاشة كاملة
       بس بارتفاع أقل شوي عشان يبين إن في محتوى تحته */
    .film-sticky {
      height: 88dvh;
      padding-block: 20px;
    }

    .film-copy {
      padding-top: 74px;
    }

    .cta {
      flex-direction: column;
      align-items: stretch;
    }

    .cta-actions .btn {
      flex: 1;
      justify-content: center;
    }
  }
</style>

<style>
  /* ═══════════════════════════════════════════════════════════
     تخطيط المقال: فهرس لاصق + نص
     ⚠️ الفهرس على الطرف بمساحة كانت فاضية أصلاً — ما أخذنا ولا
        بكسل من عرض القراءة (٦٨ حرف زي ما هو).
     ═══════════════════════════════════════════════════════════ */
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 210px;
    gap: clamp(28px, 4vw, 64px);
    align-items: start;
  }

  .toc {
    position: sticky;
    top: 130px;
    order: 2;
    padding-inline-start: 16px;
    border-inline-start: 1px solid var(--line);
  }

  .toc-title {
    font-size: 12px;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 12px;
    letter-spacing: 0.02em;
  }

  .toc ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .toc a {
    display: block;
    font-size: 13.5px;
    line-height: 1.5;
