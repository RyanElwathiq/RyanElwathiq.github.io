---
// ═══════════════════════════════════════════════════════════════
//  قالب المقال الواحد — بيلبسه كل ملف .md بمجلد src/content/blog
// ═══════════════════════════════════════════════════════════════
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  post: any;
}

const { post } = Astro.props;
const { title, description, date, lang, tags, film } = post.data;
const isAr = lang === 'ar';

const fmt = date.toLocaleDateString(isAr ? 'ar-EG' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const back = isAr ? '→ كل المقالات' : '← All articles';
---

<Base title={`${title} | ${isAr ? 'ريّان الواثق' : 'Rayan Elwathiq'}`} description={description} lang={lang}>
  <Nav lang={lang} />

  <main id="top" class="post">
    <article class="container">
      <a class="back" href={isAr ? '/ar/blog/' : '/blog/'}>{back}</a>

      <header>
        <time datetime={date.toISOString()}>{fmt}</time>
        <h1>{title}</h1>
        <p class="lede">{description}</p>
        {
          tags.length > 0 && (
            <ul class="tags">
              {tags.map((tag: string) => (
                <li>{tag}</li>
              ))}
            </ul>
          )
        }
      </header>

      <div class="body">
        <slot />
      </div>
    </article>

    <!-- ═══ فيديو المقال (اختياري) ═══
         بيظهر بس إذا حطيت  film: '/frames/اسم-المجلد/'  بأول ملف المقال.
         data-seq-pin : بيتثبّت لحد ما الفيديو يخلص كامل قدام الزائر -->
    {
      film && (
        <div class="film" data-seq data-seq-pin data-seq-length="1.4" data-seq-desktop={film}>
          <canvas aria-hidden="true"></canvas>
          <div class="film-veil" aria-hidden="true" />
        </div>
      )
    }
  </main>

  <Footer lang={lang} />
</Base>

<style>
  /* 🎛️ لوحة التحكم */
  .post {
    --title-size: clamp(30px, 4.4vw, 56px); /* حجم عنوان المقال */
    --text-size: clamp(16px, 1.7vw, 19px); /* حجم نص المقال */
    --text-line-gap: 1.85; /* تباعد أسطر النص */
    --content-width: 68ch; /* أقصى عرض للنص (مهم للقراءة) */
    padding-top: calc(68px + clamp(36px, 6vh, 72px));
    padding-bottom: var(--section-gap);
  }

  .back {
    display: inline-block;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 26px;
    transition: color 0.3s var(--ease-out);
  }

  .back:hover {
    color: var(--accent);
  }

  time {
    font-family: var(--font-en);
    font-size: 13.5px;
    color: var(--accent);
  }

  h1 {
    font-size: var(--title-size);
    font-weight: 700;
    letter-spacing: -0.025em;
    margin: 12px 0 16px;
    max-width: 24ch;
  }

  html[lang='ar'] h1 {
    font-weight: 800;
    letter-spacing: 0;
  }

  .lede {
    color: var(--muted);
    font-size: clamp(16px, 1.8vw, 20px);
    line-height: 1.7;
    max-width: 58ch;
  }

  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0;
    margin: 22px 0 0;
  }

  .tags li {
    font-size: 12.5px;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    padding: 6px 14px;
  }

  /* ─── نص المقال ─── */
  .body {
    max-width: var(--content-width);
    margin-top: clamp(36px, 5vh, 56px);
    padding-top: clamp(36px, 5vh, 56px);
    border-top: 1px solid var(--line);
    font-size: var(--text-size);
    line-height: var(--text-line-gap);
    color: var(--muted);
  }

  .body :global(h2) {
    font-size: clamp(22px, 2.4vw, 30px);
    font-weight: 700;
    color: var(--text);
    margin: 2em 0 0.6em;
    letter-spacing: -0.015em;
  }

  .body :global(h3) {
    font-size: clamp(18px, 2vw, 23px);
    font-weight: 700;
    color: var(--text);
    margin: 1.6em 0 0.5em;
  }

  .body :global(p) {
    margin-bottom: 1.3em;
  }

  .body :global(strong) {
    color: var(--text);
  }

  .body :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .body :global(ul),
  .body :global(ol) {
    margin: 0 0 1.5em;
    padding-inline-start: 1.4em;
  }

  .body :global(li) {
    margin-bottom: 0.6em;
  }

  .body :global(li::marker) {
    color: var(--accent);
  }

  .body :global(blockquote) {
    margin: 1.8em 0;
    padding-inline-start: 22px;
    border-inline-start: 2px solid var(--accent);
    color: var(--text);
  }

  .body :global(img) {
    border-radius: var(--r-card);
    margin: 1.8em 0;
  }

  .body :global(code) {
    font-size: 0.9em;
    background: var(--surface);
    border-radius: 5px;
    padding: 2px 7px;
  }

  /* ─── فيديو المقال المثبّت ─── */
  .film {
    position: relative;
    height: 100dvh;
    margin-top: clamp(48px, 7vh, 88px);
    overflow: clip;
  }

  .film canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* تدرّج خفيف بالأطراف عشان الفيديو يذوب بالصفحة بدل ما يقطع */
  .film-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      var(--bg),
      transparent 22%,
      transparent 78%,
      var(--bg)
    );
    pointer-events: none;
  }
</style>
