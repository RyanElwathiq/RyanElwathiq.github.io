---
// ═══════════════════════════════════════════════════════════════
//  القالب الأساسي — كل صفحات الموقع بتلبس هذا القالب
//  (اللغة والاتجاه RTL/LTR بينضبطوا لحالهم حسب الصفحة)
// ═══════════════════════════════════════════════════════════════
import { ClientRouter } from 'astro:transitions';
import SignalBar from '../components/SignalBar.astro';
import Cursor from '../components/Cursor.astro';
import Boot from '../components/Boot.astro';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/alexandria';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang?: 'en' | 'ar';
  // أقسام الصفحة اللي بتظهر كعلامات على شريط الإشارة
  sections?: { id: string; label: string }[];
  // صورة معاينة مخصصة لهالصفحة (اختياري) — مثال: '/assets/x.png'
  image?: string;
  // رابط نفس الصفحة باللغة الثانية.
  // ⚠️ بالعادة بينحسب لحاله (/loss/ ↔ /ar/loss/) — بس المقالات
  //    اسم ملفها بيختلف بين اللغتين، فبتمرّره الصفحة صريح.
  //    و null معناها «ما إلها نسخة بلغة تانية» فبنشيل الوسوم.
  altUrl?: string | null;
  // عقد بيانات منظّمة زيادة تخصّ هالصفحة (مقال · مشروع · مسار)
  schema?: Record<string, any>[];
}

const {
  title,
  description,
  lang = 'en',
  sections = [],
  image,
  altUrl,
  schema = [],
} = Astro.props;
const dir = lang === 'ar' ? 'rtl' : 'ltr';

// ─── روابط مطلقة (واتساب وفيسبوك بيرفضوا الروابط النسبية) ───
const site = Astro.site ?? new URL('https://ryanalali.me');
// ⚠️ صورة المشاركة بتتغيّر باللغة: العربية هي الافتراضية لأن أغلب
//    روابط الواتساب بتروح لأردنيين، والإنجليزية للصفحات الإنجليزية.
//    (الصورتان تولّدهما `_check/ogimage.mjs`)
const ogImage = new URL(image ?? (lang === 'ar' ? '/og.jpg' : '/og-en.jpg'), site).href;
const path = Astro.url.pathname;
const pageUrl = new URL(path, site).href;

// ═══════════════════════════════════════════════════════════════
//  hreflang — بيقول لجوجل «هاي نفس الصفحة بلغتين، مش نسختين مكررة»
//
//  بدونه: جوجل بيشوف /loss/ و /ar/loss/ كصفحتين متشابهتين،
//  فبيختار وحدة ويهمل التانية — أو بيعرض الإنجليزي لواحد بيدوّر
//  بالعربي. مع هالوسوم بيعرض لكل زائر نسخة لغته.
//
//  الاقتران بينحسب من الرابط (كل الصفحات مرآة)، والمقالات بس
//  بتمرّر altUrl لأنه اسم ملفها بيختلف بين اللغتين.
// ═══════════════════════════════════════════════════════════════
const sibling = altUrl === undefined ? (path.startsWith('/ar/') ? path.slice(3) : '/ar' + path) : altUrl;
const enUrl = sibling && new URL(lang === 'ar' ? sibling : path, site).href;
const arUrl = sibling && new URL(lang === 'ar' ? path : sibling, site).href;

// ═══════════════════════════════════════════════════════════════
//  البيانات المنظّمة (JSON-LD)
//
//  هاد اللي بيخلّي جوجل يفهم إنه هذا موقع **شخص** اسمه ريّان،
//  شغله تسويق، بالأردن — مش مجرد صفحات فيها كلام. وهو نفسه
//  اللي بتقرأه أدوات الذكاء الاصطناعي لما تجاوب «مين ريّان الواثق».
//
//  @id بيربط العقد ببعضها: الموقع ملك الشخص، والمقال كاتبه الشخص.
// ═══════════════════════════════════════════════════════════════
const personId = site.href + '#me';
const siteId = site.href + '#site';

const graph = [
  {
    '@type': 'Person',
    '@id': personId,
    name: lang === 'ar' ? 'ريّان الواثق' : 'Rayan Elwathiq',
    alternateName: lang === 'ar' ? 'Rayan Elwathiq' : 'ريّان الواثق',
    url: site.href,
    image: new URL('/assets/logo-white.png', site).href,
    jobTitle: lang === 'ar' ? 'مسوّق ومصمّم تجارب رقمية' : 'Marketer and digital experience designer',
    description:
      lang === 'ar'
        ? 'مسوّق بيشتغل على السبب مش العرَض: ليش الزبون ما اشترى، وليش التصميم ما اشتغل.'
        : 'A marketer who works on the cause, not the symptom: why the customer did not buy, and why the design did not work.',
    knowsLanguage: ['ar', 'en'],
    address: { '@type': 'PostalAddress', addressCountry: 'JO' },
    knowsAbout:
      lang === 'ar'
        ? ['التسويق الرقمي', 'تحسين محركات البحث', 'تحليل البيانات', 'هوية العلامة التجارية', 'تجربة المستخدم']
        : ['Digital marketing', 'SEO', 'Data analysis', 'Brand identity', 'User experience'],
  },
  {
    '@type': 'WebSite',
    '@id': siteId,
    url: site.href,
    name: lang === 'ar' ? 'ريّان الواثق' : 'Rayan Elwathiq',
    inLanguage: lang === 'ar' ? 'ar-JO' : 'en',
    publisher: { '@id': personId },
  },
  {
    '@type': 'WebPage',
    '@id': pageUrl + '#page',
    url: pageUrl,
    name: title,
    description,
    inLanguage: lang === 'ar' ? 'ar-JO' : 'en',
    isPartOf: { '@id': siteId },
    about: { '@id': personId },
  },
  ...schema,
];

const jsonld = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/assets/logo-white.png" />
    <!-- ═══ معاينة الروابط (واتساب · فيسبوك · لينكدإن · تويتر) ═══
         ⚠️ الصورة لازم تكون برابط مطلق، وإلا بتطلع المعاينة بيضا -->
    <link rel="canonical" href={pageUrl} />

    <!-- ═══ نفس الصفحة باللغة الثانية — عشان جوجل ما يحسبها تكرار ═══ -->
    {
      enUrl && arUrl && (
        <>
          <link rel="alternate" hreflang="en" href={enUrl} />
          <link rel="alternate" hreflang="ar" href={arUrl} />
          <link rel="alternate" hreflang="x-default" href={enUrl} />
        </>
      )
    }

    <!-- ═══ بيانات منظّمة — بتخلي جوجل والذكاء الاصطناعي يفهموا مين ريّان ═══ -->
    <script type="application/ld+json" is:inline set:html={jsonld} />

    <meta property="og:site_name" content={lang === 'ar' ? 'ريّان الواثق' : 'Rayan Elwathiq'} />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_JO' : 'en_US'} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#0E0F12" />

    <!-- ═══════════════════════════════════════════════════════════
         الانتقال بين الصفحات بدون إعادة تحميل كاملة.
         يعني لما تضغط «كل التصاميم» وبعدين ترجع للرئيسية،
         الموقع ما بيتحمّل من الصفر، بينتقل بنعومة وبينزل
         على قسم التصاميم مباشرة.
         ═══════════════════════════════════════════════════════════ -->
    <ClientRouter />

    <!-- ═══════════════════════════════════════════════════════════
         سكربت الظهور، بيشتغل فوراً وبدون أي مكتبة خارجية
         عشان النصوص تبين باللحظة اللي توصلها فيها، حتى لو مكتبة
         الحركة (GSAP) لسا عم تحمّل. هاد هو سبب سرعة الإحساس بالموقع.
         ═══════════════════════════════════════════════════════════ -->
    <script is:inline>
      document.documentElement.classList.add('js');

      (function () {
        var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

        function show(el) {
          el.classList.add('is-in');
        }

        function reveal(el) {
          if (el.hasAttribute('data-stagger')) {
            Array.prototype.forEach.call(el.children, show);
          } else {
            show(el);
          }
        }

        // هل العنصر ظاهر بالشاشة هلق؟
        function inView(el) {
          var r = el.getBoundingClientRect();
          return r.top < innerHeight && r.bottom > 0;
        }

        function start() {
          var targets = [].slice.call(
            document.querySelectorAll('[data-reveal], [data-stagger]')
          );

          // نرقّم أولاد كل مجموعة عشان يظهروا واحد ورا التاني
          document.querySelectorAll('[data-stagger]').forEach(function (g) {
            Array.prototype.forEach.call(g.children, function (c, i) {
              c.style.setProperty('--i', i);
            });
          });

          if (reduce || !('IntersectionObserver' in window)) {
            targets.forEach(reveal);
            return;
          }

          // 1) اللي ظاهر بالشاشة هلق بيبين فوراً بدون أي انتظار
          targets = targets.filter(function (el) {
            if (!inView(el)) return true;
            reveal(el);
            return false;
          });

          // 2) الباقي بينراقب وبيظهر لما توصله
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (e) {
                if (!e.isIntersecting) return;
                io.unobserve(e.target);
                reveal(e.target);
              });
            },
            // rootMargin سالب من تحت = يبدأ الظهور قبل ما يوصل الطرف بشوي
            { rootMargin: '0px 0px -12% 0px', threshold: 0.01 }
          );

          targets.forEach(function (el) {
            io.observe(el);
          });

          // 3) شبكة أمان: لو لأي سبب المراقبة ما اشتغلت (تبويب بالخلفية،
          //    متصفح غريب، خطأ مؤقت) — أي عنصر ظاهر بالشاشة وما بان
          //    بينكشف فوراً. يعني مستحيل يضل النص مخفي والزائر واقف عنده.
          function safetyNet() {
            targets = targets.filter(function (el) {
              if (!inView(el)) return true;
              io.unobserve(el);
              reveal(el);
              return false;
            });
          }

          // ⚠️⚠️ تنظيف الجولة السابقة (انصلح 2026-08-03) ⚠️⚠️
          //  start() بتنعاد مع كل انتقال صفحة، وكانت كل مرة تسجّل
          //  مستمعي scroll جدد بلا ما تشيل القدام — فبعد عشرين
          //  انتقال صار في عشرين مستمع، كل واحد بيلف على قائمة
          //  عناصر صفحة محذوفة مع كل حركة سكرول. تراكم صامت
          //  بيثقّل السكرول مع طول التصفح.
          if (window.__revealNet) {
            removeEventListener('scroll', window.__revealNet);
            removeEventListener('visibilitychange', window.__revealNet);
            removeEventListener('load', window.__revealNet);
          }
          if (window.__revealIO) window.__revealIO.disconnect();
          window.__revealNet = safetyNet;
          window.__revealIO = io;

          addEventListener('scroll', safetyNet, { passive: true });
          addEventListener('visibilitychange', safetyNet);
          addEventListener('load', safetyNet);
          setTimeout(safetyNet, 1200);
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', start);
        } else {
          start();
        }

        // ═══════════════════════════════════════════════════════
        //  الانتقال بين الصفحات بدون إعادة تحميل
        //
        //  ⚠️ عند الانتقال، ClientRouter بيستبدل خصائص وسم <html>
        //     بخصائص الصفحة الجديدة — وبهيك بيروح كلاس «js».
        //     وبدون هالكلاس، قاعدة الإخفاء بملف global.css بتوقف،
        //     يعني كل حركات الظهور بالموقع بتموت بعد أول انتقال.
        //     (المحتوى بيضل ظاهر — بس بيطلع بدون أي حركة)
        //
        //  بنرجّع الكلاس على **الصفحة الجاية قبل ما تنعرض**، مش
        //  بعدها، عشان ما يبين المحتوى للحظة قبل ما يختفي ويظهر.
        // ═══════════════════════════════════════════════════════
        //  حارس: لو انعاد تشغيل هذا السكربت لأي سبب، ما نسجّل
        //  المستمعين مرتين
        if (!window.__revealHooked) {
          window.__revealHooked = true;

          document.addEventListener('astro:before-swap', function (e) {
            // ⚠️ try/catch: أي خطأ بهذا الحدث بيلغي الانتقال كله
            //    («Transition was aborted») وبتطلع الأقسام فوق بعض
            try {
              if (e.newDocument) e.newDocument.documentElement.classList.add('js');
            } catch (err) {}
          });

          // وبعد ما تجهز الصفحة الجديدة، منشغّل المراقبة من جديد
          document.addEventListener('astro:page-load', function () {
            document.documentElement.classList.add('js');
            start();
          });
        }
      })();
    </script>

    <!-- ═══════════════════════════════════════════════════════
         Google Analytics 4 (مهمة #65 — 2026-08-03)

         ⚠️ بيشتغل على الدومين الحي **بس**. بدون هالشرط، كل بناء
            محلي وكل فحص Playwright كان بيتسجل كزيارة حقيقية
            وبيخرب الأرقام اللي بنبني عليها قرارات.
         ⚠️ send_page_view: false مقصودة: الموقع بينتقل بين الصفحات
            بـ ClientRouter بدون إعادة تحميل، فجوجل ما بيشوف إلا أول
            صفحة. منبعت page_view بإيدنا مع astro:page-load — وهي
            بتشتغل عالتحميل الأول **وع**كل انتقال، فكل الصفحات بتنعد
            وبلا عدّ مزدوج.
         ✏️ الـ ID مش سر (بيظهر بكود أي موقع) — بس لو تغيّر يوم،
            غيّره هون بس.
         ═══════════════════════════════════════════════════════ -->
    <script is:inline>
      (function () {
        var GA_ID = 'G-3Y35J7RN7L';
        if (!/(^|\.)ryanalali\.me$/.test(location.hostname)) return;

        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
        document.head.appendChild(s);

        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', GA_ID, { send_page_view: false });

        document.addEventListener('astro:page-load', function () {
          gtag('event', 'page_view', {
            page_location: location.href,
            page_title: document.title,
          });
        });

        // كبسة أي رابط واتساب = عميل محتمل — حدث رئيسي بـ GA4
        // وبينستورد بإعلانات جوجل كإحالة ناجحة (2026-08-05)
        document.addEventListener(
          'click',
          function (e) {
            var a = e.target && e.target.closest && e.target.closest('a[href*="wa.me/"], a[href*="api.whatsapp.com"]');
            if (a) gtag('event', 'wa_click', { link_url: a.href });
          },
          true,
        );
      })();
    </script>

    <!-- ═══════════════════════════════════════════════════════
         ضمانة الهبوط عالبداية (2026-08-04)

         ريّان لاحظ إنه أحياناً كبسة مقالة من الرئيسية بتفتحها من
         آخرها. السبب المرجّح سباق توقيت بين محرك السكرول الناعم
         (Lenis) وإعادة تعيين الموضع عند تبديل الصفحات — ما بينعاد
         إنتاجه بثبات، فالحل ضمانة حتمية:

         • كبسة رابط داخلي (بلا #) ← هبوط فوري عالبداية، دايماً.
         • الرجوع/التقدم بالمتصفح ما بينلمس ← ميزة «بيرجعك لنفس
           المكان» بتضل شغالة.
         • روابط الـ# (زي /ar/#lab) مستثناة ← بتكمل لمرساها عادي.
         ═══════════════════════════════════════════════════════ -->
    <script is:inline>
      (function () {
        var fromLink = false;

        document.addEventListener(
          'click',
          function (e) {
            var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
            if (!a) return;
            var href = a.getAttribute('href') || '';
            if (a.target === '_blank' || href.indexOf('#') !== -1) return;
            if (a.origin && a.origin !== location.origin) return;
            fromLink = true;
          },
          true,
        );

        // ⚠️ الهبوط عالصفر مرة وحدة ما بيكفي: المستعيد بيضرب بعده
        //    بـ~300ms (قياس فعلي) وبيرجّع سكرول الصفحة القديمة —
        //    وبينقص لآخر المقالة. فمنحرس ثانية ونص كاملة: أي قفزة
        //    سكرول **مش من إيد المستخدم** خلال النافذة بتنرد فوراً.
        function toTop() {
          window.scrollTo({ top: 0, behavior: 'instant' });
          if (window.__lenis && window.__lenis.scrollTo) {
            window.__lenis.scrollTo(0, { immediate: true, force: true });
          }
        }

        document.addEventListener('astro:after-swap', function () {
          if (!fromLink) return;
          fromLink = false;
          toTop();

          var userMoved = false;
          var markMoved = function () {
            userMoved = true;
          };
          // اللمسة أو العجلة أو الكيبورد = المستخدم مسك الدفة، منبطل حراسة
          window.addEventListener('wheel', markMoved, { passive: true, once: true });
          window.addEventListener('touchstart', markMoved, { passive: true, once: true });
          window.addEventListener('keydown', markMoved, { once: true });

          var guard = function () {
            if (!userMoved && window.scrollY > 150) toTop();
          };
          window.addEventListener('scroll', guard, { passive: true });
          setTimeout(function () {
            window.removeEventListener('scroll', guard);
            window.removeEventListener('wheel', markMoved);
            window.removeEventListener('touchstart', markMoved);
            window.removeEventListener('keydown', markMoved);
          }, 1500);
        });
      })();
    </script>

    <!-- ═══════════════════════════════════════════════════════
         Microsoft Clarity (2026-08-04) — الطبقة الثالثة بالقياس:
         GA بيقول «شو صار» بالأرقام، وClarity بيفرجيك «كيف وليش»:
         تسجيلات جلسات حقيقية + خرائط حرارية — وين بيكبسوا، لوين
         بيسكرلوا، وهل بيلعبوا الألعاب فعلاً. مجاني بلا حدود،
         وبيخفي نصوص الحقول تلقائياً (خصوصية الزوار).
         ⚠️ نفس حارس GA: الدومين الحي بس — فحوصات Playwright
            والبناء المحلي ما بيسجلوا جلسات وهمية.
         ⚠️ بيتتبع تنقلات ClientRouter لحاله (بيراقب الـ history).
         ✏️ الكود مش سر (بيظهر بكود الصفحة لأي زائر).
         ═══════════════════════════════════════════════════════ -->
    <script is:inline>
      (function () {
        if (!/(^|\.)ryanalali\.me$/.test(location.hostname)) return;
        (function (c, l, a, r, i, t, y) {
          c[a] =
            c[a] ||
            function () {
              (c[a].q = c[a].q || []).push(arguments);
            };
          t = l.createElement(r);
          t.async = 1;
          t.src = 'https://www.clarity.ms/tag/' + i;
          y = l.getElementsByTagName(r)[0];
          y.parentNode.insertBefore(t, y);
        })(window, document, 'clarity', 'script', 'xwoo5ekfsm');
      })();
    </script>

    <!-- ═══════════════════════════════════════════════════════
         Cloudflare Web Analytics: **ما في سكربت هون عن قصد.**
         طلع كلاودفلير مفعّلها تلقائياً (Automatic setup) من نقلة
         الـ DNS بـ 2026-08-02 — بيحقن سكربت القياس من السيرفر
         مباشرة بلا أي كود منا. كنا ركّبنا نسخة يدوية هون وانشالت
         بنفس اليوم عشان ما يصير عدّ مزدوج (سكربتين لنفس الخدمة).
         ✏️ لو يوم بطّلت التلقائية تشتغل (مثلاً انفصل الدومين عن
            كلاودفلير)، رجّع السكربت اليدوي من تاريخ git لهالملف.
         ═══════════════════════════════════════════════════════ -->
  </head>
  <body>
    <!-- شاشة التحميل — أول عنصر بالصفحة عشان ترسم فوراً -->
    <Boot lang={lang} />

    <!-- المؤشّر المخصّص (أجهزة الماوس بس) -->
    <Cursor />

    <!-- شريط الإشارة: مؤشر التقدّم أعلى كل صفحة -->
    <SignalBar lang={lang} sections={sections} />

    <slot />

    <!-- نظام الحركة -->
    <script src="../scripts/motion.js"></script>

    <!-- ═══════════════════════════════════════════════════════════
         ⚠️ إشارة «الصفحة انقرأت»، لشاشة التحميل
         ليش مش DOMContentLoaded؟ لأنه بيستنى كل ملفات الجافاسكربت
         (GSAP و Lenis و React) تنزّل وتشتغل. وهاد ٣ ثواني عالموبايل.
         بينما الصفحة بتصير مقروءة ومفهومة قبلها بكثير.
         هذا السطر بيشتغل باللحظة اللي بتخلص فيها قراءة الصفحة،
         قبل أي مكتبة. الحركات بتوصل بعدين وهو عم يتفرّج.
         ═══════════════════════════════════════════════════════════ -->
    <script is:inline>
      window.__bodyParsed = 1;
      document.dispatchEvent(new Event('body-parsed'));
    </script>
  </body>
</html>
