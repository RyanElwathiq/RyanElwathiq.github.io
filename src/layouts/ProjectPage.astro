---
// ═══════════════════════════════════════════════════════════════
//  قالب صفحة المشروع الواحد
//  بيعرض: الغلاف + الفيديو (لو موجود) + قصة المشروع + الأرقام
//
//  ✏️ محتوى القصة بيجي من work.json → story / storyAr
//     أي قسم فاضي ما بيظهر أبداً، فما في خوف تترك إشي فاضي
// ═══════════════════════════════════════════════════════════════
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';

interface Props {
  project: any;
  lang: 'en' | 'ar';
}

const { project: p, lang } = Astro.props;
const isAr = lang === 'ar';

const title = isAr ? p.titleAr : p.title;
const role = isAr ? p.roleAr : p.role;
const desc = isAr ? p.descAr : p.desc;

// ⚠️ وصف جوجل غير الوصف الظاهر بالصفحة.
//    الظاهر لازم يكون قصير عشان تصميم البطاقة يضل مرتّب،
//    وجوجل بيعرض ~١٦٠ حرف — أقصر من هيك بضيّع مساحة، وأطول
//    بينقصّ بنص الجملة. فحقل seoDesc (اختياري) بيعطي جوجل
//    نسخته الخاصة بدون ما يلمس التصميم.
const metaDesc = (isAr ? p.seoDescAr : p.seoDesc) || desc;
const story = (isAr ? p.storyAr : p.story) || {};

// عناوين أقسام القصة باللغتين
const labels = isAr
  ? { vision: 'الرؤية', goal: 'الهدف', challenge: 'التحدي', approach: 'المقاربة', result: 'النتيجة' }
  : { vision: 'Vision', goal: 'Goal', challenge: 'Challenge', approach: 'Approach', result: 'Result' };

// بس الأقسام اللي فيها محتوى فعلي
const blocks = ['vision', 'goal', 'challenge', 'approach', 'result']
  .filter((k) => story[k])
  .map((k) => ({ label: labels[k as keyof typeof labels], text: story[k] }));

// رابط الرجوع لصفحة القسم اللي المشروع تابع إله
const catPages: Record<string, string> = {
  video: 'videos',
  design: 'designs',
  website: 'websites',
  marketing: 'marketing',
};
const backHref = `${isAr ? '/ar' : ''}/${catPages[p.category] || ''}/`;
const homeAnchors: Record<string, string> = {
  video: 'work',
  marketing: 'growth',
  design: 'designs',
  website: 'websites',
};
const homeHref = `${isAr ? '/ar' : ''}/#${homeAnchors[p.category] || ''}`;
const backLabel = isAr ? '→ رجوع' : '← Back';

const emptyNote = isAr
  ? 'تفاصيل هذا المشروع قيد الإضافة.'
  : 'Full write-up for this project is coming soon.';

// ═══ الغلاف ═══
//  ⚠️ هون منستعمل **النسخة العريضة** مش المربّعة: رأس الصفحة
//     1400×800، ولو حطينا المربّع `object-fit:cover` بيقصّ من فوق
//     وتحت واسم العميل (القاعد أسفل الغلاف) بينقص. وكمان هي الأنسب
//     كصورة مشاركة على واتساب وفيسبوك — نسبتها قريبة من 1.91:1.
//  الاحتياط `|| p.cover` لأي مشروع لسا بلا غلاف مولّد.
const cover = p.coverWide || p.cover;

// ═══ بيانات منظّمة للمشروع ═══
//  CreativeWork بيقول لجوجل «هذا شغل، ريّان عمله، لهذا العميل».
//  وبهيك اسم العميل بيصير مربوط فيك بفهرس جوجل — مش مجرد كلمة
//  بصفحة. والمسار بيبدّل الرابط بـ «فيديو › اسم المشروع».
const HOME = 'https://ryanalali.me';
const here = `${HOME}${Astro.url.pathname}`;
const catName = isAr
  ? { video: 'فيديو', design: 'تصميم', website: 'مواقع', marketing: 'تسويق' }
  : { video: 'Video', design: 'Design', website: 'Websites', marketing: 'Marketing' };

const projectSchema = [
  {
    '@type': 'CreativeWork',
    '@id': here + '#work',
    name: title,
    description: desc,
    url: here,
    inLanguage: isAr ? 'ar-JO' : 'en',
    creator: { '@id': HOME + '/#me' },
    genre: role,
    about: { '@type': 'Organization', name: isAr ? p.titleAr : p.title },
    image: cover ? HOME + cover : HOME + '/og.jpg',
    isPartOf: { '@id': HOME + '/#site' },
  },
  {
    '@type': 'BreadcrumbList',
    '@id': here + '#crumbs',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: isAr ? 'الرئيسية' : 'Home', item: HOME + (isAr ? '/ar/' : '/') },
      {
        '@type': 'ListItem',
        position: 2,
        name: catName[p.category as keyof typeof catName] || (isAr ? 'الشغل' : 'Work'),
        item: HOME + backHref,
      },
      { '@type': 'ListItem', position: 3, name: title },
    ],
  },
];
---

<Base
  title={`${title} | ${isAr ? 'ريّان الواثق' : 'Rayan Elwathiq'}`}
  description={metaDesc}
  lang={lang}
  image={cover}
  schema={projectSchema}
>
  <Nav lang={lang} />

  <main id="top" class="project">
    <div class="container">
      <nav class="crumbs">
        <a href={homeHref}>{isAr ? 'الرئيسية' : 'Home'}</a>
        <span aria-hidden="true">/</span>
        <a href={backHref}>{backLabel.replace(/^[←→]\s*/, '')}</a>
      </nav>

      <!-- ═══ الترويسة ═══ -->
      <header class="head">
        <p class="role" data-reveal>{role}</p>
        <h1 data-reveal>{title}</h1>
        <p class="lede" data-reveal>{desc}</p>

        <div class="head-actions" data-reveal>
          {
            p.youtube && (
              <button class="btn btn-primary" data-play={p.youtube}>
                {isAr ? 'شغّل الفيديو' : 'Play video'}
              </button>
            )
          }
          {
            p.url && (
              <a class="btn btn-ghost" href={p.url} target="_blank" rel="noreferrer">
                {isAr ? 'زيارة الموقع ↗' : 'Visit site ↗'}
              </a>
            )
          }
        </div>
      </header>

      <!-- ═══ الغلاف ═══ -->
      <div class="cover" data-reveal>
        <img src={cover} alt={title} width="1600" height="900" />
      </div>

      <!-- ═══ الأرقام (لو موجودة) ═══ -->
      {
        p.stats?.length > 0 && (
          <div class="stats" data-stagger>
            {p.stats.map((s: any) => (
              <div class="stat">
                <strong>{s.value}</strong>
                <span>{isAr ? s.labelAr : s.label}</span>
              </div>
            ))}
          </div>
        )
      }

      <!-- ═══════════════════════════════════════════════════════
           فيديوهات المشروع
           ✏️ من work.json ← "videos": ["معرّف-يوتيوب", ...]
           بتنعرض بإطار يوتيوب مباشرة، فما بتثقّل الموقع
           ═══════════════════════════════════════════════════════ -->
      {
        p.videos?.length > 0 && (
          <section class="films" data-reveal>
            <h2>{isAr ? 'الفيديوهات' : 'The films'}</h2>
            <div class="films-grid">
              {p.videos.map((v: string) => (
                <div class="film">
                  <iframe
                    src={`https://www.youtube-nocookie.com/embed/${v}`}
                    title={title}
                    loading="lazy"
                    allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                  />
                </div>
              ))}
            </div>
          </section>
        )
      }

      <!-- ═══════════════════════════════════════════════════════
           معرض التصاميم
           ✏️ من work.json ← "gallery": ["/assets/work/.../x.webp", ...]
           ⚠️ الصور بتنزل بس لما توصلها بالسكرول (loading="lazy")
           ═══════════════════════════════════════════════════════ -->
      {
        p.gallery?.length > 0 && (
          <section class="shots" data-reveal>
            <h2>
              {isAr ? 'التصاميم' : 'The designs'}
              <span class="count">{p.gallery.length}</span>
            </h2>
            <div class="shots-grid">
              {p.gallery.map((g: string, i: number) => (
                <figure class="shot">
                  <img src={g} alt={`${title}: ${i + 1}`} loading="lazy" decoding="async" />
                </figure>
              ))}
            </div>
          </section>
        )
      }

      <!-- ═══ قصة المشروع ═══ -->
      {
        blocks.length > 0 ? (
          <div class="story">
            {blocks.map((b) => (
              <section class="block" data-reveal>
                <h2>{b.label}</h2>
                <p>{b.text}</p>
              </section>
            ))}
          </div>
        ) : (
          <p class="empty" data-reveal>
            {emptyNote}
          </p>
        )
      }
    </div>
  </main>

  <Footer lang={lang} />
  <Lightbox lang={lang} />
</Base>

<style>
  /* 🎛️ لوحة التحكم */
  .project {
    --title-size: clamp(36px, 5.6vw, 76px); /* حجم اسم المشروع */
    --lede-size: clamp(16px, 1.8vw, 21px); /* حجم الوصف تحت الاسم */
    --block-gap: clamp(36px, 5vh, 64px); /* المسافة بين أقسام القصة */
    --label-width: 180px; /* عرض عمود العناوين (الرؤية/الهدف...) */
    padding-top: calc(108px + clamp(26px, 4vh, 52px));
  }

  /* مسار التنقّل: الرئيسية / القسم */
  .crumbs {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 26px;
  }

  .crumbs a {
    transition: color 0.3s var(--ease-out);
  }

  .crumbs a:hover {
    color: var(--accent);
  }

  .crumbs span {
    opacity: 0.5;
  }

  .role {
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 12px;
  }

  h1 {
    font-size: var(--title-size);
    font-weight: 700;
    letter-spacing: -0.025em;
    margin-bottom: 18px;
  }

  html[lang='ar'] h1 {
    font-weight: 800;
    letter-spacing: 0;
  }

  .lede {
    color: var(--muted);
    font-size: var(--lede-size);
    line-height: 1.7;
    max-width: 58ch;
  }

  .head-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 30px;
  }

  .cover {
    margin-top: clamp(40px, 6vh, 64px);
    border-radius: var(--r-card);
    overflow: hidden;
    background: var(--surface);
  }

  .cover img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  /* ─── الأرقام ─── */
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(28px, 5vw, 72px);
    margin-top: clamp(36px, 5vh, 56px);
    padding-bottom: clamp(36px, 5vh, 56px);
    border-bottom: 1px solid var(--line);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .stat strong {
    font-family: var(--font-en);
    font-size: clamp(30px, 3.4vw, 46px);
    font-weight: 700;
    line-height: 1;
    color: var(--accent);
  }

  .stat span {
    font-size: 14px;
    color: var(--muted);
  }

  /* ─── قصة المشروع: عنوان بعمود ونص بعمود ─── */
  .story {
    margin-top: clamp(48px, 7vh, 80px);
  }

  .block {
    display: grid;
    grid-template-columns: var(--label-width) 1fr;
    gap: 24px;
    padding-bottom: var(--block-gap);
  }

  .block + .block {
    padding-top: var(--block-gap);
    border-top: 1px solid var(--line);
  }

  .block h2 {
    font-size: 15px;
    font-weight: 600;
    color: var(--accent);
  }

  .block p {
    font-size: clamp(16px, 1.7vw, 19px);
    line-height: 1.8;
    max-width: 62ch;
    color: var(--muted);
  }

  .empty {
    margin-top: clamp(48px, 7vh, 80px);
    color: var(--muted);
    font-size: 16px;
  }

  @media (max-width: 767px) {
    .block {
      grid-template-columns: 1fr;
      gap: 10px;
    }
  }
</style>

<style>
  /* ═══════════════ الفيديوهات ═══════════════ */
  .films,
  .shots {
    margin-top: clamp(48px, 7vh, 88px);
  }

  .films h2,
  .shots h2 {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-size: clamp(20px, 2.4vw, 28px);
    font-weight: 700;
    margin-bottom: clamp(20px, 3vh, 30px);
  }

  .shots .count {
    font-family: var(--font-en);
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
  }

  .films-grid {
    display: grid;
    /* الفيديوهات الطولية (ريلز) بتاخد عمود أضيق تلقائياً */
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: clamp(16px, 2vw, 26px);
  }

  .film {
    aspect-ratio: 16 / 9;
    border-radius: var(--r-card);
    overflow: hidden;
    border: 1px solid var(--line);
    background: #000;
  }

  .film iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  /* ═══════════════ معرض التصاميم ═══════════════
     أعمدة مش شبكة — نفس قاعدة صفحة LUV IT وقسم التجارب.

     ⚠️ بشبكة CSS البطاقة بتتمدّد لارتفاع أطول بطاقة بالصف بس
        الصورة بتضل بنسبتها، فبيبين فراغ أسود تحتها. القياس على
        صفحة أورينت كان **٢١٨px، يعني ٤٤٪ من البطاقة**.
        بالأعمدة كل صورة بتاخد ارتفاعها الحقيقي بدون قص ولا فراغ.
     ═══════════════════════════════════════════════════════ */
  .shots-grid {
    columns: 260px;
    column-gap: clamp(14px, 1.6vw, 22px);
  }

  .shot {
    margin: 0;
    /* ⚠️ ضرورية: بدونها الصورة بتنقسم بين عمودين */
    break-inside: avoid;
    margin-bottom: clamp(14px, 1.6vw, 22px);
    border-radius: var(--r-card);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--surface);
    transition:
      transform 0.4s var(--ease-out),
      border-color 0.4s var(--ease-out);
  }

  .shot:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--accent) 50%, var(--line));
  }

  .shot img {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 700px) {
    .shots-grid {
      columns: 2;
      column-gap: 10px;
    }

    .shot {
      margin-bottom: 10px;
    }
  }
</style>
