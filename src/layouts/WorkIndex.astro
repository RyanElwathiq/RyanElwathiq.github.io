---
// ═══════════════════════════════════════════════════════════════
//  قالب الصفحات الداخلية (كل الفيديوهات / التصاميم / التسويق / المواقع)
//  بيعرض كل مشاريع قسم معيّن من work.json
// ═══════════════════════════════════════════════════════════════
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Particles from '../components/Particles.astro';
import Lightbox from '../components/Lightbox.astro';
import WorkCard from '../components/WorkCard.astro';
import work from '../data/work.json';

interface Props {
  lang: 'en' | 'ar';
  category: string; // video | design | website | marketing
  title: string;
  h1?: string; // عنوان H1 مخصص للسيو — لو مش موجود بينسحب من العنوان
  description: string;
  intro?: string;
  introHtml?: string; // مقدمة فيها روابط داخلية (HTML) — بتتقدم على intro لو موجودة
  sections?: { h2?: string; body: string }[]; // أقسام نصية قصيرة بعد الشبكة (سيو)
}

const { lang, category, title, h1, description, intro, introHtml, sections = [] } = Astro.props;
const isAr = lang === 'ar';
const heading = h1 ?? title.split('|')[0].trim();

// كل مشاريع هذا القسم مرتبة حسب order
const projects = work.projects
  .filter((p) => p.category === category)
  .sort((a, b) => a.order - b.order);

// ─────────────────────────────────────────────────────────────
//  زر الرجوع بيرجّعك لنفس القسم بالصفحة الرئيسية — مش لأولها.
//  يعني لو كنت بصفحة «كل التصاميم» ورجعت، بتنزل على قسم
//  التصاميم مباشرة. كل قسم إله معرّف (id) بالصفحة الرئيسية.
// ─────────────────────────────────────────────────────────────
const anchors = {
  video: 'work',
  marketing: 'growth',
  design: 'designs',
  website: 'websites',
};
const backHref = `${isAr ? '/ar' : ''}/#${anchors[category] || ''}`;
const backLabel = isAr ? '→ الرئيسية' : '← Home';
---

<Base title={title} description={description} lang={lang}>
  <Nav lang={lang} />

  <main id="top" class="page">
    <div class="container">
      <a class="back" href={backHref}>{backLabel}</a>
      <h1 data-reveal>{heading}</h1>
      {introHtml ? <p class="intro" data-reveal set:html={introHtml} /> : <p class="intro" data-reveal>{intro}</p>}

      <div class="grid" data-stagger>
        {/* ⚠️ level=2: هون فوق البطاقات عنوان الصفحة h1 مباشرة،
            مش عنوان قسم، فلازم البطاقات تكون h2 عشان التسلسل يضل صح */}
        {projects.map((p) => <WorkCard project={p} lang={lang} level={2} />)}
      </div>

      {
        sections.length > 0 && (
          <div class="notes">
            {sections.map((s) => (
              <section class="note" data-reveal>
                {s.h2 && <h2>{s.h2}</h2>}
                <Fragment set:html={s.body} />
              </section>
            ))}
          </div>
        )
      }
    </div>

    <!-- ═══════════════════════════════════════════════════════════
         فاصل هادي: اللوجو بنقاط بالمساحة الفاضية آخر الصفحة.
         ⚠️ نفس محرّك الاسم المتفتّت بالضبط. ما في كود جديد ولا
            ملف جديد ينحمّل، بس بيقرأ شكل اللوجو بدل الحروف.
            وبيوقف الرسم تماماً لما يطلع برّا الشاشة.
         ═══════════════════════════════════════════════════════════ -->
    <Particles src="/assets/logo-white.png" size="small" />
  </main>

  <Footer lang={lang} />
  <Lightbox lang={lang} />
</Base>

<style>
  /* 🎛️ لوحة التحكم */
  .page {
    --title-size: clamp(38px, 6vw, 76px);
    --grid-gap: clamp(24px, 3vw, 44px);
    padding-top: calc(108px + clamp(30px, 5vh, 60px));
    min-height: 100dvh;
  }

  .back {
    display: inline-block;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 26px;
    transition: color 0.3s var(--ease-out);
  }

  .back:hover {
    color: var(--accent);
  }

  h1 {
    font-size: var(--title-size);
    font-weight: 700;
    letter-spacing: -0.025em;
    margin-bottom: 16px;
  }

  html[lang='ar'] h1 {
    font-weight: 800;
    letter-spacing: 0;
  }

  .intro {
    color: var(--muted);
    font-size: clamp(15px, 1.6vw, 18px);
    max-width: 56ch;
    margin-bottom: clamp(40px, 6vh, 64px);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--grid-gap);
  }

  /* روابط جوّا المقدمة (لما تنبعت introHtml) */
  .intro :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* الأقسام النصية القصيرة بعد الشبكة */
  .notes {
    margin-top: clamp(48px, 8vh, 88px);
    display: grid;
    gap: clamp(28px, 4vh, 44px);
    max-width: 62ch;
  }

  .note h2 {
    font-size: clamp(21px, 2.4vw, 28px);
    font-weight: 700;
    letter-spacing: -0.015em;
    margin-bottom: 10px;
  }

  html[lang='ar'] .note h2 {
    font-weight: 800;
    letter-spacing: 0;
  }

  .note :global(p) {
    color: var(--muted);
    font-size: clamp(15px, 1.6vw, 17px);
    line-height: 1.75;
  }

  .note :global(p + p) {
    margin-top: 10px;
  }

  .note :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
