---
// ═══════════════════════════════════════════════════════════════
//  قالب صفحة الخدمة — قمع بيع كامل مش صفحة تعريف
//
//  الترتيب مقصود ومبني على رحلة القرار:
//  ١. العنوان بالمشكلة (مش باسم الخدمة) — عشان يحس إنه المقصود
//  ٢. الوجع — يشوف حالته مكتوبة قدامه
//  ٣. شو بياخد — الحل بشكل ملموس
//  ٤. الإثبات — شغل حقيقي وأرقام
//  ٥. الأسئلة — بنقتل الاعتراضات قبل ما يسألها
//  ٦. الطلب — والخدمة مختارة مسبقاً
//  ٧. باقي الخدمات — روابط داخلية (بتفيد الزائر وجوجل سوا)
//
//  ✏️ كل النصوص من src/data/services.json — ما في نص مكتوب هون
// ═══════════════════════════════════════════════════════════════
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Particles from '../components/Particles.astro';
import BriefSection from '../components/BriefSection.astro';
import Service3D from '../components/Service3D.astro';
import AgentDaySection from '../components/AgentDaySection.astro';
import LpFilm from '../components/LpFilm.astro';
import LossSection from '../components/LossSection.astro';
import BudgetSection from '../components/BudgetSection.astro';
import BrandEyeSection from '../components/BrandEyeSection.astro';
import AttentionCounterSection from '../components/AttentionCounterSection.astro';
import LampLab from '../components/LampLab.astro';
import PersonaBuilderSection from '../components/PersonaBuilderSection.astro';
import LeakyJourneySection from '../components/LeakyJourneySection.astro';
import CompanyDetectorSection from '../components/CompanyDetectorSection.astro';
import NumberSorterSection from '../components/NumberSorterSection.astro';
import servicesData from '../data/services.json';
import work from '../data/work.json';

interface Props {
  lang: 'en' | 'ar';
  id: string;
}

const { lang, id } = Astro.props;
const isAr = lang === 'ar';
const L = isAr ? 'ar' : 'en';
const p = isAr ? '/ar' : '';

const service = servicesData.services.find((s) => s.id === id);
if (!service) throw new Error(`Service "${id}" مش موجودة بـ services.json`);

const c = service[L];

// ⚠️ خدمة «قريباً»: لسا ما فتحت. بتاخد صفحتها كاملة بالضبط —
//    الشرح والوجع والتسليمات والأسئلة — بس بدل نموذج الطلب
//    بيكون في نموذج تسجيل بقائمة الانتظار. ريّان: «حطها انه
//    حاليا مش متاحه ولكن قريبا حتكون متاحه».
const soon = service.soon === true;

// ─── تجهيز بنود «شو بتاخد» لعرض المنظومة ───
//  البند مكتوب بصيغة «عنوان: تفصيل» — منفصلهم عشان التفصيل يطلع
//  بخط أهدى تحت العنوان. بند بلا نقطتين بيتعرض كعنوان لحاله.
const deliverParts = (c.deliver || []).map((x: string) => {
  const i = x.indexOf(':');
  return i > 6 ? { head: x.slice(0, i), rest: x.slice(i + 1).trim() } : { head: x, rest: '' };
});

// «قصص تحت الغطا» — اختيارية بالبيانات (موجودة للسيو حالياً)
const stories = c.stories || [];

// ═══ #60: شبكة الترابط ═══
//  ريّان: «التسويق شبكة مترابطة، كل عنصر أهم من اللي قبله» —
//  بكل صفحة خدمة منقول بصراحة إنها لحالها مش بالضرورة بتحل
//  البيع، ومنورجي مين بيكمّلها وليش. الصراحة هاي بتبيع أكثر
//  من أي وعد، وهي نفس فلسفة «لا وعود جاهزة».
const pairs = (service.pairsWith || []).map((x: any) => {
  const other = servicesData.services.find((s) => s.id === x.id);
  return other
    ? {
        name: other[L].name,
        href: `${p}/services/${other.slug}/`,
        why: isAr ? x.whyAr : x.whyEn,
        soon: other.soon === true,
      }
    : null;
}).filter(Boolean);

const netT = isAr
  ? {
      title: 'وشو اللي ما بتحلّه لحالها؟',
      body: `للصراحة: ${c.name} لحالها مش بالضرورة بتحل مشكلة البيع. التسويق شبكة مترابطة، وكل حلقة بتقوّي اللي بعدها. هاي الحلقات اللي بتشتغل مع هاي الخدمة، وليش:`,
      soonTag: 'قريباً',
    }
  : {
      title: 'And what does it not solve alone?',
      body: `Honestly: ${c.name} on its own does not necessarily fix sales. Marketing is an interconnected network, and every link strengthens the next. These are the links that work with this service, and why:`,
      soonTag: 'soon',
    };

// باقي الخدمات — للروابط الداخلية آخر الصفحة
const others = servicesData.services
  .filter((s) => s.id !== id)
  .sort((a, b) => a.order - b.order);

// ─── نصوص الواجهة ───
const t = isAr
  ? {
      back: '→ كل الخدمات',
      painTitle: 'إذا هاي حالتك، إحنا بنحكي عن نفس الإشي',
      deliverTitle: 'شو بتاخد بالضبط',
      proofTitle: 'شغل حقيقي مش كلام',
      proofLink: 'شوف الشغل كله ←',
      faqTitle: 'أسئلة بتيجي دايماً',
      ctaTitle: 'احكيلي عن مشروعك',
      ctaBody: 'عبّي الطلب بثلاث خطوات قصيرة وبرجعلك خلال ٢٤ ساعة برأي واضح: شو بينفع، شو لأ، ومن وين نبدأ.',
      ctaBtn: 'ابدأ الطلب',
      heroNote: 'أول خطوة تشخيص مجاني، بلا أي التزام.',
      ctaAlt: 'أو احكيني واتساب مباشرة',
      othersTitle: 'خدمات ثانية',
      soonBadge: 'قريباً',
      whyTitle: 'ليش هاي الخدمة أصلاً',
      soonTitle: 'لسا ما فتحت. بس بتقدر تكون أول واحد',
      soonBody:
        'عم أبني الأساس هلأ، وما بحب أبيع إشي قبل ما يكون جاهز وقابل للتكرار. سجّل إيميلك وبوصلك خبر أول ما تفتح، وبتاخد أول شهر بسعر التأسيس.',
      soonName: 'اسمك',
      soonMail: 'إيميلك',
      soonPhone: 'واتساب (اختياري)',
      soonBtn: 'سجّلني لما تنزل',
      soonSending: 'عم أسجّلك…',
      soonDone: 'تمام، انسجّلت. رح أحكيك أول ما تفتح.',
      soonErr: 'صار خلل. جرّب كمان مرة أو احكيني واتساب.',
      soonAlt: 'أو احكيني واتساب مباشرة',
    }
  : {
      back: '← All services',
      painTitle: "If this is your situation, we're talking about the same thing",
      deliverTitle: 'What you actually get',
      proofTitle: 'Real work, not claims',
      proofLink: 'See all the work →',
      faqTitle: 'Questions that always come up',
      ctaTitle: 'Tell me about your project',
      ctaBody: 'Three short steps, and you hear back within 24 hours with a clear opinion: what works, what does not, and where to start.',
      ctaBtn: 'Start the brief',
      heroNote: 'Step one is a free diagnosis, no commitment.',
      ctaAlt: 'Or message me on WhatsApp',
      othersTitle: 'Other services',
      soonBadge: 'Coming soon',
      whyTitle: 'Why this service exists',
      soonTitle: 'Not open yet. You can be first in line',
      soonBody:
        'I am building the foundation now, and I do not sell anything before it is ready and repeatable. Leave your email and you will hear the moment it opens, with founding pricing on the first month.',
      soonName: 'Your name',
      soonMail: 'Your email',
      soonPhone: 'WhatsApp (optional)',
      soonBtn: 'Tell me when it launches',
      soonSending: 'Adding you…',
      soonDone: 'Done, you are on the list. I will reach out the moment it opens.',
      soonErr: 'Something broke. Try again or message me on WhatsApp.',
      soonAlt: 'Or message me on WhatsApp',
    };

// أرقام حقيقية — نفس أرقام قسم «ليش أنا» بالصفحة الرئيسية
const stats = isAr
  ? [
      { n: '2,395', l: 'متابع عضوي بـ ٣٠ يوم' },
      { n: '290K', l: 'مشاهدة على منشور واحد' },
      { n: '40%', l: 'وقت إنتاج أقل' },
    ]
  : [
      { n: '2,395', l: 'organic followers in 30 days' },
      { n: '290K', l: 'views on a single post' },
      { n: '40%', l: 'less production time' },
    ];

// ⚠️ الزر بينزّل الزائر على الفورم اللي بنفس الصفحة (#brief)
//    مش لصفحة تانية. الرابط الكامل بيضل مستخدم بالبيانات
//    المنظّمة تحت (availableChannel) لأنها بدها رابط مطلق.
const briefHref = `#brief`;
const briefUrl = `${p}/brief/?s=${service.id}`;
const site = Astro.site ?? new URL('https://ryanalali.me');

// ⚠️ الرقم بينقرا من work.json زي BriefSection بالضبط — ممنوع
//    يتكتب بإيدنا هون، لأنه لو تغيّر بينسى مكان وبيروح عميل لرقم ميت.
const whatsapp = `https://wa.me/${work.links.phone.replace(/[^0-9]/g, '')}`;

// فيديو الهبوط الممول (2026-08-05): نفس فلسفة فيلم الرئيسية —
// غطاء + زر نابض والكبسة بتشغل بالصوت. لكل لغة نسختها
// (النسخ الإنجليزية انولدت من نفس خط الإنتاج بنفس الضربات).
const LP_FILMS: Record<string, { film: string; dur: string }> = isAr
  ? {
      websites: { film: 'lp-websites', dur: '٠:٢٤' },
      'paid-ads': { film: 'lp-paid-ads', dur: '٠:٢٥' },
      'social-media': { film: 'lp-social-media', dur: '٠:٤٦' },
      'brand-identity': { film: 'lp-brand-identity', dur: '١:٣٢' },
      'ai-agents-automation': { film: 'lp-ai-agents-2', dur: '١:٤٥' },
      'marketing-strategy': { film: 'lp-strategy', dur: '١:٥٤' },
      'data-analysis': { film: 'lp-numbers', dur: '١:٥٢' },
    }
  : {
      websites: { film: 'lp-websites-en', dur: '0:24' },
      'paid-ads': { film: 'lp-paid-ads-en', dur: '0:25' },
      'social-media': { film: 'lp-social-media-en', dur: '0:46' },
      'brand-identity': { film: 'lp-brand-identity-en', dur: '1:32' },
      'ai-agents-automation': { film: 'lp-ai-agents-en', dur: '1:45' },
      'marketing-strategy': { film: 'lp-strategy-en', dur: '1:54' },
      'data-analysis': { film: 'lp-numbers-en', dur: '1:52' },
    };
const lpFilm = LP_FILMS[service.slug];

// ═══════════════════════════════════════════════════════════════
//  البيانات المنظّمة
//  • Service — بتقول لجوجل «هاي خدمة، مقدّمها فلان، بالأردن»
//  • FAQPage — بتخلّي الأسئلة تطلع مفتوحة تحت نتيجة البحث،
//    وبتتقرا من مساعدات الـ AI لما حدا يسأل نفس السؤال
// ═══════════════════════════════════════════════════════════════
const schema = [
  {
    '@type': 'Service',
    '@id': new URL(Astro.url.pathname, site).href + '#service',
    name: c.name,
    description: c.seoDesc,
    serviceType: c.name,
    provider: { '@id': new URL('/', site).href + '#person' },
    areaServed: [
      { '@type': 'Country', name: isAr ? 'الأردن' : 'Jordan' },
      { '@type': 'City', name: isAr ? 'عمّان' : 'Amman' },
    ],
    availableChannel: {
      '@type': 'ServiceChannel',
      serviceUrl: new URL(briefUrl, site).href,
    },
  },
  {
    '@type': 'FAQPage',
    mainEntity: c.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Base
  title={`${c.name} | ${isAr ? 'ريّان الواثق' : 'Rayan Elwathiq'}`}
  description={c.seoDesc}
  lang={lang}
  schema={schema}
>
  <Nav lang={lang} />

  <main id="top" class="svc">
    <!-- ═══════════════════════════════════════════════════════════
         ١. الافتتاحية — لوح زجاجي وجسم الخدمة الثلاثي

         ⚠️ الجسم مش زينة: هو هوية الخدمة مجسّدة — كل خدمة إلها
            هندستها (تضاريس ترتيب للسيو، مدارات للهوية، طبقات
            عصبية للوكلاء…). بيدور لحاله، بيميل مع المؤشّر،
            والضغطة بتعطيه نبضة. المحرّك: scripts/service3d.js
         ═══════════════════════════════════════════════════════════ -->
    <header class="svc-hero" data-s3d-stage>
      <div class="container hero-grid">
        <div class="hero-copy">
          <a class="back" href={`${p}/services/`} data-reveal>{t.back}</a>

          <div class="kickers" data-reveal>
            <p class="kicker">{c.name}</p>
            {soon && <p class="kicker soon-badge">{t.soonBadge}</p>}
          </div>
          <h1 data-reveal>{c.h1}</h1>
          <p class="intro" data-reveal>{c.intro}</p>

          <!-- وعد الإعلان الممول لازم يتحقق بأول نظرة (تطابق الرسالة):
               قبل الزر عشان يضل فوق الطية عالموبايل حتى بالصفحات طويلة الهيرو -->
          {!soon && <p class="hero-note" data-reveal>{t.heroNote}</p>}
          <div class="hero-cta" data-reveal>
            <a class="btn primary" href={soon ? '#notify' : briefHref}>
              {soon ? t.soonBtn : t.ctaBtn}
            </a>
            <a class="btn ghost" href={`${p}${service.proof}/`}>{t.proofLink}</a>
          </div>
        </div>

        <div class="stage" aria-hidden="true">
          <Service3D service={service.id} />
        </div>
      </div>
    </header>

    {
      lpFilm && (
        <section class="lp-film">
          <div class="container">
            <LpFilm film={lpFilm.film} dur={lpFilm.dur} lang={lang} />
          </div>
        </section>
      )
    }

    <!-- ═══════════════════════════════════════════════════════════
         ١·٥ ليش هاي الخدمة أصلاً

         ✏️ اختياري بـservices.json: `why` مصفوفة فقرات.
         ⚠️ مش تكرار للمقدمة. المقدمة بتقول شو الخدمة، وهاي بتقول
            ليش موجودة أصلاً وشو القصة وراها. طلبها ريّان صراحةً
            للخدمات الجديدة: «ليش بدنا نضيف هيك خدمه والالم
            والاهميه والقصص».
         ═══════════════════════════════════════════════════════════ -->
    {
      c.why?.length > 0 && (
        <section class="band">
          <div class="container">
            <h2 data-reveal>{t.whyTitle}</h2>
            <div class="why" data-stagger>
              {c.why.map((x: string) => (
                <p>{x}</p>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- ═══ ٢. الوجع — سطور كبيرة على عمود ليموني بيضوي بالمرور ═══ -->
    <section class="band">
      <div class="container">
        <h2 data-reveal>{t.painTitle}</h2>
        <ul class="pain" data-stagger>
          {c.pain.map((x) => <li class="pain-row"><span>{x}</span></li>)}
        </ul>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════
         ٣. شو بتاخد — منظومة على عمود فقري، مش قائمة صحّات

         ⚠️ الشكل مقصود يحكي نفس رسالة التقرير: الخدمة **نظام
            مترابط** — بنود متناوبة حول خط واحد بيربطهم، وكل بند
            وصلته الخاصة فيه. عالموبايل بيرجعوا عمود واحد.
         ═══════════════════════════════════════════════════════════ -->
    <section class="band">
      <div class="container">
        <h2 data-reveal>{t.deliverTitle}</h2>
        <ol class="sys" data-stagger>
          {deliverParts.map((d) => (
            <li class="sys-item">
              <div class="sys-card">
                <strong>{d.head}</strong>
                {d.rest && <p>{d.rest}</p>}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════
         ٣ب. تحت الغطا — قصص تقنية بتفرجي عمق المجال (اختيارية)
         بلاطات بتنفتح بالضغط. طلب ريّان لصفحة السيو تحديداً:
         «الموضوع معقد وهاد لازم يبين» — بلا ذكر أي أداة داخلية.
         ═══════════════════════════════════════════════════════════ -->
    {
      stories.length > 0 && (
        <section class="band">
          <div class="container">
            <h2 data-reveal>{c.storiesTitle}</h2>
            <p class="stories-intro" data-reveal>{c.storiesIntro}</p>
            <div class="tiles" data-stagger>
              {stories.map((s: any) => (
                <button class="tile" type="button" aria-expanded="false" data-tile>
                  <span class="tile-head">
                    <strong>{s.t}</strong>
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
                      <path d="M12 5v14M5 12h14" />
                    </svg>
                  </span>
                  <span class="tile-body">
                    <span>{s.b}</span>
                  </span>
                </button>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- ═══════════════════════════════════════════════════════════
         ٣ج. شبكة الترابط (#60) — الصراحة اللي بتبيع
         «هاي الخدمة لحالها مش بالضرورة بتحل البيع» + مين بيكمّلها
         وليش. كل بطاقة رابط داخلي لخدمتها — صراحة للزائر وقوة
         روابط لجوجل بنفس الوقت.
         ═══════════════════════════════════════════════════════════ -->
    {
      pairs.length > 0 && (
        <section class="band">
          <div class="container">
            <h2 data-reveal>{netT.title}</h2>
            <p class="net-body" data-reveal>{netT.body}</p>
            <div class="net" data-stagger>
              {pairs.map((x: any) => (
                <a class="net-card" href={x.href}>
                  <span class="net-name">
                    {x.name}
                    {x.soon && <em class="net-soon">{netT.soonTag}</em>}
                  </span>
                  <span class="net-why">{x.why}</span>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- ═══ ٤. الإثبات ═══ -->
    <section class="band">
      <div class="container">
        <h2 data-reveal>{t.proofTitle}</h2>
        <div class="stats" data-stagger>
          {stats.map((s) => (
            <div class="stat">
              <span class="n">{s.n}</span>
              <span class="l">{s.l}</span>
            </div>
          ))}
        </div>
        <a class="btn ghost" href={`${p}${service.proof}/`} data-reveal>{t.proofLink}</a>
      </div>
    </section>

    <!-- ═══ ٥. الأسئلة ═══
         details/summary أصلية: بتشتغل بلا جافاسكربت، وقارئ الشاشة
         بيفهمها لحاله، وجوجل بيقرا الجواب حتى وهو مسكّر. -->
    <section class="band">
      <div class="container">
        <h2 data-reveal>{t.faqTitle}</h2>
        <div class="faq" data-stagger>
          {c.faq.map((f) => (
            <details>
              <summary>
                <span>{f.q}</span>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ ٥.٥ «وظّف وكيلك» — بس بصفحة وكلاء الذكاء والأتمتة ═══
         محاكاة يوم كامل من شغل الوكيل (طلب ريّان 2026-08-04):
         بيلعبها ← بيتحمس ← نموذج قائمة الانتظار تحتها مباشرة -->
    {service.slug === 'ai-agents-automation' && <AgentDaySection lang={lang} cta={soon ? '#notify' : briefHref} />}

    <!-- ═══════════════════════════════════════════════════════════
         لعبة الخدمة (طلب ريّان 2026-08-05): كل صفحة خدمة فيها
         اللعبة الأقرب لموضوعها — آخر مقنع قبل الفورم. نفس مبدأ
         لعبة الوكيل فوق: بيجرب قبل ما يقرر.
         الخريطة: مواقع←حاسبة الخسارة · إعلانات←محاكي الميزانية ·
         هوية←عين البراند · سوشال←عداد الانتباه · فيديو←مختبر الأفكار ·
         استراتيجية←ارسم عميلك · سيو←الرحلة المسرّبة ·
         استشارات←كشف الشركة · بيانات←فارز الأرقام
         ═══════════════════════════════════════════════════════════ -->
    {service.slug === 'websites' && <LossSection lang={lang} id="svc-game" />}
    {service.slug === 'paid-ads' && <BudgetSection lang={lang} id="svc-game" compact />}
    {service.slug === 'brand-identity' && <BrandEyeSection lang={lang} compact href={`${p}/work/luvit/#brand-eye`} />}
    {service.slug === 'social-media' && <AttentionCounterSection lang={lang} id="svc-game" />}
    {service.slug === 'video-editing' && <LampLab lang={lang} id="svc-game" />}
    {service.slug === 'marketing-strategy' && <PersonaBuilderSection lang={lang} id="svc-game" />}
    {service.slug === 'seo' && <LeakyJourneySection lang={lang} id="svc-game" />}
    {service.slug === 'consulting' && <CompanyDetectorSection lang={lang} id="svc-game" />}
    {service.slug === 'data-analysis' && <NumberSorterSection lang={lang} id="svc-game" />}

    <!-- ═══════════════════════════════════════════════════════════
         ٦. الطلب، الفورم نفسه، مش زر بيودّي لصفحة تانية

         ⚠️ كان هون زر «ابدأ الطلب» بيروح لـ /brief/. رصدها ريّان:
            بعد ما الزائر قرأ الصفحة كاملة واقتنع، بنطلب منه ضغطة
            إضافية وانتقال صفحة، وكل خطوة زيادة بتخسّر ناس بالضبط
            عند اللحظة اللي اقتنعوا فيها.
         ⚠️ preselect بيخلّي الخدمة مختارة سلفاً، فبيفتح على الخطوة
            الأولى وخدمته محدّدة. ما بيقعد يدوّر عليها بقائمة.
         ═══════════════════════════════════════════════════════════ -->
    {
      soon ? (
        /* ═══════════════════════════════════════════════════════
           قائمة انتظار — مش نموذج طلب

           ⚠️ بيبعت على نفس مسار `/brief` بالـWorker، فما احتجنا
              نلمس البنية الشغّالة ولا ننشر Worker جديد. التسجيل
              بيوصل ريّان إيميل وتيليجرام زي أي طلب — يعني هو
              **عميل محتمل حقيقي** مش سطر بقاعدة بيانات ميتة.
           ⚠️ حقل `website` مخفي — فخّ سبام. الـWorker بيرجّع «تمام»
              لو انتعبّى، فالروبوت ما بيعرف إنه انكشف.
           ═══════════════════════════════════════════════════════ */
        <section class="band" id="notify">
          <div class="container">
            <div class="cta notify">
              <h2 data-reveal>{t.soonTitle}</h2>
              <p data-reveal>{t.soonBody}</p>

              <form class="nform" data-notify data-service={c.name} data-lang={lang} novalidate>
                <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />

                <div class="nrow">
                  <label>
                    <span>{t.soonName}</span>
                    <input name="name" required autocomplete="name" />
                  </label>
                  <label>
                    <span>{t.soonMail}</span>
                    <input name="mail" type="email" required autocomplete="email" inputmode="email" />
                  </label>
                  <label>
                    <span>{t.soonPhone}</span>
                    <input name="phone" autocomplete="tel" inputmode="tel" />
                  </label>
                </div>

                <div class="nactions">
                  <button class="btn primary" type="submit" data-label={t.soonBtn} data-sending={t.soonSending}>
                    {t.soonBtn}
                  </button>
                  <a class="btn ghost" href={whatsapp} target="_blank" rel="noreferrer">
                    {t.soonAlt}
                  </a>
                </div>

                <p class="nmsg" data-msg data-done={t.soonDone} data-err={t.soonErr} role="status" />
              </form>
            </div>
          </div>
        </section>
      ) : (
        <section class="band" id="brief">
          <div class="container">
            <BriefSection lang={lang} bare preselect={service.id} />
          </div>
        </section>
      )
    }

    <!-- ═══ ٧. باقي الخدمات ═══ -->
    <section class="band">
      <div class="container">
        <h2 data-reveal>{t.othersTitle}</h2>
        <div class="others" data-stagger>
          {others.map((s) => (
            <a class="ocard" href={`${p}/services/${s.slug}/`}>
              <h3>{s[L].name}</h3>
              <p>{s[L].menuDesc}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <Particles src="/assets/logo-white.png" size="small" />
  </main>

  <Footer lang={lang} />

  <script>
    // ═══════════════════════════════════════════════════════════
    //  بلاطات «تحت الغطا» — فتح/سكّر بالضغط
    //  بلاطة وحدة مفتوحة بنفس الوقت، عشان القارئ يركّز بقصة قصة.
    // ═══════════════════════════════════════════════════════════
    function initTiles() {
      const tiles = [...document.querySelectorAll('[data-tile]')] as HTMLElement[];
      tiles.forEach((tile) => {
        if (tile.dataset.wired) return;
        tile.dataset.wired = '1';
        tile.addEventListener('click', () => {
          const open = tile.getAttribute('aria-expanded') === 'true';
          tiles.forEach((x) => x.setAttribute('aria-expanded', 'false'));
          if (!open) tile.setAttribute('aria-expanded', 'true');
        });
      });
    }
    initTiles();
    document.addEventListener('astro:page-load', initTiles);
  </script>

  <script is:inline>
    // ═══════════════════════════════════════════════════════════
    //  إرسال قائمة الانتظار
    //  بينزّل على نفس مسار /brief — الخدمة بتنبعت كـservice
    //  عشان يعرف ريّان أي خدمة انسجّل عليها.
    //  ⚠️ ClientRouter بيعيد بناء الصفحة، فمنربط على astro:page-load
    //     مش DOMContentLoaded (شوف الشرح بـmotion.js).
    // ═══════════════════════════════════════════════════════════
    (function () {
      var API = 'https://ryanalali-api.ryanalali-api.workers.dev';

      function wire() {
        var f = document.querySelector('form[data-notify]');
        if (!f || f.dataset.wired) return;
        f.dataset.wired = '1';

        var msg = f.querySelector('[data-msg]');
        var btn = f.querySelector('button[type="submit"]');

        f.addEventListener('submit', async function (e) {
          e.preventDefault();
          var d = new FormData(f);
          var name = (d.get('name') || '').toString().trim();
          var mail = (d.get('mail') || '').toString().trim();

          if (!name || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(mail)) {
            msg.textContent = msg.dataset.err;
            msg.className = 'nmsg is-err';
            return;
          }

          btn.disabled = true;
          btn.textContent = btn.dataset.sending;
          msg.textContent = '';
          msg.className = 'nmsg';

          var svc = f.dataset.service;
          var lang = f.dataset.lang;
          var note =
            lang === 'ar'
              ? 'تسجيل بقائمة انتظار خدمة «' + svc + '» — لسا ما فتحت.'
              : 'Waitlist signup for "' + svc + '" — not open yet.';

          try {
            var r = await fetch(API + '/brief', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({
                name: name,
                mail: mail,
                phone: (d.get('phone') || '').toString().trim(),
                website: (d.get('website') || '').toString(),
                services: [svc],
                details: note,
                lang: lang,
              }),
            });
            if (!r.ok) throw new Error(String(r.status));
            msg.textContent = msg.dataset.done;
            msg.className = 'nmsg is-done';
            f.querySelector('.nrow').hidden = true;
            btn.hidden = true;
          } catch (err) {
            msg.textContent = msg.dataset.err;
            msg.className = 'nmsg is-err';
            btn.disabled = false;
            btn.textContent = btn.dataset.label;
          }
        });
      }

      wire();
      document.addEventListener('astro:page-load', wire);
    })();
  </script>
</Base>

<style>
  /* ╔═══════════════ 🎛️ لوحة التحكم ═══════════════╗ */
  .svc {
    /* ⚠️ العنوان جوّا لوح بنص الشاشة — أكبر من هيك بيكسر لأربع
       أسطر بالعربي وبيطرد الأزرار برّا أول شاشة */
    --title: clamp(27px, 3.1vw, 42px);
    --h2: clamp(24px, 3vw, 38px);
    --band-gap: clamp(72px, 10vh, 120px);
  }

  /* ═══════════════ الافتتاحية ═══════════════
     لوح نصي بجهة البداية وجسم الخدمة الثلاثي بجهة النهاية —
     نفس لغة هيرو الرئيسية (زجاج + خط ليموني). */
  .svc-hero {
    position: relative;
    padding-top: calc(96px + clamp(18px, 3.5vh, 40px));
    /* بيملى أول شاشة تقريباً بلا ما يجبر سكرول عالشاشات القصيرة */
    min-height: min(92dvh, 860px);
    display: flex;
    align-items: center;
    overflow: clip;
  }

  /* وهج ليموني خافت جداً ورا المسرح — بيقعّد الجسم بالفراغ */
  .svc-hero::before {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-end: -10%;
    width: 62%;
    background: radial-gradient(
      55% 48% at 60% 50%,
      color-mix(in srgb, var(--accent) 7%, transparent),
      transparent 75%
    );
    pointer-events: none;
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: center;
    width: 100%;
  }

  .hero-copy {
    position: relative;
    isolation: isolate;
    padding: clamp(24px, 3vw, 44px);
    border-radius: 26px;
    background: linear-gradient(
      160deg,
      rgba(27, 30, 36, 0.72),
      rgba(14, 15, 18, 0.62)
    );
    backdrop-filter: blur(22px) saturate(150%);
    -webkit-backdrop-filter: blur(22px) saturate(150%);
    border: 1px solid rgba(242, 243, 238, 0.11);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      0 28px 70px rgba(0, 0, 0, 0.45);
  }

  /* خط الهوية الليموني على حافة البداية — توقيع الموقع */
  .hero-copy::before {
    content: '';
    position: absolute;
    inset-block: clamp(24px, 3vw, 44px);
    inset-inline-start: 0;
    width: 3px;
    border-radius: var(--r-pill);
    background: linear-gradient(
      to bottom,
      var(--accent),
      color-mix(in srgb, var(--accent) 30%, transparent)
    );
  }

  @supports not (backdrop-filter: blur(4px)) {
    .hero-copy { background: rgba(14, 15, 18, 0.92); }
  }

  /* ═══ مسرح الجسم الثلاثي ═══ */
  .stage {
    position: relative;
    height: clamp(360px, 58vh, 620px);
    /* بيلمّح إنه حي: المؤشّر بيتغيّر والضغطة بتنبّضه */
    cursor: crosshair;
    touch-action: pan-y;
  }

  .back {
    display: inline-block;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 22px;
    transition: color 0.3s var(--ease-out);
  }
  .back:hover { color: var(--accent); }

  /* ─── العنوان ─── */
  .kicker {
    display: inline-block;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    border-radius: var(--r-pill);
    padding: 6px 14px;
    margin-bottom: 20px;
  }
  html[lang='ar'] .kicker { letter-spacing: 0; text-transform: none; }

  .kickers {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  /* ─── بادج «قريباً» ───
     معبّى مش مفرّغ، عشان يقرا كحالة مش كتصنيف. ونبضة هادية
     بتقول «هاد إشي جاي» بلا ما تشدّ الانتباه عن العنوان. */
  .soon-badge {
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    animation: soon-pulse 3.4s var(--ease-out) infinite;
  }

  @keyframes soon-pulse {
    0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 26%, transparent); }
    55% { box-shadow: 0 0 0 7px transparent; }
  }

  @media (prefers-reduced-motion: reduce) {
    .soon-badge { animation: none; }
  }

  /* ─── كتلة «ليش هاي الخدمة» ───
     فقرات مقروءة بعرض محدود. أول فقرة أكبر شوي لأنها بتحمل
     الفكرة كلها واللي بيقرا سطر واحد بس لازم يمسكها. */
  .why {
    display: grid;
    gap: 18px;
    max-width: 66ch;
  }

  .why p {
    color: var(--dim);
    font-size: clamp(15px, 1.6vw, 17.5px);
    line-height: 1.85;
  }

  .why p:first-child {
    color: var(--text);
    font-size: clamp(16px, 1.8vw, 20px);
    padding-inline-start: 16px;
    border-inline-start: 2px solid color-mix(in srgb, var(--accent) 50%, transparent);
  }

  h1 {
    font-size: var(--title);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.025em;
    max-width: 18ch;
    margin-bottom: 20px;
  }
  html[lang='ar'] h1 { font-weight: 800; letter-spacing: 0; line-height: 1.28; }

  .intro {
    color: var(--muted);
    font-size: clamp(15px, 1.7vw, 19px);
    line-height: 1.75;
    max-width: 60ch;
    margin-bottom: 32px;
  }

  /* ─── الأزرار ─── */
  .hero-cta { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero-note { margin: -14px 0 20px; font-size: 0.92rem; color: var(--muted); }

  .lp-film { padding: 34px 0 4px; }

  .btn {
    display: inline-flex;
    align-items: center;
    font-size: 15px;
    font-weight: 600;
    border-radius: var(--r-pill);
    padding: 13px 26px;
    transition: transform 0.3s var(--ease-out), background 0.3s var(--ease-out), color 0.3s var(--ease-out);
  }
  .btn:hover { transform: translateY(-2px); }

  .primary { background: var(--accent); color: var(--accent-ink); }
  .primary:hover { background: color-mix(in srgb, var(--accent) 85%, #fff); }

  .ghost { border: 1px solid var(--line); color: var(--text); }
  .ghost:hover { border-color: var(--accent); color: var(--accent); }

  /* ─── الأشرطة ─── */
  .band { margin-top: var(--band-gap); }

  h2 {
    font-size: var(--h2);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 28px;
    max-width: 24ch;
  }
  html[lang='ar'] h2 { font-weight: 800; letter-spacing: 0; }

  /* ═══════════════ الوجع ═══════════════
     سطور كبيرة عارية — بلا صناديق. كل سطر على عمود بيضوي أحمر
     خفيف بالمرور: «هاي مشكلة» بتنحس قبل ما تنقرا. */
  .pain {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 62ch;
  }

  .pain-row {
    border-inline-start: 2px solid color-mix(in srgb, var(--danger) 24%, var(--line));
    padding: clamp(16px, 2.2vh, 24px) clamp(16px, 2vw, 26px);
    transition: border-color 0.35s var(--ease-out), background 0.35s var(--ease-out);
  }

  .pain-row + .pain-row {
    margin-top: 2px;
  }

  .pain-row span {
    display: block;
    color: var(--dim);
    font-size: clamp(16px, 2vw, 21px);
    font-weight: 600;
    line-height: 1.6;
    transition: color 0.35s var(--ease-out);
  }

  .pain-row:hover {
    border-inline-start-color: var(--danger);
    background: color-mix(in srgb, var(--danger) 4%, transparent);
  }

  .pain-row:hover span { color: var(--text); }

  /* ═══════════════ المنظومة ═══════════════
     بنود متناوبة حول عمود فقري ليموني، وكل بند وصلة بتربطه فيه.
     الشكل بيحكي الرسالة: هاي منظومة مترابطة مش قائمة منفصلة. */
  .sys {
    --spine: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: clamp(40px, 6vw, 88px);
    row-gap: clamp(14px, 2.2vh, 22px);
    max-width: 960px;
  }

  /* العمود الفقري */
  .sys::before {
    content: '';
    position: absolute;
    inset-block: 8px;
    left: 50%;
    width: var(--spine);
    transform: translateX(-50%);
    border-radius: var(--r-pill);
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--accent) 55%, transparent),
      color-mix(in srgb, var(--accent) 12%, transparent)
    );
  }

  .sys-item { position: relative; }

  /* التناوب: فردي يمين العمود، زوجي يساره (منطقياً حسب الاتجاه) */
  .sys-item:nth-child(odd) { grid-column: 1; }
  .sys-item:nth-child(even) { grid-column: 2; margin-top: clamp(28px, 5vh, 48px); }

  /* الوصلة من العمود للبند */
  .sys-item::before {
    content: '';
    position: absolute;
    top: 28px;
    width: clamp(20px, 3vw, 44px);
    height: 2px;
    background: color-mix(in srgb, var(--accent) 40%, transparent);
  }
  .sys-item:nth-child(odd)::before { inset-inline-end: calc(clamp(20px, 3vw, 44px) * -1 - 1px); }
  .sys-item:nth-child(even)::before { inset-inline-start: calc(clamp(20px, 3vw, 44px) * -1 - 1px); }

  .sys-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    padding: clamp(16px, 2vw, 22px) clamp(18px, 2.2vw, 26px);
    transition: border-color 0.3s var(--ease-out), background 0.3s var(--ease-out), transform 0.3s var(--ease-out);
  }

  .sys-card:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    background: var(--surface-2);
    transform: translateY(-2px);
  }

  .sys-card strong {
    display: block;
    font-size: clamp(15px, 1.7vw, 17.5px);
    font-weight: 700;
    line-height: 1.5;
  }

  .sys-card p {
    margin-top: 6px;
    color: var(--muted);
    font-size: clamp(13.5px, 1.4vw, 15px);
    line-height: 1.7;
  }

  /* ═══════════════ تحت الغطا ═══════════════
     بلاطات بتنفتح بالضغط — العنوان بيشدّ والجواب بيتكشف. */
  .stories-intro {
    color: var(--muted);
    font-size: clamp(15px, 1.6vw, 17px);
    line-height: 1.7;
    max-width: 58ch;
    margin-bottom: 26px;
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    max-width: 960px;
  }

  /* خمس قصص = ٢+٢+١، والأخيرة بتاخد العرض كله */
  .tile:nth-child(5):last-child { grid-column: 1 / -1; }

  .tile {
    text-align: start;
    font: inherit;
    color: inherit;
    cursor: pointer;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    padding: 20px 22px;
    transition: border-color 0.3s var(--ease-out), background 0.3s var(--ease-out);
  }

  .tile:hover { border-color: color-mix(in srgb, var(--accent) 40%, transparent); }

  .tile[aria-expanded='true'] {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    background: var(--surface-2);
  }

  .tile-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }

  .tile-head strong {
    font-size: clamp(15px, 1.7vw, 17.5px);
    font-weight: 700;
    line-height: 1.5;
  }

  .tile-head svg {
    flex-shrink: 0;
    color: var(--accent);
    transition: transform 0.35s var(--ease-out);
  }

  .tile[aria-expanded='true'] .tile-head svg { transform: rotate(45deg); }

  /* التكشف بلا قياس ارتفاعات: صفوف الشبكة من 0fr لـ 1fr */
  .tile-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s var(--ease-out);
  }

  .tile-body > span {
