---
// ═══════════════════════════════════════════════════════════════
//  قالب صفحة الخدمة — قمع بيع كامل مش صفحة تعريف
//
//  الترتيب مقصود ومبني على رحلة القرار:
//  ١. العنوان بالمشكلة (مش باسم الخدمة) — عشان يحس إنه المقصود
//  ٢. الوجع — يشوف حالته مكتوبة قدامه
//  ٣. شو بياخد — الحل بشكل ملموس
//  ٤. الإثبات — شغل حقيقي وأرقام
//  ٥. الأسئلة — بنقتل الاعتراضات قبل ما يسألها
//  ٦. الطلب — والخدمة مختارة مسبقاً
//  ٧. باقي الخدمات — روابط داخلية (بتفيد الزائر وجوجل سوا)
//
//  ✏️ كل النصوص من src/data/services.json — ما في نص مكتوب هون
// ═══════════════════════════════════════════════════════════════
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Particles from '../components/Particles.astro';
import BriefSection from '../components/BriefSection.astro';
import servicesData from '../data/services.json';
import work from '../data/work.json';

interface Props {
  lang: 'en' | 'ar';
  id: string;
}

const { lang, id } = Astro.props;
const isAr = lang === 'ar';
const L = isAr ? 'ar' : 'en';
const p = isAr ? '/ar' : '';

const service = servicesData.services.find((s) => s.id === id);
if (!service) throw new Error(`Service "${id}" مش موجودة بـ services.json`);

const c = service[L];

// ⚠️ خدمة «قريباً»: لسا ما فتحت. بتاخد صفحتها كاملة بالضبط —
//    الشرح والوجع والتسليمات والأسئلة — بس بدل نموذج الطلب
//    بيكون في نموذج تسجيل بقائمة الانتظار. ريّان: «حطها انه
//    حاليا مش متاحه ولكن قريبا حتكون متاحه».
const soon = service.soon === true;

// باقي الخدمات — للروابط الداخلية آخر الصفحة
const others = servicesData.services
  .filter((s) => s.id !== id)
  .sort((a, b) => a.order - b.order);

// ─── نصوص الواجهة ───
const t = isAr
  ? {
      back: '→ كل الخدمات',
      painTitle: 'إذا هاي حالتك، إحنا بنحكي عن نفس الإشي',
      deliverTitle: 'شو بتاخد بالضبط',
      proofTitle: 'شغل حقيقي مش كلام',
      proofLink: 'شوف الشغل كله ←',
      faqTitle: 'أسئلة بتيجي دايماً',
      ctaTitle: 'احكيلي عن مشروعك',
      ctaBody: 'عبّي الطلب بثلاث خطوات قصيرة وبرجعلك خلال ٢٤ ساعة برأي واضح: شو بينفع، شو لأ، ومن وين نبدأ.',
      ctaBtn: 'ابدأ الطلب',
      ctaAlt: 'أو احكيني واتساب مباشرة',
      othersTitle: 'خدمات ثانية',
      soonBadge: 'قريباً',
      whyTitle: 'ليش هاي الخدمة أصلاً',
      soonTitle: 'لسا ما فتحت. بس بتقدر تكون أول واحد',
      soonBody:
        'عم أبني الأساس هلق، وما بحب أبيع إشي قبل ما يكون جاهز وقابل للتكرار. سجّل إيميلك وبوصلك خبر أول ما تفتح — وبتاخد أول شهر بسعر التأسيس.',
      soonName: 'اسمك',
      soonMail: 'إيميلك',
      soonPhone: 'واتساب (اختياري)',
      soonBtn: 'سجّلني لما تنزل',
      soonSending: 'عم أسجّلك…',
      soonDone: 'تمام، انسجّلت. رح أحكيك أول ما تفتح.',
      soonErr: 'صار خلل. جرّب كمان مرة أو احكيني واتساب.',
      soonAlt: 'أو احكيني واتساب مباشرة',
    }
  : {
      back: '← All services',
      painTitle: "If this is your situation, we're talking about the same thing",
      deliverTitle: 'What you actually get',
      proofTitle: 'Real work, not claims',
      proofLink: 'See all the work →',
      faqTitle: 'Questions that always come up',
      ctaTitle: 'Tell me about your project',
      ctaBody: 'Three short steps, and you hear back within 24 hours with a clear opinion: what works, what does not, and where to start.',
      ctaBtn: 'Start the brief',
      ctaAlt: 'Or message me on WhatsApp',
      othersTitle: 'Other services',
      soonBadge: 'Coming soon',
      whyTitle: 'Why this service exists',
      soonTitle: 'Not open yet. You can be first in line',
      soonBody:
        'I am building the foundation now, and I do not sell anything before it is ready and repeatable. Leave your email and you will hear the moment it opens, with founding pricing on the first month.',
      soonName: 'Your name',
      soonMail: 'Your email',
      soonPhone: 'WhatsApp (optional)',
      soonBtn: 'Tell me when it launches',
      soonSending: 'Adding you…',
      soonDone: 'Done, you are on the list. I will reach out the moment it opens.',
      soonErr: 'Something broke. Try again or message me on WhatsApp.',
      soonAlt: 'Or message me on WhatsApp',
    };

// أرقام حقيقية — نفس أرقام قسم «ليش أنا» بالصفحة الرئيسية
const stats = isAr
  ? [
      { n: '2,395', l: 'متابع عضوي بـ ٣٠ يوم' },
      { n: '290K', l: 'مشاهدة على منشور واحد' },
      { n: '40%', l: 'وقت إنتاج أقل' },
    ]
  : [
      { n: '2,395', l: 'organic followers in 30 days' },
      { n: '290K', l: 'views on a single post' },
      { n: '40%', l: 'less production time' },
    ];

// ⚠️ الزر بينزّل الزائر على الفورم اللي بنفس الصفحة (#brief)
//    مش لصفحة تانية. الرابط الكامل بيضل مستخدم بالبيانات
//    المنظّمة تحت (availableChannel) لأنها بدها رابط مطلق.
const briefHref = `#brief`;
const briefUrl = `${p}/brief/?s=${service.id}`;
const site = Astro.site ?? new URL('https://ryanalali.me');

// ⚠️ الرقم بينقرا من work.json زي BriefSection بالضبط — ممنوع
//    يتكتب بإيدنا هون، لأنه لو تغيّر بينسى مكان وبيروح عميل لرقم ميت.
const whatsapp = `https://wa.me/${work.links.phone.replace(/[^0-9]/g, '')}`;

// ═══════════════════════════════════════════════════════════════
//  البيانات المنظّمة
//  • Service — بتقول لجوجل «هاي خدمة، مقدّمها فلان، بالأردن»
//  • FAQPage — بتخلّي الأسئلة تطلع مفتوحة تحت نتيجة البحث،
//    وبتتقرا من مساعدات الـ AI لما حدا يسأل نفس السؤال
// ═══════════════════════════════════════════════════════════════
const schema = [
  {
    '@type': 'Service',
    '@id': new URL(Astro.url.pathname, site).href + '#service',
    name: c.name,
    description: c.seoDesc,
    serviceType: c.name,
    provider: { '@id': new URL('/', site).href + '#person' },
    areaServed: [
      { '@type': 'Country', name: isAr ? 'الأردن' : 'Jordan' },
      { '@type': 'City', name: isAr ? 'عمّان' : 'Amman' },
    ],
    availableChannel: {
      '@type': 'ServiceChannel',
      serviceUrl: new URL(briefUrl, site).href,
    },
  },
  {
    '@type': 'FAQPage',
    mainEntity: c.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Base
  title={`${c.name} | ${isAr ? 'ريّان الواثق' : 'Rayan Elwathiq'}`}
  description={c.seoDesc}
  lang={lang}
  schema={schema}
>
  <Nav lang={lang} />

  <main id="top" class="svc">
    <div class="container">
      <a class="back" href={`${p}/services/`}>{t.back}</a>

      <!-- ═══ ١. العنوان بالمشكلة ═══ -->
      <div class="kickers" data-reveal>
        <p class="kicker">{c.name}</p>
        {soon && <p class="kicker soon-badge">{t.soonBadge}</p>}
      </div>
      <h1 data-reveal>{c.h1}</h1>
      <p class="intro" data-reveal>{c.intro}</p>

      <div class="hero-cta" data-reveal>
        <a class="btn primary" href={soon ? '#notify' : briefHref}>
          {soon ? t.soonBtn : t.ctaBtn}
        </a>
        <a class="btn ghost" href={`${p}${service.proof}/`}>{t.proofLink}</a>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════
         ١·٥ ليش هاي الخدمة أصلاً

         ✏️ اختياري بـservices.json: `why` مصفوفة فقرات.
         ⚠️ مش تكرار للمقدمة. المقدمة بتقول شو الخدمة، وهاي بتقول
            ليش موجودة أصلاً وشو القصة وراها. طلبها ريّان صراحةً
            للخدمات الجديدة: «ليش بدنا نضيف هيك خدمه والالم
            والاهميه والقصص».
         ═══════════════════════════════════════════════════════════ -->
    {
      c.why?.length > 0 && (
        <section class="band">
          <div class="container">
            <h2 data-reveal>{t.whyTitle}</h2>
            <div class="why" data-stagger>
              {c.why.map((x: string) => (
                <p>{x}</p>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- ═══ ٢. الوجع ═══ -->
    <section class="band">
      <div class="container">
        <h2 data-reveal>{t.painTitle}</h2>
        <ul class="pain" data-stagger>
          {c.pain.map((x) => <li>{x}</li>)}
        </ul>
      </div>
    </section>

    <!-- ═══ ٣. شو بتاخد ═══ -->
    <section class="band">
      <div class="container">
        <h2 data-reveal>{t.deliverTitle}</h2>
        <ul class="deliver" data-stagger>
          {c.deliver.map((x) => <li>{x}</li>)}
        </ul>
      </div>
    </section>

    <!-- ═══ ٤. الإثبات ═══ -->
    <section class="band">
      <div class="container">
        <h2 data-reveal>{t.proofTitle}</h2>
        <div class="stats" data-stagger>
          {stats.map((s) => (
            <div class="stat">
              <span class="n">{s.n}</span>
              <span class="l">{s.l}</span>
            </div>
          ))}
        </div>
        <a class="btn ghost" href={`${p}${service.proof}/`} data-reveal>{t.proofLink}</a>
      </div>
    </section>

    <!-- ═══ ٥. الأسئلة ═══
         details/summary أصلية: بتشتغل بلا جافاسكربت، وقارئ الشاشة
         بيفهمها لحاله، وجوجل بيقرا الجواب حتى وهو مسكّر. -->
    <section class="band">
      <div class="container">
        <h2 data-reveal>{t.faqTitle}</h2>
        <div class="faq" data-stagger>
          {c.faq.map((f) => (
            <details>
              <summary>
                <span>{f.q}</span>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════
         ٦. الطلب، الفورم نفسه، مش زر بيودّي لصفحة تانية

         ⚠️ كان هون زر «ابدأ الطلب» بيروح لـ /brief/. رصدها ريّان:
            بعد ما الزائر قرأ الصفحة كاملة واقتنع، بنطلب منه ضغطة
            إضافية وانتقال صفحة، وكل خطوة زيادة بتخسّر ناس بالضبط
            عند اللحظة اللي اقتنعوا فيها.
         ⚠️ preselect بيخلّي الخدمة مختارة سلفاً، فبيفتح على الخطوة
            الأولى وخدمته محدّدة. ما بيقعد يدوّر عليها بقائمة.
         ═══════════════════════════════════════════════════════════ -->
    {
      soon ? (
        /* ═══════════════════════════════════════════════════════
           قائمة انتظار — مش نموذج طلب

           ⚠️ بيبعت على نفس مسار `/brief` بالـWorker، فما احتجنا
              نلمس البنية الشغّالة ولا ننشر Worker جديد. التسجيل
              بيوصل ريّان إيميل وتيليجرام زي أي طلب — يعني هو
              **عميل محتمل حقيقي** مش سطر بقاعدة بيانات ميتة.
           ⚠️ حقل `website` مخفي — فخّ سبام. الـWorker بيرجّع «تمام»
              لو انتعبّى، فالروبوت ما بيعرف إنه انكشف.
           ═══════════════════════════════════════════════════════ */
        <section class="band" id="notify">
          <div class="container">
            <div class="cta notify">
              <h2 data-reveal>{t.soonTitle}</h2>
              <p data-reveal>{t.soonBody}</p>

              <form class="nform" data-notify data-service={c.name} data-lang={lang} novalidate>
                <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />

                <div class="nrow">
                  <label>
                    <span>{t.soonName}</span>
                    <input name="name" required autocomplete="name" />
                  </label>
                  <label>
                    <span>{t.soonMail}</span>
                    <input name="mail" type="email" required autocomplete="email" inputmode="email" />
                  </label>
                  <label>
                    <span>{t.soonPhone}</span>
                    <input name="phone" autocomplete="tel" inputmode="tel" />
                  </label>
                </div>

                <div class="nactions">
                  <button class="btn primary" type="submit" data-label={t.soonBtn} data-sending={t.soonSending}>
                    {t.soonBtn}
                  </button>
                  <a class="btn ghost" href={whatsapp} target="_blank" rel="noreferrer">
                    {t.soonAlt}
                  </a>
                </div>

                <p class="nmsg" data-msg data-done={t.soonDone} data-err={t.soonErr} role="status" />
              </form>
            </div>
          </div>
        </section>
      ) : (
        <section class="band" id="brief">
          <div class="container">
            <BriefSection lang={lang} bare preselect={service.id} />
          </div>
        </section>
      )
    }

    <!-- ═══ ٧. باقي الخدمات ═══ -->
    <section class="band">
      <div class="container">
        <h2 data-reveal>{t.othersTitle}</h2>
        <div class="others" data-stagger>
          {others.map((s) => (
            <a class="ocard" href={`${p}/services/${s.slug}/`}>
              <h3>{s[L].name}</h3>
              <p>{s[L].menuDesc}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <Particles src="/assets/logo-white.png" size="small" />
  </main>

  <Footer lang={lang} />

  <script is:inline>
    // ═══════════════════════════════════════════════════════════
    //  إرسال قائمة الانتظار
    //  بينزّل على نفس مسار /brief — الخدمة بتنبعت كـservice
    //  عشان يعرف ريّان أي خدمة انسجّل عليها.
    //  ⚠️ ClientRouter بيعيد بناء الصفحة، فمنربط على astro:page-load
    //     مش DOMContentLoaded (شوف الشرح بـmotion.js).
    // ═══════════════════════════════════════════════════════════
    (function () {
      var API = 'https://ryanalali-api.ryanalali-api.workers.dev';

      function wire() {
        var f = document.querySelector('form[data-notify]');
        if (!f || f.dataset.wired) return;
        f.dataset.wired = '1';

        var msg = f.querySelector('[data-msg]');
        var btn = f.querySelector('button[type="submit"]');

        f.addEventListener('submit', async function (e) {
          e.preventDefault();
          var d = new FormData(f);
          var name = (d.get('name') || '').toString().trim();
          var mail = (d.get('mail') || '').toString().trim();

          if (!name || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(mail)) {
            msg.textContent = msg.dataset.err;
            msg.className = 'nmsg is-err';
            return;
          }

          btn.disabled = true;
          btn.textContent = btn.dataset.sending;
          msg.textContent = '';
          msg.className = 'nmsg';

          var svc = f.dataset.service;
          var lang = f.dataset.lang;
          var note =
            lang === 'ar'
              ? 'تسجيل بقائمة انتظار خدمة «' + svc + '» — لسا ما فتحت.'
              : 'Waitlist signup for "' + svc + '" — not open yet.';

          try {
            var r = await fetch(API + '/brief', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({
                name: name,
                mail: mail,
                phone: (d.get('phone') || '').toString().trim(),
                website: (d.get('website') || '').toString(),
                services: [svc],
                details: note,
                lang: lang,
              }),
            });
            if (!r.ok) throw new Error(String(r.status));
            msg.textContent = msg.dataset.done;
            msg.className = 'nmsg is-done';
            f.querySelector('.nrow').hidden = true;
            btn.hidden = true;
          } catch (err) {
            msg.textContent = msg.dataset.err;
            msg.className = 'nmsg is-err';
            btn.disabled = false;
            btn.textContent = btn.dataset.label;
          }
        });
      }

      wire();
      document.addEventListener('astro:page-load', wire);
    })();
  </script>
</Base>

<style>
  /* ╔═══════════════ 🎛️ لوحة التحكم ═══════════════╗ */
  .svc {
    --title: clamp(34px, 5.4vw, 68px);
    --h2: clamp(24px, 3vw, 38px);
    --band-gap: clamp(64px, 9vh, 110px);
    padding-top: calc(108px + clamp(30px, 5vh, 60px));
  }

  .back {
    display: inline-block;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 26px;
    transition: color 0.3s var(--ease-out);
  }
  .back:hover { color: var(--accent); }

  /* ─── العنوان ─── */
  .kicker {
    display: inline-block;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    border-radius: var(--r-pill);
    padding: 6px 14px;
    margin-bottom: 20px;
  }
  html[lang='ar'] .kicker { letter-spacing: 0; text-transform: none; }

  .kickers {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  /* ─── بادج «قريباً» ───
     معبّى مش مفرّغ، عشان يقرا كحالة مش كتصنيف. ونبضة هادية
     بتقول «هاد إشي جاي» بلا ما تشدّ الانتباه عن العنوان. */
  .soon-badge {
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    animation: soon-pulse 3.4s var(--ease-out) infinite;
  }

  @keyframes soon-pulse {
    0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 26%, transparent); }
    55% { box-shadow: 0 0 0 7px transparent; }
  }

  @media (prefers-reduced-motion: reduce) {
    .soon-badge { animation: none; }
  }

  /* ─── كتلة «ليش هاي الخدمة» ───
     فقرات مقروءة بعرض محدود. أول فقرة أكبر شوي لأنها بتحمل
     الفكرة كلها واللي بيقرا سطر واحد بس لازم يمسكها. */
  .why {
    display: grid;
    gap: 18px;
    max-width: 66ch;
  }

  .why p {
    color: var(--dim);
    font-size: clamp(15px, 1.6vw, 17.5px);
    line-height: 1.85;
  }

  .why p:first-child {
    color: var(--text);
    font-size: clamp(16px, 1.8vw, 20px);
    padding-inline-start: 16px;
    border-inline-start: 2px solid color-mix(in srgb, var(--accent) 50%, transparent);
  }

  h1 {
    font-size: var(--title);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.025em;
    max-width: 18ch;
    margin-bottom: 20px;
  }
  html[lang='ar'] h1 { font-weight: 800; letter-spacing: 0; line-height: 1.28; }

  .intro {
    color: var(--muted);
    font-size: clamp(15px, 1.7vw, 19px);
    line-height: 1.75;
    max-width: 60ch;
    margin-bottom: 32px;
  }

  /* ─── الأزرار ─── */
  .hero-cta { display: flex; flex-wrap: wrap; gap: 12px; }

  .btn {
    display: inline-flex;
    align-items: center;
    font-size: 15px;
    font-weight: 600;
    border-radius: var(--r-pill);
    padding: 13px 26px;
    transition: transform 0.3s var(--ease-out), background 0.3s var(--ease-out), color 0.3s var(--ease-out);
  }
  .btn:hover { transform: translateY(-2px); }

  .primary { background: var(--accent); color: var(--accent-ink); }
