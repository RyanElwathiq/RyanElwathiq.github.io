---
// ═══════════════════════════════════════════════════════════════
//  قالب صفحة الخدمة — قمع بيع كامل مش صفحة تعريف
//
//  الترتيب مقصود ومبني على رحلة القرار:
//  ١. العنوان بالمشكلة (مش باسم الخدمة) — عشان يحس إنه المقصود
//  ٢. الوجع — يشوف حالته مكتوبة قدامه
//  ٣. شو بياخد — الحل بشكل ملموس
//  ٤. الإثبات — شغل حقيقي وأرقام
//  ٥. الأسئلة — بنقتل الاعتراضات قبل ما يسألها
//  ٦. الطلب — والخدمة مختارة مسبقاً
//  ٧. باقي الخدمات — روابط داخلية (بتفيد الزائر وجوجل سوا)
//
//  ✏️ كل النصوص من src/data/services.json — ما في نص مكتوب هون
// ═══════════════════════════════════════════════════════════════
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Particles from '../components/Particles.astro';
import servicesData from '../data/services.json';
import work from '../data/work.json';

interface Props {
  lang: 'en' | 'ar';
  id: string;
}

const { lang, id } = Astro.props;
const isAr = lang === 'ar';
const L = isAr ? 'ar' : 'en';
const p = isAr ? '/ar' : '';

const service = servicesData.services.find((s) => s.id === id);
if (!service) throw new Error(`Service "${id}" مش موجودة بـ services.json`);

const c = service[L];

// باقي الخدمات — للروابط الداخلية آخر الصفحة
const others = servicesData.services
  .filter((s) => s.id !== id)
  .sort((a, b) => a.order - b.order);

// ─── نصوص الواجهة ───
const t = isAr
  ? {
      back: '→ كل الخدمات',
      painTitle: 'إذا هاي حالتك، إحنا بنحكي عن نفس الإشي',
      deliverTitle: 'شو بتاخد بالضبط',
      proofTitle: 'شغل حقيقي مش كلام',
      proofLink: 'شوف الشغل كله ←',
      faqTitle: 'أسئلة بتيجي دايماً',
      ctaTitle: 'احكيلي عن مشروعك',
      ctaBody: 'عبّي الطلب بثلاث خطوات قصيرة وبرجعلك خلال ٢٤ ساعة برأي واضح: شو بينفع، شو لأ، ومن وين نبدأ.',
      ctaBtn: 'ابدأ الطلب',
      ctaAlt: 'أو احكيني واتساب مباشرة',
      othersTitle: 'خدمات ثانية',
    }
  : {
      back: '← All services',
      painTitle: "If this is your situation, we're talking about the same thing",
      deliverTitle: 'What you actually get',
      proofTitle: 'Real work, not claims',
      proofLink: 'See all the work →',
      faqTitle: 'Questions that always come up',
      ctaTitle: 'Tell me about your project',
      ctaBody: 'Three short steps, and you hear back within 24 hours with a clear opinion: what works, what does not, and where to start.',
      ctaBtn: 'Start the brief',
      ctaAlt: 'Or message me on WhatsApp',
      othersTitle: 'Other services',
    };

// أرقام حقيقية — نفس أرقام قسم «ليش أنا» بالصفحة الرئيسية
const stats = isAr
  ? [
      { n: '2,395', l: 'متابع عضوي بـ ٣٠ يوم' },
      { n: '290K', l: 'مشاهدة على منشور واحد' },
      { n: '40%', l: 'وقت إنتاج أقل' },
    ]
  : [
      { n: '2,395', l: 'organic followers in 30 days' },
      { n: '290K', l: 'views on a single post' },
      { n: '40%', l: 'less production time' },
    ];

const briefHref = `${p}/brief/?s=${service.id}`;
const site = Astro.site ?? new URL('https://ryanalali.me');

// ⚠️ الرقم بينقرا من work.json زي BriefSection بالضبط — ممنوع
//    يتكتب بإيدنا هون، لأنه لو تغيّر بينسى مكان وبيروح عميل لرقم ميت.
const whatsapp = `https://wa.me/${work.links.phone.replace(/[^0-9]/g, '')}`;

// ═══════════════════════════════════════════════════════════════
//  البيانات المنظّمة
//  • Service — بتقول لجوجل «هاي خدمة، مقدّمها فلان، بالأردن»
//  • FAQPage — بتخلّي الأسئلة تطلع مفتوحة تحت نتيجة البحث،
//    وبتتقرا من مساعدات الـ AI لما حدا يسأل نفس السؤال
// ═══════════════════════════════════════════════════════════════
const schema = [
  {
    '@type': 'Service',
    '@id': new URL(Astro.url.pathname, site).href + '#service',
    name: c.name,
    description: c.seoDesc,
    serviceType: c.name,
    provider: { '@id': new URL('/', site).href + '#person' },
    areaServed: [
      { '@type': 'Country', name: isAr ? 'الأردن' : 'Jordan' },
      { '@type': 'City', name: isAr ? 'عمّان' : 'Amman' },
    ],
    availableChannel: {
      '@type': 'ServiceChannel',
      serviceUrl: new URL(briefHref, site).href,
    },
  },
  {
    '@type': 'FAQPage',
    mainEntity: c.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Base
  title={`${c.name} | ${isAr ? 'ريّان الواثق' : 'Rayan Elwathiq'}`}
  description={c.seoDesc}
  lang={lang}
  schema={schema}
>
  <Nav lang={lang} />

  <main id="top" class="svc">
    <div class="container">
      <a class="back" href={`${p}/services/`}>{t.back}</a>

      <!-- ═══ ١. العنوان بالمشكلة ═══ -->
      <p class="kicker" data-reveal>{c.name}</p>
      <h1 data-reveal>{c.h1}</h1>
      <p class="intro" data-reveal>{c.intro}</p>

      <div class="hero-cta" data-reveal>
        <a class="btn primary" href={briefHref}>{t.ctaBtn}</a>
        <a class="btn ghost" href={`${p}${service.proof}/`}>{t.proofLink}</a>
      </div>
    </div>

    <!-- ═══ ٢. الوجع ═══ -->
    <section class="band">
      <div class="container">
        <h2 data-reveal>{t.painTitle}</h2>
        <ul class="pain" data-stagger>
          {c.pain.map((x) => <li>{x}</li>)}
        </ul>
      </div>
    </section>

    <!-- ═══ ٣. شو بتاخد ═══ -->
    <section class="band">
      <div class="container">
        <h2 data-reveal>{t.deliverTitle}</h2>
        <ul class="deliver" data-stagger>
          {c.deliver.map((x) => <li>{x}</li>)}
        </ul>
      </div>
    </section>

    <!-- ═══ ٤. الإثبات ═══ -->
    <section class="band">
      <div class="container">
        <h2 data-reveal>{t.proofTitle}</h2>
        <div class="stats" data-stagger>
          {stats.map((s) => (
            <div class="stat">
              <span class="n">{s.n}</span>
              <span class="l">{s.l}</span>
            </div>
          ))}
        </div>
        <a class="btn ghost" href={`${p}${service.proof}/`} data-reveal>{t.proofLink}</a>
      </div>
    </section>

    <!-- ═══ ٥. الأسئلة ═══
         details/summary أصلية: بتشتغل بلا جافاسكربت، وقارئ الشاشة
         بيفهمها لحاله، وجوجل بيقرا الجواب حتى وهو مسكّر. -->
    <section class="band">
      <div class="container">
        <h2 data-reveal>{t.faqTitle}</h2>
        <div class="faq" data-stagger>
          {c.faq.map((f) => (
            <details>
              <summary>
                <span>{f.q}</span>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ ٦. الطلب ═══ -->
    <section class="band cta-band">
      <div class="container">
        <div class="cta">
          <h2 data-reveal>{t.ctaTitle}</h2>
          <p data-reveal>{t.ctaBody}</p>
          <div class="hero-cta" data-reveal>
            <a class="btn primary" href={briefHref}>{t.ctaBtn}</a>
            <a class="btn ghost" href={whatsapp} target="_blank" rel="noopener">{t.ctaAlt}</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ ٧. باقي الخدمات ═══ -->
    <section class="band">
      <div class="container">
        <h2 data-reveal>{t.othersTitle}</h2>
        <div class="others" data-stagger>
          {others.map((s) => (
            <a class="ocard" href={`${p}/services/${s.slug}/`}>
              <h3>{s[L].name}</h3>
              <p>{s[L].menuDesc}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <Particles src="/assets/logo-white.png" size="small" />
  </main>

  <Footer lang={lang} />
</Base>

<style>
  /* ╔═══════════════ 🎛️ لوحة التحكم ═══════════════╗ */
  .svc {
    --title: clamp(34px, 5.4vw, 68px);
    --h2: clamp(24px, 3vw, 38px);
    --band-gap: clamp(64px, 9vh, 110px);
    padding-top: calc(108px + clamp(30px, 5vh, 60px));
  }

  .back {
    display: inline-block;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 26px;
    transition: color 0.3s var(--ease-out);
  }
  .back:hover { color: var(--accent); }

  /* ─── العنوان ─── */
  .kicker {
    display: inline-block;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    border-radius: var(--r-pill);
    padding: 6px 14px;
    margin-bottom: 20px;
  }
  html[lang='ar'] .kicker { letter-spacing: 0; text-transform: none; }

  h1 {
    font-size: var(--title);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.025em;
    max-width: 18ch;
    margin-bottom: 20px;
  }
  html[lang='ar'] h1 { font-weight: 800; letter-spacing: 0; line-height: 1.28; }

  .intro {
    color: var(--muted);
    font-size: clamp(15px, 1.7vw, 19px);
    line-height: 1.75;
    max-width: 60ch;
    margin-bottom: 32px;
  }

  /* ─── الأزرار ─── */
  .hero-cta { display: flex; flex-wrap: wrap; gap: 12px; }

  .btn {
    display: inline-flex;
    align-items: center;
    font-size: 15px;
    font-weight: 600;
    border-radius: var(--r-pill);
    padding: 13px 26px;
    transition: transform 0.3s var(--ease-out), background 0.3s var(--ease-out), color 0.3s var(--ease-out);
  }
  .btn:hover { transform: translateY(-2px); }

  .primary { background: var(--accent); color: var(--accent-ink); }
  .primary:hover { background: color-mix(in srgb, var(--accent) 85%, #fff); }

  .ghost { border: 1px solid var(--line); color: var(--text); }
  .ghost:hover { border-color: var(--accent); color: var(--accent); }

  /* ─── الأشرطة ─── */
  .band { margin-top: var(--band-gap); }

  h2 {
    font-size: var(--h2);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 28px;
    max-width: 24ch;
  }
  html[lang='ar'] h2 { font-weight: 800; letter-spacing: 0; }

  /* ─── الوجع: خط أحمر خفيف عاليسار ─── */
  .pain { display: grid; gap: 12px; max-width: 68ch; }

  .pain li {
    list-style: none;
    background: var(--surface);
    border: 1px solid var(--line);
    border-inline-start: 3px solid color-mix(in srgb, var(--danger) 70%, transparent);
    border-radius: var(--r-card);
    padding: 16px 20px;
    color: var(--dim);
    font-size: clamp(14.5px, 1.5vw, 16.5px);
    line-height: 1.65;
  }

  /* ─── التسليمات: شبكة بعلامة صح ليموني ─── */
  .deliver {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    max-width: 90ch;
  }

  .deliver li {
    list-style: none;
    position: relative;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    padding: 16px 20px;
    padding-inline-start: 46px;
    font-size: clamp(14.5px, 1.5vw, 16px);
    line-height: 1.6;
    transition: border-color 0.3s var(--ease-out), background 0.3s var(--ease-out);
  }
  .deliver li:hover { border-color: color-mix(in srgb, var(--accent) 45%, transparent); background: var(--surface-2); }

  .deliver li::before {
    content: '';
    position: absolute;
    inset-inline-start: 18px;
    top: 21px;
    width: 14px;
    height: 8px;
    border-inline-start: 2.4px solid var(--accent);
    border-bottom: 2.4px solid var(--accent);
    transform: rotate(-45deg);
  }

  /* ─── الأرقام ─── */
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-bottom: 26px;
    max-width: 80ch;
  }

  .stat {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    padding: 24px 20px;
  }

  .stat .n {
    display: block;
    font-family: var(--font-en);
    font-size: clamp(30px, 4.5vw, 46px);
    font-weight: 700;
    line-height: 1;
    color: var(--accent);
    letter-spacing: -0.03em;
    margin-bottom: 8px;
  }

  .stat .l { display: block; color: var(--muted); font-size: 13.5px; line-height: 1.5; }

  /* ─── الأسئلة ─── */
  .faq { display: grid; gap: 10px; max-width: 72ch; }

  details {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    overflow: hidden;
    transition: border-color 0.3s var(--ease-out);
  }
  details[open] { border-color: color-mix(in srgb, var(--accent) 40%, transparent); }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 20px;
    cursor: pointer;
    font-weight: 600;
    font-size: clamp(15px, 1.6vw, 17px);
    line-height: 1.5;
    list-style: none;
    transition: color 0.3s var(--ease-out);
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--accent); }

  summary svg {
    flex-shrink: 0;
    color: var(--accent);
    transition: transform 0.35s var(--ease-out);
  }
  details[open] summary svg { transform: rotate(45deg); }

  details p {
    padding: 0 20px 20px;
    color: var(--muted);
    font-size: clamp(14px, 1.5vw, 16px);
    line-height: 1.8;
  }

  /* ─── شريط الطلب ─── */
  .cta {
    background: var(--surface);
    border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
    border-radius: calc(var(--r-card) * 1.6);
    padding: clamp(30px, 5vw, 56px);
  }
  .cta h2 { margin-bottom: 14px; }
  .cta p { color: var(--muted); max-width: 56ch; line-height: 1.75; margin-bottom: 26px; }

  /* ─── باقي الخدمات ─── */
  .others {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .ocard {
    display: block;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    padding: 22px;
    transition: transform 0.3s var(--ease-out), border-color 0.3s var(--ease-out), background 0.3s var(--ease-out);
  }
  .ocard:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    background: var(--surface-2);
  }

  .ocard h3 { font-size: 17px; font-weight: 700; margin-bottom: 6px; }
  .ocard p { color: var(--muted); font-size: 13.5px; line-height: 1.55; }

  /* ─── الموبايل ─── */
  @media (max-width: 860px) {
    .deliver, .others { grid-template-columns: 1fr; }
    .stats { grid-template-columns: 1fr; }
    h1 { max-width: none; }
  }
</style>
