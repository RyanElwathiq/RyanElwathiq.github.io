---
// ═══════════════════════════════════════════════════════════════
//  صفحة «هذا البورتفوليو» — التحفة الفنية
//
//  ثاني صفحة مخصصة بالموقع (بعد لوفيت). الفكرة الحاكمة: الزائر
//  **واقف جوّا المشروع نفسه** — فبدل السكرينشوتات، كل ميزة معها
//  رابط «جرّبها حية» بيوديه عالمكان الفعلي. الصفحة معرض حي.
//
//  البنية: هيرو ميتا ← أرقام بعدادات متحركة ← الجولة (٩ مميزات
//  بالتفصيل) ← «كيف تستفيد منه» (مسار بيتعلّم عليه) ← الخارطة
//  المستقبلية ← CTA.
//
//  ⚠️ الأرقام الديناميكية (مقالات، خدمات) بتنسحب من مصادرها —
//     بتتحدث لحالها. الثابتة (صفحات، أدوات) مكتوبة بتعليق جنبها.
//  ⚠️ العدادات بتشتغل مرة عند الظهور (IO) وبتحترم reduced-motion.
// ═══════════════════════════════════════════════════════════════
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import servicesData from '../data/services.json';
import work from '../data/work.json';

interface Props {
  lang: 'en' | 'ar';
}

const { lang } = Astro.props;
const isAr = lang === 'ar';
const p = isAr ? '/ar' : '';

const project = (work as any).projects.find((x: any) => x.id === 'portfolio');

// ─── الأرقام الحية ───
const articlesCount = (await getCollection('blog')).filter((x) => x.data.lang === lang && !x.data.draft).length;
const servicesCount = (servicesData as any).services.length;
// ⚠️ ثوابت بتتحدث بالإيد لما يكبر الموقع:
const PAGES_COUNT = 100; // «+١٠٠ صفحة» — البناء الحالي ١٠٤
const TOOLS_COUNT = 10; // ٧ ألعاب مقالات + عين البراند + الميزانية + اللمبة

const t = isAr
  ? {
      seoTitle: 'تصميم موقع شخصي بيشرح نفسه: جولة بهذا البورتفوليو',
      seoDesc: 'جولة بتصميم موقع شخصي حي: لغتان كاملتان، عشر أدوات تفاعلية، ومجسمات ثلاثية الأبعاد. شوف كيف انبنى، وبعدها احكيلي عن موقعك.',
      back: 'كل الأعمال',
      role: 'تصميم وبناء واجهة',
      title: 'هذا البورتفوليو: تصميم موقع شخصي بيشرح نفسه',
      lede: 'أغرب صفحة أعمال رح تشوفها: إنت واقف جوّا المشروع نفسه هلأ. فبدل ما أفرجيك صور، كل ميزة تحت معها زر بيوديك عليها تجرّبها بإيدك. الموقع هو المعرض.',
      liveBadge: 'حي، وبيكبر باستمرار',
      statsTitle: 'بالأرقام',
      stats: [
        { n: PAGES_COUNT, suffix: '+', label: 'صفحة مبنية' },
        { n: 2, suffix: '', label: 'لغتان كاملتان، مش ترجمة آلية' },
        { n: TOOLS_COUNT, suffix: '', label: 'أدوات ولعبات تفاعلية' },
        { n: articlesCount, suffix: '', label: 'مقالات من شغل حقيقي' },
        { n: servicesCount, suffix: '', label: 'خدمات بمجسمات ثلاثية الأبعاد' },
        { n: 0, suffix: '', label: 'أخطاء بفحص الـ SEO التقني' },
      ],
      tourTitle: 'الجولة: شو جوّاه',
      tourSub: 'كل ميزة هون بتقدر تجربها حية: الزر بيوديك عليها مباشرة.',
      features: [
        {
          k: '01',
          t: 'فيلم بيتحرك بسكرولك',
          d: 'أول ما تفتح الرئيسية، الفيديو ما بيلعب لحاله. إنت اللي بتحركه: كل سنتيمتر سكرول بيقدّم الفيلم كادر كادر، بنسخة عريضة للشاشات الكبيرة وعمودية للموبايل. نفس المحرك بيشتغل بمقاطع متعددة عبر الموقع بدون ما يتعارضوا.',
          href: `${p}/#top`,
          cta: 'جرّبه بالرئيسية',
        },
        {
          k: '02',
          t: 'العربي أولاً، مش ترجمة',
          d: 'الموقع مبني من أول سطر ليكون عربي RTL بالكامل: الاتجاهات، الحركات، وحتى الأغلفة المولّدة للمشاريع بتتبدل حسب لغة الصفحة. زر اللغة بينقلك لنفس الصفحة بالضبط باللغة الثانية، مش للرئيسية.',
          href: null,
          cta: null,
        },
        {
          k: '03',
          t: 'سبع ألعاب جوّا المقالات',
          d: 'كل مقالة بقسم «إشارات» فيها لعبة بتخليك تجرب الفكرة بدل ما تقرأها: بتترجم عروض شركات التسويق بند بند، بتحرك معادلة البيع بإيدك، بتحاور شركة وهمية وبتصطاد أعلامها الحمراء، بتخاطب مليون شخص وبتشوف مين بيوقف، بتصلّح رحلة شراء مسرّبة، بترسم عميلك المثالي، وبتفرز تقرير حملة كامل.',
          href: `${p}/signals/`,
          cta: 'افتح الإشارات',
        },
        {
          k: '04',
          t: 'لعبة بتتجدد كل يوم',
          d: '«عين البراند»: عشر جولات بتدرب فيها عينك تفرق بين تصميم بيبيع وتصميم بس حلو. أسئلتها بتتجدد يومياً، وعندها ذاكرة: بتحفظ رقمك القياسي وبتتحداك تكسره، وبآخر كل جولة بتقلك بالضبط شو المبادئ اللي فاتتك.',
          href: `${p}/signals/${isAr ? 'ar-3ain-al-brand' : 'en-the-brand-eye'}/`,
          cta: 'دَرِّب عينك',
        },
        {
          k: '05',
          t: 'مختبر أفكار بحبل حقيقي',
          d: 'لمبة بتنسحب بحبل بيتأرجح ويرتد زي الحقيقي، وبس تضوي بيصحى المختبر: بتحكيله عن مشروعك بكلماتك، وبيرد عليك بفكرة تسويقية مخصصة إلك تقدر تنفذها هالأسبوع. وإذا حبيت تتواصل، كل سياقك بيوصلني معك، ما بتعيد الشرح.',
          href: `${p}/#lab`,
          cta: 'اسحب الحبل',
        },
        {
          k: '06',
          t: 'مجسم ثلاثي الأبعاد لكل خدمة',
          d: 'كل خدمة من العشرة إلها جسم سلكي ثلاثي الأبعاد خاص فيها: تضاريس بترتفع للـ SEO، لوحة دارات للمواقع، أعمدة شعاعية للإعلانات... مرسومة بالكود مباشرة بمحرك حجمه أقل من ٥ كيلوبايت، بتلف مع الماوس وبتنبض بالكبسة، وما بتاكل من سرعة الصفحة شي.',
          href: `${p}/services/seo/`,
          cta: 'شوف مجسم الـ SEO',
        },
        {
          k: '07',
          t: 'بكجات بلا وعود',
          d: 'صفحة الخدمات فيها تركيبات مجربة بتشتغل مع بعض، ومكتوب تحتها بالحرف: ما في بكج بيضمن مبيعات. السعر بيطلع من تشخيص مشروعك مش من قائمة، وكل صفحة خدمة بتقلك بصراحة شو اللي الخدمة لحالها ما بتحله.',
          href: `${p}/services/#packs`,
          cta: 'شوف البكجات',
        },
        {
          k: '08',
          t: 'تشخيص بردّ أولي مدروس',
          d: 'نموذج طلب المشروع مش فورم بيروح عالفراغ: طلبك بيوصلني فوراً بأكثر من قناة، وبيرجعلك رد أولي مدروس خلال دقايق بيقرأ وضعك وبيعطيك خطوة تقدر تعملها اليوم، وبعده ردي الشخصي خلال ٢٤ ساعة.',
          href: `${p}/brief/`,
          cta: 'جرّب النموذج',
        },
        {
          k: '09',
          t: 'تحت الغطا',
          d: 'الصفحات بتفتح بسرعة لأنه ما في مكتبات ثقيلة بتنحمل عالزائر إلا وين ما إلها داعي فعلي. فحص الـ SEO التقني بيطلع صفر ملاحظات: بيانات منظمة بكل صفحة، خرائط موقع، وصف ثنائي اللغة لكل رابط، وفحوصات آلية بتلعب كل لعبة وبتكبس كل زر قبل أي تحديث بينزل.',
          href: null,
          cta: null,
        },
      ],
      guideTitle: 'كيف تستفيد منه أحسن استفادة؟',
      guideSub: 'مسار من خمس خطوات، علّم على اللي خلصته:',
      guide: [
        { t: 'العب «كشف الشركة»', d: 'سبع ردود من شركة تسويق وهمية، وإنت بتحكم: طبيعي ولا علم أحمر؟ رح تطلع منها بعين ثانية.', href: `${p}/signals/${isAr ? 'ar-dikor-raqami' : 'en-digital-decor'}/` },
        { t: 'اقرأ «معادلة البيع»', d: 'ليش الإعلان الممتاز لحاله بيطلّع بيع واحد من ألف كبسة؟ حرّك السلايدرز وشوف بعينك.', href: `${p}/signals/${isAr ? 'ar-daman-almabi3at' : 'en-sales-guarantee'}/` },
        { t: 'اسحب حبل المختبر', d: 'احكيله عن مشروعك بجملة، وخد فكرة تنفذها هالأسبوع ببلاش.', href: `${p}/#lab` },
        { t: 'قارن البكجات', d: 'شوف كيف بتبين البكجات لما تنبني عالصراحة بدل الوعود.', href: `${p}/services/#packs` },
        { t: 'احجز جلسة تشخيص', d: 'إذا وصلت لهون والموضوع جدي: احكيلي عن مشروعك وخلينا نعرف وين الخلل بالضبط.', href: `${p}/brief/` },
      ],
      guideDone: 'مسارك',
      roadTitle: 'لوين رايح؟',
      roadSub: 'الموقع بيكبر باستمرار. هاي الخارطة الجاية، بلا مواعيد وهمية:',
      road: [
        { t: 'مقالات وألعاب جديدة', d: 'قسم إشارات بيكبر باستمرار: مواضيع جديدة، وكل وحدة بلعبتها.', now: true },
        { t: 'خدمتان قيد التجهيز', d: 'تحليل البيانات وأنظمة الذكاء والأتمتة، صفحاتهم جاهزة وبتقدر تحجز مكانك بقائمة الانتظار من هلأ.', now: true },
        { t: 'حساب شخصي للعملاء', d: 'تسجيل دخول بيخلي كل عميل يتابع مشروعه: وين وصل الشغل، وشو الجاي.', now: false },
        { t: 'لوحة متابعة حية', d: 'أرقام مشروعك (حملات، زيارات، نتائج) بلوحة وحدة بتفتحها بأي وقت، بدل تقارير الشهر اللي بتضيع.', now: false },
        { t: 'أدوات أذكى بالمختبر', d: 'أدوات تفاعلية أكثر بتحلل وبتقترح، مبنية على نفس فلسفة «جرب قبل ما تقرر».', now: false },
      ],
      nowTag: 'شغال هلأ',
      soonTag: 'بالخارطة',
      ctaTitle: 'الموقع نفسه هو نموذج الشغل.',
      ctaBody: 'كل اللي شفته بهالصفحة أنا صممته وبنيته. إذا بدك مستوى زي هيك لمشروعك (موقع، هوية، أو منظومة تسويق كاملة)، خلينا نبلش بالتشخيص.',
      ctaBtn: 'احكيلي عن مشروعك',
      // ⚠️ نص الرابط مقصود للسيو: «تصميم مواقع الكترونية» بيسند صفحة الخدمة
      ctaGhost: 'شوف خدمة تصميم مواقع الكترونية',
      // رابط ثاني لمعرض المواقع بنص «نماذج تصميم مواقع» (سيو داخلي)
      ctaGhost2: 'نماذج تصميم مواقع',
      visit: null,
    }
  : {
      seoTitle: 'Web Design in Amman: A Portfolio That Explains Itself',
      seoDesc: 'A live web design case study from Amman: the bilingual portfolio you are inside, ten interactive tools, 3D wireframes and an idea lab. Tour it in place.',
      back: 'All work',
      role: 'Design & Front-end Build',
      title: 'This portfolio: web design from Amman that explains itself',
      lede: 'The strangest case study you will see: you are standing inside the project right now. So instead of screenshots, every feature below has a button that takes you to try it yourself. The site is the gallery.',
      liveBadge: 'Live, and growing',
      statsTitle: 'In numbers',
      stats: [
        { n: PAGES_COUNT, suffix: '+', label: 'pages built' },
        { n: 2, suffix: '', label: 'full languages, not machine translation' },
        { n: TOOLS_COUNT, suffix: '', label: 'interactive tools and games' },
        { n: articlesCount, suffix: '', label: 'articles from real work' },
        { n: servicesCount, suffix: '', label: 'services with 3D wireframes' },
        { n: 0, suffix: '', label: 'issues in the technical SEO audit' },
      ],
      tourTitle: 'The tour: what is inside',
      tourSub: 'Every feature here can be tried live: the button takes you straight to it.',
      features: [
        {
          k: '01',
          t: 'A film driven by your scroll',
          d: 'Open the homepage and the video does not play itself. You drive it: every centimetre of scroll advances the film frame by frame, with a wide cut for desktops and a portrait one for phones. The same engine runs multiple sequences across the site without conflicts.',
          href: `${p}/#top`,
          cta: 'Try it on the homepage',
        },
        {
          k: '02',
          t: 'Arabic-first, not translated',
          d: 'Built RTL-first from the very first line: directions, motion, and even the generated project covers switch with the page language. The language button takes you to the exact same page in the other language, never back to the homepage.',
          href: null,
          cta: null,
        },
        {
          k: '03',
          t: 'Seven games inside the articles',
          d: 'Every article in Signals has a game that lets you try the idea instead of reading it: translate marketing packages item by item, move the sales equation with your hands, interrogate a fictional agency and catch its red flags, address a million people and see who stays, repair a leaking purchase journey, draw your ideal customer, and sort a full campaign report.',
          href: `${p}/signals/`,
          cta: 'Open Signals',
        },
        {
          k: '04',
          t: 'A game that refreshes daily',
          d: 'The Brand Eye: ten rounds training your eye to tell selling design from merely pretty design. Its questions refresh every day, and it has memory: it keeps your record, dares you to break it, and tells you exactly which principles you missed.',
          href: `${p}/signals/${isAr ? 'ar-3ain-al-brand' : 'en-the-brand-eye'}/`,
          cta: 'Train your eye',
        },
        {
          k: '05',
          t: 'An idea lab with a real cord',
          d: 'A lamp you pull by a cord that swings and springs back like a real one. Once lit, the lab wakes up: tell it about your business in your own words and it answers with a marketing idea tailored to you, executable this week. And if you decide to get in touch, your full context travels with you, no repeating yourself.',
          href: `${p}/#lab`,
          cta: 'Pull the cord',
        },
        {
          k: '06',
          t: 'A 3D wireframe per service',
          d: 'Each of the ten services has its own 3D wire body: rising terrain for SEO, a circuit board for websites, radial bars for ads... drawn directly in code by an engine under 5 kilobytes. It tilts with your mouse, pulses on click, and costs the page nothing.',
