const workHref = `${p}/#work`;
const cover = isAr ? project.coverWide || project.cover : project.coverEnWide || project.coverWide || project.cover;
---

<Base title={`${t.seoTitle} | ${isAr ? 'ريّان الواثق' : 'Rayan Elwathiq'}`} description={t.seoDesc} lang={lang} image={cover}>
  <Nav lang={lang} switchTo={isAr ? '/work/portfolio/' : '/ar/work/portfolio/'} />

  <main id="top" class="pf" data-pf>
    <!-- ═══ الهيرو الميتا ═══ -->
    <header class="hero container">
      <a class="back" href={workHref}>{isAr ? '→' : '←'} {t.back}</a>
      <p class="role" data-reveal>{t.role}</p>
      <h1 data-reveal>{t.title}</h1>
      <p class="lede" data-reveal>{t.lede}</p>
      <p class="live" data-reveal><span class="dot" aria-hidden="true"></span>{t.liveBadge}</p>
    </header>

    <!-- ═══ الأرقام — عدادات بتتحرك عند الظهور ═══ -->
    <section class="stats container">
      <h2 class="sec-title" data-reveal>{t.statsTitle}</h2>
      <div class="stats-grid" data-stagger>
        {
          t.stats.map((s) => (
            <div class="stat">
              <b><span data-count={s.n}>0</span>{s.suffix}</b>
              <span class="stat-label">{s.label}</span>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ═══ الجولة ═══ -->
    <section class="tour container">
      <h2 class="sec-title" data-reveal>{t.tourTitle}</h2>
      <p class="sec-sub" data-reveal>{t.tourSub}</p>
      <div class="feats">
        {
          t.features.map((f, i) => (
            <article class={`feat ${i % 2 ? 'is-alt' : ''}`} data-reveal>
              <span class="feat-k" aria-hidden="true">{f.k}</span>
              <div class="feat-body">
                <h3>{f.t}</h3>
                <p>{f.d}</p>
                {f.href && (
                  <a class="feat-cta" href={f.href}>
                    {f.cta} <span aria-hidden="true">{isAr ? '←' : '→'}</span>
                  </a>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ═══ مسار الاستفادة — بينعلّم عليه ═══ -->
    <section class="guide container">
      <h2 class="sec-title" data-reveal>{t.guideTitle}</h2>
      <p class="sec-sub" data-reveal>{t.guideSub}</p>
      <div class="guide-bar" data-reveal>
        <span class="guide-label">{t.guideDone}</span>
        <span class="guide-track"><i data-guide-fill></i></span>
        <span class="guide-pct" data-guide-pct>{isAr ? '٠٪' : '0%'}</span>
      </div>
      <ol class="steps" data-stagger>
        {
          t.guide.map((g, i) => (
            <li class="step" data-step={i}>
              <button type="button" class="step-check" data-step-check aria-label={g.t} aria-pressed="false">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 13l4 4L19 7" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </button>
              <div class="step-body">
                <a href={g.href}><h3>{g.t}</h3></a>
                <p>{g.d}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- ═══ الخارطة ═══ -->
    <section class="road container">
      <h2 class="sec-title" data-reveal>{t.roadTitle}</h2>
      <p class="sec-sub" data-reveal>{t.roadSub}</p>
      <ol class="road-list" data-stagger>
        {
          t.road.map((r) => (
            <li class={`road-item ${r.now ? 'is-now' : ''}`}>
              <span class="road-dot" aria-hidden="true" />
              <div>
                <span class="road-top">
                  <h3>{r.t}</h3>
                  <span class="road-tag">{r.now ? t.nowTag : t.soonTag}</span>
                </span>
                <p>{r.d}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- ═══ الخاتمة ═══ -->
    <section class="cta container" data-reveal>
      <h2>{t.ctaTitle}</h2>
      <p>{t.ctaBody}</p>
      <div class="cta-actions">
        <a class="btn btn-primary" href={`${p}/brief/`}>{t.ctaBtn}</a>
        <a class="btn btn-ghost" href={`${p}/services/websites/`}>{t.ctaGhost}</a>
        {t.ctaGhost2 && <a class="btn btn-ghost" href={`${p}/websites/`}>{t.ctaGhost2}</a>}
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</Base>

<script>
  // ═══════════════════════════════════════════════════════════
  //  ١) العدادات: بتعد من صفر للرقم لما تظهر بالشاشة
  //  ٢) مسار الاستفادة: علامات بتنحفظ بالمتصفح + شريط تقدم
  // ═══════════════════════════════════════════════════════════
  function initPortfolio() {
    const root = document.querySelector('[data-pf]') as HTMLElement | null;
    if (!root || root.dataset.ready === '1') return;
    root.dataset.ready = '1';

    const isAr = document.documentElement.lang === 'ar';
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fmt = (v: number) => Math.round(v).toLocaleString(isAr ? 'ar-EG' : 'en-US');

    // ─── العدادات ───
    const counters = [...root.querySelectorAll('[data-count]')] as HTMLElement[];
    const runCount = (el: HTMLElement) => {
      const target = Number(el.dataset.count || 0);
      if (reduce || target === 0) {
        el.textContent = fmt(target);
        return;
      }
      const t0 = performance.now();
      const DUR = 1100;
      const step = (now: number) => {
        const p = Math.min(1, (now - t0) / DUR);
        el.textContent = fmt(target * (1 - Math.pow(1 - p, 3)));
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            io.unobserve(e.target);
            runCount(e.target as HTMLElement);
          }),
        { threshold: 0.6 },
      );
      counters.forEach((el) => io.observe(el));
    } else {
      counters.forEach(runCount);
    }

    // ─── مسار الاستفادة ───
    // ⚠️ التخزين بالمتصفح بس (زي سجل عين البراند) — وضع خاص بيرمي
    //    استثناء عالكتابة، فكل وصول جوّا try
    const KEY = 'pf-guide';
    const load = () => {
      try {
        return JSON.parse(localStorage.getItem(KEY) || '[]');
      } catch {
        return [];
      }
    };
    const save = (arr: number[]) => {
      try {
        localStorage.setItem(KEY, JSON.stringify(arr));
      } catch {}
    };

    const checks = [...root.querySelectorAll('[data-step-check]')] as HTMLButtonElement[];
    const fill = root.querySelector('[data-guide-fill]') as HTMLElement | null;
    const pct = root.querySelector('[data-guide-pct]') as HTMLElement | null;

    const render = () => {
      const done = load();
      checks.forEach((btn, i) => {
        const on = done.includes(i);
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
        btn.closest('.step')?.classList.toggle('is-done', on);
      });
      const ratio = checks.length ? done.length / checks.length : 0;
      if (fill) fill.style.width = ratio * 100 + '%';
      if (pct) pct.textContent = fmt(Math.round(ratio * 100)) + (isAr ? '٪' : '%');
    };

    checks.forEach((btn, i) => {
      btn.addEventListener('click', () => {
        const done = load();
        const at = done.indexOf(i);
        if (at === -1) done.push(i);
        else done.splice(at, 1);
        save(done);
        render();
      });
    });

    render();
  }

  initPortfolio();
  document.addEventListener('astro:page-load', initPortfolio);
</script>

