        { t: 'Play The Company Detector', d: 'Seven replies from a fictional agency, and you judge: normal or red flag? You leave with a second pair of eyes.', href: `${p}/signals/${isAr ? 'ar-dikor-raqami' : 'en-digital-decor'}/` },
        { t: 'Read The Sales Equation', d: 'Why does a perfect ad alone produce one sale from a thousand clicks? Move the sliders and see.', href: `${p}/signals/${isAr ? 'ar-daman-almabi3at' : 'en-sales-guarantee'}/` },
