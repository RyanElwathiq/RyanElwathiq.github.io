---
// ═══════════════════════════════════════════════════════════════
//  صفحة LUV IT — مصمّمة خصيصاً، مش القالب العام
//
//  ⚠️⚠️ القاعدة الأولى: **المحتوى للعميل، والصفحة إلنا** ⚠️⚠️
//  أول نسخة انبنت بألوان LUV IT (خلفيات فاتحة)، فصارت الصفحة
//  تبيّن كأنها من موقع ثاني. الآن كل الصفحة بألوان هويتنا:
//  الخلفية الفحمية، النص الأبيض المطفي، واللون الليموني.
//  ألوان العميل بتبيّن بصورها وبمربّعات الألوان بس — لأن هاي
//  معلومة عن المشروع مش ستايل للصفحة.
//
//  ⚠️ القاعدة الثانية: ولا صورة بتنحشر بصندوق.
//  كل صورة بتنعرض بنسبتها الأصلية (width/height من luvit.json).
//  العريضة إلها شريط بارتفاع ثابت وعرض حر، والباقي بأعمدة
//  masonry — فما بيطلع ولا فراغ ولا قص.
//
//  ⚠️ القاعدة الثالثة: كل عنصر مهم جوّا إطار الهوية (.frame).
//  الإطار معرّف بـ global.css: زوايا وحدود من نظامنا، ولما تقرّب
//  عليه (أو تضغط بالموبايل) بيلفّه خط ليموني رفيع مع لمعة خفيفة.
//
//  ✏️ بدك تضيف أو تشيل صور؟ ما تعدّل هذا الملف —
//     عدّل التصنيف بـ _check/luvitdist.mjs وشغّله، وهو بيكتب
//     src/data/luvit.json وهاي الصفحة بتقرأ منه لحالها.
// ═══════════════════════════════════════════════════════════════
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import Rail from '../components/Rail.astro';
import BrandEyeSection from '../components/BrandEyeSection.astro';
import assets from '../data/luvit.json';

interface Props {
  project: any;
  lang: 'en' | 'ar';
}

const { project: p, lang } = Astro.props;
const isAr = lang === 'ar';

const title = isAr ? p.titleAr : p.title;
const role = isAr ? p.roleAr : p.role;
const desc = isAr ? p.descAr : p.desc;
// وصف جوجل غير النص الظاهر — شوف الشرح بـ ProjectPage.astro
const metaDesc = (isAr ? p.seoDescAr : p.seoDesc) || desc;
const story = (isAr ? p.storyAr : p.story) || {};

const a = assets as Record<string, { file: string; id: string; w: number; h: number }[]>;

// كل النصوص باللغتين بمكان واحد — أسهل بالتعديل من تفريقها بالصفحة
const t = isAr
  ? {
      home: 'الرئيسية',
      back: 'التسويق',
      meta: ['٢٠٢٦', 'دخول السوق الأردني', 'علامة تركية'],
      identity: 'العلامة',
      identityNote:
        'علامة جاهزة جاية من تركيا — شغلي كان أخلّيها تحكي عربي بدون ما تفقد شكلها. نفس اللوجو، نفس السماوي، بس على كل مقاس ولكل منصة، ومكتوبة بصوت السوق اللي داخلين عليه.',
      palette: 'ألوان العلامة',
      shelf: 'ثمن منتجات، رفّ واحد',
      shelfNote:
        'كل عبوة انفرغت من خلفيتها عشان تنحطّ بأي تصميم بدون ما نرجع للمصوّر. هاد اللي خلّى إنتاج التصاميم أسرع ٤٠٪.',
      boards: 'نعلّم الروتين، مش نعلن المنتج',
      boardsNote:
        'اللوحات هاي هي جوهر الاستراتيجية: مين إحنا، شو الفجوة بالسوق، وكيف تختار روتينك. الزائر بيطلع فاهم بشرته، والمنتج بيجي نتيجة طبيعية للفهم.',
      feed: 'مبني للشبكة',
      feedNote:
        'كل بوست مقصوص من صورة وحدة أكبر. لما تنزل الثلاثية على الصفحة بتقرأها العين كلوحة وحدة متواصلة — مش ثلاث بوستات جنب بعض.',
      feedBefore: 'قبل التقصيص',
      stories: 'الستوريز',
      storiesNote: 'أطقم ستوري كاملة بنفس اللغة — إعلان، شرح مكوّن، وسؤال بيفتح محادثة.',
      posts: 'البوستات',
      highlights: 'أغلفة الهايلايت',
      influencers: 'الإنفلونسرز',
      influencersNote: 'انعرضوا بتصميم بيدمجهم مع العلامة، مش صور منفردة مرمية بالصفحة.',
      shoot: 'الجلسة اللي ما نزّلناها',
      shootNote:
        'جلسة تصوير كاملة إجت مع العلامة — وما استخدمناها بالأردن، لأنها بتحكي لجمهور ثاني. حطّيتها هون لأنها بتوضّح الفرق: نفس المنتج، سوقين مختلفين، وقرار تسويقي بينهم.',
      lab: 'قبل ما تستقرّ الهوية',
      labNote:
        'تجارب أولى وأغلفة ما انعتمدت. ما بخبّيها — هي اللي بتوضّح إنه النتيجة النهائية كانت اختيار، مش أول شي طلع.',
      chLabel: 'التحدي',
      apLabel: 'المقاربة',
      reLabel: 'النتيجة',
      pieces: 'قطعة',
      dragHint: 'اسحب أو مرّر بإصبعين',
      prev: 'السابق',
      next: 'التالي',
    }
  : {
      home: 'Home',
      back: 'Marketing',
      meta: ['2026', 'Jordan market entry', 'Turkish label'],
      identity: 'The mark',
      identityNote:
        'A finished brand arriving from Turkey — my job was to make it speak Arabic without losing its face. Same logo, same cyan, but working at every size, on every platform, in the voice of the market it was entering.',
      palette: 'Brand palette',
      shelf: 'Eight products, one shelf',
      shelfNote:
        'Every bottle was cut out from its background so it could drop into any design without going back to the photographer. That is where the 40% faster turnaround came from.',
      boards: 'Teach the routine, do not announce the product',
      boardsNote:
        'These boards are the strategy itself: who we are, what the gap in the market is, and how to choose your routine. The visitor leaves understanding their skin — the product becomes the natural conclusion.',
      feed: 'Built for the grid',
      feedNote:
        'Each post is sliced out of one larger image. When the set lands on the profile the eye reads it as a single continuous artwork — not three posts sitting next to each other.',
      feedBefore: 'Before slicing',
      stories: 'Stories',
      storiesNote:
        'Full story sets in one language — an announcement, an ingredient explainer, and a question that opens a conversation.',
      posts: 'The posts',
      highlights: 'Highlight covers',
      influencers: 'Influencers',
      influencersNote:
        'Presented inside a design that folds them into the brand, rather than dropped on the page as loose photos.',
      shoot: 'The shoot we held back',
      shootNote:
        'A full photoshoot came with the brand — and we never ran it in Jordan, because it speaks to a different audience. It sits here because it shows the difference: same product, two markets, and a marketing decision in between.',
      lab: 'Before the identity settled',
      labNote:
        'Early experiments and covers that were never approved. I am not hiding them — they are what proves the final result was a choice, not the first thing that came out.',
      chLabel: 'Challenge',
      apLabel: 'Approach',
      reLabel: 'Result',
      pieces: 'pieces',
      dragHint: 'Drag or swipe',
      prev: 'Previous',
      next: 'Next',
    };

// عدد القطع = كل أصول LUV IT المصنّفة (بينحسب لحاله من luvit.json)
// ⚠️ بالعربي لازم يكون بالأرقام العربية زي باقي الموقع
const total = Object.values(a).reduce((n, arr) => n + arr.length, 0);
const totalText = total.toLocaleString(isAr ? 'ar-EG' : 'en-US');

const blocks = [
  { label: t.chLabel, text: story.challenge },
  { label: t.apLabel, text: story.approach },
  { label: t.reLabel, text: story.result },
].filter((b) => b.text);

// كل الصور بتمرق من هون: نفس الترتيب ونفس الخصائص، مرة وحدة
const img = (x: { file: string; w: number; h: number }, alt: string, eager = false) => ({
  src: x.file,
  width: x.w,
  height: x.h,
  alt,
  loading: eager ? ('eager' as const) : ('lazy' as const),
  decoding: 'async' as const,
});

// ألوان العلامة — معلومة عن المشروع، مش ستايل للصفحة
const palette = ['#4FC3DC', '#1B4C63', '#EAF4F9', '#2B2B2B'];
---

<Base
  title={`${title} | ${isAr ? 'ريّان الواثق' : 'Rayan Elwathiq'}`}
  description={metaDesc}
  lang={lang}
  image={a.coverFinal?.[0]?.file}
>
  <Nav lang={lang} />

  <main id="top" class="luv">
    <div class="container">
      <!-- ═══════════ الترويسة ═══════════ -->
      <nav class="crumbs">
        <a href={`${isAr ? '/ar' : ''}/#growth`}>{t.home}</a>
        <span aria-hidden="true">/</span>
        <a href={`${isAr ? '/ar' : ''}/marketing/`}>{t.back}</a>
      </nav>

      <header class="head">
        <p class="role" data-reveal>{role}</p>
        <h1 data-reveal>{title}</h1>
        <p class="lede" data-reveal>{desc}</p>
        <ul class="meta" data-reveal>
          {t.meta.map((m) => <li>{m}</li>)}
          <li class="count">{totalText} {t.pieces}</li>
        </ul>
      </header>

      <!-- ═══════════ الغلاف ═══════════
           جوّا الحاوية وبإطار الهوية: خط ليموني هادي ولمعة خفيفة -->
      {
        a.coverFinal?.[0] && (
          <figure class="cover frame frame-on" data-reveal>
            <img {...img(a.coverFinal[0], title, true)} />
          </figure>
        )
      }

      <!-- ═══════════ اللوجو والألوان ═══════════ -->
      <section class="identity">
        <figure class="mark frame" data-reveal>
          {a.logo?.[0] && <img {...img(a.logo[0], `${title} logo`)} />}
        </figure>
        <div class="mark-copy" data-reveal>
          <h2>{t.identity}</h2>
          <p>{t.identityNote}</p>
          <p class="pal-label">{t.palette}</p>
          <ul class="swatches">
            {palette.map((c) => (
              <li>
                <span style={`--c: ${c}`} />
                {c}
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- ═══════════ الرفّ: المنتجات المفرّغة ═══════════
           ⚠️ ما في خلفية ورا المنتجات — كل عبوة جوّا إطار الهوية،
              فالمنتج بيبيّن والإطار إلنا -->
      <section class="sec">
        <div class="sec-head" data-reveal>
          <h2>{t.shelf}</h2>
          <p>{t.shelfNote}</p>
        </div>
        <div class="shelf" data-stagger>
          {
            a.png?.map((x, i) => (
              <figure class="bottle frame">
                <img {...img(x, `${title} — product ${i + 1}`)} />
              </figure>
            ))
          }
        </div>
      </section>
    </div>

    <!-- ═══════════════════════════════════════════════════════════
         اللوحات العريضة — شريط بينسحب
         ⚠️ اللوحات عرضها ٤ أضعاف ارتفاعها. أي شبكة بتحطّها بصندوق
            بتترك مساحات فاضية فوق وتحت. الحل: ارتفاع ثابت وعرض حر.
         ═══════════════════════════════════════════════════════════ -->
    <Rail lang={lang} heading={t.boards} note={t.boardsNote} hint={t.dragHint} prev={t.prev} next={t.next}>
      {
        a.boards?.map((x, i) => (
          <figure class="board frame">
            <img {...img(x, `${title} — board ${i + 1}`)} />
          </figure>
        ))
      }
    </Rail>

    <div class="container">
      <!-- ═══════════ الشبكة: الثلاثية ═══════════ -->
      <section class="sec">
        <div class="sec-head" data-reveal>
          <h2>{t.feed}</h2>
          <p>{t.feedNote}</p>
        </div>

        <!-- ⚠️ الثلاثية كلها بإطار واحد ومسافة ٢ بكسل بين البلاطات —
             لازم تبيّن صورة وحدة متواصلة زي ما بتبيّن على انستغرام -->
        <div class="feed frame" data-reveal>
          {
            a.triptych?.map((x, i) => (
              <figure class="tile">
                <img {...img(x, `${title} — grid ${i + 1}`)} />
              </figure>
            ))
          }
        </div>

        {
          a.triptychFirst?.length > 0 && (
            <div class="before" data-reveal>
              <span class="tag">{t.feedBefore}</span>
              <div class="before-row" data-stagger>
                {[...a.triptychFirst, ...(a.soft || [])].map((x, i) => (
                  <figure class="frame">
                    <img {...img(x, `${title} — before ${i + 1}`)} />
                  </figure>
                ))}
              </div>
            </div>
          )
        }
      </section>
    </div>

    <!-- ═══════════ الستوريز: شريط ٩:١٦ ═══════════ -->
    <Rail
      lang={lang}
      heading={t.stories}
      note={t.storiesNote}
      hint={t.dragHint}
      prev={t.prev}
      next={t.next}
      tall
    >
      {
        a.stories?.map((x, i) => (
          <figure class="phone frame">
            <img {...img(x, `${title} — story ${i + 1}`)} />
          </figure>
        ))
      }
    </Rail>

    <div class="container">
      <!-- ═══════════ البوستات + الهايلايت + الإنفلونسرز ═══════════ -->
      <section class="sec">
        <div class="sec-head" data-reveal>
          <h2>{t.posts}</h2>
        </div>
        <div class="grid" data-stagger>
          {
            a.posts?.map((x, i) => (
              <figure class="frame">
                <img {...img(x, `${title} — post ${i + 1}`)} />
              </figure>
            ))
          }
        </div>

        <div class="split">
          {
            a.highlights?.length > 0 && (
              <div data-reveal>
                <h3>{t.highlights}</h3>
                <div class="mini">
                  {a.highlights.map((x, i) => (
                    <figure class="frame">
                      <img {...img(x, `${title} — highlight ${i + 1}`)} />
                    </figure>
                  ))}
                </div>
              </div>
            )
          }
          {
            a.influencers?.length > 0 && (
              <div data-reveal>
                <h3>{t.influencers}</h3>
                <p class="small">{t.influencersNote}</p>
                <div class="mini mini-4">
                  {a.influencers.map((x, i) => (
                    <figure class="frame">
                      <img {...img(x, `${title} — influencer ${i + 1}`)} />
                    </figure>
                  ))}
                </div>
              </div>
            )
          }
        </div>
      </section>

      <!-- ═══════════ الجلسة ═══════════ -->
      <section class="sec shoot">
        <div class="sec-head" data-reveal>
          <h2>{t.shoot}</h2>
          <p>{t.shootNote}</p>
        </div>
        <div class="shoot-grid" data-stagger>
          {
            a.shoot?.map((x, i) => (
              <figure class="frame">
                <img {...img(x, `${title} — shoot ${i + 1}`)} />
              </figure>
            ))
          }
        </div>
      </section>

      <!-- ═══════════ التجارب قبل الهوية ═══════════ -->
      <section class="sec lab">
        <div class="sec-head" data-reveal>
          <h2>{t.lab}</h2>
          <p>{t.labNote}</p>
        </div>
        <div class="lab-grid" data-stagger>
          {
            [
              ...(a.preIdentity || []),
              ...(a.coverLab || []),
              ...(a.minimal || []),
              ...(a.products || []),
            ].map((x, i) => (
              <figure class="frame">
                <img {...img(x, `${title} — experiment ${i + 1}`)} />
              </figure>
            ))
          }
        </div>
      </section>

      <!-- ═══════════ القصة ═══════════ -->
      {
        blocks.length > 0 && (
          <div class="story">
            {blocks.map((b) => (
              <section class="block" data-reveal>
                <h2>{b.label}</h2>
                <p>{b.text}</p>
              </section>
            ))}
          </div>
        )
      }
    </div>

    <!-- ═══════════ لعبة الهوية ═══════════
         بتشرح نفس المبادئ اللي اشتغلنا فيها بهذا المشروع —
         التباين والتسلسل والانضباط — بدل ما نحكي عنها بس -->
    <BrandEyeSection lang={lang} />
  </main>

  <Footer lang={lang} />
  <Lightbox lang={lang} />
</Base>

<style>
  /* ═══════════════ 🎛️ لوحة التحكم ═══════════════ */
  .luv {
    --h2: clamp(26px, 3.4vw, 44px); /* حجم عناوين الأقسام */
    --gap: clamp(56px, 8vh, 104px); /* المسافة بين الأقسام */
    padding-top: calc(108px + clamp(26px, 4vh, 52px));
  }

  .crumbs {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 26px;
  }

  .crumbs a:hover {
    color: var(--accent);
  }

  .crumbs span {
    opacity: 0.5;
  }

  .role {
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 12px;
  }

  h1 {
    font-size: clamp(36px, 5.6vw, 76px);
    font-weight: 700;
    letter-spacing: -0.025em;
    margin-bottom: 18px;
  }

  html[lang='ar'] h1 {
    font-weight: 800;
    letter-spacing: 0;
  }

  .lede {
    color: var(--muted);
    font-size: clamp(16px, 1.8vw, 21px);
    line-height: 1.7;
    max-width: 58ch;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin-top: 26px;
  }

  .meta li {
    font-size: 13px;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    padding: 7px 16px;
  }

  .meta .count {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    font-family: var(--font-en);
  }

  /* ─── الغلاف ─── */
  .cover {
    margin-top: clamp(36px, 5vh, 60px);
  }

  /* ═══════════════ الأقسام ═══════════════ */
  .sec {
    padding-top: var(--gap);
  }

  h2 {
    font-size: var(--h2);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  html[lang='ar'] h2 {
    font-weight: 800;
    letter-spacing: 0;
  }

  h3 {
    font-size: clamp(17px, 1.9vw, 21px);
    font-weight: 700;
    margin-bottom: 10px;
  }

  .sec-head {
    max-width: 62ch;
    margin-bottom: clamp(26px, 4vh, 42px);
  }

  .sec-head p,
  .mark-copy p {
    margin-top: 12px;
    font-size: 16px;
    line-height: 1.8;
    max-width: 58ch;
    color: var(--muted);
  }

  /* ─── اللوجو والألوان ─── */
  .identity {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: center;
    padding-top: var(--gap);
  }

  .mark {
    display: grid;
    place-items: center;
    padding: clamp(28px, 5vw, 64px);
  }

  .mark img {
    width: min(300px, 70%);
  }

  .pal-label {
    margin-top: 22px !important;
    font-size: 13px !important;
    font-weight: 600;
    color: var(--text) !important;
    letter-spacing: 0.02em;
  }

  .swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    padding: 0;
    margin-top: 10px;
  }

  .swatches li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-en);
    font-size: 12.5px;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    padding: 5px 14px 5px 5px;
    transition: border-color 0.35s var(--ease-out);
  }

  html[lang='ar'] .swatches li {
    padding: 5px 5px 5px 14px;
  }

  .swatches li:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--line));
  }

  .swatches span {
    width: 22px;
    height: 22px;
    border-radius: var(--r-pill);
    background: var(--c);
    border: 1px solid rgba(242, 243, 238, 0.14);
  }

  /* ─── الرفّ: كل عبوة بإطارها، بدون خلفية ورا المنتجات ─── */
  .shelf {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(10px, 1.4vw, 18px);
  }

  .bottle {
    display: grid;
    place-items: end center;
    padding: clamp(14px, 1.8vw, 26px);
  }

