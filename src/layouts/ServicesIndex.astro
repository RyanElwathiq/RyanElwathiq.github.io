---
// ═══════════════════════════════════════════════════════════════
//  فهرس الخدمات — /services/ و /ar/services/
//
//  هاي الصفحة مهمة للسيو: هي اللي بتستهدف البحث العام
//  («خدمات تسويق رقمي الأردن») وبتوزّع قوّتها على الصفحات
//  الداخلية عبر الروابط.
//
//  ✏️ ما في نص خدمات هون — كله من services.json
// ═══════════════════════════════════════════════════════════════
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Particles from '../components/Particles.astro';
import servicesData from '../data/services.json';

interface Props {
  lang: 'en' | 'ar';
}

const { lang } = Astro.props;
const isAr = lang === 'ar';
const L = isAr ? 'ar' : 'en';
const p = isAr ? '/ar' : '';

const services = [...servicesData.services].sort((a, b) => a.order - b.order);

// البكجات (#60) — من services.json حسب اللغة
const packages = (servicesData as any).packages?.[L];

const t = isAr
  ? {
      back: '→ الرئيسية',
      title: 'خدماتي',
      h1: 'شو بقدر أعملك',
      seoDesc:
        'خدمات تسويق رقمي وتصميم من عمّان: مواقع إلكترونية، إعلانات ممولة، سيو، هوية بصرية، سوشال ميديا، مونتاج فيديو، استراتيجية، واستشارات.',
      intro:
        'عشر خدمات، بس المنطق واحد: نفهم المشكلة الحقيقية أول، وبعدين نختار الأداة. اضغط على أي وحدة تشوف شو بتاخد بالضبط وكيف بتصير.',
      ctaTitle: 'مش متأكد شو بتحتاج؟',
      ctaBody: 'عبّي الطلب واحكيلي وضعك، وأنا برجعلك برأي صريح، حتى لو كان الجواب إنك مش محتاج تصرف عندي.',
      ctaBtn: 'احكيلي عن مشروعك',
      more: 'اقرأ التفاصيل ←',
    }
  : {
      back: '← Home',
      title: 'Services',
      h1: 'What I can do for you',
      seoDesc:
        'Digital marketing and design services from Amman: websites, paid ads, SEO, brand identity, social media, video editing, strategy, and consulting.',
      intro:
        'Ten services, one logic: understand the real problem first, then pick the tool. Open any of them to see exactly what you get and how it works.',
      ctaTitle: 'Not sure what you need?',
      ctaBody: 'Send me a brief describing your situation and I will come back with a straight opinion. Even if the answer is that you should not spend anything with me.',
      ctaBtn: 'Tell me about your project',
      more: 'Read the details →',
    };

const site = Astro.site ?? new URL('https://ryanalali.me');

// ItemList — بتقول لجوجل «هاي قائمة خدمات مرتبة» وبتساعده
// يفهم العلاقة بين هالصفحة والصفحات الداخلية
const schema = [
  {
    '@type': 'ItemList',
    name: t.h1,
    itemListElement: services.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s[L].name,
      url: new URL(`${p}/services/${s.slug}/`, site).href,
    })),
  },
];
---

<Base
  title={`${t.title} | ${isAr ? 'ريّان الواثق' : 'Rayan Elwathiq'}`}
  description={t.seoDesc}
  lang={lang}
  schema={schema}
>
  <Nav lang={lang} />

  <main id="top" class="sx">
    <div class="container">
      <a class="back" href={`${p}/`}>{t.back}</a>
      <h1 data-reveal>{t.h1}</h1>
      <p class="intro" data-reveal>{t.intro}</p>

      <div class="grid" data-stagger>
        {services.map((s, i) => (
          <a class="card" href={`${p}/services/${s.slug}/`}>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h2>{s[L].name}</h2>
            <p class="desc">{s[L].menuDesc}</p>
            <p class="hook">{s[L].h1}</p>
            <span class="more">{t.more}</span>
          </a>
        ))}
      </div>

      <!-- ═══════════════════════════════════════════════════════
           البكجات (#60) — تركيبات بتشتغل مع بعض
           ⚠️ بلا أسعار مخترعة عن قصد: السعر بيطلع من تشخيص
              المشروع — نفس مبدأ «لا وعود جاهزة». وملاحظة الصراحة
              (ما في بكج بيضمن مبيعات) جزء من البيع مش ضده.
           ═══════════════════════════════════════════════════════ -->
      {
        packages && (
          <!-- id="packs" مقصود: مقالات الإشارات بتوصل هون مباشرة -->
          <section class="packs" id="packs">
            <h2 data-reveal>{packages.title}</h2>
            <p class="packs-intro" data-reveal>{packages.intro}</p>

            <div class="packs-grid" data-stagger>
              {packages.items.map((pk: any) => (
                <article class="pack">
                  <h3>{pk.name}</h3>
                  <p class="pack-who">{pk.who}</p>
                  <ul class="pack-has">
                    {pk.has.map((sid: string) => {
                      const sv = services.find((s) => s.id === sid);
                      return sv ? (
                        <li>
                          <a href={`${p}/services/${sv.slug}/`}>{sv[L].name}</a>
                        </li>
                      ) : null;
                    })}
                  </ul>
                  <p class="pack-line">{pk.line}</p>
                  <div class="pack-actions">
                    <a class="btn pack-btn" href={`${p}/brief/`}>{packages.cta}</a>
                    <!-- صفحة البكج التفصيلية (2026-08-04) — كتالوج الواتساب بيوصل عليها -->
                    <a class="pack-more" href={`${p}/services/packages/${pk.id}/`}>{isAr ? 'التفاصيل كاملة ←' : 'Full details →'}</a>
                  </div>
                </article>
              ))}
            </div>

            <p class="packs-note" data-reveal>{packages.note}</p>
          </section>
        )
      }

      <section class="cta" data-reveal>
        <h2>{t.ctaTitle}</h2>
        <p>{t.ctaBody}</p>
        <a class="btn" href={`${p}/brief/`}>{t.ctaBtn}</a>
      </section>
    </div>

    <Particles src="/assets/logo-white.png" size="small" />
  </main>

  <Footer lang={lang} />
</Base>

<style>
  /* 🎛️ لوحة التحكم */
  .sx {
    --title: clamp(38px, 6vw, 76px);
    padding-top: calc(108px + clamp(30px, 5vh, 60px));
    min-height: 100dvh;
  }

  .back {
    display: inline-block;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 26px;
    transition: color 0.3s var(--ease-out);
  }
  .back:hover { color: var(--accent); }

  h1 {
    font-size: var(--title);
    font-weight: 700;
    letter-spacing: -0.025em;
    margin-bottom: 16px;
  }
  html[lang='ar'] h1 { font-weight: 800; letter-spacing: 0; }

  .intro {
    color: var(--muted);
    font-size: clamp(15px, 1.6vw, 18px);
    line-height: 1.75;
    max-width: 58ch;
    margin-bottom: clamp(40px, 6vh, 64px);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }

  .card {
    display: block;
    position: relative;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    padding: clamp(24px, 3vw, 34px);
    overflow: hidden;
    transition: transform 0.35s var(--ease-out), border-color 0.35s var(--ease-out), background 0.35s var(--ease-out);
  }

  .card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--accent) 50%, transparent);
    background: var(--surface-2);
  }

  /* الرقم الشبح بالخلفية — نفس لغة الأرقام بباقي الموقع */
  .num {
    position: absolute;
    top: 14px;
    inset-inline-end: 20px;
    font-family: var(--font-en);
    font-size: 52px;
    font-weight: 700;
    line-height: 1;
    color: var(--text);
    opacity: 0.05;
    transition: opacity 0.35s var(--ease-out), color 0.35s var(--ease-out);
  }
  .card:hover .num { opacity: 0.16; color: var(--accent); }

  .card h2 {
    font-size: clamp(19px, 2.2vw, 24px);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 6px;
  }
  html[lang='ar'] .card h2 { font-weight: 800; letter-spacing: 0; }

  .desc { color: var(--accent); font-size: 13.5px; font-weight: 600; margin-bottom: 14px; }

  .hook {
    color: var(--muted);
    font-size: clamp(14px, 1.5vw, 15.5px);
    line-height: 1.65;
    max-width: 34ch;
    margin-bottom: 18px;
  }

  .more {
    display: inline-block;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--text);
    transition: color 0.3s var(--ease-out), transform 0.3s var(--ease-out);
  }
  .card:hover .more { color: var(--accent); }

  /* ═══════════════ البكجات (#60) ═══════════════ */
  .packs {
    margin-top: clamp(64px, 9vh, 110px);
  }

  .packs h2 {
    font-size: clamp(26px, 3.4vw, 42px);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 14px;
  }
  html[lang='ar'] .packs h2 { font-weight: 800; letter-spacing: 0; }

  .packs-intro {
    color: var(--muted);
    font-size: clamp(15px, 1.6vw, 17px);
    line-height: 1.75;
    max-width: 60ch;
    margin-bottom: 28px;
  }

  .packs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  .pack {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: calc(var(--r-card) * 1.3);
    padding: clamp(22px, 2.6vw, 30px);
    transition: border-color 0.3s var(--ease-out), transform 0.3s var(--ease-out);
  }

  .pack:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    transform: translateY(-3px);
  }

  /* البكج الأوسط (النمو الشهري) هو الأشيع — بياخد إبراز خفيف */
  .pack:nth-child(2) {
    border-color: color-mix(in srgb, var(--accent) 35%, var(--line));
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 12%, transparent);
  }

  .pack h3 {
    font-size: clamp(19px, 2.2vw, 24px);
    font-weight: 800;
    margin-bottom: 6px;
  }

  .pack-who {
    color: var(--muted);
    font-size: 13.5px;
    line-height: 1.6;
    margin-bottom: 16px;
  }

  .pack-has {
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .pack-has a {
    display: inline-block;
    padding: 6px 13px;
    border: 1px solid color-mix(in srgb, var(--accent) 30%, var(--line));
    border-radius: var(--r-pill);
    color: var(--text);
    font-size: 13px;
    font-weight: 600;
    transition: border-color 0.25s var(--ease-out), color 0.25s var(--ease-out);
  }

  .pack-has a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .pack-line {
    color: var(--dim);
    font-size: clamp(13.5px, 1.4vw, 15px);
    line-height: 1.75;
    margin-bottom: 20px;
    flex-grow: 1;
  }

  .pack-btn { align-self: start; }

  .pack-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .pack-more {
    font-size: 13.5px;
    font-weight: 700;
    color: var(--accent);
  }

  .pack-more:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ملاحظة الصراحة — ظاهرة ومقروءة، هي جزء من البيع مش هامش */
  .packs-note {
    margin-top: 22px;
    padding: 16px 20px;
    padding-inline-start: 24px;
    border-inline-start: 3px solid color-mix(in srgb, var(--accent) 55%, transparent);
    background: var(--surface);
    border-radius: var(--r-card);
    color: var(--dim);
    font-size: clamp(14px, 1.5vw, 15.5px);
    line-height: 1.75;
    max-width: 74ch;
  }

  /* ─── شريط الطلب ─── */
  .cta {
    margin-top: clamp(56px, 8vh, 96px);
    background: var(--surface);
    border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
    border-radius: calc(var(--r-card) * 1.6);
    padding: clamp(30px, 5vw, 56px);
  }

  .cta h2 {
    font-size: clamp(23px, 3vw, 34px);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }
  html[lang='ar'] .cta h2 { font-weight: 800; letter-spacing: 0; }

  .cta p { color: var(--muted); max-width: 56ch; line-height: 1.75; margin-bottom: 24px; }

  .btn {
    display: inline-flex;
    align-items: center;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 15px;
    font-weight: 600;
    border-radius: var(--r-pill);
    padding: 13px 26px;
    transition: transform 0.3s var(--ease-out), background 0.3s var(--ease-out);
  }
  .btn:hover { transform: translateY(-2px); background: color-mix(in srgb, var(--accent) 85%, #fff); }

  @media (max-width: 780px) {
    .grid { grid-template-columns: 1fr; }
    .packs-grid { grid-template-columns: 1fr; }
  }

  @media (min-width: 781px) and (max-width: 1080px) {
    .packs-grid { grid-template-columns: 1fr 1fr; }
    .pack:nth-child(3) { grid-column: 1 / -1; }
  }
</style>
